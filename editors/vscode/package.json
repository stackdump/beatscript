{
  "name": "beatscript",
  "displayName": "BeatScript",
  "description": "BeatScript for VS Code: highlighting, and through `beatscript lsp` diagnostics, quick-fixes, the outline, go to definition, rename, completion, hover, signature help, inlay hints, refactors, and a reference's expansion shown, hidden, copied or ejected.",
  "version": "0.1.0",
  "publisher": "stackdump",
  "private": true,
  "license": "MIT",
  "engines": { "vscode": "^1.82.0" },
  "categories": ["Programming Languages", "Linters"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "beatscript",
        "aliases": ["BeatScript", "beatscript"],
        "extensions": [".beatscript"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "beatscript", "scopeName": "source.beatscript", "path": "./syntaxes/beatscript.tmLanguage.json" }
    ],
    "configuration": {
      "title": "BeatScript",
      "properties": {
        "beatscript.server.path": {
          "type": "string",
          "default": "beatscript",
          "description": "The beatscript binary (it runs `beatscript lsp`). Build it with `cargo build --release -p beatscript-cli` in stackdump/beatscript."
        },
        "beatscript.server.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["lsp"],
          "description": "The arguments the server is started with."
        },
        "beatscript.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Log the LSP traffic to the BeatScript output channel."
        }
      }
    },
    "commands": [
      { "command": "beatscript.restartServer", "title": "BeatScript: Restart the language server" },
      { "command": "beatscript.expand.toggle", "title": "BeatScript: Show or hide the expansion of the reference here" },
      { "command": "beatscript.expand.all", "title": "BeatScript: Show or hide every reference's expansion" },
      { "command": "beatscript.expand.open", "title": "BeatScript: Open the expansion of the reference here beside" },
      { "command": "beatscript.expand.copy", "title": "BeatScript: Copy the expansion of the reference here" },
      { "command": "beatscript.eject", "title": "BeatScript: Eject the reference here into local text" },
      { "command": "beatscript.preview", "title": "BeatScript: Preview with the player", "icon": "$(open-preview)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "beatscript.preview", "when": "editorLangId == beatscript", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "beatscript.preview", "when": "editorLangId == beatscript" },
        { "command": "beatscript.expand.toggle", "when": "editorLangId == beatscript" },
        { "command": "beatscript.expand.all", "when": "editorLangId == beatscript" },
        { "command": "beatscript.expand.open", "when": "editorLangId == beatscript" },
        { "command": "beatscript.expand.copy", "when": "editorLangId == beatscript" },
        { "command": "beatscript.eject", "when": "editorLangId == beatscript" }
      ]
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "test": "node test/grammar.test.js && node test/preview.test.js"
  }
}
