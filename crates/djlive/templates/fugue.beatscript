# from $REF: a fugue at 104 in B minor, the phrase sung in it (templates $VERSION)
# phrase: $PHRASE
# vocal: $VOCAL
# the subject and the countersubject, from the public-domain theme library: Grieg's Mountain King and Bach's Badinerie
tempo 104
key bm

# the drums: the drm_* parts are what the arrangement changes; the kick and the shaker stay put
let kick4 = x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~ ~ ~
let drm_snr = ~ ~ ~ ~ x ~ ~ ~ ~ ~ ~ ~ x ~ ~ ~
let drm_hat = ~ ~ x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~
let shk = $SHAKER
$THEME_MOUNTAIN_KING
$THEME_BADINERIE
# the vocal line: a degree of the key for each syllable, ! on the stressed ones
$VOX_LETS

# subject: the theme alone
section subject 8 bars {
  deck A: kick kick4 kit=drums vel=75..90
  deck B: melody mountain_king inst=organ vel=60..80
}

# answer: it enters again a fifth up while the first voice goes on
section answer 8 bars {
  deck A: kick kick4 kit=drums vel=80..95 | hihat drm_hat kit=drums vel=40..60
  deck B: melody mountain_king inst=organ vel=60..80 | arp transpose(mountain_king, 7) inst=sax vel=55..75
}

# counter: a third voice against the two, the bass the subject two octaves down
section counter 8 bars {
  deck A: kick kick4 kit=drums vel=85..100 | clap drm_snr kit=drums vel=60..80 | hihat drm_hat kit=drums vel=45..65 | bass octave(mountain_king, -2) inst=bass vel=70..85
  deck B: melody mountain_king inst=organ vel=60..80 | arp transpose(mountain_king, 7) inst=sax vel=55..75 | harmony badinerie inst=flute vel=45..65
}

# sung: the phrase over the subject in the bass
section sung $BARS bars {
  deck A: kick kick4 kit=drums vel=75..90 | hihat$CYCLE shk kit=drums vel=30..45 | bass octave(mountain_king, -2) inst=bass vel=65..80
  deck B: harmony badinerie inst=flute vel=25..40 | melody$CYCLE $VOX inst=kalimba oct=3 vel=24..38
  deck B: sing $LYRIC on melody voice=robot-choir
}

# the subject re-enters transposed, down and back up, while the countersubject morphs toward it
arrange {
  subject
  answer
  ~ badinerie_* morph mountain_king_1 0.25
  counter
  ~ mountain_king_* down 2
  sung
  ~ drm_* grow
  answer
  ~ mountain_king_* up 2
  ~ badinerie_* morph mountain_king_3 0.2
  counter
  @ vox_* xfer shk
  sung
  ~ drm_* decay
} loop 3 then end
