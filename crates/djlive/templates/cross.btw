# from $REF: a cross at 120 in D, two sources taking turns and crossing, the phrase sung over them (templates $VERSION)
# phrase: $PHRASE
# vocal: $VOCAL
# a and b, from the public-domain theme library: Beethoven's Ode to Joy over Pachelbel's ground, and Bach's Badinerie over a B minor bass (D major's relative minor, so the two cross without a clash)
tempo 120
key d

# the drums: the drm_* parts are what the arrangement changes; the kick and the shaker stay put
let kick4 = x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~ ~ ~
let drm_snr = ~ ~ ~ ~ x ~ ~ ~ ~ ~ ~ ~ x ~ ~ ~
let drm_hat = ~ ~ x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~
let shk = $SHAKER
# a: a tune, its bass and its chords
$THEME_ODE_TO_JOY
$THEME_PACHELBEL_GROUND
let a_harmony_1 = [d3, f#3, a3] ~ ~ ~ [a2, c#3, e3] ~ ~ ~ [b2, d3, f#3] ~ ~ ~ [f#2, a2, c#3] ~ ~ ~
let a_harmony_2 = [g2, b2, d3] ~ ~ ~ [d3, f#3, a3] ~ ~ ~ [g2, b2, d3] ~ ~ ~ [a2, c#3, e3] ~ ~ ~
let a_harmony = <a_harmony_1 a_harmony_2>
# b: another tune, its bass and its chords
$THEME_BADINERIE
let b_bass_1 = b1 ~ ~ ~ ~ ~ ~ ~ f#1 ~ ~ ~ ~ ~ ~ ~
let b_bass_2 = g1 ~ ~ ~ ~ ~ ~ ~ f#1 ~ ~ ~ ~ ~ ~ ~
let b_bass = <b_bass_1 b_bass_2>
let b_harmony_1 = [b2, d3, f#3] ~ ~ ~ ~ ~ ~ ~ [f#2, a2, c#3] ~ ~ ~ ~ ~ ~ ~
let b_harmony_2 = [g2, b2, d3] ~ ~ ~ ~ ~ ~ ~ [f#2, a2, c#3] ~ ~ ~ ~ ~ ~ ~
let b_harmony = <b_harmony_1 b_harmony_2>
# the vocal line: a degree of the key for each syllable, ! on the stressed ones
$VOX_LETS

# a_leads: a's tune over its own bass and chords
section a_leads 8 bars {
  deck A: kick kick4 kit=drums vel=80..95 | hihat drm_hat kit=drums vel=40..60 | bass pachelbel_ground inst=bass vel=70..85
  deck B: harmony a_harmony inst=strings vel=40..55 len=4 | melody ode_to_joy inst=flute vel=60..80
}

# b_leads: b's tune over its own bass and chords
section b_leads 8 bars {
  deck A: kick kick4 kit=drums vel=85..100 | clap drm_snr kit=drums vel=60..80 | hihat drm_hat kit=drums vel=45..65 | bass b_bass inst=sub-bass vel=70..85
  deck B: harmony b_harmony inst=warm-pad vel=35..50 len=8 | melody badinerie inst=harpsichord vel=60..80
}

# both: the two at once, b's tune over a's bass and a's tune under it
section both 8 bars {
  deck A: kick kick4 kit=drums vel=85..100 | clap drm_snr kit=drums vel=60..80 | hihat drm_hat kit=drums vel=45..70 | bass pachelbel_ground inst=bass vel=70..85
  deck B: harmony b_harmony inst=strings vel=35..50 len=8 | arp ode_to_joy inst=marimba vel=40..55 | melody badinerie inst=flute vel=60..80
}

# sung: the phrase over the crossing, b's bass under a's chords
section sung $BARS bars {
  deck A: kick kick4 kit=drums vel=75..90 | hihat$CYCLE shk kit=drums vel=30..45 | bass b_bass inst=bass vel=65..80
  deck B: harmony a_harmony inst=warm-pad vel=25..40 len=4 | arp badinerie inst=kalimba vel=25..40 | melody$CYCLE $VOX inst=kalimba oct=3 vel=24..38
  deck B: sing $LYRIC on melody voice=robot-choir
}

# a toward b and back: each morph stays and compounds pass on pass, and the pull turns round every cycle
arrange {
  a_leads
  ~ ode_to_joy_* morph badinerie_1 0.25
  b_leads
  ~ b_bass_* morph pachelbel_ground_1 0.25
  both
  @ ode_to_joy_* xfer badinerie_1
  both
  sung
  ~ badinerie_* morph ode_to_joy_1 0.25
  ~ drm_* grow
  a_leads
  ~ pachelbel_ground_* morph b_bass_1 0.2
  b_leads
  @ vox_* xfer shk
  sung
  ~ drm_* decay
} loop 3 then end
