@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix ns:    <https://beatscript.app/ontology/ns#> .
@prefix concept: <https://beatscript.app/ontology/concept/> .
@prefix program: <https://beatscript.app/ontology/program/> .

# The BeatScript ontology's own hand-written module. A release is four inputs (src/ontology/fork.rs builds it):
#
#   upstream/bitwrap-0.2.0/ns.nt   the bitwrap ontology 0.2.0 (CC0), re-homed from https://ontology.bitwrap.io/ into
#                                  https://beatscript.app/ontology/, each term with one prov:wasDerivedFrom to the
#                                  bitwrap IRI it came from; its owl:Ontology header is replaced by the one below
#   upstream/bitwrap-conventions/conventions.ttl
#                                  bitwrap's genre conventions module (CC0), re-homed and linked back the same way
#                                  (since 0.3.0: what check's style and genre_template read)
#   fork.ttl                       this file: the header, the terms the fork adds by hand, and the wording it restates
#   generated/beatscript.ttl       the BeatScript vocabulary, generated from beatscript-serve's own code (tools/ontology/beatscript.py)
#
# From here the ontology evolves on its own: a change is made here (or in BeatScript's code, for the vocabulary),
# never in the upstream copy, which only changes when a later bitwrap release is deliberately merged in.

<https://beatscript.app/ontology/ns> a owl:Ontology ;
    dct:title "BeatScript ontology"@en ;
    owl:versionInfo "0.4.0" ;
    owl:versionIRI <https://beatscript.app/ontology/0.4.0> ;
    owl:priorVersion <https://beatscript.app/ontology/0.3.0> ;
    dct:issued "2026-11-23"^^xsd:date ;
    dct:creator "stackdump" ;
    dct:publisher <https://beatscript.app> ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:rights "Dedicated to the public domain under CC0 1.0 Universal."@en ;
    prov:wasDerivedFrom <https://ontology.bitwrap.io/release/bitwrap-ontology-0.2.0.tar> ;
    rdfs:seeAlso <https://ontology.pflow.xyz/ns> ;
    rdfs:comment "The vocabulary behind BeatScript: the genres the generator knows (tempo, scale, groove, Euclidean drum rhythms, instruments, chord progressions), the song structures and sections it arranges them into, the Petri-net engine concepts underneath, and the BeatScript language itself (its versions, its grammar's productions and keywords, voices, kits, control nouns and verbs, operators and both MCP servers' tools), generated from the code that implements them. Forked from the bitwrap ontology 0.2.0, whose terms it carries under this namespace, each linked to the bitwrap term it came from by prov:wasDerivedFrom; it evolves on its own from here."@en .

# --- products: the few the BeatScript vocabulary names ------------------------------------------------------------
# (bitwrap 0.2.0 has no product terms; the vocabulary's MCP tools are provided by an ns:McpServer.)

ns:Product a owl:Class ; rdfs:label "product"@en ; ns:status "stable" ;
    rdfs:comment "Something shipped under a name: a website, a language, an app or an MCP server."@en ;
    owl:disjointWith ns:MusicConcept .
ns:ProductFamily a owl:Class ; rdfs:subClassOf ns:Product ; rdfs:label "product family"@en ; ns:status "stable" ;
    rdfs:comment "One name shared by several products that are used together."@en .
ns:McpServer a owl:Class ; rdfs:subClassOf ns:Product ; rdfs:label "MCP server"@en ; ns:status "stable" ;
    rdfs:comment "A Model Context Protocol server: tools an AI assistant such as Claude can call to use a product."@en .
ns:ProgrammingLanguage a owl:Class ; rdfs:subClassOf ns:Product ; rdfs:label "programming language"@en ; ns:status "stable" ;
    rdfs:comment "A text language whose documents are programs a product runs. Its versions (ns:LanguageVersion) are in the generated vocabulary, from the code that reads them."@en .
ns:inProductFamily a owl:ObjectProperty ; rdfs:domain ns:Product ; rdfs:range ns:ProductFamily ; rdfs:label "in product family"@en ; ns:status "stable" ;
    rdfs:comment "The family whose name this product carries."@en .
ns:homepage a owl:DatatypeProperty ; rdfs:domain ns:Product ; rdfs:range xsd:anyURI ; rdfs:label "homepage"@en ; ns:status "stable" .
ns:fileExtension a owl:DatatypeProperty ; rdfs:domain ns:ProgrammingLanguage ; rdfs:range xsd:string ; rdfs:label "file extension"@en ; ns:status "stable" ;
    rdfs:comment "The extension a program file in the language is written with, with its dot."@en .
ns:legacyFileExtension a owl:DatatypeProperty ; rdfs:domain ns:ProgrammingLanguage ; rdfs:range xsd:string ; rdfs:label "legacy file extension"@en ; ns:status "stable" ;
    rdfs:comment "An extension program files in the language had under an earlier name: such a file is still opened and imported, and never written."@en .
ns:mediaType a owl:DatatypeProperty ; rdfs:domain ns:ProgrammingLanguage ; rdfs:range xsd:string ; rdfs:label "media type"@en ; ns:status "stable" ;
    rdfs:comment "The media (MIME) type a program text in the language is served and accepted as."@en .
ns:legacyMediaType a owl:DatatypeProperty ; rdfs:domain ns:ProgrammingLanguage ; rdfs:range xsd:string ; rdfs:label "legacy media type"@en ; ns:status "stable" ;
    rdfs:comment "Another media type a program text is still accepted as (in Accept and Content-Type), never the one it is served as."@en .

concept:product-beatscript a skos:Concept, ns:ProductFamily ; skos:prefLabel "BeatScript"@en ; ns:status "stable" ;
    skos:definition "The name shared by a music language, the Android app that plays it, the website beatscript.app and its MCP servers. Write or generate a program, send it to the phone, hear it."@en ;
    ns:homepage "https://beatscript.app"^^xsd:anyURI .
concept:product-beatscript-mcp a skos:Concept, ns:McpServer ; skos:prefLabel "BeatScript MCP server"@en ; ns:status "stable" ;
    skos:definition "Tools that let an AI assistant such as Claude use BeatScript: check, format and render programs, and play them on a paired phone."@en ;
    ns:inProductFamily concept:product-beatscript ; ns:homepage "https://beatscript.app/mcp"^^xsd:anyURI .
concept:product-beatscript-language a skos:Concept, ns:ProgrammingLanguage ; skos:prefLabel "BeatScript language"@en ;
    skos:altLabel "BeatScript"@en ; skos:hiddenLabel "btw"@en ; ns:status "stable" ;
    skos:definition "The language of BeatScript: whole tracks written as text, one line per deck, compiled to the Petri nets a deck runs. Small, total and deterministic: the same canonical text always has the same CID. Its documents are programs, written as .beatscript files."@en ;
    skos:historyNote "Called btw, its files .btw, before language version 2 (BeatScript 2, 2026-11-22). A btw program is a BeatScript 1 program: it is still read, and keeps its meaning and its CID."@en ;
    ns:inProductFamily concept:product-beatscript ;
    ns:fileExtension ".beatscript" ; ns:legacyFileExtension ".btw" ;
    ns:mediaType "text/beatscript" ; ns:legacyMediaType "text/x-beatscript", "text/btw" ;
    rdfs:seeAlso ns:Program .

# --- pairing: the devices a BeatScript site plays on, and the read they resolve programs with -------------------
# (site/PAIRING.md; the wire strings are the device record's `kind` and the resolver route)

ns:PairedDevice a owl:Class ; rdfs:label "paired device"@en ; ns:status "stable" ;
    rdfs:comment "A device an account paired with a BeatScript site (btw-pair/2): its Ed25519 public key is its only credential. The site pushes programs to it over its signed event stream, and private ones sealed for its key."@en .
ns:DeviceKind a owl:Class ; rdfs:label "device kind"@en ; ns:status "stable" ;
    rdfs:comment "What a paired device is, as its signed claim names it (the device record's kind): it decides which events the device takes."@en .
ns:deviceKind a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain ns:PairedDevice ; rdfs:range ns:DeviceKind ; rdfs:label "device kind"@en ; ns:status "stable" .
ns:wireName a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "wire name"@en ; ns:status "stable" ;
    rdfs:comment "The string a protocol carries for the term (a JSON value or a signed text's line)."@en .
ns:ProgramResolver a owl:Class ; rdfs:label "program resolver"@en ; ns:status "stable" ;
    rdfs:comment "A read-only fetch of a public program by its CID. A device that is handed a CID it does not hold (a set's member) asks its paired site; the site answers only the Creative Commons programs it stores, so anything private, restricted or asset-using is absent there and travels only sealed."@en .
ns:urlTemplate a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "URL template"@en ; ns:status "stable" ;
    rdfs:comment "An RFC 6570 URL template: {cid} is the program's CID."@en .

concept:device-kind-phone a skos:Concept, ns:DeviceKind ; skos:prefLabel "phone"@en ; ns:status "stable" ; ns:wireName "phone" ;
    skos:definition "A phone running the BeatScript app: it scans the site's pairing code and plays what it is sent (eval, load, stop, sealed pushes). The kind of every device whose claim names none."@en .
concept:device-kind-booth a skos:Concept, ns:DeviceKind ; skos:prefLabel "booth"@en ; ns:status "stable" ; ns:wireName "booth" ;
    skos:definition "The desktop DJ app, paired as a phone is but with a kind: booth line in its signed claim. It takes everything a phone does and also sets: a set event carries the set's CID and its members' CIDs, and the booth resolves each member from its own store, then from the site's program resolver, then from its offline inbox."@en ;
    rdfs:seeAlso concept:program-resolver .
concept:program-resolver a skos:Concept, ns:ProgramResolver ; skos:prefLabel "program resolver"@en ; ns:status "stable" ;
    skos:definition "GET /api/programs/{cid} on beatscript.app: a stored public program by CID ({cid, text, meta} with its licence), no sign-in, cached as immutable, its JSON-LD named by a describedby Link; 404 for anything the site does not hold."@en ;
    ns:urlTemplate "https://beatscript.app/api/programs/{cid}" ;
    rdfs:seeAlso ns:Program .

# --- conventions for the generator's own genres -----------------------------------------------------------------
# The genres djrust's generator has beyond beats' catalogue (acid, deephouse, electro, italo) are generated from its
# tables (generated/beatscript.ttl, since 0.4.0). What the tables do not say is a convention, written here as bitwrap's
# conventions module writes its own (hand-authored from general musical practice, CC0): a usual tempo range, which always
# contains the genre's ns:bpm. Advice, never a rule: check's style warns outside it.

<https://beatscript.app/ontology/genre/acid>      ns:minBpm "118"^^xsd:integer ; ns:maxBpm "140"^^xsd:integer .
<https://beatscript.app/ontology/genre/deephouse> ns:minBpm "115"^^xsd:integer ; ns:maxBpm "126"^^xsd:integer .
<https://beatscript.app/ontology/genre/electro>   ns:minBpm "105"^^xsd:integer ; ns:maxBpm "135"^^xsd:integer .
<https://beatscript.app/ontology/genre/italo>     ns:minBpm "110"^^xsd:integer ; ns:maxBpm "130"^^xsd:integer .

# --- BeatScript 1, the language when it was called btw ----------------------------------------------------------
# (the versions themselves, concept:beatscript-1 and concept:beatscript-2, are generated from djlive::version)

concept:beatscript-1 skos:altLabel "btw"@en ;
    skos:historyNote "The name of the language before language version 2 was btw: BeatScript 1 is the language as it was written then. Every BeatScript 1 program, link and CID keeps its meaning; fmt upgrades a program to BeatScript 2, which plays the same under a new CID."@en .

# The example programs bitwrap 0.2.0 names are BeatScript 1 programs (their CIDs are of BeatScript 1 canonical texts).
program:trance-138-story ns:inLanguageVersion concept:beatscript-1 .
program:dark-techno-122 ns:inLanguageVersion concept:beatscript-1 .
program:acid-rave-138 ns:inLanguageVersion concept:beatscript-1 .
program:hand-proghouse-124 ns:inLanguageVersion concept:beatscript-1 .
program:hand-dubstep-140 ns:inLanguageVersion concept:beatscript-1 .

# --- wording restated from bitwrap 0.2.0 ------------------------------------------------------------------------
# A value given here for a bitwrap term's rdfs:label, rdfs:comment, skos:prefLabel, skos:definition or skos:scopeNote, in
# the language of bitwrap's, replaces bitwrap's (src/ontology/fork.rs RESTATABLE; the old wording stays at the bitwrap IRI
# the term's prov:wasDerivedFrom names). A replaced label is kept as the term's skos:hiddenLabel, or the build refuses.

ns:Program rdfs:label "BeatScript program"@en ; skos:hiddenLabel "btw program"@en ;
    rdfs:comment "A piece written in BeatScript: lines of text that compile to the Petri nets of a DJ deck. Identified by the CID of its canonical text, so a BeatScript 1 program and its upgrade to BeatScript 2, which play the same, are two programs: the upgrade is prov:wasRevisionOf the original, and each has its own ns:programCid and ns:inLanguageVersion."@en ;
    skos:historyNote "Before language version 2 (2026-11-22) the language was called btw, and a program was a btw program."@en .
ns:ProgramLine rdfs:comment "One line of a BeatScript program. The kind of line says what it declares."@en .
ns:CanonicalForm rdfs:comment "The normal form of a BeatScript program: whitespace, numbers, note spelling and comments are normalised, so two spellings of one program have one canonical text and therefore one CID. A BeatScript 2 canonical text begins with its version line, #! beatscript 2; a BeatScript 1 canonical text has no #! line, so the first line alone tells the version."@en .
ns:ContentId skos:scopeNote "pflow's modelCID is the content identifier of a net model; ProgramCID and NetCID are the same kind of name for a BeatScript program and for the net a deck runs."@en .
ns:reachesVerb rdfs:comment "The control verb a BeatScript do line runs."@en .
concept:fmt skos:definition "The formatter: rewrites a BeatScript program into its canonical form without changing what it plays. The fmt a person or an agent asks for also upgrades a BeatScript 1 program to BeatScript 2, a new CID for the same music; the formatting a program gets on its way in (eval, load, share, queue, push) keeps its version, so its CID never moves."@en .
