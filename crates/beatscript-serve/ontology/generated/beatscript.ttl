    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's NUMBER token, used in: cprimary, gen_param, lfactor, lfo, mut_op, op, primary, prob, set_mix, weight."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "NUMBER" .

<https://beatscript.app/ontology/concept/token-param> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#TokenClass> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "PARAM"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's PARAM token, used in: arg, atom, cprimary, deck, primary, pvalue."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "PARAM" .

<https://beatscript.app/ontology/concept/token-phones> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#TokenClass> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "PHONES"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's PHONES token, used in: escape."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
