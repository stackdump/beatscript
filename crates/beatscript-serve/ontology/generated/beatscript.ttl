    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"chords\" | \"key\" | \"bass\" | \"melody\" | \"drums\" | \"rhythm\" | \"bars\" | \"tempo\" | \"pattern\"" ;
