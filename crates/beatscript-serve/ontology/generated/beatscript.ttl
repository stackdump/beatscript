    <https://beatscript.app/ontology/ns#bassDensity> "0.65"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#bassDuration> "140"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#durationVariation> "0.15"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#ghostNotes> "0.2"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#humanize> "6"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#melodyDensity> "0.4"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#melodyDuration> "110"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#swing> "8"^^<http://www.w3.org/2001/XMLSchema#integer> ;
