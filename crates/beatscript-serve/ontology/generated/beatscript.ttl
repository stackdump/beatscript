    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-sing> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-voice-param> .

<https://beatscript.app/ontology/concept/grammar-lyric> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "lyric"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lyric production of BeatScript's grammar (its text is lyric_text; docs/beatscript/phonemes.md)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "STRING" ;
    <https://beatscript.app/ontology/ns#writtenAs> "lyric" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Mix moves and sung lyrics"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-string> .

<https://beatscript.app/ontology/concept/grammar-lyric-text> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "lyric_text"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lyric_text production of BeatScript's grammar (\"/\" and a space is a phrase break; \"/\" and a phoneme opens an escape, to the next \"/\" (with none, a break too); a word touching \"=\" before an escape is its label, kept and not sung: jingle=/j ii ng g uh l/)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "{ TEXT | \"/\" SPACE | escape } [ \"/\" { TEXT } ]" ;
    <https://beatscript.app/ontology/ns#writtenAs> "lyric_text" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Mix moves and sung lyrics"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-space> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-text> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-escape> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-slash> .

<https://beatscript.app/ontology/concept/grammar-escape> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "escape"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The escape production of BeatScript's grammar (PHONES (beatscript-v1): aa ae uh aw eh er ii ee uu oo ay ie oy ow oh p b t d k g f v s z sh zh th dh h m n ng l r w y ch j, \"_\" a rest, \"-\" cuts a word, \":\" holds a vowel one more note, \"!\" accents it)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"/\" PHONES \"/\"" ;
    <https://beatscript.app/ontology/ns#writtenAs> "escape" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Mix moves and sung lyrics"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-phones> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-slash> .

<https://beatscript.app/ontology/concept/grammar-assert> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "assert"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The assert production of BeatScript's grammar (assert never A.snare beside A.snare assert never B during sing: refused where it is false; assert bass ends on 1: the lowest note of its last onset is that degree of the key)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"assert\" ( \"ends\" | \"period\" [ \"(\" NAME \")\" ] cmp INT | \"length\" ( ( \"==\" | \"!=\" ) clock [ \"±\" clock ] | ( \"<\" | \"<=\" | \">\" | \">=\" ) clock ) | \"level\" leveldeck cmp levelexpr [ \"in\" NAME ] | \"key\" ( \"==\" | \"!=\" ) KEY [ \"in\" NAME ] | \"never\" subject ( \"beside\" | \"during\" ) subject [ \"in\" NAME ] | subject \"ends\" \"on\" INT [ \"in\" NAME ] )" ;
    <https://beatscript.app/ontology/ns#writtenAs> "assert" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Assertions"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-int> ;
