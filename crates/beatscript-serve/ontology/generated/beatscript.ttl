<https://beatscript.app/ontology/concept/grammar-def> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "def"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The def production of BeatScript's grammar ($NAME inside, filled in when it is called)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"def\" NAME \"(\" [ NAME { \",\" NAME } ] \")\" [ \"in\" \":\" type { \",\" type } ] [ \"out\" \":\" type { \",\" type } ] \"{\" { def_line } \"}\"" ;
    <https://beatscript.app/ontology/ns#writtenAs> "def" ;
