    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "major" .

<https://beatscript.app/ontology/concept/theme-mode-minor> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#ThemeMode> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "minor"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A theme in a minor key."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "minor" .

<https://beatscript.app/ontology/concept/theme-mode-modal> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#ThemeMode> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "modal"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A theme neither: a pedal or an ostinato on one note."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "modal" .

<https://beatscript.app/ontology/concept/form-quodlibet> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#Form> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "quodlibet"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The quodlibet, a form from classical music: canon ode fate voices canon voices: one theme leads each section, the others under it. `~ a_* morph b_1 p` paired later with `~ b_* morph a_1 p`, the pair pulled away by a morph toward a third line, `@` one-shot borrowings; `~` persists and compounds pass on pass (loop 3)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "quodlibet" ;
    <https://beatscript.app/ontology/ns#formTemplate> <https://beatscript.app/ontology/concept/template-quodlibet> ;
    <https://beatscript.app/ontology/ns#formShape> "canon ode fate voices canon voices: one theme leads each section, the others under it"@en ;
    <https://beatscript.app/ontology/ns#mutationPlan> "`~ a_* morph b_1 p` paired later with `~ b_* morph a_1 p`, the pair pulled away by a morph toward a third line, `@` one-shot borrowings; `~` persists and compounds pass on pass (loop 3)"@en ;
    rdfs:seeAlso <https://beatscript.app/docs/forms#quodlibet> ;
    <https://beatscript.app/ontology/ns#usesTechnique> <https://beatscript.app/ontology/concept/technique-found-phrases> ;
