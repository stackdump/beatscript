    <https://beatscript.app/ontology/ns#rotationAdd> "4"^^<http://www.w3.org/2001/XMLSchema#integer> .

<https://beatscript.app/ontology/genre/acid> a <https://beatscript.app/ontology/ns#Genre> ;
    rdfs:label "acid"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "acid: a genre the seeded generator (generate, gen@N) knows (djrust's own genre, beyond beats' catalogue, following techno's musicality rules), as its tables give it: 125 BPM, minor from MIDI note 45, the four on floor groove, kick E(4,16), snare E(2,16) rotated 4, hihat E(4,16) rotated 2, swing 10, chords 1-1-7-1 or 1-4-1-4."@en ;
    <https://beatscript.app/ontology/ns#genreId> "acid" ;
    <https://beatscript.app/ontology/ns#inFamily> <https://beatscript.app/ontology/family/edm> ;
    <https://beatscript.app/ontology/ns#bpm> "125"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#defaultScale> <https://beatscript.app/ontology/scale/minor> ;
    <https://beatscript.app/ontology/ns#rootNote> "45"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#defaultGroove> <https://beatscript.app/ontology/groove/four-on-floor> ;
    <https://beatscript.app/ontology/ns#kickRhythm> <https://beatscript.app/ontology/rhythm/acid-kick> ;
    <https://beatscript.app/ontology/ns#snareRhythm> <https://beatscript.app/ontology/rhythm/acid-snare> ;
    <https://beatscript.app/ontology/ns#hihatRhythm> <https://beatscript.app/ontology/rhythm/acid-hihat> ;
    <https://beatscript.app/ontology/ns#bassDensity> "0.75"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#bassDuration> "100"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#durationVariation> "0.2"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#ghostNotes> "0.3"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#humanize> "8"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#melodyDensity> "0.25"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#melodyDuration> "90"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#swing> "10"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#syncopation> "0.3"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#followsRulesOf> <https://beatscript.app/ontology/genre/techno> ;
    <https://beatscript.app/ontology/ns#hasProgression> <https://beatscript.app/ontology/progression/acid-1> ;
    <https://beatscript.app/ontology/ns#hasProgression> <https://beatscript.app/ontology/progression/acid-2> ;
    <https://beatscript.app/ontology/ns#hasDrumVariant> <https://beatscript.app/ontology/variant/acid-hihat-b> ;
    <https://beatscript.app/ontology/ns#hasDrumVariant> <https://beatscript.app/ontology/variant/acid-hihat-c> ;
    <https://beatscript.app/ontology/ns#hasDrumVariant> <https://beatscript.app/ontology/variant/acid-kick-b> ;
    <https://beatscript.app/ontology/ns#hasDrumVariant> <https://beatscript.app/ontology/variant/acid-kick-c> ;
    <https://beatscript.app/ontology/ns#hasDrumVariant> <https://beatscript.app/ontology/variant/acid-snare-b> ;
    <https://beatscript.app/ontology/ns#hasDrumVariant> <https://beatscript.app/ontology/variant/acid-snare-c> ;
    <https://beatscript.app/ontology/ns#typicalBass> <https://beatscript.app/ontology/instrument/acid> ;
    <https://beatscript.app/ontology/ns#typicalInstrument> <https://beatscript.app/ontology/instrument/dark-pad> ;
    <https://beatscript.app/ontology/ns#typicalInstrument> <https://beatscript.app/ontology/instrument/warm-pad> ;
    <https://beatscript.app/ontology/ns#typicalInstrument> <https://beatscript.app/ontology/instrument/strings> ;
    <https://beatscript.app/ontology/ns#typicalInstrument> <https://beatscript.app/ontology/instrument/pad> ;
    <https://beatscript.app/ontology/ns#typicalKit> <https://beatscript.app/ontology/instrument/drums> ;
    <https://beatscript.app/ontology/ns#typicalKit> <https://beatscript.app/ontology/instrument/drums-v8> ;
    <https://beatscript.app/ontology/ns#typicalMelody> <https://beatscript.app/ontology/instrument/rave-stab> ;
