<https://beatscript.app/ontology/concept/grammar-repeat> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "repeat"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The repeat production of BeatScript's grammar (the count is written out, 1 to 64)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"repeat\" INT [ \"every\" INT \"bars\" ] \"{\" { body_line } \"}\"" ;
    <https://beatscript.app/ontology/ns#writtenAs> "repeat" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Structure: lets, defs, sections, the arrangement"@en ;
