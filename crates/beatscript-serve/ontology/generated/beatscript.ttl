    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"stop\" \"when\" \"gen\" ( \"==\" | \">=\" | \">\" ) INT | \"for\" INT \"gens\"" ;
