    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-xfer> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-grow> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-decay> ;
    <https://beatscript.app/ontology/ns#usesTheme> "pachelbel_ground" ;
    <https://beatscript.app/ontology/ns#usesTheme> "pachelbel_violin" ;
    <https://beatscript.app/ontology/ns#usesTheme> "ode_to_joy" ;
    <https://beatscript.app/ontology/ns#usesTheme> "beethoven_fate" ;
    <https://beatscript.app/ontology/ns#referenceProgram> "z4EBG9j86dPTC9HH6EjtBJFAWZsJLiPum4np9zoJQC9PzWm9SoC" .

<https://beatscript.app/ontology/concept/form-passacaglia> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#Form> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "passacaglia"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The passacaglia, a form from classical music: ground variation sung variation sung variation sung: the ground under every section. Cumulative variations above the ground, each `~` added on top of the last: `rot 2 | accent`, `thin`, `rev | drift`, `grow`, `up 1`, `down 1`, `decay`; the ground is never mutated."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "passacaglia" ;
    <https://beatscript.app/ontology/ns#formTemplate> <https://beatscript.app/ontology/concept/template-passacaglia> ;
    <https://beatscript.app/ontology/ns#formShape> "ground variation sung variation sung variation sung: the ground under every section"@en ;
    <https://beatscript.app/ontology/ns#mutationPlan> "cumulative variations above the ground, each `~` added on top of the last: `rot 2 | accent`, `thin`, `rev | drift`, `grow`, `up 1`, `down 1`, `decay`; the ground is never mutated"@en ;
    rdfs:seeAlso <https://beatscript.app/docs/forms#passacaglia> ;
    <https://beatscript.app/ontology/ns#usesTechnique> <https://beatscript.app/ontology/concept/technique-found-phrases> ;
    <https://beatscript.app/ontology/ns#usesThemeLibrary> <https://beatscript.app/ontology/concept/themes-public-domain> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-rot> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-accent> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-thin> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-rev> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-drift> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-grow> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-xfer> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-up> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-down> ;
