<https://beatscript.app/ontology/concept/grammar-when> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "when"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The when production of BeatScript's grammar (every 16 bars every 2 beats every 4 bars from 8; every 8 bars: a phrase; once, on that place of the program; once, where that section ends; once, that long ahead of that section)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"every\" dur [ \"from\" ( arith | pos ) ] | \"on\" \"phrase\" | \"on\" \"next\" \"bar\" | \"on\" \"next\" \"phrase\" [ \"8\" | \"16\" | \"32\" ] | \"at\" pos | \"after\" NAME | \"before\" NAME dur" ;
    <https://beatscript.app/ontology/ns#writtenAs> "when" ;
