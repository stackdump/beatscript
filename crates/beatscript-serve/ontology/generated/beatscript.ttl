<https://beatscript.app/ontology/concept/token-phrase> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#TokenClass> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "PHRASE"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's PHRASE token, used in: sing, template, use_source."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "PHRASE" .

