    <https://beatscript.app/ontology/ns#usesTheme> "badinerie" .

<https://beatscript.app/ontology/concept/form-theme-and-variations> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#Form> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "theme and variations"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The theme and variations, a form from classical music: theme variation variation variation sung variation theme. One source, a different transform for each section as a one-shot `@` (`rev`, `invert`, `stutter 2`, `oct -1`, `half | accent`), so the theme comes back unchanged; no cross-morphs."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "theme-and-variations" ;
    <https://beatscript.app/ontology/ns#formTemplate> <https://beatscript.app/ontology/concept/template-theme-and-variations> ;
    <https://beatscript.app/ontology/ns#formShape> "theme variation variation variation sung variation theme"@en ;
    <https://beatscript.app/ontology/ns#mutationPlan> "one source, a different transform for each section as a one-shot `@` (`rev`, `invert`, `stutter 2`, `oct -1`, `half | accent`), so the theme comes back unchanged; no cross-morphs"@en ;
    rdfs:seeAlso <https://beatscript.app/docs/forms#theme-and-variations> ;
    <https://beatscript.app/ontology/ns#usesTechnique> <https://beatscript.app/ontology/concept/technique-found-phrases> ;
    <https://beatscript.app/ontology/ns#usesThemeLibrary> <https://beatscript.app/ontology/concept/themes-public-domain> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-rev> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-invert> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-stutter> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-oct> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-half> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-accent> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-grow> ;
    <https://beatscript.app/ontology/ns#usesTheme> "new_world_largo" .

<https://beatscript.app/ontology/concept/form-cross> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#Form> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "cross"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The cross, a form from classical music: a_leads b_leads both both sung a_leads b_leads sung: one source leads, then the other, then both at once. A quodlibet of two: `~ a_melody_* morph b_melody_1 p` paired with `~ b_bass_* morph a_bass_1 p`, an `@ ... xfer` one-shot in the overlap, then the pull turned round (`~ b_melody_* morph a_melody_1 p`, `~ a_bass_* morph b_bass_1 p`); `~` persists and compounds pass on pass (loop 3)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "cross" ;
    <https://beatscript.app/ontology/ns#formTemplate> <https://beatscript.app/ontology/concept/template-cross> ;
    <https://beatscript.app/ontology/ns#formShape> "a_leads b_leads both both sung a_leads b_leads sung: one source leads, then the other, then both at once"@en ;
    <https://beatscript.app/ontology/ns#mutationPlan> "a quodlibet of two: `~ a_melody_* morph b_melody_1 p` paired with `~ b_bass_* morph a_bass_1 p`, an `@ ... xfer` one-shot in the overlap, then the pull turned round (`~ b_melody_* morph a_melody_1 p`, `~ a_bass_* morph b_bass_1 p`); `~` persists and compounds pass on pass (loop 3)"@en ;
    rdfs:seeAlso <https://beatscript.app/docs/forms#cross> ;
    <https://beatscript.app/ontology/ns#usesTechnique> <https://beatscript.app/ontology/concept/technique-found-phrases> ;
    <https://beatscript.app/ontology/ns#usesThemeLibrary> <https://beatscript.app/ontology/concept/themes-public-domain> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-morph> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-xfer> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-grow> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-decay> ;
    <https://beatscript.app/ontology/ns#usesTheme> "ode_to_joy" ;
    <https://beatscript.app/ontology/ns#usesTheme> "pachelbel_ground" ;
    <https://beatscript.app/ontology/ns#usesTheme> "badinerie" .

