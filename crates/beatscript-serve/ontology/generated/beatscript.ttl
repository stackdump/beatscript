<https://beatscript.app/ontology/concept/grammar-pitem> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "pitem"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The pitem production of BeatScript's grammar (each item between `|` has a part in it; over parts: `stack` is `|`; over parts: the per-bar alternation <p q>)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "part | \"stack\" \"(\" pargs \")\" | \"then\" \"(\" pargs \")\"" ;
