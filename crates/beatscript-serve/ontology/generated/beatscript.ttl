<https://beatscript.app/ontology/concept/grammar-section> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "section"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The section production of BeatScript's grammar (1 to 256 bars; a `key` may open the body; section intro from seed(techno, 42)[1..8] section hook from <cid>.drop)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"section\" NAME INT \"bars\" \"{\" { line } \"}\" | \"section\" NAME \"from\" ref" ;
    <https://beatscript.app/ontology/ns#writtenAs> "section" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Structure: lets, defs, sections, the arrangement"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-int> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-line> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-ref> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-bars> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-from> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-section> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-open-brace> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-close-brace> .

<https://beatscript.app/ontology/concept/grammar-arrange> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "arrange"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The arrange production of BeatScript's grammar (with a NAME it is one of several arrangements; the whole of a generated track: arrange from seed(techno, 42), or of a phrase: arrange from template(deep-house, @tempest_such_stuff); the whole program a generator call prints: arrange from gen@2 techno seed=42)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"arrange\" sexpr { sexpr } | \"arrange\" NAME \":\" sexpr { sexpr } [ arr_end ] | \"arrange\" \"from\" ( seed | template ) | \"arrange\" \"from\" gen" ;
    <https://beatscript.app/ontology/ns#writtenAs> "arrange" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Structure: lets, defs, sections, the arrangement"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-arr-end> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-gen> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-seed> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-sexpr> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-template> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-colon> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-arrange> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-from> .

<https://beatscript.app/ontology/concept/grammar-arr-end> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "arr_end"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The arr_end production of BeatScript's grammar (only after a NAME: see \"Several arrangements\")."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"then\" NAME | \"loop\" [ INT ] | \"end\"" ;
    <https://beatscript.app/ontology/ns#writtenAs> "arr_end" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Structure: lets, defs, sections, the arrangement"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-int> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-end> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-loop> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-then> .

<https://beatscript.app/ontology/concept/grammar-start> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "start"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The start production of BeatScript's grammar (the named arrangement that plays first; default the first written)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"start\" NAME" ;
    <https://beatscript.app/ontology/ns#writtenAs> "start" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Structure: lets, defs, sections, the arrangement"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-start> .

<https://beatscript.app/ontology/concept/grammar-launch> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "launch"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The launch production of BeatScript's grammar (a hit of the pad brings the scene, a section or an arrangement, in on that bar line: 8 bars by default)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"launch\" NAME \"on\" \"pad\" \"(\" INT \")\" [ \"next\" ( \"bar\" | \"phrase\" [ \"8\" | \"16\" | \"32\" ] ) ]" ;
    <https://beatscript.app/ontology/ns#writtenAs> "launch" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Structure: lets, defs, sections, the arrangement"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-int> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-open-paren> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-close-paren> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-16> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-32> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-8> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-bar> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-launch> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-next> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-on> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-pad> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-phrase> .

<https://beatscript.app/ontology/concept/grammar-sexpr> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "sexpr"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The sexpr production of BeatScript's grammar (a section, or a let that names a composition; the empty section; at the same time; one after another)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "NAME | \"silence\" | \"stack\" \"(\" sexpr { \",\" sexpr } \")\" | \"then\" \"(\" sexpr { \",\" sexpr } \")\"" ;
    <https://beatscript.app/ontology/ns#writtenAs> "sexpr" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Structure: lets, defs, sections, the arrangement"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-sexpr> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-open-paren> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-close-paren> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-comma> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-silence> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-stack> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-then> .

<https://beatscript.app/ontology/concept/grammar-end> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "end"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The end production of BeatScript's grammar (a song ends after its last section by default)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"end\" [ \"at\" \"bar\" INT | \"after\" NAME ]" ;
    <https://beatscript.app/ontology/ns#writtenAs> "end" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Structure: lets, defs, sections, the arrangement"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-int> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-after> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-at> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-bar> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-end> .

<https://beatscript.app/ontology/concept/grammar-loop> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "loop"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The loop production of BeatScript's grammar (a song starts again at its end)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"loop\"" ;
    <https://beatscript.app/ontology/ns#writtenAs> "loop" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Structure: lets, defs, sections, the arrangement"@en ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-loop> .

<https://beatscript.app/ontology/concept/grammar-arrange-block> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "arrange_block"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The arrange_block production of BeatScript's grammar (at least one section; see \"Arrange mutations\"; a named arrangement with mutations)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"arrange\" \"{\" { arr_gap } NAME { arr_gap | NAME } \"}\" [ block_end ] | \"arrange\" NAME \":\" \"{\" { arr_gap } NAME { arr_gap | NAME } \"}\" [ arr_end ]" ;
    <https://beatscript.app/ontology/ns#writtenAs> "arrange_block" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Arrange mutations"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-arr-end> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-arr-gap> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-block-end> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-colon> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-arrange> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-open-brace> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-close-brace> .

<https://beatscript.app/ontology/concept/grammar-arr-gap> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "arr_gap"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The arr_gap production of BeatScript's grammar (a mutation runs to the end of its line)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "NEWLINE | \",\" | mutation NEWLINE" ;
    <https://beatscript.app/ontology/ns#writtenAs> "arr_gap" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Arrange mutations"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-newline> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-mutation> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-comma> .

<https://beatscript.app/ontology/concept/grammar-mutation> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "mutation"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The mutation production of BeatScript's grammar (~ from here on, @ the next section only; ~3: every 3rd pass)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "( \"~\" | \"@\" ) [ INT ] ( switch | mut_target mut_op { \"|\" mut_op } { \",\" mut_target mut_op { \"|\" mut_op } } )" ;
    <https://beatscript.app/ontology/ns#writtenAs> "mutation" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Arrange mutations"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-int> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-mut-op> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-mut-target> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-switch> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-comma> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-at> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-bar> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-tilde> .

<https://beatscript.app/ontology/concept/grammar-switch> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "switch"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The switch production of BeatScript's grammar (the control deck's lines fire or not: all of them, or one call's (~ control freeze off); a line of its own)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"control\" [ NAME ] ( \"on\" | \"off\" )" ;
    <https://beatscript.app/ontology/ns#writtenAs> "switch" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Arrange mutations"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-control> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-off> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-on> .

<https://beatscript.app/ontology/concept/grammar-mut-target> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "mut_target"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The mut_target production of BeatScript's grammar (a let pattern, or a glob: acid_*)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "GLOB | NAME" ;
    <https://beatscript.app/ontology/ns#writtenAs> "mut_target" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Arrange mutations"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-glob> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> .

<https://beatscript.app/ontology/concept/grammar-mut-op> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "mut_op"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The mut_op production of BeatScript's grammar (rot 2 thin 0.1 oct -1 morph b 0.5 jux rev: the operators of \"Arrange mutations\")."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "NAME { NUMBER | \"-\" NUMBER | NAME }" ;
    <https://beatscript.app/ontology/ns#writtenAs> "mut_op" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Arrange mutations"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-number> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-minus> .

<https://beatscript.app/ontology/concept/grammar-block-end> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "block_end"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The block_end production of BeatScript's grammar (default end; loop N: 1 to 256 passes, then a coda)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"end\" | \"loop\" | \"loop\" INT [ \"then\" { NAME } \"end\" ]" ;
    <https://beatscript.app/ontology/ns#writtenAs> "block_end" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Arrange mutations"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-int> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-end> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-loop> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-then> .

<https://beatscript.app/ontology/concept/grammar-ref> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "ref"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The ref production of BeatScript's grammar (music from elsewhere, written out as BeatScript before the program is read)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "seed | gen | stored" ;
    <https://beatscript.app/ontology/ns#writtenAs> "ref" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Start from a seed"@en ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-gen> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-seed> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-stored> .

<https://beatscript.app/ontology/concept/grammar-seed> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "seed"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The seed production of BeatScript's grammar (a track of the beats generator: genre, seed; a part, bars from 1; SEED is seed (seeds v1) or seed@2 (v2: with its genre's swing))."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "SEED \"(\" NAME \",\" INT [ \",\" structure ] \")\" [ \".\" role ] [ \"[\" INT [ \"..\" INT ] \"]\" ]" ;
    <https://beatscript.app/ontology/ns#writtenAs> "seed" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Start from a seed"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-int> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-seed> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-role> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-structure> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-open-paren> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-close-paren> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-comma> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-dot> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-range> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-open-bracket> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-close-bracket> .

<https://beatscript.app/ontology/concept/grammar-stored> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "stored"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The stored production of BeatScript's grammar (a saved program's section or part, by its CID: <cid>.drop <cid>.drop.bass; a bare <cid> is a program with no sections)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "CID [ \".\" NAME ] [ \".\" role ]" ;
    <https://beatscript.app/ontology/ns#writtenAs> "stored" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Start from a seed"@en ;
    <https://beatscript.app/ontology/ns#hostOnly> true ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-cid> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-role> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-dot> .

<https://beatscript.app/ontology/concept/grammar-gen> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "gen"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The gen production of BeatScript's grammar (gen@2 techno seed=42 section=drop part=bass: the seeded generator, called; GEN is gen@2 or a bare gen)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "GEN NAME \"seed\" \"=\" ( INT | NAME ) { gen_param }" ;
    <https://beatscript.app/ontology/ns#writtenAs> "gen" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Start from a seed"@en ;
    <https://beatscript.app/ontology/ns#hostOnly> true ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-gen> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-int> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-gen-param> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-equals> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-seed> .

<https://beatscript.app/ontology/concept/grammar-gen-param> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "gen_param"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The gen_param production of BeatScript's grammar."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"bpm\" \"=\" NUMBER | \"key\" \"=\" KEY | \"length\" \"=\" ( \"short\" | \"standard\" | \"long\" ) | \"section\" \"=\" NAME | \"part\" \"=\" role" ;
    <https://beatscript.app/ontology/ns#writtenAs> "gen_param" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Start from a seed"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-key> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-number> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-role> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-equals> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-bpm> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-key> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-length> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-long> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-part> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-section> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-short> ;
