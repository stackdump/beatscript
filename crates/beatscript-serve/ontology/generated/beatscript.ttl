    <https://beatscript.app/ontology/ns#ebnf> "\"x\" | \"~\" | NOTE | INT | \"(\" arith \")\" | degrees | ROMAN [ \"/\" INT ] | PARAM | \"[\" pattern { \",\" pattern } \"]\" | \"<\" pattern \">\" | choose | call | NAME" ;
