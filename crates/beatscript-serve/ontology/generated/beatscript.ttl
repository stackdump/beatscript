    <https://beatscript.app/ontology/ns#kickRhythm> <https://beatscript.app/ontology/rhythm/electro-kick> ;
    <https://beatscript.app/ontology/ns#snareRhythm> <https://beatscript.app/ontology/rhythm/electro-snare> ;
