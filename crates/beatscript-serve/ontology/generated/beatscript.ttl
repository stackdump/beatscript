<https://beatscript.app/ontology/concept/template-deep-house> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#PhraseTemplate> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "deep-house"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The phrase template deep-house: deep house at 122: a night/spot cycle, the voice buried then spotlit, crossed onto the shaker; the phrase is the vocal line. Written arrange from template(deep-house, @tempest_such_stuff)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "deep-house" ;
    rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> .

<https://beatscript.app/ontology/concept/template-quodlibet> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#PhraseTemplate> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "quodlibet"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The phrase template quodlibet: a quodlibet at 96 in D: public-domain themes take turns by section and cross-morph toward each other and away in cycles; the phrase sung over the ground. Written arrange from template(quodlibet, @psalm42_deep_calleth)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "quodlibet" ;
    rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> .

<https://beatscript.app/ontology/concept/template-passacaglia> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#PhraseTemplate> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "passacaglia"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The phrase template passacaglia: a passacaglia at 100 in G minor: a ground that never changes (Holst's five-beat ostinato) under cumulative variations; the phrase sung over the ground. Written arrange from template(passacaglia, @eccl3_season)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "passacaglia" ;
    rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> .

<https://beatscript.app/ontology/concept/template-canon> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#PhraseTemplate> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "canon"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The phrase template canon: a canon at 90 in D: Pachelbel's violin line chased by copies of itself, a bar and a beat behind, over his ground; the phrase sung over them. Written arrange from template(canon, @mgm_pease_porridge_hot)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "canon" ;
    rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> .

<https://beatscript.app/ontology/concept/template-rondo> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#PhraseTemplate> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "rondo"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The phrase template rondo: a rondo at 116 in C: Joplin's Entertainer as the refrain, returning mutated between episodes (Bach's Prelude in C, the phrase sung). Written arrange from template(rondo, @shanty_drunken_sailor)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "rondo" ;
    rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> .

<https://beatscript.app/ontology/concept/template-fugue> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#PhraseTemplate> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "fugue"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The phrase template fugue: a fugue at 104 in B minor: Grieg's Mountain King as the subject, answered a fifth up and re-entering transposed while Bach's Badinerie morphs toward it; the phrase sung over the subject. Written arrange from template(fugue, @tyger_burning_bright)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "fugue" ;
    rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> .

<https://beatscript.app/ontology/concept/template-theme-and-variations> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#PhraseTemplate> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "theme-and-variations"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The phrase template theme-and-variations: a theme and variations at 84 in D-flat: Dvorak's New World Largo, a different transform in each section and no cross-morphs; the phrase sung in one. Written arrange from template(theme-and-variations, @dickinson_chariot_death)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "theme-and-variations" ;
    rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> .

<https://beatscript.app/ontology/concept/template-cross> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#PhraseTemplate> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "cross"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The phrase template cross: a cross at 120 in D: two sources (two seeds, in any genres: `a=gen@1 dubstep seed=54876, b=gen@1 house seed=7`) take turns and overlap, and morph toward each other and back in cycles; the phrase sung over the crossing. Written arrange from template(cross, @psalm42_deep_calleth)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "cross" ;
    rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> .

