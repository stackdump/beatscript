    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's NAME token, used in: SPEC, arg, arr_end, arrange, arrange_block, assert, atom, binding, block_end, call, def, do, end, engine, form, gen, gen_param, import, invoke, launch, let, mut_op, mut_target, sample, section, seed, set_play, sexpr, sing, source, start, station_line, stored, switch, template, track, until_when, use, use_source, when, wire."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
