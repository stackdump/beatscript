    <https://beatscript.app/ontology/ns#actsOn> <https://beatscript.app/ontology/concept/noun-track> ;
    <https://beatscript.app/ontology/ns#actsOn> <https://beatscript.app/ontology/concept/noun-vocal> .

<https://beatscript.app/ontology/concept/verb-vocoder> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#ControlVerb> ;
