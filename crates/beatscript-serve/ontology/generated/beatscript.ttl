    <http://www.w3.org/2004/02/skos/core#prefLabel> "PITCH"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's PITCH token, used in: input."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "PITCH" .

<https://beatscript.app/ontology/concept/token-ratchet> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#TokenClass> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "RATCHET"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's RATCHET token, used in: mark."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "RATCHET" .

