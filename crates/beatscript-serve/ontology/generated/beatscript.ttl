    <http://www.w3.org/2004/02/skos/core#prefLabel> "ROMAN"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's ROMAN token, used in: arg, atom."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "ROMAN" .

