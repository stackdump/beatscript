    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"==\" | \"!=\" | \"<\" | \"<=\" | \">\" | \">=\"" ;
    <https://beatscript.app/ontology/ns#writtenAs> "cmp" ;
