    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-dot> .

<https://beatscript.app/ontology/concept/grammar-evolve> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "evolve"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The evolve production of BeatScript's grammar (a rule a line; the bound last)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"evolve\" \"every\" INT \"bars\" \"{\" { NEWLINE } { rule NEWLINE { NEWLINE } } [ bound NEWLINE { NEWLINE } ] \"}\"" ;
