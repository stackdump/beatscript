<https://beatscript.app/ontology/concept/grammar-tokens> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "tokens"@en ;
