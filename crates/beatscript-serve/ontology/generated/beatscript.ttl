    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-close-paren> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-comma> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-dot> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-template> .

<https://beatscript.app/ontology/concept/grammar-track> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "track"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The track production of BeatScript's grammar (a stored set's track by number: <cid>.track2, its section <cid>.track2.drop, its part <cid>.track2.drop.bass)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "CID \".\" NAME [ \".\" NAME ] [ \".\" role ]" ;
    <https://beatscript.app/ontology/ns#writtenAs> "track" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Phrase templates"@en ;
    <https://beatscript.app/ontology/ns#hostOnly> true ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-cid> ;
