    <http://www.w3.org/2004/02/skos/core#prefLabel> "NEWLINE"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's NEWLINE token, used in: arr_gap, body_line, def_line, evolve, line, mix, set, station."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
