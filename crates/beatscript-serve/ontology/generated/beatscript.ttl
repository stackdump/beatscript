<https://beatscript.app/ontology/concept/form-fugue> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#Form> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "fugue"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The fugue, a form from classical music: subject answer counter sung answer counter sung: the voices enter one by one. The subject re-enters transposed (`~ subject_* down 2`, later `~ up 2`) while the countersubject morphs toward it (`~ counter_* morph subject_1 p`)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "fugue" ;
    <https://beatscript.app/ontology/ns#formTemplate> <https://beatscript.app/ontology/concept/template-fugue> ;
    <https://beatscript.app/ontology/ns#formShape> "subject answer counter sung answer counter sung: the voices enter one by one"@en ;
    <https://beatscript.app/ontology/ns#mutationPlan> "the subject re-enters transposed (`~ subject_* down 2`, later `~ up 2`) while the countersubject morphs toward it (`~ counter_* morph subject_1 p`)"@en ;
    rdfs:seeAlso <https://beatscript.app/docs/forms#fugue> ;
    <https://beatscript.app/ontology/ns#usesTechnique> <https://beatscript.app/ontology/concept/technique-found-phrases> ;
    <https://beatscript.app/ontology/ns#usesThemeLibrary> <https://beatscript.app/ontology/concept/themes-public-domain> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-morph> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-down> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-grow> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-up> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-xfer> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-decay> ;
