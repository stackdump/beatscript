<https://beatscript.app/ontology/concept/grammar-def-line> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "def_line"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The def_line production of BeatScript's grammar (a def's body line; `emit` says what an out port carries)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "[ statement | emit ] NEWLINE" ;
    <https://beatscript.app/ontology/ns#writtenAs> "def_line" ;
