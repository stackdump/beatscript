<https://beatscript.app/ontology/concept/grammar-input> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "input"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The input production of BeatScript's grammar (performed: only in a control value or guard; PITCH: a note with its octave, c4)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"knob\" \"(\" INT \")\" | \"pad\" \"(\" INT \")\" | \"fader\" \"(\" deck \")\" | \"held\" \"(\" \"key\" \")\" | \"held\" \"(\" PITCH \")\"" ;
    <https://beatscript.app/ontology/ns#writtenAs> "input" ;
