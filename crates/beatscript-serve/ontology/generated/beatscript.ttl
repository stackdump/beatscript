<https://beatscript.app/ontology/concept/form-canon> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#Form> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "canon"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The canon, a form from classical music: lead chase round sung round sung: one voice, then two, then three. The theme chases its own delayed and rotated copies; they are made of its bars, so `~ theme_* rot 2` and `rev` move the leader and its followers together."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "canon" ;
    <https://beatscript.app/ontology/ns#formTemplate> <https://beatscript.app/ontology/concept/template-canon> ;
    <https://beatscript.app/ontology/ns#formShape> "lead chase round sung round sung: one voice, then two, then three"@en ;
    <https://beatscript.app/ontology/ns#mutationPlan> "the theme chases its own delayed and rotated copies; they are made of its bars, so `~ theme_* rot 2` and `rev` move the leader and its followers together"@en ;
    rdfs:seeAlso <https://beatscript.app/docs/forms#canon> ;
    <https://beatscript.app/ontology/ns#usesTechnique> <https://beatscript.app/ontology/concept/technique-found-phrases> ;
    <https://beatscript.app/ontology/ns#usesThemeLibrary> <https://beatscript.app/ontology/concept/themes-public-domain> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-rot> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-rev> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-accent> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-grow> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-xfer> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-decay> ;
    <https://beatscript.app/ontology/ns#usesTheme> "pachelbel_ground" ;
    <https://beatscript.app/ontology/ns#usesTheme> "pachelbel_violin" .

<https://beatscript.app/ontology/concept/form-rondo> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#Form> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "rondo"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The rondo, a form from classical music: refrain episode refrain sung refrain episode refrain sung refrain: A B A C A B A C A. The refrain mutated on each return: `~ rot 2 | accent`, `@ mirror | vel 2` for one return, `~ up 1` then `~ down 1`; the episode morphs toward the refrain."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "rondo" ;
    <https://beatscript.app/ontology/ns#formTemplate> <https://beatscript.app/ontology/concept/template-rondo> ;
    <https://beatscript.app/ontology/ns#formShape> "refrain episode refrain sung refrain episode refrain sung refrain: A B A C A B A C A"@en ;
    <https://beatscript.app/ontology/ns#mutationPlan> "the refrain mutated on each return: `~ rot 2 | accent`, `@ mirror | vel 2` for one return, `~ up 1` then `~ down 1`; the episode morphs toward the refrain"@en ;
    rdfs:seeAlso <https://beatscript.app/docs/forms#rondo> ;
    <https://beatscript.app/ontology/ns#usesTechnique> <https://beatscript.app/ontology/concept/technique-found-phrases> ;
    <https://beatscript.app/ontology/ns#usesThemeLibrary> <https://beatscript.app/ontology/concept/themes-public-domain> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-rot> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-accent> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-mirror> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-vel> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-morph> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-up> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-xfer> ;
    <https://beatscript.app/ontology/ns#usesMutation> <https://beatscript.app/ontology/concept/mutation-op-down> ;
    <https://beatscript.app/ontology/ns#usesTheme> "the_entertainer" ;
    <https://beatscript.app/ontology/ns#usesTheme> "bach_prelude_c" ;
