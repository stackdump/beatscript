<https://beatscript.app/ontology/genre/italo> a <https://beatscript.app/ontology/ns#Genre> ;
    rdfs:label "italo"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "italo: a genre the seeded generator (generate, gen@N) knows (djrust's own genre, beyond beats' catalogue, following synthwave's musicality rules), as its tables give it: 120 BPM, minor from MIDI note 45, the four on floor groove, kick E(4,16), snare E(2,16) rotated 4, hihat E(4,16) rotated 2, chords 1-6-3-7 or 1-4-7-3."@en ;
    <https://beatscript.app/ontology/ns#genreId> "italo" ;
    <https://beatscript.app/ontology/ns#inFamily> <https://beatscript.app/ontology/family/song> ;
    <https://beatscript.app/ontology/ns#bpm> "120"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#defaultScale> <https://beatscript.app/ontology/scale/minor> ;
    <https://beatscript.app/ontology/ns#rootNote> "45"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#defaultGroove> <https://beatscript.app/ontology/groove/four-on-floor> ;
    <https://beatscript.app/ontology/ns#kickRhythm> <https://beatscript.app/ontology/rhythm/italo-kick> ;
    <https://beatscript.app/ontology/ns#snareRhythm> <https://beatscript.app/ontology/rhythm/italo-snare> ;
    <https://beatscript.app/ontology/ns#hihatRhythm> <https://beatscript.app/ontology/rhythm/italo-hihat> ;
    <https://beatscript.app/ontology/ns#bassDensity> "0.8"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#bassDuration> "110"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#durationVariation> "0.15"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#ghostNotes> "0.15"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#humanize> "5"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#melodyDensity> "0.45"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#melodyDuration> "150"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#swing> "0"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#syncopation> "0.1"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    <https://beatscript.app/ontology/ns#tensionCurve> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
