<https://beatscript.app/ontology/concept/grammar-let> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "let"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The let production of BeatScript's grammar (one token is a value; more tokens are a pattern)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"let\" NAME \"=\" ( sexpr | arith | ref | TOKEN { TOKEN } )" ;
