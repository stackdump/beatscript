<https://beatscript.app/ontology/genre/electro> a <https://beatscript.app/ontology/ns#Genre> ;
    rdfs:label "electro"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "electro: a genre the seeded generator (generate, gen@N) knows (djrust's own genre, beyond beats' catalogue, following edm's musicality rules), as its tables give it: 118 BPM, minor from MIDI note 45, the breakbeat groove, kick E(5,16), snare E(2,16) rotated 4, hihat E(8,16), swing 8, chords 1-7-6-7 or 1-4-1-5."@en ;
    <https://beatscript.app/ontology/ns#genreId> "electro" ;
    <https://beatscript.app/ontology/ns#inFamily> <https://beatscript.app/ontology/family/edm> ;
