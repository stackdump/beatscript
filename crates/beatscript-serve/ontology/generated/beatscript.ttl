    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-bars> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-every> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-repeat> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-open-brace> ;
