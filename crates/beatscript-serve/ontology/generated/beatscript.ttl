    <http://www.w3.org/2004/02/skos/core#prefLabel> "SDEG"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's SDEG token, used in: dleaf."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "SDEG" .

