<https://beatscript.app/ontology/concept/grammar-sing> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "sing"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The sing production of BeatScript's grammar (a tonal role; PHRASE: a phrasebook id, @hands_up; NAME: a phrase a `use phrase` line named)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"sing\" ( lyric | PHRASE | NAME ) \"on\" role { \"bars=\" INT | \"key=\" KEY | \"voice=\" NAME }" ;
    <https://beatscript.app/ontology/ns#writtenAs> "sing" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Mix moves and sung lyrics"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-int> ;
