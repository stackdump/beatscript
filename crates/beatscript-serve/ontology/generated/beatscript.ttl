<https://beatscript.app/ontology/concept/grammar-parts> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "parts"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The parts production of BeatScript's grammar (only after \"deck X:\" and with no time word)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "pitem { \"|\" pitem }" ;
