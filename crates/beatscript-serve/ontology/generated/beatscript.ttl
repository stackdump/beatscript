<https://beatscript.app/ontology/concept/grammar-body-line> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "body_line"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The body_line production of BeatScript's grammar (a repeat's body line: $i is the pass, 0 up)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "[ statement ] NEWLINE" ;
    <https://beatscript.app/ontology/ns#writtenAs> "body_line" ;
