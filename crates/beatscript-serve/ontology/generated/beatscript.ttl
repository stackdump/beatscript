    <https://beatscript.app/ontology/ns#ebnf> "( \"rotate\" | \"transpose\" | \"octave\" | \"invert\" | \"reverse\" | \"thin\" ) { NUMBER | \"<\" NUMBER { NUMBER } \">\" } [ \"seed=\" INT ]" ;
