    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-lyric> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-role> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-bars-param> ;
