    <http://www.w3.org/2004/02/skos/core#prefLabel> "INT"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's INT token, used in: SPEC, arg, arr_end, assert, atom, binding, block_end, bound, choose, dleaf, dterm, end, engine, evolve, gen, input, launch, mutation, op, part, repeat, rule, section, seed, set_mix, shape, sing, step, term, until_when."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
