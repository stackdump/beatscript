<https://beatscript.app/ontology/concept/grammar-structure> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "structure"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The structure production of BeatScript's grammar (the generator's song structures; standard is the default)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"standard\" | \"loop\" | \"minimal\" | \"extended\"" ;
    <https://beatscript.app/ontology/ns#writtenAs> "structure" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Start from a seed"@en ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-extended> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-loop> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-minimal> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-standard> .

<https://beatscript.app/ontology/concept/grammar-template> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "template"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The template production of BeatScript's grammar (a template's name and a phrase, a phrasebook id or words in quotes (NAME: one a `use phrase` line named): the phrase is the vocal line of a track; then a form's roles)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"template\" \"(\" NAME \",\" ( PHRASE | STRING | NAME ) { \",\" binding } \")\"" ;
    <https://beatscript.app/ontology/ns#writtenAs> "template" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Phrase templates"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-phrase> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-string> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-binding> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-open-paren> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-close-paren> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-comma> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-template> .

<https://beatscript.app/ontology/concept/grammar-binding> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "binding"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The binding production of BeatScript's grammar (a role of the form and what fills it: ground=gen@1 dubstep seed=54876 part=bass; one part of a seed role: a.bass=[d2 ~ a1 ~]; a form's number: delay=6 interval=-12)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "NAME [ \".\" role ] \"=\" ( source | [ \"-\" ] INT )" ;
    <https://beatscript.app/ontology/ns#writtenAs> "binding" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Phrase templates"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-int> ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-role> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-source> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-minus> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-dot> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-equals> .

<https://beatscript.app/ontology/concept/grammar-source> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "source"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The source production of BeatScript's grammar (an engine call; a public-domain theme by id (ode_to_joy); notes; another template, or one section of it; a stored program's part or sections; a stored set's track)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "gen | NAME | notes | form | stored | track" ;
    <https://beatscript.app/ontology/ns#writtenAs> "source" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Phrase templates"@en ;
    <https://beatscript.app/ontology/ns#usesToken> <https://beatscript.app/ontology/concept/token-name> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-form> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-gen> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-notes> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-stored> ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-track> .

<https://beatscript.app/ontology/concept/grammar-notes> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "notes"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The notes production of BeatScript's grammar (a bar, or bars one after another)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"[\" pattern \"]\" | \"<\" \"[\" pattern \"]\" { \"[\" pattern \"]\" } \">\"" ;
    <https://beatscript.app/ontology/ns#writtenAs> "notes" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Phrase templates"@en ;
    <https://beatscript.app/ontology/ns#usesProduction> <https://beatscript.app/ontology/concept/grammar-pattern> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-lt> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-gt> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-open-bracket> ;
    <https://beatscript.app/ontology/ns#usesKeyword> <https://beatscript.app/ontology/concept/keyword-symbol-close-bracket> .

<https://beatscript.app/ontology/concept/grammar-form> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "form"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The form production of BeatScript's grammar (a form inside another takes no phrase: forms nest 3 deep; .both is one of its sections, .both.arp that section's part)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"template\" \"(\" NAME { \",\" binding } \")\" [ \".\" NAME [ \".\" role ] ]" ;
    <https://beatscript.app/ontology/ns#writtenAs> "form" ;
