<https://beatscript.app/ontology/concept/token-key> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#TokenClass> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "KEY"@en ;
