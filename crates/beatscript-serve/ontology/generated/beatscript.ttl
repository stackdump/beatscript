    <http://www.w3.org/2004/02/skos/core#prefLabel> "SEED"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's SEED token, used in: seed."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "SEED" .

<https://beatscript.app/ontology/concept/token-space> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#TokenClass> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "SPACE"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's SPACE token, used in: lyric_text."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "SPACE" .

<https://beatscript.app/ontology/concept/token-string> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#TokenClass> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "STRING"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's STRING token, used in: do, doval, import, lyric, sample, set_play, template."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "STRING" .

<https://beatscript.app/ontology/concept/token-sugar> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#TokenClass> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "SUGAR"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's SUGAR token, used in: do."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "SUGAR" .

<https://beatscript.app/ontology/concept/token-text> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#TokenClass> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "TEXT"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's TEXT token, used in: lyric_text."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "TEXT" .

<https://beatscript.app/ontology/concept/token-token> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#TokenClass> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "TOKEN"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's TOKEN token, used in: let, tokens."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "TOKEN" .

<https://beatscript.app/ontology/concept/token-unit> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#TokenClass> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "UNIT"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's UNIT token, used in: TIME."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "UNIT" .

<https://beatscript.app/ontology/concept/token-word> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#TokenClass> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "WORD"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's WORD token, used in: arg, coperand, do, doval, engine, operand, pvalue."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "WORD" .

<https://beatscript.app/ontology/concept/modifier-repeat> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#PatternModifier> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "repeat (*n)"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A term written x*n plays n times in the time of one slot: hihat x*4 is four hits in one step."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#markedBy> <https://beatscript.app/ontology/concept/keyword-symbol-star> ;
    <https://beatscript.app/ontology/ns#writtenAs> "*" .

<https://beatscript.app/ontology/concept/modifier-chance> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#PatternModifier> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "chance (?p)"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A term written x?p plays with probability p (0 to 1, or a percent), drawn from the program's seed so the same program always plays the same."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#markedBy> <https://beatscript.app/ontology/concept/keyword-symbol-question> ;
    <https://beatscript.app/ontology/ns#writtenAs> "?" .

<https://beatscript.app/ontology/concept/modifier-accent> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#PatternModifier> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "accent (!)"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A term written c2! is accented: played louder than its neighbours."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#markedBy> <https://beatscript.app/ontology/concept/keyword-symbol-bang> ;
    <https://beatscript.app/ontology/ns#writtenAs> "!" .

<https://beatscript.app/ontology/concept/modifier-slide> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#PatternModifier> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "slide (^)"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A term written e2^ slides into the next note instead of re-attacking, as on an acid bass line."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#markedBy> <https://beatscript.app/ontology/concept/keyword-symbol-caret> ;
    <https://beatscript.app/ontology/ns#writtenAs> "^" .

<https://beatscript.app/ontology/concept/modifier-cycle> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#PatternModifier> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "cycle length (/n)"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A part written hihat/12 has a cycle of n sixteenths instead of 16, so it drifts against the bar."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#markedBy> <https://beatscript.app/ontology/concept/keyword-symbol-slash> ;
    <https://beatscript.app/ontology/ns#writtenAs> "/" .

<https://beatscript.app/ontology/concept/mutation-from-here> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#LanguageTerm> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "mutation from here on (~)"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "An arrange mutation written ~target op applies from that point of the arrangement to its end."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#markedBy> <https://beatscript.app/ontology/concept/keyword-symbol-tilde> ;
    <https://beatscript.app/ontology/ns#writtenAs> "~" .

<https://beatscript.app/ontology/concept/mutation-next-section> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#LanguageTerm> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "mutation for one section (@)"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "An arrange mutation written @target op applies to the next section only."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#markedBy> <https://beatscript.app/ontology/concept/keyword-symbol-at> ;
    <https://beatscript.app/ontology/ns#writtenAs> "@" .

<https://beatscript.app/ontology/concept/mutation-every-nth-pass> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#LanguageTerm> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "mutation count (~N, @N)"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "An arrange mutation written ~N target op (or @N target op) fires only on every Nth pass of its arrange block, on passes N, 2N, 3N and so on counted from 1; with no count it fires on every pass."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#markedBy> <https://beatscript.app/ontology/concept/token-int> ;
    <https://beatscript.app/ontology/ns#writtenAs> "~N" .

<https://beatscript.app/ontology/concept/beatscript-1> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#LanguageVersion> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "BeatScript 1"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "BeatScript 1: a text is in it when its header block has the version line #! btw 1, or no version line at all. Its canonical text has no #! line, and its program CID is the CID of the document {\"format\":1,\"text\":\"<canonical text>\",\"type\":\"djrust.live\"}."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#versionOf> <https://beatscript.app/ontology/concept/product-beatscript-language> ;
    <https://beatscript.app/ontology/ns#versionLine> "#! btw 1" ;
    <https://beatscript.app/ontology/ns#programCidFormat> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#programCidType> "djrust.live" .

<https://beatscript.app/ontology/concept/beatscript-2> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#LanguageVersion> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "BeatScript 2"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "BeatScript 2: a text is in it when its header block has the version line #! beatscript 2. Its canonical text begins with #! beatscript 2, and its program CID is the CID of the document {\"format\":2,\"text\":\"<canonical text>\",\"type\":\"beatscript\"}. The current version: what fmt upgrades a program to and what the generators write."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#versionOf> <https://beatscript.app/ontology/concept/product-beatscript-language> ;
    <https://beatscript.app/ontology/ns#versionLine> "#! beatscript 2" ;
    <https://beatscript.app/ontology/ns#programCidFormat> "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    <https://beatscript.app/ontology/ns#programCidType> "beatscript" ;
