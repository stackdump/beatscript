<https://beatscript.app/ontology/concept/phrasebook-public-domain> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#Phrasebook> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "public-domain phrasebook"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "Lines of verse, scripture, speech and work song first published before 1929, each with its source, its meter as a step pattern and the lyric BeatScript sings it as. A CC0 file, every text in the public domain, addressed by the CID of its text (beatscript.app/phrasebook)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "phrasebook-pd" ;
    <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://beatscript.app/ontology/concept/phrasebook-family-iambic> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#MeterFamily> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "iambic pentameter"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "Lines of ten syllables (eleven with a feminine ending) in pairs, unstressed then stressed: the beat of blank verse and the sonnet."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "iambic" ;
    <https://beatscript.app/ontology/ns#suitsGroove> "lilts on the offbeat: house" ;
    <https://beatscript.app/ontology/ns#suitsGenre> <https://beatscript.app/ontology/genre/house> .

<https://beatscript.app/ontology/concept/phrasebook-family-trochaic> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#MeterFamily> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "trochaic"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A stressed syllable then an unstressed one, four to a line, the last often cut short: Blake's Tyger and Hiawatha."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "trochaic" ;
    <https://beatscript.app/ontology/ns#suitsGroove> "chants on the kick: techno, EDM, four on the floor" ;
    <https://beatscript.app/ontology/ns#suitsGenre> <https://beatscript.app/ontology/genre/techno> ;
    <https://beatscript.app/ontology/ns#suitsGenre> <https://beatscript.app/ontology/genre/edm> ;
    <https://beatscript.app/ontology/ns#suitsGenre> <https://beatscript.app/ontology/genre/trance> .

<https://beatscript.app/ontology/concept/phrasebook-family-anapestic> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#MeterFamily> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "anapestic"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "Two unstressed syllables then a stressed one, so it rolls in threes: Byron's Sennacherib and Lear's nonsense."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "anapestic" ;
    <https://beatscript.app/ontology/ns#suitsGroove> "wants a triplet feel: drum and bass, breakbeat" ;
    <https://beatscript.app/ontology/ns#suitsGenre> <https://beatscript.app/ontology/genre/dnb> ;
    <https://beatscript.app/ontology/ns#suitsGenre> <https://beatscript.app/ontology/genre/garage> .

<https://beatscript.app/ontology/concept/phrasebook-family-dactylic> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#MeterFamily> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "dactylic"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A stressed syllable then two unstressed ones, also in threes: the long line of Evangeline."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "dactylic" ;
    <https://beatscript.app/ontology/ns#suitsGroove> "wants a triplet feel: drum and bass, breakbeat" ;
    <https://beatscript.app/ontology/ns#suitsGenre> <https://beatscript.app/ontology/genre/dnb> ;
    <https://beatscript.app/ontology/ns#suitsGenre> <https://beatscript.app/ontology/genre/garage> .

<https://beatscript.app/ontology/concept/phrasebook-family-common-meter> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#MeterFamily> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "common meter"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The hymn and ballad stanza: a line of four beats, then a line of three (eight syllables, then six)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "common-meter" ;
    <https://beatscript.app/ontology/ns#suitsGroove> "its 8-6-8-6 fills a 16-bar section, a line to a four-bar phrase" .

<https://beatscript.app/ontology/concept/phrasebook-family-sprung> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#MeterFamily> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "sprung rhythm"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "Gerard Manley Hopkins's rhythm: count the stresses, not the syllables; a stress stands alone or takes up to three slack syllables."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "sprung" ;
    <https://beatscript.app/ontology/ns#suitsGroove> "counts stresses, not syllables: one stress to a beat, over any groove" .

<https://beatscript.app/ontology/concept/phrasebook-family-nursery> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#MeterFamily> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "nursery rhyme"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "Two or three strong beats a line with any number of weak syllables between: a rhyme said aloud."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "nursery" ;
    <https://beatscript.app/ontology/ns#suitsGroove> "a clapping or lullaby dimeter: a triplet shuffle, or sparse" ;
    <https://beatscript.app/ontology/ns#suitsGenre> <https://beatscript.app/ontology/genre/garage> ;
    <https://beatscript.app/ontology/ns#suitsGenre> <https://beatscript.app/ontology/genre/lofi> .

<https://beatscript.app/ontology/concept/phrasebook-family-parallelism> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#MeterFamily> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "parallelism"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The verse of the King James Bible: two halves that answer each other (day and night, speech and knowledge), with no fixed foot."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "parallelism" ;
    <https://beatscript.app/ontology/ns#suitsGroove> "repeat plus variation: the second half answers the first" .

<https://beatscript.app/ontology/concept/phrasebook-family-oratory> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#MeterFamily> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "oratory"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "Speech: no fixed foot, the stresses of the sentence, built in threes and answering clauses."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "oratory" ;
    <https://beatscript.app/ontology/ns#suitsGroove> "speech as rhythm: a sparse spot section, not a groove" ;
    <https://beatscript.app/ontology/ns#suitsGenre> <https://beatscript.app/ontology/genre/ambient> .

<https://beatscript.app/ontology/concept/phrasebook-family-call-and-response> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#MeterFamily> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "call and response"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A work song: the leader sings a line and the crew answers; the stresses are the heaves, the pulls on the rope."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "call-and-response" ;
    <https://beatscript.app/ontology/ns#suitsGroove> "call and response: the leader's syllables, then the crew's" .

<https://beatscript.app/ontology/concept/technique-found-phrases> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#Technique> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "found phrases"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "Borrowing found material for its shape, not its meaning: a public-domain line is chosen for its meter (trochees chant on the kick, iambs lilt on the offbeat, anapests and dactyls want a triplet feel, shanties call and respond, psalm parallelism repeats with variation), its stresses are written to land where the meter says, the vocal is kept low (about A3 to F4) and cycled between a buried section and a spotlit one, crossed onto the drum rhythms with xfer, and its pronunciation fixed with phoneme escapes. The lineage of sampling, cut-ups and readymades, borrowing structure rather than recordings, from sources clean by construction."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    rdfs:seeAlso <https://beatscript.app/docs/found-phrases> ;
    <https://beatscript.app/ontology/ns#usesPhrasebook> <https://beatscript.app/ontology/concept/phrasebook-public-domain> ;
    <https://beatscript.app/ontology/ns#writtenAs> "found-phrases" .

<https://beatscript.app/ontology/concept/phrasebook-feel-straight> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#Feel> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "straight"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A straight feel: the syllables sit on the sixteenth grid."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "straight" .

<https://beatscript.app/ontology/concept/phrasebook-feel-triplet> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#Feel> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "triplet"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A triplet feel: the syllables go in groups of three."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "triplet" .

<https://beatscript.app/ontology/concept/themes-public-domain> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#ThemeLibrary> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "public-domain theme library"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "Melodies, basses and figures composed and first published before 1929, each written from the melody itself as BeatScript bars in a stated key, with its role, meter, source work, composer, year and pairings. A CC0 file, addressed by the CID of its text (beatscript.app/themes): the melodic twin of the phrasebook."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "themes-pd" ;
    <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/> ;
    rdfs:seeAlso <https://beatscript.app/themes> .

<https://beatscript.app/ontology/concept/theme-role-melody> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#ThemeRole> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "melody"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A theme written for the melody part: a tune: the line a person hums."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "melody" .

<https://beatscript.app/ontology/concept/theme-role-bass> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#ThemeRole> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "bass"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A theme written for the bass part: a bass line, a ground or an ostinato: the line under the others."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "bass" .

<https://beatscript.app/ontology/concept/theme-role-harmony> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#ThemeRole> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "harmony"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A theme written for the harmony part: chords, or an interval held: what the other lines are heard against."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "harmony" .

<https://beatscript.app/ontology/concept/theme-role-arp> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#ThemeRole> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "arp"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "A theme written for the arp part: a chord broken into a figure: the harmony as a moving line."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "arp" .

<https://beatscript.app/ontology/concept/theme-mode-major> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#ThemeMode> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "major"@en ;
