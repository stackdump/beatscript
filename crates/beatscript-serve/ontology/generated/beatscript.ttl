<https://beatscript.app/ontology/concept/grammar-use-source> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#GrammarProduction> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "use_source"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The use_source production of BeatScript's grammar (<cid>.drop: a section; <cid>.drop.bass: a line; <cid>: a source for a role; gen@2 techno seed=42 section=drop, part=bass: a section or a line; with neither, a source for a role; template(passacaglia, ground=...): a form, for a role; .ground: a canned section of it; template(deep-house, @tempest_such_stuff).night: a canned section, sung with that phrase; a theme of the public-domain library: a line, in the program's key; a phrasebook line: a phrase, for sing and template; genre@1 techno.drop: a section of a genre template, frozen)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "stored | gen | \"template\" \"(\" NAME { \",\" binding } \")\" [ \".\" NAME ] | template \".\" NAME | \"theme\" NAME | \"phrase\" PHRASE | GENRE NAME \".\" NAME" ;
    <https://beatscript.app/ontology/ns#writtenAs> "use_source" ;
    <https://beatscript.app/ontology/ns#grammarSection> "Radio: stations"@en ;
