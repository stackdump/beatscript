    <http://www.w3.org/2004/02/skos/core#prefLabel> "NOTE"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The lexer's NOTE token, used in: atom."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#writtenAs> "NOTE" .

<https://beatscript.app/ontology/concept/token-number> a <http://www.w3.org/2004/02/skos/core#Concept>, <https://beatscript.app/ontology/ns#TokenClass> ;
