    <http://www.w3.org/2004/02/skos/core#prefLabel> "deck"@en ;
    <http://www.w3.org/2004/02/skos/core#definition> "The deck production of BeatScript's grammar (PARAM: in a def body, filled in when it is called)."@en ;
    <https://beatscript.app/ontology/ns#status> "stable" ;
    <https://beatscript.app/ontology/ns#ebnf> "\"A\" | \"B\" | PARAM" ;
