		<rdfs:comment xml:lang="en">The theme library a form or a technique takes its found melodies from.</rdfs:comment>
		<rdfs:label xml:lang="en">uses theme library</rdfs:label>
		<rdfs:range rdf:resource="https://beatscript.app/ontology/ns#ThemeLibrary"/>
		<ns:status>stable</ns:status>
	</owl:ObjectProperty>
	<owl:ObjectProperty rdf:about="https://beatscript.app/ontology/ns#usesToken">
