		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>until_when</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-use">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The use production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">use</skos:prefLabel>
		<ns:ebnf>&quot;use&quot; &quot;restricted&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Radio: stations</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-restricted"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-use"/>
		<ns:writtenAs>use</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-value">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The value production of BeatScript&apos;s grammar (a control&apos;s value may read inputs: 200 + knob(3) * 7800).</skos:definition>
		<skos:prefLabel xml:lang="en">value</skos:prefLabel>
		<ns:ebnf>carith</ns:ebnf>
		<ns:grammarSection xml:lang="en">Control: what the mix does</ns:grammarSection>
