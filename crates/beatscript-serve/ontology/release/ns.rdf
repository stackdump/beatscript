	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-until-when">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The until_when production of BeatScript&apos;s grammar (a time, a bar of the track, a section&apos;s start or end).</skos:definition>
		<skos:prefLabel xml:lang="en">until_when</skos:prefLabel>
		<ns:ebnf>TIME | &quot;bar&quot; INT | NAME | &quot;after&quot; NAME</ns:ebnf>
		<ns:grammarSection xml:lang="en">Sets, samples, imports</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-after"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bar"/>
