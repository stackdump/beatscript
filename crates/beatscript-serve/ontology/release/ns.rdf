	</ns:InstrumentRole>
	<ns:InstrumentRole rdf:about="https://beatscript.app/ontology/role/bass">
		<rdfs:label xml:lang="en">bass</rdfs:label>
		<skos:definition xml:lang="en">The low line that carries the harmony&apos;s roots.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/role/bass"/>
	</ns:InstrumentRole>
	<ns:InstrumentRole rdf:about="https://beatscript.app/ontology/role/clap">
		<rdfs:label xml:lang="en">clap</rdfs:label>
		<skos:definition xml:lang="en">A hand-clap sound doubling the snare.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/role/clap"/>
	</ns:InstrumentRole>
	<ns:InstrumentRole rdf:about="https://beatscript.app/ontology/role/harmony">
		<rdfs:label xml:lang="en">harmony</rdfs:label>
		<skos:definition xml:lang="en">Chordal accompaniment: pads, keys or stabs.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/role/harmony"/>
	</ns:InstrumentRole>
	<ns:InstrumentRole rdf:about="https://beatscript.app/ontology/role/hihat">
		<rdfs:label xml:lang="en">hihat</rdfs:label>
		<skos:definition xml:lang="en">The hi-hat: keeps the subdivision.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/role/hihat"/>
	</ns:InstrumentRole>
	<ns:InstrumentRole rdf:about="https://beatscript.app/ontology/role/kick">
		<rdfs:label xml:lang="en">kick</rdfs:label>
		<skos:definition xml:lang="en">The bass drum: marks the pulse.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/role/kick"/>
	</ns:InstrumentRole>
	<ns:InstrumentRole rdf:about="https://beatscript.app/ontology/role/melody">
		<rdfs:label xml:lang="en">melody</rdfs:label>
		<skos:definition xml:lang="en">The lead line.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/role/melody"/>
	</ns:InstrumentRole>
	<ns:InstrumentRole rdf:about="https://beatscript.app/ontology/role/snare">
		<rdfs:label xml:lang="en">snare</rdfs:label>
		<skos:definition xml:lang="en">The snare drum: marks the backbeat.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/role/snare"/>
	</ns:InstrumentRole>
	<ns:Scale rdf:about="https://beatscript.app/ontology/scale/blues">
		<rdfs:label xml:lang="en">blues</rdfs:label>
		<skos:definition xml:lang="en">The minor pentatonic scale plus the flattened fifth, the blue note.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/scale/blues"/>
		<ns:intervals>0 3 5 6 7 10</ns:intervals>
		<ns:noteCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</ns:noteCount>
	</ns:Scale>
	<ns:Scale rdf:about="https://beatscript.app/ontology/scale/dorian">
		<rdfs:label xml:lang="en">dorian</rdfs:label>
		<skos:definition xml:lang="en">Minor with a raised sixth degree: the second mode of the major scale.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/scale/dorian"/>
		<ns:intervals>0 2 3 5 7 9 10</ns:intervals>
		<ns:noteCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</ns:noteCount>
	</ns:Scale>
	<ns:Scale rdf:about="https://beatscript.app/ontology/scale/harmonic-minor">
		<rdfs:label xml:lang="en">harmonic minor</rdfs:label>
		<skos:definition xml:lang="en">Natural minor with a raised seventh degree.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/scale/harmonic-minor"/>
		<ns:intervals>0 2 3 5 7 8 11</ns:intervals>
		<ns:noteCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</ns:noteCount>
	</ns:Scale>
	<ns:Scale rdf:about="https://beatscript.app/ontology/scale/major">
		<rdfs:label xml:lang="en">major</rdfs:label>
		<skos:definition xml:lang="en">The seven-note major scale: whole, whole, half, whole, whole, whole, half.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/scale/major"/>
		<ns:intervals>0 2 4 5 7 9 11</ns:intervals>
		<ns:noteCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</ns:noteCount>
	</ns:Scale>
	<ns:Scale rdf:about="https://beatscript.app/ontology/scale/minor-pentatonic">
