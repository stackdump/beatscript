	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/open-net-cospan">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#CategoricalConcept"/>
		<rdfs:seeAlso rdf:resource="https://ontology.pflow.xyz/ns#hasPort"/>
		<skos:definition xml:lang="en">A net with named ports at its boundary, as a cospan of sets of places. Imports and macro definitions are read this way: they are glued to the rest of a program by identifying ports.</skos:definition>
		<skos:prefLabel xml:lang="en">open net (cospan)</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/open-net-cospan"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
