		<rdfs:range rdf:resource="https://beatscript.app/ontology/ns#Stem"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#usesStem"/>
	</owl:ObjectProperty>
	<owl:ObjectProperty rdf:about="https://beatscript.app/ontology/ns#usesTechnique">
		<rdfs:comment xml:lang="en">A composition technique the form is written with (found phrases: the vocal line).</rdfs:comment>
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#Form"/>
		<rdfs:label xml:lang="en">uses technique</rdfs:label>
		<rdfs:range rdf:resource="https://beatscript.app/ontology/ns#Technique"/>
		<ns:status>stable</ns:status>
	</owl:ObjectProperty>
	<owl:ObjectProperty rdf:about="https://beatscript.app/ontology/ns#usesTerm">
