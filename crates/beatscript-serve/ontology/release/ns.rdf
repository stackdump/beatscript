	<rdf:Description rdf:about="https://beatscript.app/ontology/ns">
		<dct:creator>stackdump</dct:creator>
		<dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-22</dct:issued>
		<dct:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
		<dct:publisher rdf:resource="https://beatscript.app"/>
		<dct:rights xml:lang="en">Dedicated to the public domain under CC0 1.0 Universal.</dct:rights>
		<dct:title xml:lang="en">BeatScript ontology</dct:title>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
		<rdfs:comment xml:lang="en">The vocabulary behind BeatScript: the genres the generator knows (tempo, scale, groove, Euclidean drum rhythms, instruments, chord progressions), the song structures and sections it arranges them into, the Petri-net engine concepts underneath, and the BeatScript language itself (its versions, its grammar&apos;s productions and keywords, voices, kits, control nouns and verbs, operators and both MCP servers&apos; tools), generated from the code that implements them. Forked from the bitwrap ontology 0.2.0, whose terms it carries under this namespace, each linked to the bitwrap term it came from by prov:wasDerivedFrom; it evolves on its own from here.</rdfs:comment>
		<rdfs:seeAlso rdf:resource="https://ontology.pflow.xyz/ns"/>
		<owl:priorVersion rdf:resource="https://beatscript.app/ontology/0.2.0"/>
		<owl:versionIRI rdf:resource="https://beatscript.app/ontology/0.3.0"/>
		<owl:versionInfo>0.3.0</owl:versionInfo>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/release/bitwrap-ontology-0.2.0.tar"/>
	</rdf:Description>
	<ns:SectionProfile rdf:about="https://beatscript.app/ontology/profile/chill-breakdown">
		<rdfs:label xml:lang="en">breakdown in chill</rdfs:label>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/profile/chill-breakdown"/>
		<ns:activeRole rdf:resource="https://beatscript.app/ontology/role/melody"/>
		<ns:energy rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3</ns:energy>
		<ns:filterOpen rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</ns:filterOpen>
		<ns:forFamily rdf:resource="https://beatscript.app/ontology/family/chill"/>
		<ns:ofSection rdf:resource="https://beatscript.app/ontology/section/breakdown"/>
	</ns:SectionProfile>
	<ns:SectionProfile rdf:about="https://beatscript.app/ontology/profile/chill-bridge">
		<rdfs:label xml:lang="en">bridge in chill</rdfs:label>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/profile/chill-bridge"/>
		<ns:activeRole rdf:resource="https://beatscript.app/ontology/role/bass"/>
		<ns:activeRole rdf:resource="https://beatscript.app/ontology/role/melody"/>
		<ns:energy rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.55</ns:energy>
		<ns:filterOpen rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.55</ns:filterOpen>
		<ns:forFamily rdf:resource="https://beatscript.app/ontology/family/chill"/>
		<ns:ofSection rdf:resource="https://beatscript.app/ontology/section/bridge"/>
	</ns:SectionProfile>
