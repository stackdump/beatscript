	</owl:ObjectProperty>
	<owl:DatatypeProperty rdf:about="https://beatscript.app/ontology/ns#usesTheme">
		<rdfs:comment xml:lang="en">The id of a theme of the public-domain theme library the form is built from.</rdfs:comment>
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#Form"/>
		<rdfs:label xml:lang="en">uses theme</rdfs:label>
