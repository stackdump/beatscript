<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:dct="http://purl.org/dc/terms/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:its="http://www.w3.org/2005/11/its" xmlns:prov="http://www.w3.org/ns/prov#" xmlns:ns="https://beatscript.app/ontology/ns#" xmlns:pflow="https://ontology.pflow.xyz/ns#">
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/beatscript-1">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#LanguageVersion"/>
		<skos:altLabel xml:lang="en">btw</skos:altLabel>
		<skos:definition xml:lang="en">BeatScript 1: a text is in it when its header block has the version line #! btw 1, or no version line at all. Its canonical text has no #! line, and its program CID is the CID of the document {&quot;format&quot;:1,&quot;text&quot;:&quot;&lt;canonical text&gt;&quot;,&quot;type&quot;:&quot;djrust.live&quot;}.</skos:definition>
		<skos:historyNote xml:lang="en">The name of the language before language version 2 was btw: BeatScript 1 is the language as it was written then. Every BeatScript 1 program, link and CID keeps its meaning; fmt upgrades a program to BeatScript 2, which plays the same under a new CID.</skos:historyNote>
		<skos:prefLabel xml:lang="en">BeatScript 1</skos:prefLabel>
		<ns:programCidFormat rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns:programCidFormat>
		<ns:programCidType>djrust.live</ns:programCidType>
		<ns:status>stable</ns:status>
		<ns:versionLine>#! btw 1</ns:versionLine>
		<ns:versionOf rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-language"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/beatscript-2">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#LanguageVersion"/>
		<skos:definition xml:lang="en">BeatScript 2: a text is in it when its header block has the version line #! beatscript 2. Its canonical text begins with #! beatscript 2, and its program CID is the CID of the document {&quot;format&quot;:2,&quot;text&quot;:&quot;&lt;canonical text&gt;&quot;,&quot;type&quot;:&quot;beatscript&quot;}. The current version: what fmt upgrades a program to and what the generators write.</skos:definition>
		<skos:prefLabel xml:lang="en">BeatScript 2</skos:prefLabel>
		<prov:wasRevisionOf rdf:resource="https://beatscript.app/ontology/concept/beatscript-1"/>
		<ns:programCidFormat rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ns:programCidFormat>
		<ns:programCidType>beatscript</ns:programCidType>
		<ns:status>stable</ns:status>
		<ns:versionLine>#! beatscript 2</ns:versionLine>
		<ns:versionOf rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-language"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/bjorklund">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Euclidean_rhythm"/>
		<skos:definition xml:lang="en">The procedure that spreads K pulses over N steps as evenly as possible. Applied repeatedly, it merges the longer groups with the leftover shorter ones until at most one leftover remains.</skos:definition>
		<skos:prefLabel xml:lang="en">Bjorklund algorithm</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/bjorklund"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/call-and-response">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:definition xml:lang="en">A phrase answered by another phrase.</skos:definition>
		<skos:prefLabel xml:lang="en">call and response</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/call-and-response"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/camelot-wheel">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:definition xml:lang="en">A way of naming the twenty-four keys as numbers 1 to 12 with a letter, A for minor and B for major. Keys one step apart on the wheel, or at the same number with the other letter, mix harmonically.</skos:definition>
		<skos:prefLabel xml:lang="en">Camelot wheel</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/camelot-wheel"/>
		<ns:status>stable</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/chord-tone">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:definition xml:lang="en">A scale degree that belongs to the chord sounding now. Strong-beat melody notes are pulled to the nearest one.</skos:definition>
		<skos:prefLabel xml:lang="en">chord tone</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/chord-tone"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/circulating-token">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:closeMatch rdf:resource="https://ontology.pflow.xyz/ns#Token"/>
		<skos:definition xml:lang="en">The single token that moves around a ring, one step per tick. Its position is the playhead.</skos:definition>
		<skos:prefLabel xml:lang="en">circulating token</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/circulating-token"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/density">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:definition xml:lang="en">The share of steps that sound rather than rest.</skos:definition>
		<skos:prefLabel xml:lang="en">density</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/density"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/empty-section-identity">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#CategoricalConcept"/>
		<skos:definition xml:lang="en">The section with no lines. Arranging it before or after any section leaves that section unchanged.</skos:definition>
		<skos:prefLabel xml:lang="en">empty section (identity)</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/empty-section-identity"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/ending-end">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Ending"/>
		<skos:definition xml:lang="en">The program stops when its last section finishes.</skos:definition>
		<skos:prefLabel xml:lang="en">end</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/ending-end"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/ending-loop">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Ending"/>
		<skos:definition xml:lang="en">The program returns to its first section when its last finishes, and the net&apos;s marking resets to its initial marking.</skos:definition>
		<skos:prefLabel xml:lang="en">loop</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/ending-loop"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/endomorphism-monoid">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#CategoricalConcept"/>
		<skos:definition xml:lang="en">The pattern transforms, each taking a pattern to a pattern, closed under doing one after another, with doing nothing as the identity.</skos:definition>
		<skos:prefLabel xml:lang="en">endomorphism monoid</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/endomorphism-monoid"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/euclidean-rhythm">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:closeMatch rdf:resource="https://beatscript.app/ontology/ns#EuclideanRhythm"/>
		<skos:definition xml:lang="en">A rhythm made by the Bjorklund algorithm. Many traditional patterns around the world are Euclidean rhythms. In the engine it becomes a rhythm ring with a note binding on each pulse step.</skos:definition>
		<skos:prefLabel xml:lang="en">Euclidean rhythm</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/euclidean-rhythm"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/evolve-invert">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EvolveOperator"/>
		<skos:definition xml:lang="en">The evolve operator invert: applied to a part once a generation.</skos:definition>
		<skos:prefLabel xml:lang="en">invert</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>invert</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/evolve-octave">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EvolveOperator"/>
		<skos:definition xml:lang="en">The evolve operator octave: applied to a part once a generation.</skos:definition>
		<skos:prefLabel xml:lang="en">octave</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>octave</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/evolve-reverse">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EvolveOperator"/>
		<skos:definition xml:lang="en">The evolve operator reverse: applied to a part once a generation.</skos:definition>
		<skos:prefLabel xml:lang="en">reverse</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>reverse</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/evolve-rotate">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EvolveOperator"/>
		<skos:definition xml:lang="en">The evolve operator rotate: applied to a part once a generation.</skos:definition>
		<skos:prefLabel xml:lang="en">rotate</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>rotate</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/evolve-thin">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EvolveOperator"/>
		<skos:definition xml:lang="en">The evolve operator thin: applied to a part once a generation.</skos:definition>
		<skos:prefLabel xml:lang="en">thin</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>thin</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/evolve-transpose">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EvolveOperator"/>
		<skos:definition xml:lang="en">The evolve operator transpose: applied to a part once a generation.</skos:definition>
		<skos:prefLabel xml:lang="en">transpose</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>transpose</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/fmt">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:definition xml:lang="en">The formatter: rewrites a BeatScript program into its canonical form without changing what it plays. The fmt a person or an agent asks for also upgrades a BeatScript 1 program to BeatScript 2, a new CID for the same music; the formatting a program gets on its way in (eval, load, share, queue, push) keeps its version, so its CID never moves.</skos:definition>
		<skos:prefLabel xml:lang="en">fmt</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/fmt"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/normal-form"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/form-canon">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Form"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/docs/forms#canon"/>
		<skos:definition xml:lang="en">The canon, a form from classical music: lead chase round sung round sung: one voice, then two, then three. The theme chases its own delayed and rotated copies; they are made of its bars, so `~ theme_* rot 2` and `rev` move the leader and its followers together.</skos:definition>
		<skos:prefLabel xml:lang="en">canon</skos:prefLabel>
		<ns:formShape xml:lang="en">lead chase round sung round sung: one voice, then two, then three</ns:formShape>
		<ns:formTemplate rdf:resource="https://beatscript.app/ontology/concept/template-canon"/>
		<ns:mutationPlan xml:lang="en">the theme chases its own delayed and rotated copies; they are made of its bars, so `~ theme_* rot 2` and `rev` move the leader and its followers together</ns:mutationPlan>
		<ns:status>stable</ns:status>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-accent"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-decay"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-grow"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-rev"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-rot"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-xfer"/>
		<ns:usesTechnique rdf:resource="https://beatscript.app/ontology/concept/technique-found-phrases"/>
		<ns:usesTheme>pachelbel_ground</ns:usesTheme>
		<ns:usesTheme>pachelbel_violin</ns:usesTheme>
		<ns:usesThemeLibrary rdf:resource="https://beatscript.app/ontology/concept/themes-public-domain"/>
		<ns:writtenAs>canon</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/form-cross">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Form"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/docs/forms#cross"/>
		<skos:definition xml:lang="en">The cross, a form from classical music: a_leads b_leads both both sung a_leads b_leads sung: one source leads, then the other, then both at once. A quodlibet of two: `~ a_melody_* morph b_melody_1 p` paired with `~ b_bass_* morph a_bass_1 p`, an `@ ... xfer` one-shot in the overlap, then the pull turned round (`~ b_melody_* morph a_melody_1 p`, `~ a_bass_* morph b_bass_1 p`); `~` persists and compounds pass on pass (loop 3).</skos:definition>
		<skos:prefLabel xml:lang="en">cross</skos:prefLabel>
		<ns:formShape xml:lang="en">a_leads b_leads both both sung a_leads b_leads sung: one source leads, then the other, then both at once</ns:formShape>
		<ns:formTemplate rdf:resource="https://beatscript.app/ontology/concept/template-cross"/>
		<ns:mutationPlan xml:lang="en">a quodlibet of two: `~ a_melody_* morph b_melody_1 p` paired with `~ b_bass_* morph a_bass_1 p`, an `@ ... xfer` one-shot in the overlap, then the pull turned round (`~ b_melody_* morph a_melody_1 p`, `~ a_bass_* morph b_bass_1 p`); `~` persists and compounds pass on pass (loop 3)</ns:mutationPlan>
		<ns:status>stable</ns:status>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-decay"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-grow"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-morph"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-xfer"/>
		<ns:usesTechnique rdf:resource="https://beatscript.app/ontology/concept/technique-found-phrases"/>
		<ns:usesTheme>badinerie</ns:usesTheme>
		<ns:usesTheme>ode_to_joy</ns:usesTheme>
		<ns:usesTheme>pachelbel_ground</ns:usesTheme>
		<ns:usesThemeLibrary rdf:resource="https://beatscript.app/ontology/concept/themes-public-domain"/>
		<ns:writtenAs>cross</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/form-fugue">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Form"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/docs/forms#fugue"/>
		<skos:definition xml:lang="en">The fugue, a form from classical music: subject answer counter sung answer counter sung: the voices enter one by one. The subject re-enters transposed (`~ subject_* down 2`, later `~ up 2`) while the countersubject morphs toward it (`~ counter_* morph subject_1 p`).</skos:definition>
		<skos:prefLabel xml:lang="en">fugue</skos:prefLabel>
		<ns:formShape xml:lang="en">subject answer counter sung answer counter sung: the voices enter one by one</ns:formShape>
		<ns:formTemplate rdf:resource="https://beatscript.app/ontology/concept/template-fugue"/>
		<ns:mutationPlan xml:lang="en">the subject re-enters transposed (`~ subject_* down 2`, later `~ up 2`) while the countersubject morphs toward it (`~ counter_* morph subject_1 p`)</ns:mutationPlan>
		<ns:status>stable</ns:status>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-decay"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-down"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-grow"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-morph"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-up"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-xfer"/>
		<ns:usesTechnique rdf:resource="https://beatscript.app/ontology/concept/technique-found-phrases"/>
		<ns:usesTheme>badinerie</ns:usesTheme>
		<ns:usesTheme>mountain_king</ns:usesTheme>
		<ns:usesThemeLibrary rdf:resource="https://beatscript.app/ontology/concept/themes-public-domain"/>
		<ns:writtenAs>fugue</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/form-passacaglia">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Form"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/docs/forms#passacaglia"/>
		<skos:definition xml:lang="en">The passacaglia, a form from classical music: ground variation sung variation sung variation sung: the ground under every section. Cumulative variations above the ground, each `~` added on top of the last: `rot 2 | accent`, `thin`, `rev | drift`, `grow`, `up 1`, `down 1`, `decay`; the ground is never mutated.</skos:definition>
		<skos:prefLabel xml:lang="en">passacaglia</skos:prefLabel>
		<ns:formShape xml:lang="en">ground variation sung variation sung variation sung: the ground under every section</ns:formShape>
		<ns:formTemplate rdf:resource="https://beatscript.app/ontology/concept/template-passacaglia"/>
		<ns:mutationPlan xml:lang="en">cumulative variations above the ground, each `~` added on top of the last: `rot 2 | accent`, `thin`, `rev | drift`, `grow`, `up 1`, `down 1`, `decay`; the ground is never mutated</ns:mutationPlan>
		<ns:referenceProgram>z4EBG9j3xZiLH5Sa8EnFW5sg2WuSPRuMbBaTr3JHeQjfWWE7Ug9</ns:referenceProgram>
		<ns:status>stable</ns:status>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-accent"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-decay"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-down"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-drift"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-grow"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-rev"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-rot"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-thin"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-up"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-xfer"/>
		<ns:usesTechnique rdf:resource="https://beatscript.app/ontology/concept/technique-found-phrases"/>
		<ns:usesTheme>mars_ostinato</ns:usesTheme>
		<ns:usesThemeLibrary rdf:resource="https://beatscript.app/ontology/concept/themes-public-domain"/>
		<ns:writtenAs>passacaglia</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/form-quodlibet">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Form"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/docs/forms#quodlibet"/>
		<skos:definition xml:lang="en">The quodlibet, a form from classical music: canon ode fate voices canon voices: one theme leads each section, the others under it. `~ a_* morph b_1 p` paired later with `~ b_* morph a_1 p`, the pair pulled away by a morph toward a third line, `@` one-shot borrowings; `~` persists and compounds pass on pass (loop 3).</skos:definition>
		<skos:prefLabel xml:lang="en">quodlibet</skos:prefLabel>
		<ns:formShape xml:lang="en">canon ode fate voices canon voices: one theme leads each section, the others under it</ns:formShape>
		<ns:formTemplate rdf:resource="https://beatscript.app/ontology/concept/template-quodlibet"/>
		<ns:mutationPlan xml:lang="en">`~ a_* morph b_1 p` paired later with `~ b_* morph a_1 p`, the pair pulled away by a morph toward a third line, `@` one-shot borrowings; `~` persists and compounds pass on pass (loop 3)</ns:mutationPlan>
		<ns:referenceProgram>z4EBG9j86dPTC9HH6EjtBJFAWZsJLiPum4np9zoJQC9PzWm9SoC</ns:referenceProgram>
		<ns:status>stable</ns:status>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-decay"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-grow"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-morph"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-xfer"/>
		<ns:usesTechnique rdf:resource="https://beatscript.app/ontology/concept/technique-found-phrases"/>
		<ns:usesTheme>beethoven_fate</ns:usesTheme>
		<ns:usesTheme>ode_to_joy</ns:usesTheme>
		<ns:usesTheme>pachelbel_ground</ns:usesTheme>
		<ns:usesTheme>pachelbel_violin</ns:usesTheme>
		<ns:usesThemeLibrary rdf:resource="https://beatscript.app/ontology/concept/themes-public-domain"/>
		<ns:writtenAs>quodlibet</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/form-rondo">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Form"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/docs/forms#rondo"/>
		<skos:definition xml:lang="en">The rondo, a form from classical music: refrain episode refrain sung refrain episode refrain sung refrain: A B A C A B A C A. The refrain mutated on each return: `~ rot 2 | accent`, `@ mirror | vel 2` for one return, `~ up 1` then `~ down 1`; the episode morphs toward the refrain.</skos:definition>
		<skos:prefLabel xml:lang="en">rondo</skos:prefLabel>
		<ns:formShape xml:lang="en">refrain episode refrain sung refrain episode refrain sung refrain: A B A C A B A C A</ns:formShape>
		<ns:formTemplate rdf:resource="https://beatscript.app/ontology/concept/template-rondo"/>
		<ns:mutationPlan xml:lang="en">the refrain mutated on each return: `~ rot 2 | accent`, `@ mirror | vel 2` for one return, `~ up 1` then `~ down 1`; the episode morphs toward the refrain</ns:mutationPlan>
		<ns:referenceProgram>z4EBG9izzm3asNWWapjXtPFSZoPzgyj4cKjPELrw4jvrhdjPxrW</ns:referenceProgram>
		<ns:status>stable</ns:status>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-accent"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-down"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-mirror"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-morph"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-rot"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-up"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-vel"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-xfer"/>
		<ns:usesTechnique rdf:resource="https://beatscript.app/ontology/concept/technique-found-phrases"/>
		<ns:usesTheme>bach_prelude_c</ns:usesTheme>
		<ns:usesTheme>the_entertainer</ns:usesTheme>
		<ns:usesThemeLibrary rdf:resource="https://beatscript.app/ontology/concept/themes-public-domain"/>
		<ns:writtenAs>rondo</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/form-theme-and-variations">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Form"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/docs/forms#theme-and-variations"/>
		<skos:definition xml:lang="en">The theme and variations, a form from classical music: theme variation variation variation sung variation theme. One source, a different transform for each section as a one-shot `@` (`rev`, `invert`, `stutter 2`, `oct -1`, `half | accent`), so the theme comes back unchanged; no cross-morphs.</skos:definition>
		<skos:prefLabel xml:lang="en">theme and variations</skos:prefLabel>
		<ns:formShape xml:lang="en">theme variation variation variation sung variation theme</ns:formShape>
		<ns:formTemplate rdf:resource="https://beatscript.app/ontology/concept/template-theme-and-variations"/>
		<ns:mutationPlan xml:lang="en">one source, a different transform for each section as a one-shot `@` (`rev`, `invert`, `stutter 2`, `oct -1`, `half | accent`), so the theme comes back unchanged; no cross-morphs</ns:mutationPlan>
		<ns:status>stable</ns:status>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-accent"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-grow"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-half"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-invert"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-oct"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-rev"/>
		<ns:usesMutation rdf:resource="https://beatscript.app/ontology/concept/mutation-op-stutter"/>
		<ns:usesTechnique rdf:resource="https://beatscript.app/ontology/concept/technique-found-phrases"/>
		<ns:usesTheme>new_world_largo</ns:usesTheme>
		<ns:usesThemeLibrary rdf:resource="https://beatscript.app/ontology/concept/themes-public-domain"/>
		<ns:writtenAs>theme-and-variations</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/free-smc">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#CategoricalConcept"/>
		<skos:definition xml:lang="en">The category whose objects are multisets of places and whose morphisms are generated by the net&apos;s transitions. A deck&apos;s net is read as this category: what the deck can do is exactly what the category&apos;s morphisms can do.</skos:definition>
		<skos:prefLabel xml:lang="en">free symmetric monoidal category on a net</skos:prefLabel>
		<skos:relatedMatch rdf:resource="https://beatscript.app/ontology/concept/note-transition"/>
		<skos:relatedMatch rdf:resource="https://beatscript.app/ontology/concept/step-place"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/free-smc"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/generator-arp">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternGenerator"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/ontology/ns#ArpTerm"/>
		<skos:definition xml:lang="en">The pattern generator arp: a call that makes a pattern from its arguments.</skos:definition>
		<skos:prefLabel xml:lang="en">arp</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>arp</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/generator-choose">
