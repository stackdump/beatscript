	<ns:Groove rdf:about="https://beatscript.app/ontology/groove/bossa">
		<rdfs:label xml:lang="en">bossa</rdfs:label>
		<skos:definition xml:lang="en">A syncopated ostinato alternating the root and the low fifth, the bossa nova bass figure.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/groove/bossa"/>
	</ns:Groove>
	<ns:Groove rdf:about="https://beatscript.app/ontology/groove/breakbeat">
		<rdfs:label xml:lang="en">breakbeat</rdfs:label>
		<skos:definition xml:lang="en">The bass plays about three eighths of the steps, evenly spread and randomly rotated, independent of the kick.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/groove/breakbeat"/>
	</ns:Groove>
	<ns:Groove rdf:about="https://beatscript.app/ontology/groove/four-on-floor">
		<rdfs:label xml:lang="en">four on floor</rdfs:label>
		<skos:definition xml:lang="en">The bass plays exactly where the kick plays.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/groove/four-on-floor"/>
	</ns:Groove>
	<ns:Groove rdf:about="https://beatscript.app/ontology/groove/offbeat">
		<rdfs:label xml:lang="en">offbeat</rdfs:label>
		<skos:definition xml:lang="en">The bass plays one step before each kick, in the gap the kick leaves.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/groove/offbeat"/>
	</ns:Groove>
	<ns:Groove rdf:about="https://beatscript.app/ontology/groove/sidechained">
		<rdfs:label xml:lang="en">sidechained</rdfs:label>
		<skos:definition xml:lang="en">The bass plays wherever the kick does not, so the two never sound together.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/groove/sidechained"/>
	</ns:Groove>
	<ns:Groove rdf:about="https://beatscript.app/ontology/groove/syncopated-pocket">
		<rdfs:label xml:lang="en">syncopated pocket</rdfs:label>
		<skos:definition xml:lang="en">The bass follows the kick and adds two off-beat hits, on steps 6 and 14 of a sixteen-step bar (3 and 7 of eight).</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/groove/syncopated-pocket"/>
	</ns:Groove>
	<ns:Groove rdf:about="https://beatscript.app/ontology/groove/walking">
		<rdfs:label xml:lang="en">walking</rdfs:label>
		<skos:definition xml:lang="en">A steady quarter-note bass line that walks through the chord tones, independent of the kick.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/groove/walking"/>
	</ns:Groove>
