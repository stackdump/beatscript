	<owl:DatatypeProperty rdf:about="https://beatscript.app/ontology/ns#stressPattern">
		<rdfs:comment xml:lang="en">The meter as a BeatScript step pattern, one step a syllable: x stressed, ~ not (~ x is an iamb).</rdfs:comment>
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#PhrasebookEntry"/>
		<rdfs:label xml:lang="en">stress pattern</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<ns:status>stable</ns:status>
	</owl:DatatypeProperty>
	<owl:DatatypeProperty rdf:about="https://beatscript.app/ontology/ns#sugarWord">
		<rdfs:comment xml:lang="en">A word a program may write without do to reach this noun: vocoder on is do vocoder on.</rdfs:comment>
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#ControlNoun"/>
		<rdfs:label xml:lang="en">sugar word</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<ns:status>stable</ns:status>
	</owl:DatatypeProperty>
	<owl:ObjectProperty rdf:about="https://beatscript.app/ontology/ns#suitsGenre">
		<rdfs:comment xml:lang="en">A genre whose groove a line of this meter family sits on.</rdfs:comment>
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#MeterFamily"/>
		<rdfs:label xml:lang="en">suits genre</rdfs:label>
		<rdfs:range rdf:resource="https://beatscript.app/ontology/ns#Genre"/>
		<ns:status>stable</ns:status>
	</owl:ObjectProperty>
	<owl:DatatypeProperty rdf:about="https://beatscript.app/ontology/ns#suitsGroove">
		<rdfs:comment xml:lang="en">The groove a line of this meter family sits on, in a sentence: a trochee chants on the kick, an iamb lilts on the offbeat, an anapest wants a triplet feel.</rdfs:comment>
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#MeterFamily"/>
		<rdfs:label xml:lang="en">suits groove</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<ns:status>stable</ns:status>
	</owl:DatatypeProperty>
	<owl:ObjectProperty rdf:about="https://beatscript.app/ontology/ns#sungBy">
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#VocalLine"/>
		<rdfs:label xml:lang="en">sung by</rdfs:label>
		<rdfs:range rdf:resource="https://beatscript.app/ontology/ns#FormantVoice"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#sungBy"/>
	</owl:ObjectProperty>
	<owl:DatatypeProperty rdf:about="https://beatscript.app/ontology/ns#swing">
		<rdfs:comment xml:lang="en">How far off-beats are pushed late, 0 (straight) to about 60 (heavy).</rdfs:comment>
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#Genre"/>
		<rdfs:label xml:lang="en">swing</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#swing"/>
	</owl:DatatypeProperty>
	<owl:DatatypeProperty rdf:about="https://beatscript.app/ontology/ns#syllableCount">
		<rdfs:comment xml:lang="en">How many notes the line takes as sung: the steps of its stress pattern.</rdfs:comment>
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#PhrasebookEntry"/>
		<rdfs:label xml:lang="en">syllable count</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
		<ns:status>stable</ns:status>
	</owl:DatatypeProperty>
	<owl:DatatypeProperty rdf:about="https://beatscript.app/ontology/ns#syncopation">
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#Genre"/>
		<rdfs:label xml:lang="en">syncopation</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#syncopation"/>
	</owl:DatatypeProperty>
	<owl:DatatypeProperty rdf:about="https://beatscript.app/ontology/ns#templateKind">
		<rdfs:comment xml:lang="en">minimal, standard, extended, ab, drop, build or jam.</rdfs:comment>
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#SongStructure"/>
		<rdfs:label xml:lang="en">template kind</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#templateKind"/>
	</owl:DatatypeProperty>
	<owl:DatatypeProperty rdf:about="https://beatscript.app/ontology/ns#tempoBpm">
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
		<rdfs:comment xml:lang="en">Beats per minute the program sets. Distinct from ns:bpm, which is a genre&apos;s default.</rdfs:comment>
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#Program"/>
		<rdfs:label xml:lang="en">program tempo</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#tempoBpm"/>
		<ns:status>in-development</ns:status>
	</owl:DatatypeProperty>
	<owl:DatatypeProperty rdf:about="https://beatscript.app/ontology/ns#tensionCurve">
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#Genre"/>
		<rdfs:label xml:lang="en">tension curve</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#tensionCurve"/>
	</owl:DatatypeProperty>
	<owl:ObjectProperty rdf:about="https://beatscript.app/ontology/ns#themeMode">
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#ThemeEntry"/>
		<rdfs:label xml:lang="en">theme mode</rdfs:label>
		<rdfs:range rdf:resource="https://beatscript.app/ontology/ns#ThemeMode"/>
		<ns:status>stable</ns:status>
	</owl:ObjectProperty>
	<owl:ObjectProperty rdf:about="https://beatscript.app/ontology/ns#themeRole">
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#ThemeEntry"/>
		<rdfs:label xml:lang="en">theme role</rdfs:label>
		<rdfs:range rdf:resource="https://beatscript.app/ontology/ns#ThemeRole"/>
		<ns:status>stable</ns:status>
	</owl:ObjectProperty>
	<owl:DatatypeProperty rdf:about="https://beatscript.app/ontology/ns#themeWork">
		<rdfs:comment xml:lang="en">The work the theme is from, and where in it.</rdfs:comment>
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#ThemeEntry"/>
		<rdfs:label xml:lang="en">theme work</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<ns:status>stable</ns:status>
	</owl:DatatypeProperty>
