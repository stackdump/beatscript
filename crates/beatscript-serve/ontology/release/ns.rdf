	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/normal-form">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#CategoricalConcept"/>
		<skos:definition xml:lang="en">A choice of one representative for every set of programs the symmetric monoidal laws make equal. Because the canonical text is such a representative, equal processes get equal CIDs.</skos:definition>
		<skos:prefLabel xml:lang="en">normal form modulo the SMC laws</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/normal-form"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/note-transition">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:closeMatch rdf:resource="https://ontology.pflow.xyz/ns#Transition"/>
		<skos:definition xml:lang="en">A ring transition that carries a MIDI binding. Firing it plays the note; a transition without a binding passes the token silently.</skos:definition>
		<skos:prefLabel xml:lang="en">note transition</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/note-transition"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/noun-analysis">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#ControlNoun"/>
