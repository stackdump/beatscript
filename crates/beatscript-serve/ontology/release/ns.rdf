		<ns:writtenAs>WORD</ns:writtenAs>
	</skos:Concept>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-artifact">
		<skos:definition xml:lang="en">One BeatScript program as a self-contained HTML page, for the person to hear and share: publish the returned html as a page (an Artifact) exactly as it is, without rewriting it, and do not hand-roll a player instead. The page embeds the program&apos;s text and its CID, starts sound only when the person presses Play, shows the CID and the program&apos;s rights (licence, credits, forked from), and links back to the program on https://beatscript.app: https://beatscript.app/p/&lt;CID&gt; when the site has it stored, else the self-sealing share link (the program is in the link), never a /p/&lt;CID&gt; that would not answer. Nothing is fetched from https://beatscript.app. With store true a signed-in caller stores a text first, publicly and under its `#! license:` (default CC0-1.0, a Creative Commons licence only), as share does, so the page gets the /p/&lt;CID&gt; link and inline audio. Two ways to sound, chosen by audio: &quot;inline&quot; (the default for a stored program that renders) carries the site&apos;s Ogg Opus render of the program in the page as a data: URI in a plain &lt;audio controls&gt;, so the page loads nothing at all (no script, no engine); it is the offline render (notes and sounds, not control lines), at most 6 MB as base64, and a longer render, a text that is not stored, or a render that does not finish falls back to engine with audio_note saying why. &quot;engine&quot; (the default for a text) plays it live with the &lt;beatscript-track&gt; player (@stackdump/beatscript-player@0.3.0, the same engine as the editor, loaded from cdn.jsdelivr.net at that exact version with a Subresource Integrity hash for every module it loads); the host must allow scripts from cdn.jsdelivr.net and WebAssembly (&apos;wasm-unsafe-eval&apos;), as a claude.ai Artifact does. Ogg Opus does not play in older Safari; there is no AAC render. Give exactly one of text (the program; it must pass check; not stored unless store), cid (a program stored here or an example&apos;s CID: the page carries the stored rights) or example (a name from list_examples). title names the page (default the program&apos;s `#! name:`, else its stored name). Answers two text blocks: the first a JSON summary {title, cid, canonical_bytes, stored, rights, link, short_url, audio, player, render, audio_note, store_hint, html_bytes, publish}, the second the page (a whole HTML document). A program that uses samples or loops, or says `use restricted`, has nothing to play in a page and is refused. No sign-in, and it stores nothing, unless store; billed as a check (a render not cached yet is limited as render&apos;s are, a store as share&apos;s). Text at most 16384 bytes.</skos:definition>
		<skos:prefLabel xml:lang="en">artifact</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;audio&quot;:{&quot;description&quot;:&quot;inline (the site&apos;s Opus render in the page, nothing loaded; default for a stored program) or engine (the live player from jsDelivr; default for a text).&quot;,&quot;enum&quot;:[&quot;inline&quot;,&quot;engine&quot;],&quot;type&quot;:&quot;string&quot;},&quot;cid&quot;:{&quot;description&quot;:&quot;CID of a program stored here, or of an example: the page carries the rights it was stored with.&quot;,&quot;maxLength&quot;:100,&quot;pattern&quot;:&quot;^z[1-9A-HJ-NP-Za-km-z]{20,100}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;example&quot;:{&quot;description&quot;:&quot;Name of an example, from list_examples.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;store&quot;:{&quot;description&quot;:&quot;With text: store it on the site first (public, its `#! license:` or CC0-1.0; needs a signed-in caller), as share does, so the page links /p/&lt;CID&gt; and can carry the render inline (default false: the page links the self-sealing link instead).&quot;,&quot;type&quot;:&quot;boolean&quot;},&quot;text&quot;:{&quot;description&quot;:&quot;The program text. It must pass check.&quot;,&quot;maxLength&quot;:16384,&quot;type&quot;:&quot;string&quot;},&quot;title&quot;:{&quot;description&quot;:&quot;The page&apos;s title and the name to publish it under (default the program&apos;s `#! name:`, else its stored name, else \&quot;BeatScript\&quot;).&quot;,&quot;maxLength&quot;:80,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>artifact</ns:toolName>
		<ns:toolParameter>audio</ns:toolParameter>
		<ns:toolParameter>cid</ns:toolParameter>
		<ns:toolParameter>example</ns:toolParameter>
		<ns:toolParameter>store</ns:toolParameter>
		<ns:toolParameter>text</ns:toolParameter>
		<ns:toolParameter>title</ns:toolParameter>
		<ns:toolTitle xml:lang="en">A program as a page to publish</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-check">
		<skos:definition xml:lang="en">Check a BeatScript program without playing it: parse, type-check and compile the text. ALWAYS call check before eval, share or render, and fix every error at its line:col before trying again: a program with an error is refused whole. Warnings do not block. A `control:` line is the control deck (docs/BEATSCRIPT.md &quot;The control deck&quot;): engine calls only (move, swap pairs, load pair, queue, crossfader, a timed tempo, duck, mix, do), beside deck A:, deck B: and master:, sequenced by sections like a deck; it checks and plays as the same line with no head.

Answers {ok, errors, warnings, diagnostics[{severity, line, col, end_col, message, expected, found, help, render}], cid, canonical, version, renamed_cid, expanded_cid, tempo, key, sections, song_bars, seconds, evolve, uses_assets, restricted, docs}, and refs and resolution for a program with references. docs is the text&apos;s doc comments, [{kind, name, doc}]: the `#` lines directly above a section, let, def or arrange (a comment, so the CID does not change); sections[].doc is a section&apos;s, when it has one. line and col are 1-based; help says what would fix it (&quot;did you mean ...&quot;); render is the same error in caret form. ok:false is an answer, not a tool error. cid and canonical are of the canonical text (comments and spacing do not change the CID). version is the language version: 2 for a text whose header has `#! beatscript 2` (write that), 1 for a text with `#! btw 1` or no version line (BeatScript 1, the old spelling, which checks as before and keeps its old CID); renamed_cid is the CID of the same program in the other version (fmt upgrades a BeatScript 1 text to it). A station program (radio: a `station { }` block, see the station tool) checks the tracks of its first pass of forms and its first segue, and the answer gains station {text, cid, genre, generator, seed, step, forms, tempo, key, length, start_cid, version, tracks, segue}.

With same_as (another program&apos;s CID or text) the answer gains same_as {same, text_same, basis, why, diffs[{section, deck, start_bar, a_cid, b_cid}], only_in_a, only_in_b, renamed, song, diff}: whether the two are the same song by their compiled nets and song-level settings, not their text. When they are not, diff says what changed in music: diff.summary is one line per change (&quot;tempo 124 -&gt; 126&quot;, &quot;moved outro: bar 13 -&gt; bar 5&quot;, &quot;drop2 bass = drop bass transposed +1&quot;, &quot;drop bass: 1 note changed (1:7 c3 -&gt; d3)&quot;), with song, arrangement (inserted, removed, moved, repeated, renamed, changed) and parts (a transform: transpose, octave, rotate, reverse, thin, fill, fast, slow; else the notes added, removed or changed at bar:step) as JSON. Use it to prove a refactor changed nothing, or to find what an edit did.

This is the loop for writing a program (there is no compose tool): read https://beatscript.app/docs/cheatsheet.md and one or two list_examples programs, call instruments, write the program (its first line `#! beatscript 2`), call check and fix every line:col error until ok, then eval / load to play it and share to store it. Voices come from the instruments tool: use only names from it. For a sung line, a public-domain phrasebook line (list_examples with phrasebook true) comes with its meter, stress and phoneme escapes, so that sing @id on melody checks with no unknown-word warning (https://beatscript.app/docs/found-phrases.md). A voice name with a leading digit (808-bass) cannot be written: inst=808-bass reads as 808 - bass and a quoted &quot;808-bass&quot; is refused, so pick a voice that starts with a letter (inst=sub-bass for a deep bass). Read-only, no sign-in. Limits: the text is at most 16384 bytes; about 60 calls a minute.

References: a program can call the seeded generator (gen@2 techno seed=42 section=drop part=bass is the program generate prints, fitted to the program&apos;s key and tempo unless it says bpm= or key=) or borrow from seed(...), template(...) or a stored program by CID. Its cid is of the text as written (the recipe), and the answer says what the recipe makes: refs lists each reference of the program (a gen@N call, a seed(...), a template(...), a &lt;cid&gt;.section borrowed from a stored program): its kind, half (engine or structure), call, place (part, let, section or arrange), name, line and col, resolved (the CID it is pinned to), generator, fitted (what a gen call took from the program: key, bpm) and track; expanded_cid is the CID of the program with every reference written out as plain BeatScript: cid addresses the recipe, expanded_cid the result; the same recipe always gives the same expanded_cid, and a program with no references has expanded_cid equal to cid; resolution is the manifest: each reference once, with the CID it is pinned to and the generator and version that made it (seeded@2), and for a gen call the key and bpm it was generated in. With expand true, each entry of refs also carries its expansion (the BeatScript it is written out as where it stands). A diagnostic of severity info at each gen call says the CID it resolved to and the key and tempo it was fitted to; the expand tool writes the whole program out.

Lexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules&apos; pronunciation. Only the word, its phonemes and the program&apos;s CID are kept, never the text. The answer&apos;s lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/.</skos:definition>
		<skos:prefLabel xml:lang="en">check</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;expand&quot;:{&quot;description&quot;:&quot;Also give each entry of refs its expansion: the BeatScript the reference is written out as where it stands (default false).&quot;,&quot;type&quot;:&quot;boolean&quot;},&quot;genre&quot;:{&quot;description&quot;:&quot;Optional: a genre of the BeatScript ontology (techno, house, jazz, ... or its https://beatscript.app/ontology/genre/ IRI); else the program&apos;s own `#! genre:` line. The answer gains style {genre, label, warnings[{severity: \&quot;style\&quot;, code, message, line?, col?}]}: advice from the genre&apos;s conventions in the ontology (a tempo outside its range, a kit or voice the genre and its family do not use, chords far from its progressions). Style warnings never make ok false.&quot;,&quot;maxLength&quot;:200,&quot;type&quot;:&quot;string&quot;},&quot;same_as&quot;:{&quot;description&quot;:&quot;Optional: another program to compare with, as its CID (stored here, or an example&apos;s), a short https://beatscript.app/p/&lt;CID&gt; link, or its text. The answer gains same_as: whether the two are the same song by their compiled nets and song-level settings (tempo, key, swing, length, end, loop), not their text: a let/def/repeat refactor or a renamed section is the same song; a changed note is not, and diff says what changed in music (song settings, sections moved or inserted, a part transposed or rotated, notes at bar:step).&quot;,&quot;maxLength&quot;:16384,&quot;type&quot;:&quot;string&quot;},&quot;text&quot;:{&quot;description&quot;:&quot;The program text (at most 16384 bytes). Comments and blank lines are fine.&quot;,&quot;maxLength&quot;:16384,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;text&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:requiredParameter>text</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>check</ns:toolName>
		<ns:toolParameter>expand</ns:toolParameter>
		<ns:toolParameter>genre</ns:toolParameter>
		<ns:toolParameter>same_as</ns:toolParameter>
		<ns:toolTitle xml:lang="en">Check a BeatScript program</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-devices">
		<skos:definition xml:lang="en">List the phones paired with the token&apos;s account (djrust on Android scans the QR code that https://beatscript.app shows under Mobile; site/PAIRING.md): id, name, fingerprint (the code both ends showed at pairing), paired, connected (djrust has its stream open now), last_seen, and state (what it last reported: cid, playing, section, bar). Pairing is the grant: a phone paired by an account is driven over MCP with that account&apos;s token and no other.

Pass a phone&apos;s id as device to eval, load, get or stop to drive that phone alone (eval and load run the same checks as for a tab; a program with errors, samples or &quot;use restricted&quot; is not sent). Needs a bearer token. Read-only.</skos:definition>
		<skos:prefLabel xml:lang="en">devices</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{},&quot;required&quot;:[],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>devices</ns:toolName>
		<ns:toolTitle xml:lang="en">Your paired phones</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-embed">
		<skos:definition xml:lang="en">A program (or a set, or a station) embedded anywhere, from one embed config (https://beatscript.app/embed-config.schema.json, the same config the &lt;beatscript-track&gt; player and the &lt;beatscript-studio&gt; editor read): give a target and a config, and get the snippet or page for it, whether the config works there, is degraded or is unsupported, and one-sentence notes on what the target cannot do and what it does instead. Use the snippet as it is. Targets: artifact, web, iframe, oembed, preview, markdown, jupyter, vscode, obsidian, audio, rss, android, json. kind is player, studio (the whole editor as an MCP server inside the page: check, fmt, expand, generate, highlight, share, open, instruments, cheatsheet run offline on the wasm engine), card or audio; source is text, cid, set or station; audio is live, render, inline or url; features and capabilities are lists. With target artifact the answer is two text blocks, a JSON summary and the page: publish the page as an HTML page (an Artifact) exactly as it is, and declare the summary&apos;s capabilities (sample, mcp with the Beatscript connector&apos;s share, render and queue, db and user, downloads, room) when you publish it. Kind player or audio on target artifact is the artifact tool&apos;s page: kind audio (or audio inline) carries the site&apos;s render of a stored program in the page (a render not cached yet is limited as render&apos;s are), kind player plays it with the pinned player; kind studio loads @stackdump/beatscript-studio from cdn.jsdelivr.net at an exact version with Subresource Integrity. markdown (a GitHub README) gets an SVG card (https://beatscript.app/card/&lt;CID&gt;.svg) and an audio link; iframe, oembed, preview, audio, rss and obsidian need a program the site stores (share it signed in, or render it); android is the self-sealing /p# link the app opens. Give the program as text, cid or example (or in the config&apos;s source). No sign-in, and it stores nothing unless store (artifact, player or audio only); billed as a check. Text at most 16384 bytes. See https://beatscript.app/docs/embed.</skos:definition>
		<skos:prefLabel xml:lang="en">embed</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;cid&quot;:{&quot;description&quot;:&quot;CID of a program stored here, or of an example.&quot;,&quot;maxLength&quot;:100,&quot;pattern&quot;:&quot;^z[1-9A-HJ-NP-Za-km-z]{20,100}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;config&quot;:{&quot;description&quot;:&quot;The embed config (https://beatscript.app/embed-config.schema.json): kind, source, audio, features, capabilities, theme, compact, width, height, title, site, bridge, pin. Defaults by kind.&quot;,&quot;type&quot;:&quot;object&quot;},&quot;example&quot;:{&quot;description&quot;:&quot;Name of an example, from list_examples.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;store&quot;:{&quot;description&quot;:&quot;Target artifact, kind player or audio: store the text first (signed in), as the artifact tool does.&quot;,&quot;type&quot;:&quot;boolean&quot;},&quot;target&quot;:{&quot;description&quot;:&quot;Where it goes. artifact (the default) gives a whole page.&quot;,&quot;enum&quot;:[&quot;artifact&quot;,&quot;web&quot;,&quot;iframe&quot;,&quot;oembed&quot;,&quot;preview&quot;,&quot;markdown&quot;,&quot;jupyter&quot;,&quot;vscode&quot;,&quot;obsidian&quot;,&quot;audio&quot;,&quot;rss&quot;,&quot;android&quot;,&quot;json&quot;],&quot;type&quot;:&quot;string&quot;},&quot;text&quot;:{&quot;description&quot;:&quot;The program text, instead of the config&apos;s source. It must pass check.&quot;,&quot;maxLength&quot;:16384,&quot;type&quot;:&quot;string&quot;},&quot;title&quot;:{&quot;description&quot;:&quot;The name to show and publish under (default the program&apos;s `#! name:`).&quot;,&quot;maxLength&quot;:80,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>embed</ns:toolName>
		<ns:toolParameter>cid</ns:toolParameter>
		<ns:toolParameter>config</ns:toolParameter>
		<ns:toolParameter>example</ns:toolParameter>
		<ns:toolParameter>store</ns:toolParameter>
		<ns:toolParameter>target</ns:toolParameter>
		<ns:toolParameter>text</ns:toolParameter>
		<ns:toolParameter>title</ns:toolParameter>
		<ns:toolTitle xml:lang="en">A program embedded anywhere</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-eval">
		<skos:definition xml:lang="en">Send a program to a browser tab that has https://beatscript.app open, as if the user pressed Cmd+Enter in the editor: the text replaces the editor&apos;s and the change lands on the next bar, with no gap; play:true starts playback too. Needs a bearer token.

A tab must be connected. It is the page&apos;s own connection, so ask the user to open https://beatscript.app in a browser (signed in as the same account as the token, and eval reaches every live tab of that account), or, for a tab that is not signed in, to press MCP in the page&apos;s top bar and give you the session id it shows, which you pass as session. With no tab connected the answer is a no_session error that says this.

Run check first. eval checks too and refuses a program with errors (nothing is sent; the diagnostics come back), and one that uses samples or &quot;use restricted&quot; (the browser has no such files). The program is the user&apos;s to hear: do not eval over something they are playing without saying so. After eval call get to see what is playing, the section and bar, and any diagnostics the page itself reports. The text is formatted on the way in, as fmt does (header lines and comments kept), so the editor shows it tidy. Text is at most 16384 bytes.

Lexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules&apos; pronunciation. Only the word, its phonemes and the program&apos;s CID are kept, never the text. The answer&apos;s lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/.</skos:definition>
		<skos:prefLabel xml:lang="en">eval</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;device&quot;:{&quot;description&quot;:&quot;Id of one of your paired phones (djrust on Android), from the devices tool. Targets that phone alone; do not combine with session.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9_-]{6,64}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;play&quot;:{&quot;description&quot;:&quot;Start playing too (default false: load it and leave it stopped, or leave a playing tab as it is).&quot;,&quot;type&quot;:&quot;boolean&quot;},&quot;session&quot;:{&quot;description&quot;:&quot;Session id of one browser tab, from the MCP panel of the page. Leave out to use your own signed-in tabs (every live one for eval/load/stop, the latest for get).&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9_-]{6,64}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;text&quot;:{&quot;description&quot;:&quot;The program text. It must pass check.&quot;,&quot;maxLength&quot;:16384,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;text&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:readOnly>
		<ns:requiredParameter>text</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>eval</ns:toolName>
		<ns:toolParameter>device</ns:toolParameter>
		<ns:toolParameter>play</ns:toolParameter>
		<ns:toolParameter>session</ns:toolParameter>
		<ns:toolTitle xml:lang="en">Play a program in a browser tab</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-expand">
		<skos:definition xml:lang="en">Write out every seed(...) and template(...) of a BeatScript program as the plain BeatScript it stands for, to start from a generated track and edit it. seed(genre, n[, structure]) is a track of the beats generator (genres: ambient blues bossa country dnb dubstep edm funk garage house jazz lofi metal reggae speedcore synthwave techno trance trap; structures: standard, loop, minimal, extended), and it is a value, never audio: `arrange from seed(techno, 42)` is the whole track, `section intro from seed(techno, 42)[1..8]` its first eight bars as a section, and `bass seed(techno, 42).bass[17..24]` (or `let riff = seed(techno, 42).bass[17..24]`) one part&apos;s bars as a pattern. template(name, phrase) compiles a phrase, a phrasebook id (@tempest_such_stuff) or any words in quotes, to a whole track, `arrange from template(deep-house, @tempest_such_stuff)` (templates: deep-house): the phrase is the vocal line, its syllables the line&apos;s length, its stress the accents and the beats, its meter the subdivision, and the arrangement is the template&apos;s own. A gen@N call (gen@2 techno seed=42 section=drop part=bass: the seeded generator, the program generate prints, pinned by its CID) is written out by where it stands: `arrange from gen@2 ...` as the whole program (under a `# from: gen@2 ... -&gt; &lt;cid&gt;` line), a part line or `section X from gen@2 ... section=drop` as that section&apos;s parts, `let bed = gen@2 ... section=drop part=bass` as a let a bar (bed_1, bed_2, ..., bed = &lt;bed_1 bed_2 ...&gt;). check, eval and share take the references as they are and play the same music (the CID is of the short text); expand gives the long text, with a `# from seed(...)` or `# from template(...)` line over each place it wrote, to edit from there. Answers {ok, text, canonical, cid, from_cid, refs, diagnostics}: cid is the written-out program&apos;s, from_cid the one you gave; with lineage true the text opens with `#! forked-from: &lt;from_cid&gt;`. With eject &quot;line:col&quot; it writes out only the reference there, in place, under its `# from: &lt;call&gt; -&gt; &lt;cid&gt;` line (a comment: the ejected text has the CID of the same notes typed by hand), and answers {ok, text, cid, ejected: {call, kind, half, place, name, resolved, from}}. Read-only, no sign-in.</skos:definition>
		<skos:prefLabel xml:lang="en">expand</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;eject&quot;:{&quot;description&quot;:&quot;Optional: \&quot;line:col\&quot; (1-based) of one reference (a gen@N call, a seed(...), a &lt;cid&gt;.drop, a template(...)): eject it, writing just that one out in place under its `# from: &lt;call&gt; -&gt; &lt;cid&gt;` line, the rest left as they are.&quot;,&quot;maxLength&quot;:16,&quot;pattern&quot;:&quot;^[0-9]+:[0-9]+$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;lineage&quot;:{&quot;description&quot;:&quot;Open the written-out text with `#! forked-from: &lt;CID of the program as given&gt;` (default false), so that once it is shared it says what it came from.&quot;,&quot;type&quot;:&quot;boolean&quot;},&quot;text&quot;:{&quot;description&quot;:&quot;The program text, with gen@N calls, seed(...) or template(...) references in it.&quot;,&quot;maxLength&quot;:16384,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;text&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:requiredParameter>text</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>expand</ns:toolName>
		<ns:toolParameter>eject</ns:toolParameter>
		<ns:toolParameter>lineage</ns:toolParameter>
		<ns:toolTitle xml:lang="en">Write out a program&apos;s seeds and templates</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-fmt">
		<skos:definition xml:lang="en">Format a BeatScript program as the editor&apos;s fmt button does, in BeatScript 2: one statement a line, one space between tokens, blocks indented two spaces, numbers, notes and chords spelled one way, and the version line `#! beatscript 2` first; the other `#!` header lines, the comments and the blank lines between blocks stay where they are. A BeatScript 1 text (`#! btw 1`, or no version line) is upgraded: the same program under a new CID, and from_cid is the CID of the text as given (the old CID keeps working). Answers text (the formatted program), canonical (the same with no comments and no header lines but the version line: the CID is of that), cid, version (2), from_cid (only when it upgraded) and comments. A BeatScript 2 text formats to its own CID, so use fmt to tidy a program, to upgrade one, or to compare two; eval, load, queue, share and push_private already format what they are given and never upgrade it. A program that does not parse answers the same diagnostics as check. Read-only, no sign-in.</skos:definition>
		<skos:prefLabel xml:lang="en">fmt</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;text&quot;:{&quot;description&quot;:&quot;The program text.&quot;,&quot;maxLength&quot;:16384,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;text&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:requiredParameter>text</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>fmt</ns:toolName>
		<ns:toolTitle xml:lang="en">Format a BeatScript program</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-generate">
		<skos:definition xml:lang="en">Generate a whole BeatScript track from a seed, with no model and no sign-in: the beats generator picks the genre&apos;s rhythms (Euclidean), chord progression, instruments and song structure from the seed, and the result is printed as readable source (named lets, a def for the shared groove, sections, an arrange, filter ramps, the chords as Roman numerals and e()/arp()/markov()/every/rotate/degrade with their seeds written out, so one `key` line moves the whole song) for you to edit. Same genre, bpm, key, length and seed: the same text and CID, every time; the seed and generator are in the #! header so the track can be re-derived. The program passes check and is stored as public CC0 (source generate). Answers text, cid, name, seed, generator, url and render_url; play it with eval or load, or edit it and check again.

The answer also has gen, the call that is this program in BeatScript (gen@2 techno seed=42, with the bpm=, key= and length= you gave: `arrange from gen@2 techno seed=42` plays it), expanded_cid (the same as cid: a generated program has no references), and parts, so you can pick parts without reading the text: one entry a role, {role, section, sections, voice or kit, text, let, gen}, where gen is the call that is just that part (gen@2 techno seed=42 section=drop part=bass) and let is what `let drop_bass = &lt;gen&gt;` writes (a let a bar). Put a part&apos;s gen in a let or on a part line of your own program to layer it, mutate it in an arrange or cross it with another seed; there it is fitted to your program&apos;s key and tempo unless it says key= and bpm=, and check reports it in refs. With part (a role) the answer gains that part and its let alone; generator picks the version (1, 2 or 3, as gen@1, gen@2 and gen@3 name them; 3 writes BeatScript 2); seeds (a list, or {count, start}, at most 16) answers a compact summary a seed instead of one program.

Lexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules&apos; pronunciation. Only the word, its phonemes and the program&apos;s CID are kept, never the text. The answer&apos;s lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/.</skos:definition>
		<skos:prefLabel xml:lang="en">generate</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;bpm&quot;:{&quot;description&quot;:&quot;Tempo; default the genre&apos;s.&quot;,&quot;maximum&quot;:300,&quot;minimum&quot;:40,&quot;type&quot;:&quot;number&quot;},&quot;generator&quot;:{&quot;description&quot;:&quot;The version of the seeded generator, as gen@N names it in a program: 1 (seeded@1, frozen), 2 (seeded@2, the chords and arps as Roman numerals) or 3 (seeded@3: seeded@2&apos;s music written in BeatScript 2, `#! beatscript 2` first); default 3. A version always prints the same program for the same inputs.&quot;,&quot;enum&quot;:[1,2,3],&quot;type&quot;:&quot;integer&quot;},&quot;genre&quot;:{&quot;description&quot;:&quot;The genre whose rhythms, chords, instruments and song structure it uses (default techno).&quot;,&quot;enum&quot;:[&quot;techno&quot;,&quot;house&quot;,&quot;jazz&quot;,&quot;ambient&quot;,&quot;dnb&quot;,&quot;edm&quot;,&quot;speedcore&quot;,&quot;dubstep&quot;,&quot;country&quot;,&quot;blues&quot;,&quot;synthwave&quot;,&quot;trance&quot;,&quot;lofi&quot;,&quot;reggae&quot;,&quot;funk&quot;,&quot;bossa&quot;,&quot;trap&quot;,&quot;garage&quot;,&quot;metal&quot;,&quot;electro&quot;,&quot;deephouse&quot;,&quot;italo&quot;,&quot;acid&quot;],&quot;type&quot;:&quot;string&quot;},&quot;key&quot;:{&quot;description&quot;:&quot;Key: am, c, f#m, d:dorian ...; default the genre&apos;s.&quot;,&quot;maxLength&quot;:16,&quot;type&quot;:&quot;string&quot;},&quot;length&quot;:{&quot;description&quot;:&quot;Song length (default standard).&quot;,&quot;enum&quot;:[&quot;short&quot;,&quot;standard&quot;,&quot;long&quot;],&quot;type&quot;:&quot;string&quot;},&quot;part&quot;:{&quot;description&quot;:&quot;One part (a role): the answer gains part (that role&apos;s entry of parts) and let, the let its gen call writes (let drop_bass_1 = ... let drop_bass = &lt;drop_bass_1 ...&gt;), to paste into a program of your own.&quot;,&quot;enum&quot;:[&quot;kick&quot;,&quot;snare&quot;,&quot;hihat&quot;,&quot;clap&quot;,&quot;bass&quot;,&quot;melody&quot;,&quot;harmony&quot;,&quot;arp&quot;],&quot;type&quot;:&quot;string&quot;},&quot;section&quot;:{&quot;description&quot;:&quot;With part: the section the part is taken from (default the drop or chorus when it plays there, else the first section it plays in).&quot;,&quot;maxLength&quot;:32,&quot;type&quot;:&quot;string&quot;},&quot;seed&quot;:{&quot;description&quot;:&quot;A number or a word (default 1). Same inputs, same program text and CID.&quot;,&quot;type&quot;:[&quot;string&quot;,&quot;integer&quot;]},&quot;seeds&quot;:{&quot;anyOf&quot;:[{&quot;items&quot;:{&quot;type&quot;:[&quot;string&quot;,&quot;integer&quot;]},&quot;maxItems&quot;:16,&quot;minItems&quot;:1,&quot;type&quot;:&quot;array&quot;},{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;count&quot;:{&quot;maximum&quot;:16,&quot;minimum&quot;:1,&quot;type&quot;:&quot;integer&quot;},&quot;start&quot;:{&quot;minimum&quot;:0,&quot;type&quot;:&quot;integer&quot;}},&quot;required&quot;:[&quot;count&quot;],&quot;type&quot;:&quot;object&quot;}],&quot;description&quot;:&quot;Instead of seed: many seeds, as a list ([1, 2, \&quot;sunrise\&quot;]) or as {count, start} (count seeds from start, default 1), at most 16. The answer is programs, one compact summary a seed in order: seed, generator, cid, name, key, tempo, bars, gen, parts (role, section, sections, voice or kit, text, gen) and url and render_url; each program is stored as one generate stores it, and nothing else is. The same seeds give the same summaries.&quot;}},&quot;required&quot;:[],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>generate</ns:toolName>
		<ns:toolParameter>bpm</ns:toolParameter>
		<ns:toolParameter>generator</ns:toolParameter>
		<ns:toolParameter>genre</ns:toolParameter>
		<ns:toolParameter>key</ns:toolParameter>
		<ns:toolParameter>length</ns:toolParameter>
		<ns:toolParameter>part</ns:toolParameter>
		<ns:toolParameter>section</ns:toolParameter>
		<ns:toolParameter>seed</ns:toolParameter>
		<ns:toolParameter>seeds</ns:toolParameter>
		<ns:toolTitle xml:lang="en">Generate a track from a seed (no model)</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-genre-template">
		<skos:definition xml:lang="en">A starting BeatScript program for a genre, built from the BeatScript ontology&apos;s data for it (https://beatscript.app/ontology/, CC0, forked from the bitwrap ontology): its tempo, key (root and scale), swing, drum kit and Euclidean kick, snare and hihat rhythms, its bass, arp and melody voices, its first chord progression (the chords, bass, arp and melody are Roman numerals, so a `key` line moves them all), and its family&apos;s standard song structure, each section with the roles the family&apos;s section profile makes active and its usual length. Returns {text, cid, canonical, seconds, genre{genre, label, family, tempo, tempo_range, scale, kit, voices, progressions, sections}} (and phrase, warnings with a phrase). The text passes check (it is checked before it is returned) and carries a `#! genre:` line, so check reports its style against the genre. Edit it, check it, then play or share it. For vocals, pass phrase (a phrasebook id from list_examples with phrasebook true, or any words): it is sung on the melody part of each section that has one, and the answer gains phrase with its source, year, meter, stress, syllables and phoneme escapes and whether its meter fits the genre (https://beatscript.app/docs/found-phrases.md). For a classical form, pass form (quodlibet, passacaglia, canon, rondo, fugue or theme-and-variations): the program is that form&apos;s template at the genre&apos;s tempo, built from public-domain themes, with the phrase (or the form&apos;s own) sung in it, and the answer gains form (its sections, mutation plan, themes and reference track) and expanded (the program written out to edit). To borrow one theme instead, pass theme (an id from list_examples with themes true): its lets go in, moved to the genre&apos;s key, played by the part of its role. See https://beatscript.app/docs/forms.md. For a whole track made from a phrase, write `arrange from template(deep-house, &quot;your words&quot;)` (see expand). Read-only, no sign-in. The answer also has expanded_cid (the CID of the program written out: the same as cid for a program with no references) and, for a program with references (a form&apos;s template(...)), refs and resolution, as check gives them. A form takes its sources as roles (docs/beatscript/ext-roles.md): with form and roles, each role is bound to a source (a seed of the seeded generator, a public-domain theme, notes, a stored program&apos;s part or section, another form), and the forms include cross (a quodlibet of two sources, roles a and b): two seeds that lead in turn, overlap, and morph toward each other and back.

Lexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules&apos; pronunciation. Only the word, its phonemes and the program&apos;s CID are kept, never the text. The answer&apos;s lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/.</skos:definition>
		<skos:prefLabel xml:lang="en">genre_template</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;form&quot;:{&quot;description&quot;:&quot;Optional (docs/beatscript/forms.md): a classical form, one of quodlibet, passacaglia, canon, rondo, fugue, theme-and-variations, or cross (a quodlibet of two sources, roles a and b). The program is then that form&apos;s template at the genre&apos;s tempo, arrange from template(&lt;form&gt;, &lt;phrase&gt;), and the answer gains form (shape, mutation plan, themes, reference track) and expanded (the program written out as plain BeatScript). Not with theme.&quot;,&quot;maxLength&quot;:64,&quot;type&quot;:&quot;string&quot;},&quot;genre&quot;:{&quot;description&quot;:&quot;A genre of the BeatScript ontology: its name (techno, house, jazz, dnb, ...), genre:&lt;name&gt;, or its https://beatscript.app/ontology/genre/ IRI.&quot;,&quot;maxLength&quot;:200,&quot;type&quot;:&quot;string&quot;},&quot;phrase&quot;:{&quot;description&quot;:&quot;Optional, for vocals (found phrases, see docs/beatscript/found-phrases.md): a phrasebook id (tyger_burning_bright, from list_examples with phrasebook true) or any words. It is sung on the melody part of each section that has one, and the answer gains phrase: its source, year, meter, stress, syllables and phoneme escapes, and whether its meter fits the genre.&quot;,&quot;maxLength&quot;:400,&quot;type&quot;:&quot;string&quot;},&quot;roles&quot;:{&quot;additionalProperties&quot;:{&quot;maxLength&quot;:400,&quot;type&quot;:&quot;string&quot;},&quot;description&quot;:&quot;Optional, with form (docs/beatscript/ext-roles.md): the form&apos;s roles, each bound to a source, {\&quot;ROLE\&quot;: \&quot;SOURCE\&quot;}: a seed of the seeded generator (gen@1 dubstep seed=54876, gen@2 techno seed=42 section=drop part=bass), a public-domain theme id (ode_to_joy), notes in brackets, a stored program&apos;s part or section by CID, or another form (template(passacaglia, ground=gen@1 dubstep seed=54876)). cross takes a and b; passacaglia ground and upper; canon subject and ground; rondo refrain and episodes; fugue subject and counter; theme-and-variations theme. A seed is fitted to the form&apos;s key and tempo and stays an engine call, pinned (see resolution).&quot;,&quot;type&quot;:&quot;object&quot;},&quot;theme&quot;:{&quot;description&quot;:&quot;Optional (docs/beatscript/forms.md): a theme of the public-domain theme library (ode_to_joy, pachelbel_ground, from list_examples with themes true). Its lets go into the program, moved to the genre&apos;s key, and the part of its role plays it in every section that has one; the answer gains theme. Not with form.&quot;,&quot;maxLength&quot;:64,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;genre&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:requiredParameter>genre</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>genre_template</ns:toolName>
		<ns:toolParameter>form</ns:toolParameter>
		<ns:toolParameter>phrase</ns:toolParameter>
		<ns:toolParameter>roles</ns:toolParameter>
		<ns:toolParameter>theme</ns:toolParameter>
		<ns:toolTitle xml:lang="en">A starting program for a genre</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-get">
		<skos:definition xml:lang="en">What a browser tab at https://beatscript.app is doing now, as the page last reported it: the program text and cid, playing (true/false), source (engine or stream), section (name), section_num of sections_total, bar, bars_in_section, phase (0-7, the light in the phrase), marks (what is firing: active lines, token flashes, ramps and timed lines, with line:col spans into the text), diagnostics (the page&apos;s own check of the text), ts, mixer (what the listener hears: crossfader, master, and per deck its level, mute, EQ kills, filter, insert filter and vocoder; null from a page or phone too old to report it) and warnings (a playing deck that cannot be heard, and why: &quot;deck B inaudible: the crossfader is all the way to A&quot;). Use it after eval or load to confirm the change landed, and to see the program a user is playing and editing.

Needs a bearer token: it reads the tabs of the token&apos;s account, by default the most recently seen one. A tab that is not signed in is read by its session id (the page&apos;s MCP panel shows it), with your token. Read-only. No tab connected: a no_session error that says how to connect one.</skos:definition>
		<skos:prefLabel xml:lang="en">get</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;device&quot;:{&quot;description&quot;:&quot;Id of one of your paired phones (djrust on Android), from the devices tool. Targets that phone alone; do not combine with session.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9_-]{6,64}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;session&quot;:{&quot;description&quot;:&quot;Session id of one browser tab, from the MCP panel of the page. Leave out to use your own signed-in tabs (every live one for eval/load/stop, the latest for get).&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9_-]{6,64}$&quot;,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>get</ns:toolName>
		<ns:toolParameter>device</ns:toolParameter>
		<ns:toolParameter>session</ns:toolParameter>
		<ns:toolTitle xml:lang="en">What a browser tab is playing</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-instruments">
		<skos:definition xml:lang="en">The sounds a program may name: voices (inst=NAME), families (a name that contains one plays that family&apos;s generic voice and check warns about it), drum kits (kit=NAME) and palettes. Use only names from this answer: an unknown inst= is a check error with the nearest names. Read-only, no sign-in, cached for five minutes.</skos:definition>
		<skos:prefLabel xml:lang="en">instruments</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{},&quot;required&quot;:[],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>instruments</ns:toolName>
		<ns:toolTitle xml:lang="en">Voices, kits and palettes</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-lineage">
		<skos:definition xml:lang="en">A stored program&apos;s family tree, from the rights each program keeps (forked_from): its ancestors (nearest first), its siblings (the parent&apos;s other forks) and every generation of its forks, each edge labelled with what changed in music from parent to fork (the same diff summary lines check&apos;s same_as gives: &quot;tempo 124 -&gt; 126&quot;, &quot;drop2 bass = drop bass transposed +1&quot;; sameSong true when the fork only rewrote the text). Returns the JSON-LD document https://beatscript.app/p/&lt;CID&gt;/tree.jsonld serves: program, forkCount, descendantCount, ancestors, siblings and forks as CIDs, programs (name, licence, tempo, key, credits, url, forkCount of each), derivations (from, to, sameSong, change, and a compare URL, https://beatscript.app/p/&lt;A&gt;/compare/&lt;B&gt;). Only public programs appear: a private one is never listed, and a chain that passes through one stops there (ancestorsCut). A person can browse the same tree at https://beatscript.app/p/&lt;CID&gt;/tree.</skos:definition>
		<skos:prefLabel xml:lang="en">lineage</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;cid&quot;:{&quot;description&quot;:&quot;The program: its CID, or a short https://beatscript.app/p/&lt;CID&gt; link. It must be stored here (or be an example) and public.&quot;,&quot;maxLength&quot;:200,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;cid&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:requiredParameter>cid</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>lineage</ns:toolName>
		<ns:toolTitle xml:lang="en">A program&apos;s family tree</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-list-examples">
		<skos:definition xml:lang="en">The public example programs of https://beatscript.app, all CC0-1.0: name, title, description, cid, bpm, bars, license and the url of the raw .beatscript. Pass name to get that program&apos;s full text as well. Read two or three before writing a program of your own: after the cheat-sheet (https://beatscript.app/docs/cheatsheet.md) they are the best guide to the language, from a four-line beat (first-beat) to whole tracks with sections, defs, ramps and evolve. With phrasebook true (or a meter, or syllables) it also returns the public-domain phrasebook: lines first published before 1929, each with its text, source, year, meter, stress pattern, syllables and phoneme escapes, to sing by id (sing @tempest_such_stuff on melody); choose one for its meter, see https://beatscript.app/docs/found-phrases.md. With themes true (or a key, a role or a composer) it also returns the public-domain theme library: melodies, basses and figures composed and published before 1929, each as BeatScript bars in a stated key with the let lines and the part that play it, its work, composer, year and the themes it morphs well with; borrow one as found material or build a form from it, see https://beatscript.app/docs/forms.md. Read-only, no sign-in.</skos:definition>
		<skos:prefLabel xml:lang="en">list_examples</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;composer&quot;:{&quot;description&quot;:&quot;Only the themes by this composer (any part of the name: beethoven). Implies themes.&quot;,&quot;maxLength&quot;:64,&quot;type&quot;:&quot;string&quot;},&quot;key&quot;:{&quot;description&quot;:&quot;Only the themes in this key, matched on its tonic: a key word (d, bm, db). Implies themes.&quot;,&quot;maxLength&quot;:16,&quot;type&quot;:&quot;string&quot;},&quot;lexicon&quot;:{&quot;description&quot;:&quot;Also return the lexicon harvest (default false): the words the checking tools collected from programs&apos; lyrics, ranked for the CC0 lexicon, at most 50: those with an annotated escape (word=/phonemes/) first, then by how many programs gave them. Each is {word, programs, conflict, in_lexicon, variants[{phones, source (annotated or rule), count, first, last, cids}]}; conflict: two annotated pronunciations disagree. Read-only.&quot;,&quot;type&quot;:&quot;boolean&quot;},&quot;meter&quot;:{&quot;description&quot;:&quot;Only the phrasebook lines of this meter: a family (iambic, trochaic, anapestic, dactylic, common-meter, sprung, nursery, parallelism, oratory, call-and-response) or a word of a meter&apos;s name (pentameter). Implies phrasebook.&quot;,&quot;maxLength&quot;:64,&quot;type&quot;:&quot;string&quot;},&quot;name&quot;:{&quot;description&quot;:&quot;Optional: also return this example&apos;s full text.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;phrasebook&quot;:{&quot;description&quot;:&quot;Also return the public-domain phrasebook: lines first published before 1929, each with its text, source, year, meter, stress pattern, syllables and phoneme escapes (default false).&quot;,&quot;type&quot;:&quot;boolean&quot;},&quot;role&quot;:{&quot;description&quot;:&quot;Only the themes of this role: melody, bass, harmony or arp. Implies themes.&quot;,&quot;maxLength&quot;:16,&quot;type&quot;:&quot;string&quot;},&quot;syllables&quot;:{&quot;description&quot;:&quot;Only the phrasebook lines with this many syllables: a number (8) or a range (8-12). Implies phrasebook.&quot;,&quot;maxLength&quot;:16,&quot;type&quot;:&quot;string&quot;},&quot;themes&quot;:{&quot;description&quot;:&quot;Also return the public-domain theme library: melodies, basses and figures composed and published before 1929, each as BeatScript bars in a stated key (let-ready), with its role, meter, work, composer, year and pairings (default false).&quot;,&quot;type&quot;:&quot;boolean&quot;}},&quot;required&quot;:[],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>list_examples</ns:toolName>
		<ns:toolParameter>composer</ns:toolParameter>
		<ns:toolParameter>key</ns:toolParameter>
		<ns:toolParameter>lexicon</ns:toolParameter>
		<ns:toolParameter>meter</ns:toolParameter>
		<ns:toolParameter>name</ns:toolParameter>
		<ns:toolParameter>phrasebook</ns:toolParameter>
		<ns:toolParameter>role</ns:toolParameter>
		<ns:toolParameter>syllables</ns:toolParameter>
		<ns:toolParameter>themes</ns:toolParameter>
		<ns:toolTitle xml:lang="en">The example programs</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-listen">
		<skos:definition xml:lang="en">Listen to a BeatScript program without audio: it is rendered offline through the same engine as render, and you get a small JSON summary to check your work by ear, as numbers. Per deck and per part (a role of a deck&apos;s line: drums, bass, ...): RMS and peak in dBFS and loudness in LUFS. `silent` lists every deck or part that has notes in the window but is not heard (under -60 LUFS), with `reason` when the mixer explains it (master_zero, mute, level_0, crossfader, filter_closed, eq_killed; voice_missing when the mixer lets a part through and its voice made nothing; no_sound otherwise) and `why` in words. `detected` gives the tempo and key heard against the declared ones (bpm_match same|half|double|two_thirds|three_halves|differs; key_match same|relative|differs|unsure|undeclared). `sections` gives each section&apos;s loudness, `bar_lufs` a loudness per bar, and master.clipped_samples counts samples over full scale. `warnings` is the short list to act on. A part that came from a reference (a gen@2 call, a seed(...), a template, a stored program&apos;s section) says so in `from` {call, kind, resolved, place, generator, sections} (`also_from` when several made it); a gen call fitted to the program&apos;s key or tempo says so in `notes`, in check&apos;s words; and the answer gains `expanded_cid` and `resolution`, as check&apos;s. Give exactly one of text, cid, example; optionally `section` (listen to that section only) and `bars` (at most this many bars of the window). Nothing is stored and no sign-in is needed. At most 30 new listens an hour per caller; the same program, section and bars again is answered from the cache. Programs are at most 16384 bytes; the render covers at most 96 bars from the start. Like render, the offline engine plays the notes, the mixer and insert moves it has ops for and the `macro` lines (the DJ macro catalogue: see the macros tool); `notes` names the control lines it leaves out. A program with a macro line gains `macros`: each call in the window, `at_bar` (the bar the engine starts it on, as the time words count), and `played`, with `refused` (the engine&apos;s reason, also a warning) when it was not.

Lexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules&apos; pronunciation. Only the word, its phonemes and the program&apos;s CID are kept, never the text. The answer&apos;s lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/.</skos:definition>
		<skos:prefLabel xml:lang="en">listen</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;bars&quot;:{&quot;description&quot;:&quot;At most this many bars of the window, from its start.&quot;,&quot;maximum&quot;:96,&quot;minimum&quot;:1,&quot;type&quot;:&quot;integer&quot;},&quot;cid&quot;:{&quot;description&quot;:&quot;CID of a stored program or an example.&quot;,&quot;maxLength&quot;:100,&quot;pattern&quot;:&quot;^z[1-9A-HJ-NP-Za-km-z]{20,100}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;example&quot;:{&quot;description&quot;:&quot;Name of an example, from list_examples.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;section&quot;:{&quot;description&quot;:&quot;Listen to this section only (its name in the program).&quot;,&quot;maxLength&quot;:64,&quot;type&quot;:&quot;string&quot;},&quot;text&quot;:{&quot;description&quot;:&quot;The program text. It must pass check. Not stored.&quot;,&quot;maxLength&quot;:16384,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>listen</ns:toolName>
		<ns:toolParameter>bars</ns:toolParameter>
		<ns:toolParameter>cid</ns:toolParameter>
		<ns:toolParameter>example</ns:toolParameter>
		<ns:toolParameter>section</ns:toolParameter>
		<ns:toolParameter>text</ns:toolParameter>
		<ns:toolTitle xml:lang="en">Listen to a program (a summary, no audio)</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-load">
		<skos:definition xml:lang="en">Put a stored or example program into a browser tab (the same tabs and rules as eval: a tab open at https://beatscript.app, signed in as the token&apos;s account, or its session id from the page&apos;s MCP panel). Give exactly one of: cid (a program the site stored, or an example&apos;s CID; render and a signed-in share store theirs), example (a name from list_examples), url (a share link https://beatscript.app/#CID.packed or a /c/ link; one made on an older host opens too; the link is verified, and one whose CID is not its text&apos;s is refused with cid_mismatch). play:true starts it. The program is formatted on the way in, as eval&apos;s text is. Needs a bearer token. Call get afterwards to see what is playing.

Lexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules&apos; pronunciation. Only the word, its phonemes and the program&apos;s CID are kept, never the text. The answer&apos;s lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/.</skos:definition>
		<skos:prefLabel xml:lang="en">load</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;cid&quot;:{&quot;description&quot;:&quot;CID of a program the site has stored (render and a signed-in share store theirs) or of an example.&quot;,&quot;maxLength&quot;:100,&quot;pattern&quot;:&quot;^z[1-9A-HJ-NP-Za-km-z]{20,100}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;device&quot;:{&quot;description&quot;:&quot;Id of one of your paired phones (djrust on Android), from the devices tool. Targets that phone alone; do not combine with session.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9_-]{6,64}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;example&quot;:{&quot;description&quot;:&quot;Name of an example, from list_examples.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;play&quot;:{&quot;description&quot;:&quot;Start playing too (default false: load it and leave it stopped, or leave a playing tab as it is).&quot;,&quot;type&quot;:&quot;boolean&quot;},&quot;session&quot;:{&quot;description&quot;:&quot;Session id of one browser tab, from the MCP panel of the page. Leave out to use your own signed-in tabs (every live one for eval/load/stop, the latest for get).&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9_-]{6,64}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;url&quot;:{&quot;description&quot;:&quot;A share link: https://beatscript.app/#&lt;CID&gt;.&lt;packed&gt;, a /c/ link, or a short /p/&lt;CID&gt; link (one made on an older host opens too) (the program must be stored here).&quot;,&quot;maxLength&quot;:32768,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>load</ns:toolName>
		<ns:toolParameter>cid</ns:toolParameter>
		<ns:toolParameter>device</ns:toolParameter>
		<ns:toolParameter>example</ns:toolParameter>
		<ns:toolParameter>play</ns:toolParameter>
		<ns:toolParameter>session</ns:toolParameter>
		<ns:toolParameter>url</ns:toolParameter>
		<ns:toolTitle xml:lang="en">Load a stored program into a browser tab</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-macros">
		<skos:definition xml:lang="en">The DJ macro catalogue a program&apos;s `macro` line names (docs/beatscript/ext-control.md): `macro riser on A over 8 bars` (or on the control deck, `control: macro cathedral on B over 2 bars`) fires one entry on the deck&apos;s bar line, the same thing the desktop&apos;s Effects window and the booth fire. Returns the macro@1 table, or version&apos;s: for each entry its id, label, category, family (trick, net, master, aux), transition (a one-shot), length (bars: runs `over N bars`, 1 to 64; sweep: the riser rises over them; held: held that long, then let go; own: takes no `over`), default_bars (when the line says no `over`) and needs_net (works a net deck&apos;s parts). A bare `macro` is macro@1 for good and its table never changes; a later catalogue is macro@2. listen and render play a macro line; a browser tab does not (not played here). Read-only, no sign-in.</skos:definition>
		<skos:prefLabel xml:lang="en">macros</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;version&quot;:{&quot;description&quot;:&quot;Optional: which table, macro@N (default 1: what a bare `macro` is).&quot;,&quot;minimum&quot;:1,&quot;type&quot;:&quot;integer&quot;}},&quot;required&quot;:[],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>macros</ns:toolName>
		<ns:toolParameter>version</ns:toolParameter>
		<ns:toolTitle xml:lang="en">The DJ macro catalogue a macro line names</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-open">
		<skos:definition xml:lang="en">Decode a BeatScript share link and return its canonical text, its text (the program formatted, with the `#!` header lines and comments the link carried: what to edit), its CID and whether the CID verifies against the text. Takes either form: a self-sealing link (https://beatscript.app/#&lt;CID&gt;.&lt;packed&gt;, a /c/&lt;CID&gt;.&lt;packed&gt; link, a bare #fragment or &lt;CID&gt;.&lt;packed&gt;) or a CID-only link (https://beatscript.app/p/&lt;CID&gt;, /c/&lt;CID&gt;, #&lt;CID&gt;, or a bare CID; the same forms on an older host open too), which is resolved from the programs the site has stored (shared signed in, or rendered) and the examples, and answers its rights in meta. Either way the text is recompiled and its CID recomputed: a program whose CID is not its text&apos;s is refused with cid_mismatch, and an unknown CID answers not_found. Do not trust or play a refused text. Comments and header lines carried in a link are not covered by the CID (a beats link&apos;s notes are unverified). Read-only, no sign-in.</skos:definition>
		<skos:prefLabel xml:lang="en">open</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;url&quot;:{&quot;description&quot;:&quot;A share link (self-sealing #&lt;CID&gt;.&lt;packed&gt;, or a short &lt;site&gt;/p/&lt;CID&gt; or /c/&lt;CID&gt; link), a #fragment, &lt;CID&gt;.&lt;packed&gt;, or a bare CID.&quot;,&quot;maxLength&quot;:32768,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;url&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:requiredParameter>url</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>open</ns:toolName>
		<ns:toolTitle xml:lang="en">Open a share link</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-push-private">
		<skos:definition xml:lang="en">Send a private program to one of your paired phones, end-to-end encrypted, and never stored. Use it for what https://beatscript.app does not keep: covers, programs with local samples (`sample ... from`), `use restricted`, anything not under a Creative Commons licence. The program is sealed for the phone&apos;s own key (X25519 from its pairing key, ChaCha20-Poly1305) and handed to the phone&apos;s live connection in memory: it is not written to disk, a database or a log (only its size and the device id are logged), no CID is registered, and if the phone is not connected nothing is sent and nothing is kept (push again when it is). The phone opens it, checks it and plays it itself; samples resolve against files in the phone&apos;s own sample library, and any that are missing are reported back in get&apos;s diagnostics, never fetched. Give device and exactly one of text (sealed here, so the text is in this server&apos;s memory for this call, where it is formatted first, as eval&apos;s is) or sealed (an envelope you sealed yourself for the phone&apos;s seal_key from devices: then this server only ever sees ciphertext). Needs a bearer token; only your own paired phones.</skos:definition>
		<skos:prefLabel xml:lang="en">push_private</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;device&quot;:{&quot;description&quot;:&quot;Id of one of your paired phones, from the devices tool.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9_-]{6,64}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;load&quot;:{&quot;description&quot;:&quot;Load it on the phone and leave it stopped unless play (default false: play it as eval does).&quot;,&quot;type&quot;:&quot;boolean&quot;},&quot;play&quot;:{&quot;description&quot;:&quot;Start playing too (default false: load it and leave it stopped, or leave a playing tab as it is).&quot;,&quot;type&quot;:&quot;boolean&quot;},&quot;sealed&quot;:{&quot;description&quot;:&quot;An envelope you sealed for the phone&apos;s seal_key (beatscript-seal v1). Give text or sealed.&quot;,&quot;maxLength&quot;:65536,&quot;type&quot;:&quot;string&quot;},&quot;text&quot;:{&quot;description&quot;:&quot;The program text, sealed here for the phone. Give text or sealed.&quot;,&quot;maxLength&quot;:16384,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;device&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:readOnly>
		<ns:requiredParameter>device</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>push_private</ns:toolName>
		<ns:toolParameter>load</ns:toolParameter>
		<ns:toolParameter>play</ns:toolParameter>
		<ns:toolParameter>sealed</ns:toolParameter>
		<ns:toolParameter>text</ns:toolParameter>
		<ns:toolTitle xml:lang="en">Send a private program to your phone</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-queue">
		<skos:definition xml:lang="en">An &quot;up next&quot; queue on one browser tab at https://beatscript.app (the same tabs and rules as load: session, or device, else your most recently seen signed-in tab). When the playing program ends the page plays the next item, on the bar line where it can; a looping program (one that never ends) plays for the item&apos;s bars or minutes, else one full pass of its arrangement, and then advances. Needs a bearer token.

action is one of: list (the queue, now_playing, position, paused_reason, listener), add (items: up to 20 per call, 50 in the queue), remove (item: an item id from list, or a CID), clear, skip (play the next item now).

Items must already be programs: {cid} of a stored program (render and a signed-in share store theirs) or an example&apos;s CID, {example} by name from list_examples, or {url} a share link (verified exactly as load verifies it; a CID-only link must name a stored program). Optional per item: bars (1-1024) or minutes (0.1-120) to play, title. THE QUEUE NEVER COMPOSES OR CALLS A MODEL, and there is no way to make it: to queue new music, write the programs yourself (check them), store each with render or share, then add the CIDs.

The queue advances only while a listener is plausibly present, as the page reports it: it pauses at the next track boundary when the tab&apos;s audio is suspended, when the tab has been hidden with no key, pointer, touch or media key for 30 minutes, or after 8 tracks in a row without any interaction; the page then shows &quot;Still listening? Press play to continue&quot;. Only a person on the page lifts a pause: skip is refused while paused (paused_reason says why), and load still plays one program as it always has but does not resume the queue. Writes are limited to about 30 a minute. The queue lives with the tab&apos;s session and is gone when the tab is.

Lexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules&apos; pronunciation. Only the word, its phonemes and the program&apos;s CID are kept, never the text. The answer&apos;s lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/.</skos:definition>
		<skos:prefLabel xml:lang="en">queue</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;action&quot;:{&quot;description&quot;:&quot;list, add, remove, clear or skip.&quot;,&quot;enum&quot;:[&quot;list&quot;,&quot;add&quot;,&quot;remove&quot;,&quot;clear&quot;,&quot;skip&quot;],&quot;type&quot;:&quot;string&quot;},&quot;device&quot;:{&quot;description&quot;:&quot;Id of one of your paired phones (djrust on Android), from the devices tool. Targets that phone alone; do not combine with session.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9_-]{6,64}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;item&quot;:{&quot;description&quot;:&quot;remove: an item id from list (q1, q2, ...) or a CID (the first queued item with it).&quot;,&quot;maxLength&quot;:100,&quot;type&quot;:&quot;string&quot;},&quot;items&quot;:{&quot;description&quot;:&quot;add: the programs to append, each an object with exactly one of cid, example, url, and optionally bars, minutes, title.&quot;,&quot;items&quot;:{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;bars&quot;:{&quot;description&quot;:&quot;Play this many bars, then advance (else until the program ends; a loop: one arrangement pass).&quot;,&quot;maximum&quot;:1024,&quot;minimum&quot;:1,&quot;type&quot;:&quot;integer&quot;},&quot;cid&quot;:{&quot;description&quot;:&quot;CID of a stored program or an example.&quot;,&quot;maxLength&quot;:100,&quot;pattern&quot;:&quot;^z[1-9A-HJ-NP-Za-km-z]{20,100}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;example&quot;:{&quot;description&quot;:&quot;Name of an example, from list_examples.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;minutes&quot;:{&quot;description&quot;:&quot;Play this long, then advance at the next bar line. Not with bars.&quot;,&quot;maximum&quot;:120,&quot;minimum&quot;:0.1,&quot;type&quot;:&quot;number&quot;},&quot;title&quot;:{&quot;description&quot;:&quot;What the page shows for it (else the program&apos;s name).&quot;,&quot;maxLength&quot;:80,&quot;type&quot;:&quot;string&quot;},&quot;url&quot;:{&quot;description&quot;:&quot;A share link, verified as load verifies it.&quot;,&quot;maxLength&quot;:32768,&quot;type&quot;:&quot;string&quot;}},&quot;type&quot;:&quot;object&quot;},&quot;maxItems&quot;:20,&quot;type&quot;:&quot;array&quot;},&quot;session&quot;:{&quot;description&quot;:&quot;Session id of one browser tab, from the MCP panel of the page. Leave out to use your own signed-in tabs (every live one for eval/load/stop, the latest for get).&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9_-]{6,64}$&quot;,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;action&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:readOnly>
		<ns:requiredParameter>action</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>queue</ns:toolName>
		<ns:toolParameter>device</ns:toolParameter>
		<ns:toolParameter>item</ns:toolParameter>
		<ns:toolParameter>items</ns:toolParameter>
		<ns:toolParameter>session</ns:toolParameter>
		<ns:toolTitle xml:lang="en">Up next: queue programs on a browser tab</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-record">
		<skos:definition xml:lang="en">Set up a demo recording of a program: the page in record mode (full screen code, the firing markers and follow-scroll on) and the steps that turn it into a video. Give exactly one of text, cid or example (as render does: a text or example is checked and stored publicly as CC0-1.0, nothing private). Answers {cid, seconds, record_url, record_url_manual_clock, audio_url, recipe}. record_url opens the page in record mode and plays it for a person to screen-record; record_url_manual_clock opens it on a fake clock that a script steps frame by frame (window.__btw.setTime(seconds); window.__btw.frame()), which is how site/tools/record-demo.mjs in the repo makes a perfectly synced, stutter-free MP4 (H.264, AAC, 1920x1080) plus a silent hero loop (MP4 and WebM) and a poster PNG, taking the audio from audio_url (the offline render of the same program). This tool does not capture video itself: it needs a browser and ffmpeg on your side. The audio is the offline render: notes and sounds, not control lines (filters, reverb). Call check first. Rendering limits apply (about 30 programs an hour per client). No sign-in needed.</skos:definition>
		<skos:prefLabel xml:lang="en">record</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;cid&quot;:{&quot;description&quot;:&quot;CID of a program already stored (for instance the cid render or a signed-in share returned).&quot;,&quot;maxLength&quot;:100,&quot;pattern&quot;:&quot;^z[1-9A-HJ-NP-Za-km-z]{20,100}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;example&quot;:{&quot;description&quot;:&quot;Name of an example, from list_examples.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;text&quot;:{&quot;description&quot;:&quot;The program text. It must pass check; it is stored publicly (CC0-1.0).&quot;,&quot;maxLength&quot;:16384,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>record</ns:toolName>
		<ns:toolParameter>cid</ns:toolParameter>
		<ns:toolParameter>example</ns:toolParameter>
		<ns:toolParameter>text</ns:toolParameter>
		<ns:toolTitle xml:lang="en">Set up a demo recording</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-render">
		<skos:definition xml:lang="en">Make a program streamable as audio. Give exactly one of text (the program), cid (a program already stored, e.g. what an earlier render or a signed-in share returned) or example (a name from list_examples). A text or example is checked, then stored publicly under its CID as CC0-1.0 if it is not stored yet (never submit anything private; programs that use samples or &quot;use restricted&quot; are refused). Answers {cid, stream_url, status_url, seconds, format}: open stream_url to listen (it streams the offline render as it renders; the first sound comes within about a second, so a client can play it at once), download the same URL for a file, and read status_url to see how far a render is. format is opus (Ogg Opus, small) or wav (16-bit stereo, plays chunk by chunk in a web page); default opus. To take the program to a DAW: format midi (a Standard MIDI File: a track per part, drums on channel 10 with General MIDI notes, the tempo map, key and section markers) or stems (a zip of a 32-bit float WAV per part and per deck that add up to the master, plus the master, the .mid and manifest.json with the CID, tempo, key and the stored license and credits; stems-opus: the same with Ogg Opus stems); a stems URL answers 202 while it is being made, ask again until it is the zip.

Call check first. The offline render plays the notes and sounds, not control lines (filters, reverb, do ... lines), so it can sound plainer than the browser; a program with no end (no sections or end line) is cut at the server&apos;s bar limit (256 bars). Rendering is limited per address per hour and to a few at once: on busy or rate_limited wait retry_after seconds. No sign-in needed; about 30 programs an hour per client.

Lexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules&apos; pronunciation. Only the word, its phonemes and the program&apos;s CID are kept, never the text. The answer&apos;s lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/.</skos:definition>
		<skos:prefLabel xml:lang="en">render</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;cid&quot;:{&quot;description&quot;:&quot;CID of a program already stored (for instance the cid render or a signed-in share returned).&quot;,&quot;maxLength&quot;:100,&quot;pattern&quot;:&quot;^z[1-9A-HJ-NP-Za-km-z]{20,100}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;example&quot;:{&quot;description&quot;:&quot;Name of an example, from list_examples.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;format&quot;:{&quot;default&quot;:&quot;opus&quot;,&quot;description&quot;:&quot;opus (Ogg Opus, smaller, for download or &lt;audio&gt;) or wav (16-bit stereo, plays chunk by chunk in a web page) to listen; for a DAW: midi (a Standard MIDI File of the notes, a track per part), stems (a zip: a 32-bit float WAV per part and per deck that add up to the master, the master, the .mid and manifest.json with the CID, tempo, key, license and credits) or stems-opus (the same zip with Ogg Opus stems).&quot;,&quot;enum&quot;:[&quot;opus&quot;,&quot;wav&quot;,&quot;midi&quot;,&quot;stems&quot;,&quot;stems-opus&quot;],&quot;type&quot;:&quot;string&quot;},&quot;text&quot;:{&quot;description&quot;:&quot;The program text. It must pass check; it is stored publicly (CC0-1.0).&quot;,&quot;maxLength&quot;:16384,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>render</ns:toolName>
		<ns:toolParameter>cid</ns:toolParameter>
		<ns:toolParameter>example</ns:toolParameter>
		<ns:toolParameter>format</ns:toolParameter>
		<ns:toolParameter>text</ns:toolParameter>
		<ns:toolTitle xml:lang="en">Render a program to streaming audio</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-share">
		<skos:definition xml:lang="en">Make the share links of a program. Always the self-sealing link: https://beatscript.app/#&lt;CID&gt;.&lt;base64url(deflate(formatted text))&gt;; the program travels inside the link with its `#!` header lines and comments, and whoever opens it gets exactly that program, verified against the CID (the canonical text&apos;s: the headers and comments are not covered by it), and can play and fork it. Also social_url (https://beatscript.app/c/&lt;CID&gt;.&lt;packed&gt;, the form to post where a link preview is wanted: it carries a card image). Called signed in (a bearer token), it also stores the program on the site (public, with its rights: license, forked_from, credits, name; the first share&apos;s rights stay) and returns the CID-only forms: short_url (https://beatscript.app/p/&lt;CID&gt;) and short_social_url (https://beatscript.app/c/&lt;CID&gt;), plus fetch_url, a public GET that returns the canonical text and rights for a phone or an app. Opening a short link fetches the text, recompiles it, recomputes the CID and refuses a mismatch. A short link to a BeatScript 1 program (https://beatscript.app/p/&lt;old CID&gt;) redirects to its BeatScript 2 upgrade (the CID check&apos;s renamed_cid gives, the program fmt writes) once the site stores it; the old CID&apos;s text stays at fetch_url. Anonymous calls get the self-sealing links and short_url null. The program must pass check and must not use samples or &quot;use restricted&quot; (a private program is never shared or stored); programs shared here are CC0 unless license says otherwise. The text is formatted on the way in, its version kept (the stored program is its canonical text, whose CID the header lines and comments do not change, and the link carries the formatted text; a `#! name:` line names the stored program). Links over about 2000 characters (chars says) may be cut by some apps; short links are not. A stored program also embeds in other sites: embed_url (https://beatscript.app/embed/&lt;CID&gt;) is a player any page may frame, https://beatscript.app/embed.js gives &lt;beatscript-player cid=&quot;&lt;CID&gt;&quot;&gt;, and https://beatscript.app/oembed?url=&lt;a /p/ or /c/ link&gt; answers oEmbed; see https://beatscript.app/docs/embed. Who authored a program and what rights it has, in plain language: https://beatscript.app/authorship.

Lexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules&apos; pronunciation. Only the word, its phonemes and the program&apos;s CID are kept, never the text. The answer&apos;s lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/.</skos:definition>
		<skos:prefLabel xml:lang="en">share</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;credits&quot;:{&quot;description&quot;:&quot;Who is credited, one short line each. Stored with the rights.&quot;,&quot;items&quot;:{&quot;maxLength&quot;:80,&quot;type&quot;:&quot;string&quot;},&quot;maxItems&quot;:8,&quot;type&quot;:&quot;array&quot;},&quot;forked_from&quot;:{&quot;description&quot;:&quot;CID of the program this one was forked from. Stored with the rights.&quot;,&quot;maxLength&quot;:100,&quot;pattern&quot;:&quot;^z[1-9A-HJ-NP-Za-km-z]{20,100}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;license&quot;:{&quot;description&quot;:&quot;Rights kept with the stored program: a Creative Commons SPDX id (default CC0-1.0; CC-BY-4.0, CC-BY-SA-4.0 and the like). The site stores no other licence: keep such a program local, or send it to your phone with push_private.&quot;,&quot;maxLength&quot;:40,&quot;type&quot;:&quot;string&quot;},&quot;name&quot;:{&quot;description&quot;:&quot;A name for the program (else its `#! name:` line).&quot;,&quot;maxLength&quot;:80,&quot;type&quot;:&quot;string&quot;},&quot;text&quot;:{&quot;description&quot;:&quot;The program text. It must pass check.&quot;,&quot;maxLength&quot;:16384,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;text&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:readOnly>
		<ns:requiredParameter>text</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>share</ns:toolName>
		<ns:toolParameter>credits</ns:toolParameter>
		<ns:toolParameter>forked_from</ns:toolParameter>
		<ns:toolParameter>license</ns:toolParameter>
		<ns:toolParameter>name</ns:toolParameter>
		<ns:toolTitle xml:lang="en">Make share links</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-station">
		<skos:definition xml:lang="en">Radio: a station is a BeatScript program that names a run of tracks with no end, and this tool answers what is at a position of one. Stations are endless and deterministic: position N of a station is always the same track (the same text, so the same CID), worked out from the station&apos;s text alone, with no clock and no store; nothing is stored here. A station program holds its `tempo`, its `key` and one block:

tempo 128
key am
station {
  from gen@2 techno seed=42
  next seed=~
  forms seeded passacaglia rondo fugue
}

from is the first track&apos;s call of the seeded generator (gen@V GENRE seed=N, optionally length=short|standard|long; the station&apos;s tempo and key are its own lines, never the call&apos;s bpm= or key=). next is the walk from one track&apos;s seed to the next: seed=+N counts on (each track&apos;s seed is the one before&apos;s plus N), seed=~ draws each seed from the CID of the track before (worked out step by step, so a position past the walk&apos;s cap is refused; a seed=+N station has a track at any position); default seed=+1. forms is the forms rotation within the genre: track N plays forms[N mod R] of the R forms (seeded, the generator&apos;s own arrangement, or passacaglia, canon, rondo, fugue, theme-and-variations, cross), each form&apos;s first role bound to the chapter&apos;s theme seed (the first track of each pass of the rotation, so it recurs) and its second role to track N&apos;s own seed; default forms seeded. The segue from track N to N+1 is the cross form of their two seeds: a program of its own, with its own CID.

Answers {ok, version, station {text, cid, genre, generator, seed, step, forms, tempo, key, length, start_cid}, n, tracks[{n, seed, theme, form, phrase, text, cid, parent, station, check}], segues[{from, to, form, phrase, text, cid, check}], neighbours, retuned, locks, diagnostics}; ok:false with error and diagnostics is an answer, not a tool error. Each track&apos;s text is a program to check, listen to, eval, render or share; its parent is track N-1&apos;s CID. A listener does not steer a station: they turn its knobs (genre, seed, step, forms, tempo, key, length), and turning one moves them to a neighbouring station that already exists. retune sets knobs before anything else, each to a value or to &quot;+1&quot; / &quot;-1&quot; for one notch (seed by 1, tempo by 2, key a fifth round the circle in its own mode, step between +1 and ~, forms rotated by one, length one step; a genre only by name), and retune keeps N: the answer is track N of the retuned station. locks are knobs held fixed: retuning a locked knob is refused, and neighbours (true) lists the stations one notch away along each unlocked knob, each with its text, its CID and its track at n. check (true) checks each track and segue: {ok, expanded_cid, bars, seconds, errors}; each program checked counts as one call of the checker. check of a station program answers station too. Read-only, no sign-in. Stations, the walk and the knobs: https://beatscript.app/docs/radio.md.</skos:definition>
		<skos:prefLabel xml:lang="en">station</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;check&quot;:{&quot;description&quot;:&quot;Check each track and segue: {ok, expanded_cid, bars, seconds, errors} (default false). Each program checked counts as one call of the checker.&quot;,&quot;type&quot;:&quot;boolean&quot;},&quot;count&quot;:{&quot;description&quot;:&quot;How many tracks from n (default 1, at most 16; with check, at most 4).&quot;,&quot;maximum&quot;:16,&quot;minimum&quot;:1,&quot;type&quot;:&quot;integer&quot;},&quot;locks&quot;:{&quot;description&quot;:&quot;Knobs held fixed: retuning one is refused, and neighbours never turns one.&quot;,&quot;items&quot;:{&quot;enum&quot;:[&quot;genre&quot;,&quot;seed&quot;,&quot;step&quot;,&quot;forms&quot;,&quot;tempo&quot;,&quot;key&quot;,&quot;length&quot;],&quot;type&quot;:&quot;string&quot;},&quot;maxItems&quot;:7,&quot;type&quot;:&quot;array&quot;},&quot;n&quot;:{&quot;description&quot;:&quot;The position: the station&apos;s track n (default 0). Track n of a station is always the same track.&quot;,&quot;minimum&quot;:0,&quot;type&quot;:&quot;integer&quot;},&quot;neighbours&quot;:{&quot;description&quot;:&quot;Also the neighbouring stations, one notch away along each unlocked knob, each with its text, its CID and its track at n (default false).&quot;,&quot;type&quot;:&quot;boolean&quot;},&quot;retune&quot;:{&quot;additionalProperties&quot;:false,&quot;description&quot;:&quot;Knobs to set before anything else, each to a value or to \&quot;+1\&quot; / \&quot;-1\&quot; for one notch: {\&quot;tempo\&quot;: \&quot;+1\&quot;}, {\&quot;seed\&quot;: 7, \&quot;forms\&quot;: \&quot;seeded cross\&quot;}. The position n is kept: the answer is track n of the retuned station.&quot;,&quot;properties&quot;:{&quot;forms&quot;:{&quot;description&quot;:&quot;The forms in turn (\&quot;seeded passacaglia\&quot; or a list), or a notch: rotated by one.&quot;,&quot;items&quot;:{&quot;type&quot;:&quot;string&quot;},&quot;type&quot;:[&quot;string&quot;,&quot;array&quot;]},&quot;genre&quot;:{&quot;description&quot;:&quot;A genre of the seeded generator, by name (a genre has no notch).&quot;,&quot;type&quot;:&quot;string&quot;},&quot;key&quot;:{&quot;description&quot;:&quot;A key (am, c, f#m ...), or a notch: a fifth round the circle in its own mode.&quot;,&quot;type&quot;:&quot;string&quot;},&quot;length&quot;:{&quot;description&quot;:&quot;short, standard or long, or a notch.&quot;,&quot;type&quot;:&quot;string&quot;},&quot;seed&quot;:{&quot;description&quot;:&quot;The first track&apos;s seed: a whole number or a word, or \&quot;+1\&quot; / \&quot;-1\&quot;.&quot;,&quot;type&quot;:[&quot;string&quot;,&quot;integer&quot;]},&quot;step&quot;:{&quot;description&quot;:&quot;The walk: \&quot;+1\&quot;, \&quot;+2\&quot; ... or \&quot;~\&quot;; a notch turns between +1 and ~.&quot;,&quot;type&quot;:&quot;string&quot;},&quot;tempo&quot;:{&quot;description&quot;:&quot;40 to 300, or a notch of 2.&quot;,&quot;type&quot;:[&quot;string&quot;,&quot;number&quot;]}},&quot;type&quot;:&quot;object&quot;},&quot;segue&quot;:{&quot;description&quot;:&quot;Also the segue after each track, track n into n+1: the cross form of their two seeds, with its own CID (default true).&quot;,&quot;type&quot;:&quot;boolean&quot;},&quot;station&quot;:{&quot;description&quot;:&quot;The station program: its tempo and key lines and its station { from, next, forms } block (at most 16384 bytes).&quot;,&quot;maxLength&quot;:16384,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;station&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:requiredParameter>station</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>station</ns:toolName>
		<ns:toolParameter>check</ns:toolParameter>
		<ns:toolParameter>count</ns:toolParameter>
		<ns:toolParameter>locks</ns:toolParameter>
		<ns:toolParameter>n</ns:toolParameter>
		<ns:toolParameter>neighbours</ns:toolParameter>
		<ns:toolParameter>retune</ns:toolParameter>
		<ns:toolParameter>segue</ns:toolParameter>
		<ns:toolTitle xml:lang="en">A radio station: the track at a position</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-beatscript-stop">
		<skos:definition xml:lang="en">Stop what a browser tab at https://beatscript.app is playing: the program ends and whatever its lines held (a filter, a mute) is put back. Reaches every live tab of the token&apos;s account, or one tab by session (the id the page&apos;s MCP panel shows). Needs a bearer token. No tab connected: a no_session error that says how to connect one.</skos:definition>
		<skos:prefLabel xml:lang="en">stop</skos:prefLabel>
		<ns:inputSchema>{&quot;additionalProperties&quot;:false,&quot;properties&quot;:{&quot;device&quot;:{&quot;description&quot;:&quot;Id of one of your paired phones (djrust on Android), from the devices tool. Targets that phone alone; do not combine with session.&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9_-]{6,64}$&quot;,&quot;type&quot;:&quot;string&quot;},&quot;session&quot;:{&quot;description&quot;:&quot;Session id of one browser tab, from the MCP panel of the page. Leave out to use your own signed-in tabs (every live one for eval/load/stop, the latest for get).&quot;,&quot;maxLength&quot;:64,&quot;pattern&quot;:&quot;^[A-Za-z0-9_-]{6,64}$&quot;,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>stop</ns:toolName>
		<ns:toolParameter>device</ns:toolParameter>
		<ns:toolParameter>session</ns:toolParameter>
		<ns:toolTitle xml:lang="en">Stop a browser tab</ns:toolTitle>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-ontology-describe-term">
		<skos:definition xml:lang="en">Everything the ontology states about one class, property, genre, scale, groove, section, instrument or concept, as N-Triples (the materialized graph). Give a short name such as Genre, bpm, genre:techno or section:drop, or a full IRI in the ontology&apos;s namespaces. format &quot;json&quot; returns a compact view instead: label, types, definition (its own, else the glossary concept it closeMatches, else its rdfs:comment), direct superclasses and subclasses as asserted, close matches and sources.</skos:definition>
		<skos:prefLabel xml:lang="en">describe_term</skos:prefLabel>
		<ns:inputSchema>{&quot;properties&quot;:{&quot;format&quot;:{&quot;description&quot;:&quot;triples (default, N-Triples) or json (compact term view)&quot;,&quot;enum&quot;:[&quot;triples&quot;,&quot;json&quot;],&quot;type&quot;:&quot;string&quot;},&quot;term&quot;:{&quot;description&quot;:&quot;name or IRI&quot;,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;term&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:requiredParameter>term</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>describe_term</ns:toolName>
		<ns:toolParameter>format</ns:toolParameter>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-ontology-get-genre">
		<skos:definition xml:lang="en">One genre in full: tempo, scale, kick/snare/hihat Euclidean rhythms (pulses, steps, rotation, MIDI note), swing, humanize, densities, instrument per channel, chord progressions, song-structure sections, and links to Wikidata and to pflow ontology terms. Give a slug such as techno or jazz.</skos:definition>
		<skos:prefLabel xml:lang="en">get_genre</skos:prefLabel>
		<ns:inputSchema>{&quot;properties&quot;:{&quot;genre&quot;:{&quot;description&quot;:&quot;genre slug, e.g. techno&quot;,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;genre&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:requiredParameter>genre</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>get_genre</ns:toolName>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-ontology-get-release">
		<skos:definition xml:lang="en">Version, pack digest and file hashes of the release being served, and what its certificate covers.</skos:definition>
		<skos:prefLabel xml:lang="en">get_release</skos:prefLabel>
		<ns:inputSchema>{&quot;properties&quot;:{},&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>get_release</ns:toolName>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-ontology-list-classes">
		<skos:definition xml:lang="en">All classes in the ontology namespace with their direct superclasses, as asserted: a superclass another listed one already implies is left out, so LiveNet lists DeadlockFreeNet, not PetriNet too. For the inferred closure, query rdfs:subClassOf with sparql_query.</skos:definition>
		<skos:prefLabel xml:lang="en">list_classes</skos:prefLabel>
		<ns:inputSchema>{&quot;properties&quot;:{},&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>list_classes</ns:toolName>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-ontology-list-genres">
		<skos:definition xml:lang="en">Every genre the engine knows, with its tempo, scale, family and groove. Filter by family (edm, song, jazz, chill) or by a BPM range.</skos:definition>
		<skos:prefLabel xml:lang="en">list_genres</skos:prefLabel>
		<ns:inputSchema>{&quot;properties&quot;:{&quot;family&quot;:{&quot;description&quot;:&quot;edm, song, jazz or chill; omit for all&quot;,&quot;type&quot;:&quot;string&quot;},&quot;max_bpm&quot;:{&quot;type&quot;:&quot;integer&quot;},&quot;min_bpm&quot;:{&quot;type&quot;:&quot;integer&quot;}},&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:status>stable</ns:status>
		<ns:toolName>list_genres</ns:toolName>
		<ns:toolParameter>family</ns:toolParameter>
		<ns:toolParameter>max_bpm</ns:toolParameter>
		<ns:toolParameter>min_bpm</ns:toolParameter>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-ontology-search-terms">
		<skos:definition xml:lang="en">Find terms whose label, other label (an alternative or a former name, such as btw for BeatScript) or definition contains the text (case-insensitive). A class with no definition of its own gets the one of the glossary concept it closeMatches, or its rdfs:comment.</skos:definition>
		<skos:prefLabel xml:lang="en">search_terms</skos:prefLabel>
		<ns:inputSchema>{&quot;properties&quot;:{&quot;limit&quot;:{&quot;description&quot;:&quot;max results, default 25, at most 200&quot;,&quot;type&quot;:&quot;integer&quot;},&quot;text&quot;:{&quot;description&quot;:&quot;text to look for&quot;,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;text&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:requiredParameter>text</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>search_terms</ns:toolName>
		<ns:toolParameter>limit</ns:toolParameter>
	</ns:McpTool>
	<ns:McpTool rdf:about="https://beatscript.app/ontology/concept/tool-ontology-sparql-query">
		<skos:definition xml:lang="en">Run a read-only SPARQL query (SELECT, ASK, CONSTRUCT or DESCRIBE) over the BeatScript ontology. Rows are capped and queries time out. Results can contain blank nodes (OWL class expressions); add FILTER(isIRI(?x)) to skip them.</skos:definition>
		<skos:prefLabel xml:lang="en">sparql_query</skos:prefLabel>
		<ns:inputSchema>{&quot;properties&quot;:{&quot;query&quot;:{&quot;description&quot;:&quot;SPARQL query text&quot;,&quot;type&quot;:&quot;string&quot;}},&quot;required&quot;:[&quot;query&quot;],&quot;type&quot;:&quot;object&quot;}</ns:inputSchema>
		<ns:needsToken rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ns:needsToken>
		<ns:providedBy rdf:resource="https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"/>
		<ns:readOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:readOnly>
		<ns:requiredParameter>query</ns:requiredParameter>
		<ns:status>stable</ns:status>
		<ns:toolName>sparql_query</ns:toolName>
	</ns:McpTool>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/transform-degrade">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternTransform"/>
		<skos:definition xml:lang="en">Drop some hits at random, thinning the pattern.</skos:definition>
		<skos:prefLabel xml:lang="en">degrade</skos:prefLabel>
		<skos:relatedMatch rdf:resource="https://beatscript.app/ontology/concept/density"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/transform-degrade"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/endomorphism-monoid"/>
		<ns:liftedThrough rdf:resource="https://beatscript.app/ontology/concept/pattern-endofunctor"/>
		<ns:status>in-development</ns:status>
		<ns:writtenAs>degrade</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/transform-every">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternTransform"/>
		<skos:definition xml:lang="en">The pattern call every: takes a pattern and gives another.</skos:definition>
		<skos:prefLabel xml:lang="en">every</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>every</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/transform-fast">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternTransform"/>
		<skos:definition xml:lang="en">Squeeze the pattern so each step lasts less time.</skos:definition>
		<skos:prefLabel xml:lang="en">fast</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/transform-fast"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/endomorphism-monoid"/>
		<ns:liftedThrough rdf:resource="https://beatscript.app/ontology/concept/pattern-endofunctor"/>
		<ns:status>in-development</ns:status>
		<ns:writtenAs>fast</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/transform-humanize">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternTransform"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/ontology/ns#humanize"/>
		<skos:definition xml:lang="en">Add small random wobble to timing and loudness.</skos:definition>
		<skos:prefLabel xml:lang="en">humanize</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/transform-humanize"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/endomorphism-monoid"/>
		<ns:liftedThrough rdf:resource="https://beatscript.app/ontology/concept/pattern-endofunctor"/>
		<ns:status>in-development</ns:status>
		<ns:writtenAs>humanize</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/transform-maybe">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternTransform"/>
		<skos:definition xml:lang="en">The pattern call maybe: takes a pattern and gives another.</skos:definition>
		<skos:prefLabel xml:lang="en">maybe</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>maybe</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/transform-octave">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternTransform"/>
		<skos:definition xml:lang="en">Move every note up or down whole octaves: a transpose by a multiple of twelve.</skos:definition>
		<skos:prefLabel xml:lang="en">octave</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/transform-octave"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/endomorphism-monoid"/>
		<ns:liftedThrough rdf:resource="https://beatscript.app/ontology/concept/pattern-endofunctor"/>
		<ns:status>in-development</ns:status>
		<ns:writtenAs>octave</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/transform-rests">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternTransform"/>
		<skos:definition xml:lang="en">The pattern call rests: takes a pattern and gives another.</skos:definition>
		<skos:prefLabel xml:lang="en">rests</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>rests</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/transform-reverse">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternTransform"/>
		<skos:definition xml:lang="en">Play the pattern backwards. Doing it twice is the identity.</skos:definition>
		<skos:prefLabel xml:lang="en">reverse</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/transform-reverse"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/endomorphism-monoid"/>
		<ns:liftedThrough rdf:resource="https://beatscript.app/ontology/concept/pattern-endofunctor"/>
		<ns:status>in-development</ns:status>
		<ns:writtenAs>reverse</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/transform-rotate">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternTransform"/>
		<skos:definition xml:lang="en">Shift the pattern in time by a number of steps, wrapping around.</skos:definition>
		<skos:prefLabel xml:lang="en">rotate</skos:prefLabel>
		<skos:relatedMatch rdf:resource="https://beatscript.app/ontology/concept/rotation"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/transform-rotate"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/endomorphism-monoid"/>
		<ns:liftedThrough rdf:resource="https://beatscript.app/ontology/concept/pattern-endofunctor"/>
		<ns:status>in-development</ns:status>
		<ns:writtenAs>rotate</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/transform-slow">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternTransform"/>
		<skos:definition xml:lang="en">Stretch the pattern so each step lasts longer.</skos:definition>
		<skos:prefLabel xml:lang="en">slow</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/transform-slow"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/endomorphism-monoid"/>
		<ns:liftedThrough rdf:resource="https://beatscript.app/ontology/concept/pattern-endofunctor"/>
		<ns:status>in-development</ns:status>
		<ns:writtenAs>slow</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/transform-transpose">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternTransform"/>
		<skos:definition xml:lang="en">Shift every note by a fixed number of semitones.</skos:definition>
		<skos:prefLabel xml:lang="en">transpose</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/transform-transpose"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/endomorphism-monoid"/>
		<ns:liftedThrough rdf:resource="https://beatscript.app/ontology/concept/pattern-endofunctor"/>
		<ns:status>in-development</ns:status>
		<ns:writtenAs>transpose</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/verb-activity">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#ControlVerb"/>
		<skos:definition xml:lang="en">The control verb activity, accepted by: bindings.</skos:definition>
		<skos:prefLabel xml:lang="en">activity</skos:prefLabel>
		<ns:actsOn rdf:resource="https://beatscript.app/ontology/concept/noun-bindings"/>
		<ns:status>stable</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/verb-add-dest">
