		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The weight production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">weight</skos:prefLabel>
		<ns:ebnf>NUMBER | &quot;(&quot; arith &quot;)&quot;</ns:ebnf>
