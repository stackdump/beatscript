	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-action">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The action production of BeatScript&apos;s grammar (hertz: 20 .. 20k; 0 .. 1: how much; deck X: / master: level; deck X:).</skos:definition>
		<skos:prefLabel xml:lang="en">action</skos:prefLabel>
		<ns:ebnf>&quot;filter&quot; ( &quot;lp&quot; | &quot;hp&quot; ) change | &quot;filter&quot; ( &quot;off&quot; | &quot;open&quot; ) | ( &quot;delay&quot; | &quot;reverb&quot; | &quot;crush&quot; | &quot;drive&quot; | &quot;resonance&quot; ) change | ( &quot;level&quot; | &quot;low&quot; | &quot;mid&quot; | &quot;high&quot; ) change | &quot;load&quot; SPEC | &quot;play&quot; | &quot;stop&quot; | &quot;sync&quot; | &quot;mute&quot; | &quot;unmute&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Control: what the mix does</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-crush"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-delay"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-drive"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-filter"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-high"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-hp"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-level"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-load"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-low"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-lp"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-mid"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-mute"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-off"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-open"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-play"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-resonance"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-reverb"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-stop"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-sync"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-unmute"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-change"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-lexical-spec"/>
		<ns:writtenAs>action</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-and">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The and production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">and</skos:prefLabel>
		<ns:ebnf>not { &quot;and&quot; not }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-and"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-not"/>
		<ns:writtenAs>and</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-arg">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The arg production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">arg</skos:prefLabel>
		<ns:ebnf>arith | KEY | CHORD | ROMAN [ &quot;/&quot; INT ] | NAME | NAME &quot;=&quot; ( arith | WORD ) | &quot;[&quot; pattern &quot;]&quot; | degrees | call | PARAM</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mini-notation: the rhythm of a part</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-bracket"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-equals"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-bracket"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-slash"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-call"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-degrees"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-pattern"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-chord"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-key"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-param"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-roman"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-word"/>
		<ns:writtenAs>arg</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-arith">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The arith production of BeatScript&apos;s grammar (worked out once, when the program is read, over exact rationals).</skos:definition>
		<skos:prefLabel xml:lang="en">arith</skos:prefLabel>
		<ns:ebnf>sum</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-sum"/>
		<ns:writtenAs>arith</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-arr-end">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The arr_end production of BeatScript&apos;s grammar (only after a NAME: see &quot;Several arrangements&quot;).</skos:definition>
		<skos:prefLabel xml:lang="en">arr_end</skos:prefLabel>
		<ns:ebnf>&quot;then&quot; NAME | &quot;loop&quot; [ INT ] | &quot;end&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-end"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-loop"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-then"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>arr_end</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-arr-gap">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The arr_gap production of BeatScript&apos;s grammar (a mutation runs to the end of its line).</skos:definition>
		<skos:prefLabel xml:lang="en">arr_gap</skos:prefLabel>
		<ns:ebnf>NEWLINE | &quot;,&quot; | mutation NEWLINE</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arrange mutations</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-mutation"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-newline"/>
		<ns:writtenAs>arr_gap</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-arrange-block">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The arrange_block production of BeatScript&apos;s grammar (at least one section; see &quot;Arrange mutations&quot;; a named arrangement with mutations).</skos:definition>
		<skos:prefLabel xml:lang="en">arrange_block</skos:prefLabel>
		<ns:ebnf>&quot;arrange&quot; &quot;{&quot; { arr_gap } NAME { arr_gap | NAME } &quot;}&quot; [ block_end ] | &quot;arrange&quot; NAME &quot;:&quot; &quot;{&quot; { arr_gap } NAME { arr_gap | NAME } &quot;}&quot; [ arr_end ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arrange mutations</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-arrange"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-brace"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-colon"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-brace"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arr-end"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arr-gap"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-block-end"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>arrange_block</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-arrange">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The arrange production of BeatScript&apos;s grammar (with a NAME it is one of several arrangements; the whole of a generated track: arrange from seed(techno, 42), or of a phrase: arrange from template(deep-house, @tempest_such_stuff); the whole program a generator call prints: arrange from gen@2 techno seed=42).</skos:definition>
		<skos:prefLabel xml:lang="en">arrange</skos:prefLabel>
		<ns:ebnf>&quot;arrange&quot; sexpr { sexpr } | &quot;arrange&quot; NAME &quot;:&quot; sexpr { sexpr } [ arr_end ] | &quot;arrange&quot; &quot;from&quot; ( seed | template ) | &quot;arrange&quot; &quot;from&quot; gen</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-arrange"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-from"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-colon"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arr-end"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-gen"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-seed"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-sexpr"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-template"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>arrange</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-assert">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The assert production of BeatScript&apos;s grammar (assert never A.snare beside A.snare assert never B during sing: refused where it is false; assert bass ends on 1: the lowest note of its last onset is that degree of the key).</skos:definition>
		<skos:prefLabel xml:lang="en">assert</skos:prefLabel>
		<ns:ebnf>&quot;assert&quot; ( &quot;ends&quot; | &quot;period&quot; [ &quot;(&quot; NAME &quot;)&quot; ] cmp INT | &quot;length&quot; ( ( &quot;==&quot; | &quot;!=&quot; ) clock [ &quot;±&quot; clock ] | ( &quot;&lt;&quot; | &quot;&lt;=&quot; | &quot;&gt;&quot; | &quot;&gt;=&quot; ) clock ) | &quot;level&quot; leveldeck cmp levelexpr [ &quot;in&quot; NAME ] | &quot;key&quot; ( &quot;==&quot; | &quot;!=&quot; ) KEY [ &quot;in&quot; NAME ] | &quot;never&quot; subject ( &quot;beside&quot; | &quot;during&quot; ) subject [ &quot;in&quot; NAME ] | subject &quot;ends&quot; &quot;on&quot; INT [ &quot;in&quot; NAME ] )</ns:ebnf>
		<ns:grammarSection xml:lang="en">Assertions</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-assert"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-beside"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-during"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-ends"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-in"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-key"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-length"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-level"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-never"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-on"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-period"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-eq"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-ge"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-gt"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-le"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-lt"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-ne"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-plus-minus"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-clock"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-cmp"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-leveldeck"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-levelexpr"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-subject"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-key"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>assert</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-atom">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The atom production of BeatScript&apos;s grammar (a hit; a rest; c3 f#2 bb4; a scale degree of the key: 1 3 5; a degree computed: ($i + 1); deg(1 b3 5&apos; ~); i VI V7/7: a chord of the key; /3 /5 /7 an inversion; a def&apos;s parameter: $chords; a group: squeezed into one slot; commas stack; alternation: one term per cycle; choose [a b c] weights 3 1 1; a let pattern&apos;s name).</skos:definition>
		<skos:prefLabel xml:lang="en">atom</skos:prefLabel>
		<ns:ebnf>&quot;x&quot; | &quot;~&quot; | NOTE | INT | &quot;(&quot; arith &quot;)&quot; | degrees | ROMAN [ &quot;/&quot; INT ] | PARAM | &quot;[&quot; pattern { &quot;,&quot; pattern } &quot;]&quot; | &quot;&lt;&quot; pattern &quot;&gt;&quot; | choose | call | NAME</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mini-notation: the rhythm of a part</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-bracket"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-gt"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-lt"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-bracket"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-slash"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-tilde"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-x"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-call"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-choose"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-degrees"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-pattern"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-note"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-param"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-roman"/>
		<ns:writtenAs>atom</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-band">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The band production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">band</skos:prefLabel>
		<ns:ebnf>&quot;low&quot; | &quot;mid&quot; | &quot;high&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mix moves and sung lyrics</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-high"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-low"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-mid"/>
		<ns:writtenAs>band</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-binding">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The binding production of BeatScript&apos;s grammar (a role of the form and what fills it: ground=gen@1 dubstep seed=54876 part=bass).</skos:definition>
		<skos:prefLabel xml:lang="en">binding</skos:prefLabel>
		<ns:ebnf>NAME &quot;=&quot; source</ns:ebnf>
		<ns:grammarSection xml:lang="en">Phrase templates</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-equals"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-source"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>binding</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-block-end">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The block_end production of BeatScript&apos;s grammar (default end; loop N: 1 to 256 passes, then a coda).</skos:definition>
		<skos:prefLabel xml:lang="en">block_end</skos:prefLabel>
		<ns:ebnf>&quot;end&quot; | &quot;loop&quot; | &quot;loop&quot; INT [ &quot;then&quot; { NAME } &quot;end&quot; ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arrange mutations</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-end"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-loop"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-then"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>block_end</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-body-line">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The body_line production of BeatScript&apos;s grammar (a repeat&apos;s body line: $i is the pass, 0 up).</skos:definition>
		<skos:prefLabel xml:lang="en">body_line</skos:prefLabel>
		<ns:ebnf>[ statement ] NEWLINE</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-statement"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-newline"/>
		<ns:writtenAs>body_line</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-bound">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The bound production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">bound</skos:prefLabel>
		<ns:ebnf>&quot;stop&quot; &quot;when&quot; &quot;gen&quot; ( &quot;==&quot; | &quot;&gt;=&quot; | &quot;&gt;&quot; ) INT | &quot;for&quot; INT &quot;gens&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Evolving</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-for"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-gen"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-gens"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-stop"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-eq"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-ge"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-gt"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-when"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:writtenAs>bound</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-call">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The call production of BeatScript&apos;s grammar (e(5,8) markov(0.6) arp(am7, up) chord(am) maybe(p, 0.5)).</skos:definition>
		<skos:prefLabel xml:lang="en">call</skos:prefLabel>
		<ns:ebnf>NAME &quot;(&quot; [ arg { &quot;,&quot; arg } ] &quot;)&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mini-notation: the rhythm of a part</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arg"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>call</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-cand">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The cand production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">cand</skos:prefLabel>
		<ns:ebnf>cnot { &quot;and&quot; cnot }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-and"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-cnot"/>
		<ns:writtenAs>cand</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-carith">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The carith production of BeatScript&apos;s grammar (arithmetic that may read inputs: only in a control).</skos:definition>
		<skos:prefLabel xml:lang="en">carith</skos:prefLabel>
		<ns:ebnf>csum</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-csum"/>
		<ns:writtenAs>carith</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-ccompare">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The ccompare production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">ccompare</skos:prefLabel>
		<ns:ebnf>coperand [ cmp coperand ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-cmp"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-coperand"/>
		<ns:writtenAs>ccompare</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-cexpr">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The cexpr production of BeatScript&apos;s grammar (a control line&apos;s guard).</skos:definition>
		<skos:prefLabel xml:lang="en">cexpr</skos:prefLabel>
		<ns:ebnf>cor</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-cor"/>
		<ns:writtenAs>cexpr</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-cguard">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The cguard production of BeatScript&apos;s grammar (a control line&apos;s guard may read an input).</skos:definition>
		<skos:prefLabel xml:lang="en">cguard</skos:prefLabel>
		<ns:ebnf>&quot;when&quot; cexpr</ns:ebnf>
		<ns:grammarSection xml:lang="en">Lines: when, where, what</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-when"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-cexpr"/>
		<ns:writtenAs>cguard</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-change">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The change production of BeatScript&apos;s grammar (a plain value; a ramp: 2k -&gt; 8k over 8 bars exp; a value that keeps moving).</skos:definition>
		<skos:prefLabel xml:lang="en">change</skos:prefLabel>
		<ns:ebnf>value | value &quot;-&gt;&quot; value span [ shape ] | lfo</ns:ebnf>
		<ns:grammarSection xml:lang="en">Control: what the mix does</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-arrow"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-lfo"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-shape"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-span"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-value"/>
		<ns:writtenAs>change</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-choose">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The choose production of BeatScript&apos;s grammar (one weight for each option).</skos:definition>
		<skos:prefLabel xml:lang="en">choose</skos:prefLabel>
		<ns:ebnf>&quot;choose&quot; &quot;[&quot; pattern &quot;]&quot; &quot;weights&quot; weight { weight } [ &quot;seed=&quot; INT ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Degrees, Roman numerals, chance</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-choose"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-seed-param"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-bracket"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-bracket"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-weights"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-pattern"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-weight"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:writtenAs>choose</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-clock">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The clock production of BeatScript&apos;s grammar (3m30s 90s 500ms).</skos:definition>
		<skos:prefLabel xml:lang="en">clock</skos:prefLabel>
		<ns:ebnf>DECIMAL &quot;m&quot; [ DECIMAL &quot;s&quot; ] | DECIMAL &quot;s&quot; | DECIMAL &quot;ms&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Assertions</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-m"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-ms"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-s"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-decimal"/>
		<ns:writtenAs>clock</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-cmp">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The cmp production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">cmp</skos:prefLabel>
		<ns:ebnf>&quot;==&quot; | &quot;!=&quot; | &quot;&lt;&quot; | &quot;&lt;=&quot; | &quot;&gt;&quot; | &quot;&gt;=&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-eq"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-ge"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-gt"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-le"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-lt"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-ne"/>
		<ns:writtenAs>cmp</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-cnot">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The cnot production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">cnot</skos:prefLabel>
		<ns:ebnf>[ &quot;not&quot; ] ccompare</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-not"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-ccompare"/>
		<ns:writtenAs>cnot</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-compare">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The compare production of BeatScript&apos;s grammar (words compare with == and != only).</skos:definition>
		<skos:prefLabel xml:lang="en">compare</skos:prefLabel>
		<ns:ebnf>operand [ cmp operand ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-cmp"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-operand"/>
		<ns:writtenAs>compare</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-control">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The control production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">control</skos:prefLabel>
		<ns:ebnf>action | engine | do | sing</ns:ebnf>
		<ns:grammarSection xml:lang="en">Lines: when, where, what</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-action"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-do"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-engine"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-sing"/>
		<ns:writtenAs>control</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-coperand">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The coperand production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">coperand</skos:prefLabel>
		<ns:ebnf>csum | WORD</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-csum"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-word"/>
		<ns:writtenAs>coperand</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-cor">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The cor production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">cor</skos:prefLabel>
		<ns:ebnf>cand { &quot;or&quot; cand }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-or"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-cand"/>
		<ns:writtenAs>cor</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-cprimary">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The cprimary production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">cprimary</skos:prefLabel>
		<ns:ebnf>NUMBER | PARAM | &quot;(&quot; carith &quot;)&quot; | ( &quot;min&quot; | &quot;max&quot; ) &quot;(&quot; carith { &quot;,&quot; carith } &quot;)&quot; | input</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-max"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-min"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-carith"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-input"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-number"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-param"/>
		<ns:writtenAs>cprimary</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-cproduct">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The cproduct production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">cproduct</skos:prefLabel>
		<ns:ebnf>cunary { ( &quot;*&quot; | &quot;/&quot; | &quot;%&quot; ) cunary }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-percent"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-slash"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-star"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-cunary"/>
		<ns:writtenAs>cproduct</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-csum">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The csum production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">csum</skos:prefLabel>
		<ns:ebnf>cproduct { ( &quot;+&quot; | &quot;-&quot; ) cproduct }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-minus"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-plus"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-cproduct"/>
		<ns:writtenAs>csum</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-cunary">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The cunary production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">cunary</skos:prefLabel>
		<ns:ebnf>[ &quot;-&quot; ] cprimary</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-minus"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-cprimary"/>
		<ns:writtenAs>cunary</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-db">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The db production of BeatScript&apos;s grammar (glued: 6db).</skos:definition>
		<skos:prefLabel xml:lang="en">db</skos:prefLabel>
		<ns:ebnf>DECIMAL &quot;db&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mix moves and sung lyrics</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-db"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-decimal"/>
		<ns:writtenAs>db</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-deck">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The deck production of BeatScript&apos;s grammar (PARAM: in a def body, filled in when it is called).</skos:definition>
		<skos:prefLabel xml:lang="en">deck</skos:prefLabel>
		<ns:ebnf>&quot;A&quot; | &quot;B&quot; | PARAM</ns:ebnf>
		<ns:grammarSection xml:lang="en">Lines: when, where, what</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-a"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-b"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-param"/>
		<ns:writtenAs>deck</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-def-line">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The def_line production of BeatScript&apos;s grammar (a def&apos;s body line; `emit` says what an out port carries).</skos:definition>
		<skos:prefLabel xml:lang="en">def_line</skos:prefLabel>
		<ns:ebnf>[ statement | emit ] NEWLINE</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-emit"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-statement"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-newline"/>
		<ns:writtenAs>def_line</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-def">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The def production of BeatScript&apos;s grammar ($NAME inside, filled in when it is called).</skos:definition>
		<skos:prefLabel xml:lang="en">def</skos:prefLabel>
		<ns:ebnf>&quot;def&quot; NAME &quot;(&quot; [ NAME { &quot;,&quot; NAME } ] &quot;)&quot; [ &quot;in&quot; &quot;:&quot; type { &quot;,&quot; type } ] [ &quot;out&quot; &quot;:&quot; type { &quot;,&quot; type } ] &quot;{&quot; { def_line } &quot;}&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-def"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-in"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-out"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-brace"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-colon"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-brace"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-def-line"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-type"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>def</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-degrees">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The degrees production of BeatScript&apos;s grammar (one slot, its terms squeezed into it like [..]).</skos:definition>
		<skos:prefLabel xml:lang="en">degrees</skos:prefLabel>
		<ns:ebnf>&quot;deg&quot; &quot;(&quot; dstack &quot;)&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Degrees, Roman numerals, chance</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-deg"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-dstack"/>
		<ns:writtenAs>degrees</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-dleaf">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The dleaf production of BeatScript&apos;s grammar (5&apos; an octave up, 1, down; b3 flat, #4 sharp).</skos:definition>
		<skos:prefLabel xml:lang="en">dleaf</skos:prefLabel>
		<ns:ebnf>( INT | SDEG ) { &quot;&apos;&quot; } { &quot;,&quot; }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Degrees, Roman numerals, chance</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-apostrophe"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-sdeg"/>
		<ns:writtenAs>dleaf</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-do">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The do production of BeatScript&apos;s grammar (the control registry: noun, verb; SUGAR: a noun said with no `do` (vocoder, freeze, wheel ...)).</skos:definition>
		<skos:prefLabel xml:lang="en">do</skos:prefLabel>
		<ns:ebnf>( &quot;do&quot; WORD | SUGAR ) [ WORD ] { STRING } { NAME &quot;=&quot; doval } [ span [ shape ] ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Control: what the mix does</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-do"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-equals"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-doval"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-shape"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-span"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-string"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-sugar"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-word"/>
		<ns:writtenAs>do</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-doval">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The doval production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">doval</skos:prefLabel>
		<ns:ebnf>arith [ &quot;-&gt;&quot; arith ] | WORD | STRING | &quot;[&quot; [ doval { &quot;,&quot; doval } ] &quot;]&quot; | lfo</ns:ebnf>
		<ns:grammarSection xml:lang="en">Control: what the mix does</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-arrow"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-bracket"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-bracket"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-doval"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-lfo"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-string"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-word"/>
		<ns:writtenAs>doval</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-dseq">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The dseq production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">dseq</skos:prefLabel>
		<ns:ebnf>dterm { dterm }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Degrees, Roman numerals, chance</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-dterm"/>
		<ns:writtenAs>dseq</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-dstack">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The dstack production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">dstack</skos:prefLabel>
		<ns:ebnf>dseq { &quot;,&quot; dseq }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Degrees, Roman numerals, chance</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-dseq"/>
		<ns:writtenAs>dstack</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-dterm">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The dterm production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">dterm</skos:prefLabel>
		<ns:ebnf>dleaf [ mark ] [ &quot;*&quot; INT ] | &quot;~&quot; | &quot;x&quot; | &quot;[&quot; dstack &quot;]&quot; | &quot;&lt;&quot; dseq &quot;&gt;&quot; | &quot;(&quot; ( dterm | arith ) &quot;)&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Degrees, Roman numerals, chance</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-bracket"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-gt"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-lt"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-bracket"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-star"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-tilde"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-x"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-dleaf"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-dseq"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-dstack"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-dterm"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-mark"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:writtenAs>dterm</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-duck">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The duck production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">duck</skos:prefLabel>
		<ns:ebnf>&quot;duck&quot; deck &quot;under&quot; deck &quot;.&quot; role db { &quot;attack=&quot; time | &quot;release=&quot; time }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mix moves and sung lyrics</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-attack-param"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-duck"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-release-param"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-dot"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-under"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-db"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-deck"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-role"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-time"/>
		<ns:writtenAs>duck</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-dur">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The dur production of BeatScript&apos;s grammar (4 bars 1/2 bar 2 beats).</skos:definition>
		<skos:prefLabel xml:lang="en">dur</skos:prefLabel>
		<ns:ebnf>arith ( &quot;bar&quot; | &quot;bars&quot; | &quot;beat&quot; | &quot;beats&quot; )</ns:ebnf>
		<ns:grammarSection xml:lang="en">Lines: when, where, what</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bar"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bars"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-beat"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-beats"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:writtenAs>dur</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-emit">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The emit production of BeatScript&apos;s grammar (a line of a def body: what an out port carries).</skos:definition>
		<skos:prefLabel xml:lang="en">emit</skos:prefLabel>
		<ns:ebnf>&quot;emit&quot; [ type | &quot;out&quot; ] tokens</ns:ebnf>
		<ns:grammarSection xml:lang="en">Typed ports</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-emit"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-out"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-tokens"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-type"/>
		<ns:writtenAs>emit</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-end">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The end production of BeatScript&apos;s grammar (a song ends after its last section by default).</skos:definition>
		<skos:prefLabel xml:lang="en">end</skos:prefLabel>
		<ns:ebnf>&quot;end&quot; [ &quot;at&quot; &quot;bar&quot; INT | &quot;after&quot; NAME ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-after"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-at"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bar"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-end"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>end</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-engine">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The engine production of BeatScript&apos;s grammar (no target, or control:; at bar 16: tempo 128 -&gt; 140 over 4 bars; the booth&apos;s: the desktop app plays these; macro riser on A over 8 bars: the DJ macro catalogue, by id; MACRO is macro or macro@1).</skos:definition>
		<skos:prefLabel xml:lang="en">engine</skos:prefLabel>
		<ns:ebnf>&quot;crossfader&quot; change | &quot;tempo&quot; tempo | &quot;swap&quot; &quot;pairs&quot; [ &quot;with&quot; MOVE ] | &quot;move&quot; MOVE &quot;on&quot; deck [ span ] | &quot;load&quot; &quot;pair&quot; SPEC [ &quot;group&quot; INT ] | &quot;queue&quot; ( &quot;play&quot; | &quot;pause&quot; | &quot;stop&quot; | &quot;next&quot; | &quot;loop&quot; | &quot;jump&quot; INT | &quot;add&quot; WORD ) | MACRO NAME ( &quot;on&quot; deck [ span ] | span &quot;on&quot; deck )</ns:ebnf>
		<ns:grammarSection xml:lang="en">Control: what the mix does</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-add"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-crossfader"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-group"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-jump"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-load"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-loop"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-move"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-next"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-on"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-pair"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-pairs"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-pause"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-play"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-queue"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-stop"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-swap"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-tempo"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-with"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-change"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-deck"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-lexical-move"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-lexical-spec"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-span"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-tempo"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-macro"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-word"/>
		<ns:writtenAs>engine</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-escape">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The escape production of BeatScript&apos;s grammar (PHONES (beatscript-v1): aa ae uh aw eh er ii ee uu oo ay ie oy ow oh p b t d k g f v s z sh zh th dh h m n ng l r w y ch j, &quot;_&quot; a rest, &quot;-&quot; cuts a word, &quot;:&quot; holds a vowel one more note, &quot;!&quot; accents it).</skos:definition>
		<skos:prefLabel xml:lang="en">escape</skos:prefLabel>
		<ns:ebnf>&quot;/&quot; PHONES &quot;/&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mix moves and sung lyrics</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-slash"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-phones"/>
		<ns:writtenAs>escape</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-evolve">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The evolve production of BeatScript&apos;s grammar (a rule a line; the bound last).</skos:definition>
		<skos:prefLabel xml:lang="en">evolve</skos:prefLabel>
		<ns:ebnf>&quot;evolve&quot; &quot;every&quot; INT &quot;bars&quot; &quot;{&quot; { NEWLINE } { rule NEWLINE { NEWLINE } } [ bound NEWLINE { NEWLINE } ] &quot;}&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Evolving</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bars"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-every"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-evolve"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-brace"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-brace"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-bound"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-rule"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-newline"/>
		<ns:writtenAs>evolve</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-expr">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The expr production of BeatScript&apos;s grammar (a guard: kept when it is true).</skos:definition>
		<skos:prefLabel xml:lang="en">expr</skos:prefLabel>
		<ns:ebnf>or</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-or"/>
		<ns:writtenAs>expr</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-form">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The form production of BeatScript&apos;s grammar (a form inside another takes no phrase: forms nest 3 deep).</skos:definition>
		<skos:prefLabel xml:lang="en">form</skos:prefLabel>
		<ns:ebnf>&quot;template&quot; &quot;(&quot; NAME { &quot;,&quot; binding } &quot;)&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Phrase templates</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-template"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-binding"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>form</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-gen-param">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The gen_param production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">gen_param</skos:prefLabel>
		<ns:ebnf>&quot;bpm&quot; &quot;=&quot; NUMBER | &quot;key&quot; &quot;=&quot; KEY | &quot;length&quot; &quot;=&quot; ( &quot;short&quot; | &quot;standard&quot; | &quot;long&quot; ) | &quot;section&quot; &quot;=&quot; NAME | &quot;part&quot; &quot;=&quot; role</ns:ebnf>
		<ns:grammarSection xml:lang="en">Start from a seed</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bpm"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-key"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-length"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-long"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-part"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-section"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-short"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-standard"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-equals"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-role"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-key"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-number"/>
		<ns:writtenAs>gen_param</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-gen">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The gen production of BeatScript&apos;s grammar (gen@2 techno seed=42 section=drop part=bass: the seeded generator, called; GEN is gen@2 or a bare gen).</skos:definition>
		<skos:prefLabel xml:lang="en">gen</skos:prefLabel>
		<ns:ebnf>GEN NAME &quot;seed&quot; &quot;=&quot; ( INT | NAME ) { gen_param }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Start from a seed</ns:grammarSection>
		<ns:hostOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:hostOnly>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-seed"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-equals"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-gen-param"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-gen"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>gen</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-guard">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The guard production of BeatScript&apos;s grammar (kept where it holds).</skos:definition>
		<skos:prefLabel xml:lang="en">guard</skos:prefLabel>
		<ns:ebnf>&quot;when&quot; expr</ns:ebnf>
		<ns:grammarSection xml:lang="en">Lines: when, where, what</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-when"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-expr"/>
		<ns:writtenAs>guard</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-headed">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The headed production of BeatScript&apos;s grammar (a deck&apos;s parts: no time word before them; the control deck; a def&apos;s call, a duck and a mix name their decks themselves).</skos:definition>
		<skos:prefLabel xml:lang="en">headed</skos:prefLabel>
		<ns:ebnf>&quot;deck&quot; deck &quot;:&quot; parts [ guard ] | [ timing &quot;:&quot; ] [ target &quot;:&quot; ] control [ cguard ] | [ timing &quot;:&quot; ] &quot;control&quot; &quot;:&quot; ( engine | do | duck | mix ) [ cguard ] | [ timing &quot;:&quot; ] ( invoke | duck | mix ) [ cguard ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Lines: when, where, what</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-control"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-deck"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-colon"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-cguard"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-control"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-deck"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-do"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-duck"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-engine"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-guard"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-invoke"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-mix"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-parts"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-target"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-timing"/>
		<ns:writtenAs>headed</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-import">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The import production of BeatScript&apos;s grammar (a snippet&apos;s name in quotes, or its CID).</skos:definition>
		<skos:prefLabel xml:lang="en">import</skos:prefLabel>
		<ns:ebnf>&quot;import&quot; ( NAME | STRING )</ns:ebnf>
		<ns:grammarSection xml:lang="en">Radio: stations</ns:grammarSection>
		<ns:hostOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:hostOnly>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-import"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-string"/>
		<ns:writtenAs>import</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-input">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The input production of BeatScript&apos;s grammar (performed: only in a control value or guard; PITCH: a note with its octave, c4).</skos:definition>
		<skos:prefLabel xml:lang="en">input</skos:prefLabel>
		<ns:ebnf>&quot;knob&quot; &quot;(&quot; INT &quot;)&quot; | &quot;pad&quot; &quot;(&quot; INT &quot;)&quot; | &quot;fader&quot; &quot;(&quot; deck &quot;)&quot; | &quot;held&quot; &quot;(&quot; &quot;key&quot; &quot;)&quot; | &quot;held&quot; &quot;(&quot; PITCH &quot;)&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-fader"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-held"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-key"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-knob"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-pad"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-deck"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-pitch"/>
		<ns:writtenAs>input</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-invoke">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The invoke production of BeatScript&apos;s grammar (a def&apos;s call).</skos:definition>
		<skos:prefLabel xml:lang="en">invoke</skos:prefLabel>
		<ns:ebnf>NAME &quot;(&quot; [ tokens { &quot;,&quot; tokens } ] &quot;)&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-tokens"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>invoke</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-launch">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The launch production of BeatScript&apos;s grammar (a hit of the pad brings the scene, a section or an arrangement, in on that bar line: 8 bars by default).</skos:definition>
		<skos:prefLabel xml:lang="en">launch</skos:prefLabel>
		<ns:ebnf>&quot;launch&quot; NAME &quot;on&quot; &quot;pad&quot; &quot;(&quot; INT &quot;)&quot; [ &quot;next&quot; ( &quot;bar&quot; | &quot;phrase&quot; [ &quot;8&quot; | &quot;16&quot; | &quot;32&quot; ] ) ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-16"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-32"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-8"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bar"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-launch"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-next"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-on"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-pad"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-phrase"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>launch</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-ldeck">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The ldeck production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">ldeck</skos:prefLabel>
		<ns:ebnf>&quot;A&quot; | &quot;B&quot; | &quot;master&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Assertions</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-a"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-b"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-master"/>
		<ns:writtenAs>ldeck</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-let">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The let production of BeatScript&apos;s grammar (one token is a value; more tokens are a pattern).</skos:definition>
		<skos:prefLabel xml:lang="en">let</skos:prefLabel>
		<ns:ebnf>&quot;let&quot; NAME &quot;=&quot; ( sexpr | arith | ref | TOKEN { TOKEN } )</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-let"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-equals"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-ref"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-sexpr"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-token"/>
		<ns:writtenAs>let</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-leveldeck">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The leveldeck production of BeatScript&apos;s grammar (a level read: it names a deck).</skos:definition>
		<skos:prefLabel xml:lang="en">leveldeck</skos:prefLabel>
		<ns:ebnf>{ lfactor lop } ldeck { lop lfactor }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Assertions</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-ldeck"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-lfactor"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-lop"/>
		<ns:writtenAs>leveldeck</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-levelexpr">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The levelexpr production of BeatScript&apos;s grammar (arithmetic over the words A, B and master: their levels).</skos:definition>
		<skos:prefLabel xml:lang="en">levelexpr</skos:prefLabel>
		<ns:ebnf>lterm { ( &quot;+&quot; | &quot;-&quot; ) lterm }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Assertions</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-minus"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-plus"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-lterm"/>
		<ns:writtenAs>levelexpr</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-lexical-move">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The MOVE production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">MOVE</skos:prefLabel>
		<ns:ebnf>&quot;filter_exit&quot; | &quot;echo_out&quot; | &quot;loop_roll&quot; | &quot;bass_swap&quot; | &quot;phrase_sync&quot; | &quot;vocoder_handoff&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Control: what the mix does</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bass-swap"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-echo-out"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-filter-exit"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-loop-roll"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-phrase-sync"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-vocoder-handoff"/>
		<ns:writtenAs>MOVE</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-lexical-spec">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The SPEC production of BeatScript&apos;s grammar (dnb:2602 acid-bass).</skos:definition>
		<skos:prefLabel xml:lang="en">SPEC</skos:prefLabel>
		<ns:ebnf>NAME &quot;:&quot; INT | NAME</ns:ebnf>
		<ns:grammarSection xml:lang="en">Control: what the mix does</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-colon"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>SPEC</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-lexical-time">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The TIME production of BeatScript&apos;s grammar (units glued: 20m 90s 1h 3m30s).</skos:definition>
		<skos:prefLabel xml:lang="en">TIME</skos:prefLabel>
		<ns:ebnf>DECIMAL UNIT { DECIMAL UNIT }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Sets, samples, imports</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-decimal"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-unit"/>
		<ns:writtenAs>TIME</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-lexical-transition">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The TRANSITION production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">TRANSITION</skos:prefLabel>
		<ns:ebnf>&quot;crossfade&quot; | &quot;filter_exit&quot; | &quot;echo_out&quot; | &quot;cut&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Sets, samples, imports</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-crossfade"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-cut"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-echo-out"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-filter-exit"/>
		<ns:writtenAs>TRANSITION</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-lfactor">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The lfactor production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">lfactor</skos:prefLabel>
		<ns:ebnf>NUMBER | ldeck | &quot;(&quot; levelexpr &quot;)&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Assertions</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-ldeck"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-levelexpr"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-number"/>
		<ns:writtenAs>lfactor</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-lfo">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The lfo production of BeatScript&apos;s grammar (lfo sine 2 bars center=3k depth=1k).</skos:definition>
		<skos:prefLabel xml:lang="en">lfo</skos:prefLabel>
		<ns:ebnf>&quot;lfo&quot; wave dur { &quot;depth=&quot; value | &quot;center=&quot; value | &quot;phase=&quot; NUMBER } [ span ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Shapes and lfo</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-center-param"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-depth-param"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-lfo"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-phase-param"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-dur"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-span"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-value"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-wave"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-number"/>
		<ns:writtenAs>lfo</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-license">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The license production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">license</skos:prefLabel>
		<ns:ebnf>&quot;cc0&quot; | &quot;cc-by&quot; | &quot;all-rights-reserved&quot; | &quot;restricted-private&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Radio: stations</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-all-rights-reserved"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-cc-by"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-cc0"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-restricted-private"/>
		<ns:writtenAs>license</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-line">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The line production of BeatScript&apos;s grammar (a comment is &quot;#&quot; to the end of the line; it is not a token).</skos:definition>
		<skos:prefLabel xml:lang="en">line</skos:prefLabel>
		<ns:ebnf>[ statement ] NEWLINE</ns:ebnf>
		<ns:grammarSection xml:lang="en">Programs and lines</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-statement"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-newline"/>
		<ns:writtenAs>line</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-loop">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The loop production of BeatScript&apos;s grammar (a song starts again at its end).</skos:definition>
		<skos:prefLabel xml:lang="en">loop</skos:prefLabel>
		<ns:ebnf>&quot;loop&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-loop"/>
		<ns:writtenAs>loop</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-lop">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The lop production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">lop</skos:prefLabel>
		<ns:ebnf>&quot;+&quot; | &quot;-&quot; | &quot;*&quot; | &quot;/&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Assertions</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-minus"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-plus"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-slash"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-star"/>
		<ns:writtenAs>lop</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-lterm">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The lterm production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">lterm</skos:prefLabel>
		<ns:ebnf>lfactor { ( &quot;*&quot; | &quot;/&quot; ) lfactor }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Assertions</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-slash"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-star"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-lfactor"/>
		<ns:writtenAs>lterm</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-lyric-text">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The lyric_text production of BeatScript&apos;s grammar (&quot;/&quot; and a space is a phrase break; &quot;/&quot; and a phoneme opens an escape, to the next &quot;/&quot; (with none, a break too); a word touching &quot;=&quot; before an escape is its label, kept and not sung: jingle=/j ii ng g uh l/).</skos:definition>
		<skos:prefLabel xml:lang="en">lyric_text</skos:prefLabel>
		<ns:ebnf>{ TEXT | &quot;/&quot; SPACE | escape } [ &quot;/&quot; { TEXT } ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mix moves and sung lyrics</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-slash"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-escape"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-space"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-text"/>
		<ns:writtenAs>lyric_text</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-lyric">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The lyric production of BeatScript&apos;s grammar (its text is lyric_text; docs/beatscript/phonemes.md).</skos:definition>
		<skos:prefLabel xml:lang="en">lyric</skos:prefLabel>
		<ns:ebnf>STRING</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mix moves and sung lyrics</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-string"/>
		<ns:writtenAs>lyric</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-mark">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The mark production of BeatScript&apos;s grammar (accent ghost slide flam ratchet, any order).</skos:definition>
		<skos:prefLabel xml:lang="en">mark</skos:prefLabel>
		<ns:ebnf>( &quot;!&quot; | GHOST ) [ &quot;^&quot; ] [ &quot;&amp;&quot; ] [ RATCHET ] | &quot;^&quot; [ &quot;!&quot; | GHOST ] [ &quot;&amp;&quot; ] [ RATCHET ] | &quot;&amp;&quot; [ RATCHET ] | RATCHET</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mini-notation: the rhythm of a part</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-ampersand"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-bang"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-caret"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-ghost"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-ratchet"/>
		<ns:writtenAs>mark</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-mix">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The mix production of BeatScript&apos;s grammar (in a section: put back where the section ends).</skos:definition>
		<skos:prefLabel xml:lang="en">mix</skos:prefLabel>
		<ns:ebnf>&quot;mix&quot; &quot;{&quot; { NEWLINE } mixitem { ( &quot;,&quot; | NEWLINE ) { NEWLINE } mixitem } { NEWLINE } &quot;}&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mix moves and sung lyrics</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-mix"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-brace"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-brace"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-mixitem"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-newline"/>
		<ns:writtenAs>mix</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-mixitem">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The mixitem production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">mixitem</skos:prefLabel>
		<ns:ebnf>deck &quot;level&quot; arith | deck &quot;eq&quot; band arith [ &quot;db&quot; ] | &quot;master&quot; &quot;level&quot; arith | deck &quot;pan&quot; arith</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mix moves and sung lyrics</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-db"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-eq"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-level"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-master"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-pan"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-band"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-deck"/>
		<ns:writtenAs>mixitem</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-mut-op">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The mut_op production of BeatScript&apos;s grammar (rot 2 thin 0.1 oct -1 morph b 0.5 jux rev: the operators of &quot;Arrange mutations&quot;).</skos:definition>
		<skos:prefLabel xml:lang="en">mut_op</skos:prefLabel>
		<ns:ebnf>NAME { NUMBER | &quot;-&quot; NUMBER | NAME }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arrange mutations</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-minus"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-number"/>
		<ns:writtenAs>mut_op</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-mut-target">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The mut_target production of BeatScript&apos;s grammar (a let pattern, or a glob: acid_*).</skos:definition>
		<skos:prefLabel xml:lang="en">mut_target</skos:prefLabel>
		<ns:ebnf>GLOB | NAME</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arrange mutations</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-glob"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>mut_target</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-mutation">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The mutation production of BeatScript&apos;s grammar (~ from here on, @ the next section only; ~3: every 3rd pass).</skos:definition>
		<skos:prefLabel xml:lang="en">mutation</skos:prefLabel>
		<ns:ebnf>( &quot;~&quot; | &quot;@&quot; ) [ INT ] mut_target mut_op { &quot;|&quot; mut_op } { &quot;,&quot; mut_target mut_op { &quot;|&quot; mut_op } }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arrange mutations</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-at"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-bar"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-tilde"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-mut-op"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-mut-target"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:writtenAs>mutation</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-not">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The not production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">not</skos:prefLabel>
		<ns:ebnf>[ &quot;not&quot; ] compare</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-not"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-compare"/>
		<ns:writtenAs>not</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-notes">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The notes production of BeatScript&apos;s grammar (a bar, or bars one after another).</skos:definition>
		<skos:prefLabel xml:lang="en">notes</skos:prefLabel>
		<ns:ebnf>&quot;[&quot; pattern &quot;]&quot; | &quot;&lt;&quot; &quot;[&quot; pattern &quot;]&quot; { &quot;[&quot; pattern &quot;]&quot; } &quot;&gt;&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Phrase templates</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-bracket"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-gt"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-lt"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-bracket"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-pattern"/>
		<ns:writtenAs>notes</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-op">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The op production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">op</skos:prefLabel>
		<ns:ebnf>( &quot;rotate&quot; | &quot;transpose&quot; | &quot;octave&quot; | &quot;invert&quot; | &quot;reverse&quot; | &quot;thin&quot; ) { NUMBER | &quot;&lt;&quot; NUMBER { NUMBER } &quot;&gt;&quot; } [ &quot;seed=&quot; INT ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Evolving</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-invert"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-octave"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-reverse"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-rotate"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-seed-param"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-gt"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-lt"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-thin"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-transpose"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-number"/>
		<ns:writtenAs>op</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-operand">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The operand production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">operand</skos:prefLabel>
		<ns:ebnf>sum | WORD</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-sum"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-word"/>
		<ns:writtenAs>operand</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-or">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The or production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">or</skos:prefLabel>
		<ns:ebnf>and { &quot;or&quot; and }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-or"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-and"/>
		<ns:writtenAs>or</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-param">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The param production of BeatScript&apos;s grammar (vel=70..100 oct=2 len=3 inst=sub-bass glide=60; a switch, on when it is bare).</skos:definition>
		<skos:prefLabel xml:lang="en">param</skos:prefLabel>
		<ns:ebnf>pname &quot;=&quot; pvalue | &quot;voice-lead&quot; [ &quot;=&quot; ( &quot;on&quot; | &quot;off&quot; ) ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Parts</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-off"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-on"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-equals"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-voice-lead"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-pname"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-pvalue"/>
		<ns:writtenAs>param</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-pargs">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The pargs production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">pargs</skos:prefLabel>
		<ns:ebnf>{ pexpr &quot;,&quot; } pitem { &quot;,&quot; pexpr }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Parts</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-pexpr"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-pitem"/>
		<ns:writtenAs>pargs</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-part">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The part production of BeatScript&apos;s grammar (hihat/12 x x ~ x : a cycle of 12 sixteenths; bass seed(techno, 42)[17..24]: a generated part&apos;s bars; bass &lt;cid&gt;.drop: a stored program&apos;s).</skos:definition>
		<skos:prefLabel xml:lang="en">part</skos:prefLabel>
		<ns:ebnf>role [ &quot;/&quot; INT ] pattern { param } | role ref { param }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Parts</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-slash"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-param"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-pattern"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-ref"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-role"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:writtenAs>part</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-parts">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The parts production of BeatScript&apos;s grammar (only after &quot;deck X:&quot; and with no time word).</skos:definition>
		<skos:prefLabel xml:lang="en">parts</skos:prefLabel>
		<ns:ebnf>pitem { &quot;|&quot; pitem }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Parts</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-bar"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-pitem"/>
		<ns:writtenAs>parts</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-pattern">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The pattern production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">pattern</skos:prefLabel>
		<ns:ebnf>term { term }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mini-notation: the rhythm of a part</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-term"/>
		<ns:writtenAs>pattern</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-pexpr">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The pexpr production of BeatScript&apos;s grammar (silence: the unit of both).</skos:definition>
		<skos:prefLabel xml:lang="en">pexpr</skos:prefLabel>
		<ns:ebnf>pitem | &quot;silence&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Parts</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-silence"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-pitem"/>
		<ns:writtenAs>pexpr</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-pitem">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The pitem production of BeatScript&apos;s grammar (each item between `|` has a part in it; over parts: `stack` is `|`; over parts: the per-bar alternation &lt;p q&gt;).</skos:definition>
		<skos:prefLabel xml:lang="en">pitem</skos:prefLabel>
		<ns:ebnf>part | &quot;stack&quot; &quot;(&quot; pargs &quot;)&quot; | &quot;then&quot; &quot;(&quot; pargs &quot;)&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Parts</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-stack"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-then"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-pargs"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-part"/>
		<ns:writtenAs>pitem</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-pname">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The pname production of BeatScript&apos;s grammar (velocity, octave, length, voice, its generators&apos; seed, a drum kit, a sound, where it plays; tonal, an 808: glide= decay= ms, pitch-drop= 1 to 24 semitones).</skos:definition>
		<skos:prefLabel xml:lang="en">pname</skos:prefLabel>
		<ns:ebnf>&quot;vel&quot; | &quot;oct&quot; | &quot;len&quot; | &quot;inst&quot; | &quot;seed&quot; | &quot;kit&quot; | &quot;sound&quot; | &quot;route&quot; | &quot;glide&quot; | &quot;decay&quot; | &quot;pitch-drop&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Parts</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-decay"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-glide"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-inst"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-kit"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-len"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-oct"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-pitch-drop"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-route"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-seed"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-sound"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-vel"/>
		<ns:writtenAs>pname</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-port">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The port production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">port</skos:prefLabel>
		<ns:ebnf>type | &quot;in&quot; | &quot;out&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Typed ports</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-in"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-out"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-type"/>
		<ns:writtenAs>port</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-pos">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The pos production of BeatScript&apos;s grammar (bar 16 bar 16 beat 3 a beat is 0 to 3).</skos:definition>
		<skos:prefLabel xml:lang="en">pos</skos:prefLabel>
		<ns:ebnf>&quot;bar&quot; arith [ &quot;beat&quot; arith ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Lines: when, where, what</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bar"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-beat"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:writtenAs>pos</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-primary">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The primary production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">primary</skos:prefLabel>
		<ns:ebnf>NUMBER | PARAM | &quot;(&quot; arith &quot;)&quot; | ( &quot;min&quot; | &quot;max&quot; ) &quot;(&quot; arith { &quot;,&quot; arith } &quot;)&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-max"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-min"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-number"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-param"/>
		<ns:writtenAs>primary</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-prob">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The prob production of BeatScript&apos;s grammar (0 to 1, or a percent: ?0.3 ?30% ?(1 / 4)).</skos:definition>
		<skos:prefLabel xml:lang="en">prob</skos:prefLabel>
		<ns:ebnf>NUMBER | &quot;(&quot; arith &quot;)&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Degrees, Roman numerals, chance</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-number"/>
		<ns:writtenAs>prob</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-product">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The product production of BeatScript&apos;s grammar (&quot;/&quot; is exact; &quot;%&quot; is Euclidean).</skos:definition>
		<skos:prefLabel xml:lang="en">product</skos:prefLabel>
		<ns:ebnf>unary { ( &quot;*&quot; | &quot;/&quot; | &quot;%&quot; ) unary }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-percent"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-slash"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-star"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-unary"/>
		<ns:writtenAs>product</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-program">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The program production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">program</skos:prefLabel>
		<ns:ebnf>{ line }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Programs and lines</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-line"/>
		<ns:writtenAs>program</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-pvalue">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The pvalue production of BeatScript&apos;s grammar (a number, a range drawn per hit, a name; a $name in a body).</skos:definition>
		<skos:prefLabel xml:lang="en">pvalue</skos:prefLabel>
		<ns:ebnf>arith [ &quot;..&quot; arith ] | WORD | PARAM</ns:ebnf>
		<ns:grammarSection xml:lang="en">Parts</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-range"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-param"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-word"/>
		<ns:writtenAs>pvalue</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-ref">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The ref production of BeatScript&apos;s grammar (music from elsewhere, written out as BeatScript before the program is read).</skos:definition>
		<skos:prefLabel xml:lang="en">ref</skos:prefLabel>
		<ns:ebnf>seed | gen | stored</ns:ebnf>
		<ns:grammarSection xml:lang="en">Start from a seed</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-gen"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-seed"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-stored"/>
		<ns:writtenAs>ref</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-repeat">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The repeat production of BeatScript&apos;s grammar (the count is written out, 1 to 64).</skos:definition>
		<skos:prefLabel xml:lang="en">repeat</skos:prefLabel>
		<ns:ebnf>&quot;repeat&quot; INT [ &quot;every&quot; INT &quot;bars&quot; ] &quot;{&quot; { body_line } &quot;}&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bars"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-every"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-repeat"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-brace"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-brace"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-body-line"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:writtenAs>repeat</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-role">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The role production of BeatScript&apos;s grammar (drum parts: a hit plays the drum&apos;s note; tonal parts: a hit plays the key&apos;s root).</skos:definition>
		<skos:prefLabel xml:lang="en">role</skos:prefLabel>
		<ns:ebnf>&quot;kick&quot; | &quot;snare&quot; | &quot;hihat&quot; | &quot;clap&quot; | &quot;bass&quot; | &quot;melody&quot; | &quot;harmony&quot; | &quot;arp&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Parts</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-arp"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bass"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-clap"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-harmony"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-hihat"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-kick"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-melody"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-snare"/>
		<ns:writtenAs>role</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-rule">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The rule production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">rule</skos:prefLabel>
		<ns:ebnf>( role | &quot;deck&quot; deck ) &quot;:&quot; op { &quot;|&quot; op } [ &quot;when&quot; &quot;gen&quot; [ &quot;%&quot; INT ] cmp INT ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Evolving</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-deck"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-gen"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-bar"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-colon"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-percent"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-when"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-cmp"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-deck"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-op"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-role"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:writtenAs>rule</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-sample">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The sample production of BeatScript&apos;s grammar (restricted sounds: a local file, an Apple Loop by its hash).</skos:definition>
		<skos:prefLabel xml:lang="en">sample</skos:prefLabel>
		<ns:ebnf>&quot;sample&quot; NAME &quot;from&quot; STRING [ &quot;license&quot; license ] [ &quot;else&quot; NAME ] | &quot;loop&quot; STRING &quot;as&quot; NAME [ &quot;else&quot; NAME ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Radio: stations</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-as"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-else"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-from"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-license"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-loop"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-sample"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-license"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-string"/>
		<ns:writtenAs>sample</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-section">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The section production of BeatScript&apos;s grammar (1 to 256 bars; a `key` may open the body; section intro from seed(techno, 42)[1..8] section hook from &lt;cid&gt;.drop).</skos:definition>
		<skos:prefLabel xml:lang="en">section</skos:prefLabel>
		<ns:ebnf>&quot;section&quot; NAME INT &quot;bars&quot; &quot;{&quot; { line } &quot;}&quot; | &quot;section&quot; NAME &quot;from&quot; ref</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bars"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-from"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-section"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-brace"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-brace"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-line"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-ref"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>section</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-seed">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The seed production of BeatScript&apos;s grammar (a track of the beats generator: genre, seed; a part, bars from 1).</skos:definition>
		<skos:prefLabel xml:lang="en">seed</skos:prefLabel>
		<ns:ebnf>&quot;seed&quot; &quot;(&quot; NAME &quot;,&quot; INT [ &quot;,&quot; structure ] &quot;)&quot; [ &quot;.&quot; role ] [ &quot;[&quot; INT [ &quot;..&quot; INT ] &quot;]&quot; ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Start from a seed</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-seed"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-bracket"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-dot"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-bracket"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-range"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-role"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-structure"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>seed</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-set-mix">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The set_mix production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">set_mix</skos:prefLabel>
		<ns:ebnf>&quot;mix&quot; INT ( &quot;bar&quot; | &quot;bars&quot; ) &quot;with&quot; TRANSITION [ &quot;,&quot; &quot;tempo&quot; NUMBER &quot;-&gt;&quot; NUMBER ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Sets, samples, imports</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bar"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bars"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-mix"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-arrow"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-tempo"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-with"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-lexical-transition"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-number"/>
		<ns:writtenAs>set_mix</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-set-next">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The set_next production of BeatScript&apos;s grammar (the track before it, a generator call, with its seed stepped).</skos:definition>
		<skos:prefLabel xml:lang="en">set_next</skos:prefLabel>
		<ns:ebnf>&quot;next&quot; step [ &quot;until&quot; until_when ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Sets, samples, imports</ns:grammarSection>
		<ns:hostOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:hostOnly>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-next"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-until"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-step"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-until-when"/>
		<ns:writtenAs>set_next</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-set-play">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The set_play production of BeatScript&apos;s grammar (a saved program, its CID in the canonical text, or a generator call).</skos:definition>
		<skos:prefLabel xml:lang="en">set_play</skos:prefLabel>
		<ns:ebnf>&quot;play&quot; ( NAME | STRING | gen ) [ &quot;until&quot; until_when ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Sets, samples, imports</ns:grammarSection>
		<ns:hostOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:hostOnly>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-play"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-until"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-gen"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-until-when"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-string"/>
		<ns:writtenAs>set_play</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-set">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The set production of BeatScript&apos;s grammar (programs of programs: an item a line).</skos:definition>
		<skos:prefLabel xml:lang="en">set</skos:prefLabel>
		<ns:ebnf>&quot;set&quot; &quot;{&quot; { NEWLINE } { ( set_play | set_mix | set_next ) NEWLINE { NEWLINE } } &quot;}&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Sets, samples, imports</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-set"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-brace"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-brace"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-set-mix"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-set-next"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-set-play"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-newline"/>
		<ns:writtenAs>set</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-setting">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The setting production of BeatScript&apos;s grammar (a setting reads no input: it is the program&apos;s own).</skos:definition>
		<skos:prefLabel xml:lang="en">setting</skos:prefLabel>
		<ns:ebnf>&quot;tempo&quot; tempo | &quot;swing&quot; arith | &quot;key&quot; KEY</ns:ebnf>
		<ns:grammarSection xml:lang="en">Settings</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-key"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-swing"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-tempo"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-tempo"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-key"/>
		<ns:writtenAs>setting</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-sexpr">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The sexpr production of BeatScript&apos;s grammar (a section, or a let that names a composition; the empty section; at the same time; one after another).</skos:definition>
		<skos:prefLabel xml:lang="en">sexpr</skos:prefLabel>
		<ns:ebnf>NAME | &quot;silence&quot; | &quot;stack&quot; &quot;(&quot; sexpr { &quot;,&quot; sexpr } &quot;)&quot; | &quot;then&quot; &quot;(&quot; sexpr { &quot;,&quot; sexpr } &quot;)&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-silence"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-stack"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-then"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-sexpr"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>sexpr</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-shape">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The shape production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">shape</skos:prefLabel>
		<ns:ebnf>&quot;linear&quot; | &quot;exp&quot; | &quot;log&quot; | &quot;s-curve&quot; | &quot;step&quot; INT</ns:ebnf>
		<ns:grammarSection xml:lang="en">Shapes and lfo</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-exp"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-linear"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-log"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-s-curve"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-step"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:writtenAs>shape</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-sing">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The sing production of BeatScript&apos;s grammar (a tonal role; PHRASE: a phrasebook id, @hands_up).</skos:definition>
		<skos:prefLabel xml:lang="en">sing</skos:prefLabel>
		<ns:ebnf>&quot;sing&quot; ( lyric | PHRASE ) &quot;on&quot; role { &quot;bars=&quot; INT | &quot;key=&quot; KEY | &quot;voice=&quot; NAME }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mix moves and sung lyrics</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bars-param"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-key-param"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-on"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-sing"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-voice-param"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-lyric"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-role"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-key"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-phrase"/>
		<ns:writtenAs>sing</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-source">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The source production of BeatScript&apos;s grammar (an engine call; a public-domain theme by id (ode_to_joy); notes; another template; a stored program&apos;s part or sections).</skos:definition>
		<skos:prefLabel xml:lang="en">source</skos:prefLabel>
		<ns:ebnf>gen | NAME | notes | form | stored</ns:ebnf>
		<ns:grammarSection xml:lang="en">Phrase templates</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-form"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-gen"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-notes"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-stored"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>source</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-span">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The span production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">span</skos:prefLabel>
		<ns:ebnf>&quot;over&quot; dur</ns:ebnf>
		<ns:grammarSection xml:lang="en">Control: what the mix does</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-over"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-dur"/>
		<ns:writtenAs>span</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-start">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The start production of BeatScript&apos;s grammar (the named arrangement that plays first; default the first written).</skos:definition>
		<skos:prefLabel xml:lang="en">start</skos:prefLabel>
		<ns:ebnf>&quot;start&quot; NAME</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-start"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>start</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-statement">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The statement production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">statement</skos:prefLabel>
		<ns:ebnf>setting | headed | let | def | repeat | section | arrange | arrange_block | start | launch | import | end | loop | evolve | wire | assert | sample | use | set | station</ns:ebnf>
		<ns:grammarSection xml:lang="en">Programs and lines</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arrange-block"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arrange"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-assert"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-def"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-end"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-evolve"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-headed"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-import"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-launch"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-let"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-loop"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-repeat"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-sample"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-section"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-set"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-setting"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-start"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-station"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-use"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-wire"/>
		<ns:writtenAs>statement</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-station-line">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The station_line production of BeatScript&apos;s grammar (the first track&apos;s call; the step from a track to the next; the forms in turn).</skos:definition>
		<skos:prefLabel xml:lang="en">station_line</skos:prefLabel>
		<ns:ebnf>&quot;from&quot; gen | &quot;next&quot; step | &quot;forms&quot; NAME { NAME }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Radio: stations</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-forms"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-from"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-next"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-gen"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-step"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>station_line</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-station">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The station production of BeatScript&apos;s grammar (endless and deterministic: position N is always the same track).</skos:definition>
		<skos:prefLabel xml:lang="en">station</skos:prefLabel>
		<ns:ebnf>&quot;station&quot; &quot;{&quot; { NEWLINE } { station_line NEWLINE { NEWLINE } } &quot;}&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Radio: stations</ns:grammarSection>
		<ns:hostOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:hostOnly>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-station"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-brace"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-brace"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-station-line"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-newline"/>
		<ns:writtenAs>station</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-step">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The step production of BeatScript&apos;s grammar (seed=+1 counts on; seed=~ draws from a hash of the track before&apos;s CID).</skos:definition>
		<skos:prefLabel xml:lang="en">step</skos:prefLabel>
		<ns:ebnf>&quot;seed&quot; &quot;=&quot; ( &quot;+&quot; INT | &quot;~&quot; )</ns:ebnf>
		<ns:grammarSection xml:lang="en">Radio: stations</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-seed"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-equals"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-plus"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-tilde"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:writtenAs>step</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-stored">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The stored production of BeatScript&apos;s grammar (a saved program&apos;s section or part, by its CID: &lt;cid&gt;.drop &lt;cid&gt;.drop.bass; a bare &lt;cid&gt; is a program with no sections).</skos:definition>
		<skos:prefLabel xml:lang="en">stored</skos:prefLabel>
		<ns:ebnf>CID [ &quot;.&quot; NAME ] [ &quot;.&quot; role ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Start from a seed</ns:grammarSection>
		<ns:hostOnly rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns:hostOnly>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-dot"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-role"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-cid"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:writtenAs>stored</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-structure">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The structure production of BeatScript&apos;s grammar (the generator&apos;s song structures; standard is the default).</skos:definition>
		<skos:prefLabel xml:lang="en">structure</skos:prefLabel>
		<ns:ebnf>&quot;standard&quot; | &quot;loop&quot; | &quot;minimal&quot; | &quot;extended&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Start from a seed</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-extended"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-loop"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-minimal"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-standard"/>
		<ns:writtenAs>structure</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-subject">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The subject production of BeatScript&apos;s grammar (sing: the vocal; a deck; A.snare; bass on both decks).</skos:definition>
		<skos:prefLabel xml:lang="en">subject</skos:prefLabel>
		<ns:ebnf>&quot;sing&quot; | ldeck | [ ldeck &quot;.&quot; ] role</ns:ebnf>
		<ns:grammarSection xml:lang="en">Assertions</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-sing"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-dot"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-ldeck"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-role"/>
		<ns:writtenAs>subject</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-sum">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The sum production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">sum</skos:prefLabel>
		<ns:ebnf>product { ( &quot;+&quot; | &quot;-&quot; ) product }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-minus"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-plus"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-product"/>
		<ns:writtenAs>sum</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-target">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The target production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">target</skos:prefLabel>
		<ns:ebnf>&quot;deck&quot; deck | &quot;master&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Lines: when, where, what</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-deck"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-master"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-deck"/>
		<ns:writtenAs>target</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-template">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The template production of BeatScript&apos;s grammar (a template&apos;s name and a phrase, a phrasebook id or words in quotes: the phrase is the vocal line of a track; then a form&apos;s roles).</skos:definition>
		<skos:prefLabel xml:lang="en">template</skos:prefLabel>
		<ns:ebnf>&quot;template&quot; &quot;(&quot; NAME &quot;,&quot; ( PHRASE | STRING ) { &quot;,&quot; binding } &quot;)&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Phrase templates</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-comma"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-template"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-binding"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-name"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-phrase"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-string"/>
		<ns:writtenAs>template</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-tempo">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The tempo production of BeatScript&apos;s grammar (tempo 126 tempo 100 -&gt; 130 over 8 bars exp).</skos:definition>
		<skos:prefLabel xml:lang="en">tempo</skos:prefLabel>
		<ns:ebnf>arith [ &quot;-&gt;&quot; arith &quot;over&quot; dur [ shape ] ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Settings</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-over"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-arrow"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-dur"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-shape"/>
		<ns:writtenAs>tempo</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-term">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The term production of BeatScript&apos;s grammar (x*4 c2! e2^ x:3 x*8?0.7).</skos:definition>
		<skos:prefLabel xml:lang="en">term</skos:prefLabel>
		<ns:ebnf>atom [ mark ] [ &quot;*&quot; ( INT | &quot;(&quot; arith &quot;)&quot; ) ] { &quot;?&quot; [ prob ] } [ &quot;~&quot; INT ]</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mini-notation: the rhythm of a part</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-close-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-open-paren"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-question"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-star"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-tilde"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-arith"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-atom"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-mark"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-prob"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:writtenAs>term</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-time">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The time production of BeatScript&apos;s grammar (glued: 5ms).</skos:definition>
		<skos:prefLabel xml:lang="en">time</skos:prefLabel>
		<ns:ebnf>DECIMAL ( &quot;ms&quot; | &quot;s&quot; )</ns:ebnf>
		<ns:grammarSection xml:lang="en">Mix moves and sung lyrics</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-ms"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-s"/>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-decimal"/>
		<ns:writtenAs>time</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-timing">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The timing production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">timing</skos:prefLabel>
		<ns:ebnf>when [ &quot;for&quot; dur ] | &quot;for&quot; dur</ns:ebnf>
		<ns:grammarSection xml:lang="en">Lines: when, where, what</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-for"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-dur"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-when"/>
		<ns:writtenAs>timing</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-tokens">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The tokens production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">tokens</skos:prefLabel>
		<ns:ebnf>TOKEN { TOKEN }</ns:ebnf>
		<ns:grammarSection xml:lang="en">Structure: lets, defs, sections, the arrangement</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesToken rdf:resource="https://beatscript.app/ontology/concept/token-token"/>
		<ns:writtenAs>tokens</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-type">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The type production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">type</skos:prefLabel>
		<ns:ebnf>&quot;chords&quot; | &quot;key&quot; | &quot;bass&quot; | &quot;melody&quot; | &quot;drums&quot; | &quot;rhythm&quot; | &quot;bars&quot; | &quot;tempo&quot; | &quot;pattern&quot;</ns:ebnf>
		<ns:grammarSection xml:lang="en">Typed ports</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bars"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-bass"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-chords"/>
