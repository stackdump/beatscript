		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/markov-melody">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:definition xml:lang="en">A melody made by a chain in which the next scale degree depends on the current one and the position in the bar: strong beats land on the nearest chord tone, weak beats move by step or repeat. A density setting then turns the weakest-beat notes into rests, never the first step.</skos:definition>
		<skos:prefLabel xml:lang="en">Markov melody</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/markov-melody"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/modifier-accent">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternModifier"/>
		<skos:definition xml:lang="en">A term written c2! is accented: played louder than its neighbours.</skos:definition>
		<skos:prefLabel xml:lang="en">accent (!)</skos:prefLabel>
		<ns:markedBy rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-bang"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>!</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/modifier-chance">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternModifier"/>
		<skos:definition xml:lang="en">A term written x?p plays with probability p (0 to 1, or a percent), drawn from the program&apos;s seed so the same program always plays the same.</skos:definition>
		<skos:prefLabel xml:lang="en">chance (?p)</skos:prefLabel>
		<ns:markedBy rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-question"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>?</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/modifier-cycle">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternModifier"/>
		<skos:definition xml:lang="en">A part written hihat/12 has a cycle of n sixteenths instead of 16, so it drifts against the bar.</skos:definition>
		<skos:prefLabel xml:lang="en">cycle length (/n)</skos:prefLabel>
		<ns:markedBy rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-slash"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>/</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/modifier-repeat">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternModifier"/>
		<skos:definition xml:lang="en">A term written x*n plays n times in the time of one slot: hihat x*4 is four hits in one step.</skos:definition>
		<skos:prefLabel xml:lang="en">repeat (*n)</skos:prefLabel>
		<ns:markedBy rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-star"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>*</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/modifier-slide">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PatternModifier"/>
		<skos:definition xml:lang="en">A term written e2^ slides into the next note instead of re-attacking, as on an acid bass line.</skos:definition>
		<skos:prefLabel xml:lang="en">slide (^)</skos:prefLabel>
		<ns:markedBy rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-caret"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>^</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/monoidal-product">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#CategoricalConcept"/>
		<skos:definition xml:lang="en">Stacking parts side by side: two parts played together make one part whose net is the disjoint union of the two. Written with the tensor sign. Associative and symmetric: the order parts are listed in does not change what plays.</skos:definition>
		<skos:prefLabel xml:lang="en">monoidal product</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/monoidal-product"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/move-bass-swap">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PerformMove"/>
		<skos:definition xml:lang="en">Cut the outgoing deck&apos;s low end and bring in the incoming deck&apos;s, so two basslines never sound together.</skos:definition>
		<skos:prefLabel xml:lang="en">bass swap</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/move-bass-swap"/>
		<ns:status>stable</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/move-echo-out">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PerformMove"/>
		<skos:definition xml:lang="en">Feed the outgoing deck into a delay and cut the dry signal, leaving the echoes to trail away.</skos:definition>
		<skos:prefLabel xml:lang="en">echo out</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/move-echo-out"/>
		<ns:status>stable</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/move-filter-exit">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PerformMove"/>
		<skos:definition xml:lang="en">Close a filter on the outgoing deck until it fades out of the mix.</skos:definition>
		<skos:prefLabel xml:lang="en">filter exit</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/move-filter-exit"/>
		<ns:status>stable</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/move-loop-roll">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PerformMove"/>
		<skos:definition xml:lang="en">Repeat ever shorter slices of the playing audio to build tension.</skos:definition>
		<skos:prefLabel xml:lang="en">loop roll</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/move-loop-roll"/>
		<ns:status>stable</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/move-phrase-sync">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PerformMove"/>
		<skos:definition xml:lang="en">Line the incoming deck up so its phrase starts on the outgoing deck&apos;s phrase boundary.</skos:definition>
		<skos:prefLabel xml:lang="en">phrase sync</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/move-phrase-sync"/>
		<ns:status>stable</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/move-vocoder-handoff">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PerformMove"/>
		<skos:definition xml:lang="en">Pass the carrier role of a vocoder from one deck to the other so a voice carries across the change.</skos:definition>
		<skos:prefLabel xml:lang="en">vocoder handoff</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/move-vocoder-handoff"/>
		<ns:status>stable</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/mutation-every-nth-pass">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#LanguageTerm"/>
		<skos:definition xml:lang="en">An arrange mutation written ~N target op (or @N target op) fires only on every Nth pass of its arrange block, on passes N, 2N, 3N and so on counted from 1; with no count it fires on every pass.</skos:definition>
		<skos:prefLabel xml:lang="en">mutation count (~N, @N)</skos:prefLabel>
		<ns:markedBy rdf:resource="https://beatscript.app/ontology/concept/token-int"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>~N</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/mutation-from-here">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#LanguageTerm"/>
		<skos:definition xml:lang="en">An arrange mutation written ~target op applies from that point of the arrangement to its end.</skos:definition>
		<skos:prefLabel xml:lang="en">mutation from here on (~)</skos:prefLabel>
		<ns:markedBy rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-tilde"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>~</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/mutation-next-section">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#LanguageTerm"/>
		<skos:definition xml:lang="en">An arrange mutation written @target op applies to the next section only.</skos:definition>
		<skos:prefLabel xml:lang="en">mutation for one section (@)</skos:prefLabel>
		<ns:markedBy rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-at"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>@</ns:writtenAs>
	</skos:Concept>
