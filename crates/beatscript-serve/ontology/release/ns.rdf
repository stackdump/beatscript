		<ns:noteCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</ns:noteCount>
	</ns:Scale>
	<ns:Scale rdf:about="https://beatscript.app/ontology/scale/minor">
		<rdfs:label xml:lang="en">minor</rdfs:label>
		<skos:definition xml:lang="en">The natural minor scale, the sixth mode of the major scale.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/scale/minor"/>
		<ns:intervals>0 2 3 5 7 8 10</ns:intervals>
		<ns:noteCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</ns:noteCount>
	</ns:Scale>
	<ns:Scale rdf:about="https://beatscript.app/ontology/scale/mixolydian">
		<rdfs:label xml:lang="en">mixolydian</rdfs:label>
		<skos:definition xml:lang="en">Major with a lowered seventh: the fifth mode of the major scale.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/scale/mixolydian"/>
		<ns:intervals>0 2 4 5 7 9 10</ns:intervals>
		<ns:noteCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</ns:noteCount>
	</ns:Scale>
	<ns:Scale rdf:about="https://beatscript.app/ontology/scale/pentatonic">
		<rdfs:label xml:lang="en">pentatonic</rdfs:label>
		<skos:definition xml:lang="en">The five-note major pentatonic scale: the major scale without its fourth and seventh.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/scale/pentatonic"/>
		<ns:intervals>0 2 4 7 9</ns:intervals>
		<ns:noteCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</ns:noteCount>
	</ns:Scale>
	<ns:Scale rdf:about="https://beatscript.app/ontology/scale/phrygian">
		<rdfs:label xml:lang="en">phrygian</rdfs:label>
		<skos:definition xml:lang="en">Minor with a lowered second degree: the third mode of the major scale. Dark and tense.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/scale/phrygian"/>
		<ns:intervals>0 1 3 5 7 8 10</ns:intervals>
		<ns:noteCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</ns:noteCount>
	</ns:Scale>
	<ns:SongSection rdf:about="https://beatscript.app/ontology/section/breakdown">
		<rdfs:label xml:lang="en">breakdown</rdfs:label>
		<skos:definition xml:lang="en">A stripped-back section where the drums drop out and a melody carries.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/section/breakdown"/>
		<ns:bars rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</ns:bars>
	</ns:SongSection>
	<ns:SongSection rdf:about="https://beatscript.app/ontology/section/bridge">
		<rdfs:label xml:lang="en">bridge</rdfs:label>
		<skos:definition xml:lang="en">A contrasting section away from the verse and chorus.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/section/bridge"/>
		<ns:bars rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</ns:bars>
	</ns:SongSection>
	<ns:SongSection rdf:about="https://beatscript.app/ontology/section/buildup">
		<rdfs:label xml:lang="en">buildup</rdfs:label>
		<skos:definition xml:lang="en">Rising tension before a drop: snare and hi-hat density climb.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/section/buildup"/>
		<ns:bars rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</ns:bars>
	</ns:SongSection>
	<ns:SongSection rdf:about="https://beatscript.app/ontology/section/chorus">
		<rdfs:label xml:lang="en">chorus</rdfs:label>
		<skos:definition xml:lang="en">The high-energy, full-arrangement section a song returns to.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/section/chorus"/>
		<ns:bars rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</ns:bars>
	</ns:SongSection>
	<ns:SongSection rdf:about="https://beatscript.app/ontology/section/drop">
		<rdfs:label xml:lang="en">drop</rdfs:label>
		<skos:definition xml:lang="en">The peak of an electronic track after a buildup: full arrangement at highest energy.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/section/drop"/>
		<ns:bars rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</ns:bars>
	</ns:SongSection>
	<ns:SongSection rdf:about="https://beatscript.app/ontology/section/intro">
		<rdfs:label xml:lang="en">intro</rdfs:label>
		<skos:definition xml:lang="en">The opening: few parts playing, building attention.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/section/intro"/>
		<ns:bars rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</ns:bars>
	</ns:SongSection>
	<ns:SongSection rdf:about="https://beatscript.app/ontology/section/outro">
		<rdfs:label xml:lang="en">outro</rdfs:label>
		<skos:definition xml:lang="en">The closing section: parts fall away.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/section/outro"/>
		<ns:bars rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</ns:bars>
	</ns:SongSection>
	<ns:SongSection rdf:about="https://beatscript.app/ontology/section/pre-chorus">
		<rdfs:label xml:lang="en">pre-chorus</rdfs:label>
		<skos:definition xml:lang="en">A short lift into the chorus.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/section/pre-chorus"/>
		<ns:bars rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</ns:bars>
	</ns:SongSection>
	<ns:SongSection rdf:about="https://beatscript.app/ontology/section/solo">
		<rdfs:label xml:lang="en">solo</rdfs:label>
		<skos:definition xml:lang="en">A section featuring one melodic voice over the rhythm section.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/section/solo"/>
		<ns:bars rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</ns:bars>
	</ns:SongSection>
	<ns:SongSection rdf:about="https://beatscript.app/ontology/section/verse">
		<rdfs:label xml:lang="en">verse</rdfs:label>
		<skos:definition xml:lang="en">A main body section carrying the groove with moderate energy.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/section/verse"/>
		<ns:bars rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</ns:bars>
	</ns:SongSection>
