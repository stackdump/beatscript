		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-pattern"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-rhythm"/>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-tempo"/>
		<ns:writtenAs>type</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/grammar-unary">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#GrammarProduction"/>
		<skos:definition xml:lang="en">The unary production of BeatScript&apos;s grammar.</skos:definition>
		<skos:prefLabel xml:lang="en">unary</skos:prefLabel>
		<ns:ebnf>[ &quot;-&quot; ] primary</ns:ebnf>
		<ns:grammarSection xml:lang="en">Arithmetic and guards</ns:grammarSection>
		<ns:status>stable</ns:status>
		<ns:usesKeyword rdf:resource="https://beatscript.app/ontology/concept/keyword-symbol-minus"/>
		<ns:usesProduction rdf:resource="https://beatscript.app/ontology/concept/grammar-primary"/>
