		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/instrument/scream-lead"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=scream-lead</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/screech">
		<skos:definition xml:lang="en">The BeatScript voice screech, written inst=screech.</skos:definition>
		<skos:prefLabel xml:lang="en">screech</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=screech</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/sitar">
		<skos:definition xml:lang="en">The BeatScript voice sitar, written inst=sitar.</skos:definition>
		<skos:prefLabel xml:lang="en">sitar</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=sitar</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/square-lead">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Instrument"/>
		<rdfs:label xml:lang="en">square-lead</rdfs:label>
		<skos:definition xml:lang="en">A lead built on a square wave.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/instrument/square-lead"/>
		<ns:inVoiceFamily rdf:resource="https://beatscript.app/ontology/concept/voice-family-square"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=square-lead</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/steel-drum">
		<skos:definition xml:lang="en">The BeatScript voice steel-drum, written inst=steel-drum.</skos:definition>
		<skos:prefLabel xml:lang="en">steel-drum</skos:prefLabel>
		<ns:inVoiceFamily rdf:resource="https://beatscript.app/ontology/concept/voice-family-steel"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=steel-drum</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/strings">
		<skos:definition xml:lang="en">The BeatScript voice strings, written inst=strings.</skos:definition>
		<skos:prefLabel xml:lang="en">strings</skos:prefLabel>
		<ns:inVoiceFamily rdf:resource="https://beatscript.app/ontology/concept/voice-family-strings"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=strings</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/sub-bass">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Instrument"/>
		<rdfs:label xml:lang="en">sub-bass</rdfs:label>
		<skos:definition xml:lang="en">A low sine-like bass with almost no upper harmonics.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/instrument/sub-bass"/>
		<ns:inVoiceFamily rdf:resource="https://beatscript.app/ontology/concept/voice-family-bass"/>
		<ns:inVoiceFamily rdf:resource="https://beatscript.app/ontology/concept/voice-family-sub"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=sub-bass</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/subdrop">
		<skos:definition xml:lang="en">The BeatScript voice subdrop, written inst=subdrop.</skos:definition>
		<skos:prefLabel xml:lang="en">subdrop</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=subdrop</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:Instrument rdf:about="https://beatscript.app/ontology/instrument/supersaw">
		<rdfs:label xml:lang="en">supersaw</rdfs:label>
		<skos:definition xml:lang="en">A stack of detuned sawtooth oscillators: the wide, bright trance and EDM lead.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/instrument/supersaw"/>
		<ns:beatscriptVoice>trance-lead</ns:beatscriptVoice>
	</ns:Instrument>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/sync-lead">
		<skos:definition xml:lang="en">The BeatScript voice sync-lead, written inst=sync-lead.</skos:definition>
		<skos:prefLabel xml:lang="en">sync-lead</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=sync-lead</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/talkbox">
		<skos:definition xml:lang="en">The BeatScript voice talkbox, written inst=talkbox.</skos:definition>
		<skos:prefLabel xml:lang="en">talkbox</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=talkbox</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/tape-lead">
		<skos:definition xml:lang="en">The BeatScript voice tape-lead, written inst=tape-lead.</skos:definition>
		<skos:prefLabel xml:lang="en">tape-lead</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=tape-lead</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/trance-lead">
		<skos:definition xml:lang="en">The BeatScript voice trance-lead, written inst=trance-lead.</skos:definition>
		<skos:prefLabel xml:lang="en">trance-lead</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=trance-lead</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/trumpet">
		<skos:definition xml:lang="en">The BeatScript voice trumpet, written inst=trumpet.</skos:definition>
		<skos:prefLabel xml:lang="en">trumpet</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=trumpet</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/unbound">
		<skos:definition xml:lang="en">The BeatScript voice unbound, written inst=unbound.</skos:definition>
		<skos:prefLabel xml:lang="en">unbound</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=unbound</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/vibes">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Instrument"/>
		<rdfs:label xml:lang="en">vibes</rdfs:label>
		<skos:definition xml:lang="en">A vibraphone sound.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/instrument/vibes"/>
		<ns:inVoiceFamily rdf:resource="https://beatscript.app/ontology/concept/voice-family-vibes"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=vibes</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/voice-android">
		<skos:definition xml:lang="en">The BeatScript voice voice-android, written inst=voice-android.</skos:definition>
		<skos:prefLabel xml:lang="en">voice-android</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=voice-android</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/voice-bass-choir">
		<skos:definition xml:lang="en">The BeatScript voice voice-bass-choir, written inst=voice-bass-choir.</skos:definition>
		<skos:prefLabel xml:lang="en">voice-bass-choir</skos:prefLabel>
		<ns:inVoiceFamily rdf:resource="https://beatscript.app/ontology/concept/voice-family-bass"/>
		<ns:inVoiceFamily rdf:resource="https://beatscript.app/ontology/concept/voice-family-choir"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=voice-bass-choir</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/voice-choir-aah">
		<skos:definition xml:lang="en">The BeatScript voice voice-choir-aah, written inst=voice-choir-aah.</skos:definition>
		<skos:prefLabel xml:lang="en">voice-choir-aah</skos:prefLabel>
		<ns:inVoiceFamily rdf:resource="https://beatscript.app/ontology/concept/voice-family-choir"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=voice-choir-aah</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/voice-choir-ooh">
		<skos:definition xml:lang="en">The BeatScript voice voice-choir-ooh, written inst=voice-choir-ooh.</skos:definition>
		<skos:prefLabel xml:lang="en">voice-choir-ooh</skos:prefLabel>
		<ns:inVoiceFamily rdf:resource="https://beatscript.app/ontology/concept/voice-family-choir"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=voice-choir-ooh</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/voice-robot-choir">
		<skos:definition xml:lang="en">The BeatScript voice voice-robot-choir, written inst=voice-robot-choir.</skos:definition>
		<skos:prefLabel xml:lang="en">voice-robot-choir</skos:prefLabel>
		<ns:inVoiceFamily rdf:resource="https://beatscript.app/ontology/concept/voice-family-choir"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=voice-robot-choir</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/voice-robot">
		<skos:definition xml:lang="en">The BeatScript voice voice-robot, written inst=voice-robot.</skos:definition>
		<skos:prefLabel xml:lang="en">voice-robot</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=voice-robot</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/voice-soprano">
		<skos:definition xml:lang="en">The BeatScript voice voice-soprano, written inst=voice-soprano.</skos:definition>
		<skos:prefLabel xml:lang="en">voice-soprano</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=voice-soprano</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/voice-talkbox">
		<skos:definition xml:lang="en">The BeatScript voice voice-talkbox, written inst=voice-talkbox.</skos:definition>
		<skos:prefLabel xml:lang="en">voice-talkbox</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=voice-talkbox</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/warm-pad">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Instrument"/>
		<rdfs:label xml:lang="en">warm-pad</rdfs:label>
		<skos:definition xml:lang="en">A slow, soft sustained pad.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/instrument/warm-pad"/>
		<ns:inVoiceFamily rdf:resource="https://beatscript.app/ontology/concept/voice-family-pad"/>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=warm-pad</ns:writtenAs>
	</ns:BeatScriptVoice>
	<ns:Instrument rdf:about="https://beatscript.app/ontology/instrument/wobble-bass">
		<rdfs:label xml:lang="en">wobble-bass</rdfs:label>
		<skos:definition xml:lang="en">A bass whose filter is modulated at a steady rate, giving the dubstep wobble.</skos:definition>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/instrument/wobble-bass"/>
	</ns:Instrument>
	<ns:BeatScriptVoice rdf:about="https://beatscript.app/ontology/instrument/wobble-lead">
		<skos:definition xml:lang="en">The BeatScript voice wobble-lead, written inst=wobble-lead.</skos:definition>
		<skos:prefLabel xml:lang="en">wobble-lead</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>inst=wobble-lead</ns:writtenAs>
	</ns:BeatScriptVoice>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ABPair">
		<rdfs:comment xml:lang="en">Two complementary loops: the call and the answer, in the same key and at the same tempo, so either can follow the other.</rdfs:comment>
		<rdfs:label xml:lang="en">A/B pair</rdfs:label>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/ontology/concept/call-and-response"/>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ABPair"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#AlternationTerm">
		<rdfs:comment xml:lang="en">Terms taken in turn, one per pass through the pattern.</rdfs:comment>
		<rdfs:label xml:lang="en">alternation</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#PatternTerm"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#AlternationTerm"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Analysis">
		<rdfs:comment xml:lang="en">A step that reads audio and reports facts about it: beats, key, stems.</rdfs:comment>
		<rdfs:label xml:lang="en">audio analysis</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Analysis"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ArpTerm">
		<rdfs:comment xml:lang="en">A chord&apos;s notes played one after another across the step.</rdfs:comment>
		<rdfs:label xml:lang="en">arp term</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#PatternTerm"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ArpTerm"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ArrangeLine">
		<rdfs:comment xml:lang="en">Orders section blocks in time. Read categorically, it is sequential composition.</rdfs:comment>
		<rdfs:label xml:lang="en">arrange line</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#ProgramLine"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ArrangeLine"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/sequential-composition"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#AudioEffect">
		<rdfs:comment xml:lang="en">Something that changes a deck&apos;s sound as it plays.</rdfs:comment>
		<rdfs:label xml:lang="en">audio effect</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#AudioEffect"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#AuthorSignature">
		<rdfs:comment xml:lang="en">A signature by the author over the program&apos;s CID, proving who sealed the link.</rdfs:comment>
		<rdfs:label xml:lang="en">author signature</rdfs:label>
		<rdfs:seeAlso rdf:resource="https://ontology.pflow.xyz/ns#signature"/>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#AuthorSignature"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Batch">
		<rdfs:comment xml:lang="en">Several control commands sent as one, applied together.</rdfs:comment>
		<rdfs:label xml:lang="en">batch</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Batch"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#BeatGrid">
		<rdfs:comment xml:lang="en">The positions of beats and downbeats in an audio file, found by a neural network (Beat This!).</rdfs:comment>
		<rdfs:label xml:lang="en">beat grid</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#Analysis"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#BeatGrid"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#BeatScriptVoice">
		<rdfs:comment xml:lang="en">A voice a BeatScript part may name with inst=NAME: what /api/instruments lists.</rdfs:comment>
		<rdfs:label xml:lang="en">BeatScript voice</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#Instrument"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#CanonicalForm">
		<rdfs:comment xml:lang="en">The normal form of a BeatScript program: whitespace, numbers, note spelling and comments are normalised, so two spellings of one program have one canonical text and therefore one CID. A BeatScript 2 canonical text begins with its version line, #! beatscript 2; a BeatScript 1 canonical text has no #! line, so the first line alone tells the version.</rdfs:comment>
		<rdfs:label xml:lang="en">canonical form</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#CanonicalForm"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/normal-form"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#CategoricalConcept">
		<rdfs:comment xml:lang="en">A notion from category theory used to read how decks, parts and sections compose.</rdfs:comment>
		<rdfs:label xml:lang="en">categorical concept</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#CategoricalConcept"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ChordProgression">
		<rdfs:comment xml:lang="en">A cycle of chords named by the scale degree of their root.</rdfs:comment>
		<rdfs:label xml:lang="en">Chord progression</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ChordProgression"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ChordTerm">
		<rdfs:comment xml:lang="en">Several notes sounded together on one step.</rdfs:comment>
		<rdfs:label xml:lang="en">chord term</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#PatternTerm"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ChordTerm"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ContentId">
		<rdfs:comment xml:lang="en">A name derived from the bytes it names (a CID): the same content always has the same identifier.</rdfs:comment>
		<rdfs:label xml:lang="en">content identifier</rdfs:label>
		<rdfs:seeAlso rdf:resource="https://ontology.pflow.xyz/ns#modelCID"/>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<skos:scopeNote xml:lang="en">pflow&apos;s modelCID is the content identifier of a net model; ProgramCID and NetCID are the same kind of name for a BeatScript program and for the net a deck runs.</skos:scopeNote>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ContentId"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ControlLanguage">
		<rdfs:comment xml:lang="en">The app&apos;s text command language: every control is a noun (what) and a verb (do what). One verb, describe, tells a user what a noun can do.</rdfs:comment>
		<rdfs:label xml:lang="en">control language</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ControlLanguage"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ControlLine">
		<rdfs:comment xml:lang="en">A line that sets something about the deck rather than playing notes: tempo, key, a level.</rdfs:comment>
		<rdfs:label xml:lang="en">control line</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#ProgramLine"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ControlLine"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ControlNet">
		<rdfs:comment xml:lang="en">A linear net that fires mute and unmute actions at section boundaries, which is how a song structure plays out.</rdfs:comment>
		<rdfs:label xml:lang="en">Control net</rdfs:label>
		<rdfs:seeAlso rdf:resource="https://ontology.pflow.xyz/ns#PetriNet"/>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#EngineNet"/>
		<skos:closeMatch rdf:resource="https://ontology.pflow.xyz/ns#PetriNet"/>
		<skos:scopeNote xml:lang="en">A control net is a linear workflow: its transitions fire once, in order.</skos:scopeNote>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ControlNet"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ControlNoun">
		<rdfs:comment xml:lang="en">The thing a control command acts on: a deck, a fader, an effect.</rdfs:comment>
		<rdfs:label xml:lang="en">control noun</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ControlNoun"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ControlVerb">
		<rdfs:comment xml:lang="en">What a control command does to its noun.</rdfs:comment>
		<rdfs:label xml:lang="en">control verb</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ControlVerb"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Credit">
		<rdfs:comment xml:lang="en">An acknowledgement of someone whose work a track uses, such as a sample or a forked program&apos;s author.</rdfs:comment>
		<rdfs:label xml:lang="en">credit</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Credit"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Deck">
		<rdfs:comment xml:lang="en">One playback channel of the DJ app. Each deck runs a Petri net compiled from a program.</rdfs:comment>
		<rdfs:label xml:lang="en">deck</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Deck"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/free-smc"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#DjConcept">
		<rdfs:comment xml:lang="en">Root of the things a DJ app has: collections of loops, set planning, performance moves, effects, analysis and the control language.</rdfs:comment>
		<rdfs:label xml:lang="en">DJ concept</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#DjConcept"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#DoLine">
		<rdfs:comment xml:lang="en">Runs one verb of the control language, so a program can reach any control the app has without a dedicated syntax for it.</rdfs:comment>
		<rdfs:label xml:lang="en">do line</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#ProgramLine"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#DoLine"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#DrumKit">
		<rdfs:comment xml:lang="en">A set of drum sounds a part may name with kit=NAME.</rdfs:comment>
		<rdfs:label xml:lang="en">drum kit</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#Instrument"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#DrumVariant">
		<rdfs:comment xml:lang="en">A named alteration (B, C) of a genre&apos;s base drum rhythm: add pulses, scale them, rotate.</rdfs:comment>
		<rdfs:label xml:lang="en">Drum variant</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#DrumVariant"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Ending">
		<rdfs:comment xml:lang="en">What happens when a program&apos;s last section finishes: it ends, or it loops back to the start.</rdfs:comment>
		<rdfs:label xml:lang="en">ending</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Ending"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#EngineConcept">
		<rdfs:comment xml:lang="en">A concept from the generator or sequencer that is not itself a genre property: the Bjorklund algorithm, Markov melody, swing and so on.</rdfs:comment>
		<rdfs:label xml:lang="en">Engine concept</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#EngineConcept"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#EngineNet">
		<rdfs:comment xml:lang="en">A Petri net the sequencer executes to make sound.</rdfs:comment>
		<rdfs:label xml:lang="en">Engine net</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<skos:closeMatch rdf:resource="https://ontology.pflow.xyz/ns#PetriNet"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#EngineNet"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/free-smc"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#EuclidTerm">
		<rdfs:comment xml:lang="en">K hits spread evenly over N steps, as a Euclidean rhythm.</rdfs:comment>
		<rdfs:label xml:lang="en">euclid term</rdfs:label>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/ontology/ns#EuclideanRhythm"/>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#PatternTerm"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#EuclidTerm"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#EuclideanRhythm">
		<rdfs:comment xml:lang="en">K pulses spread as evenly as possible over N steps, then rotated.</rdfs:comment>
		<rdfs:label xml:lang="en">Euclidean rhythm</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#EuclideanRhythm"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#EvolveOperator">
		<rdfs:comment xml:lang="en">An operation an evolve block applies to a part every N bars, generation after generation.</rdfs:comment>
		<rdfs:label xml:lang="en">evolve operator</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#PatternTransform"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Feel">
		<rdfs:comment xml:lang="en">How a line&apos;s syllables sit on the grid: on the sixteenths, or in groups of three.</rdfs:comment>
		<rdfs:label xml:lang="en">feel</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Fork">
		<rdfs:comment xml:lang="en">A track made by changing another track. It names what it was forked from, and so its credits and licence trace back.</rdfs:comment>
		<rdfs:label xml:lang="en">fork</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#TrackObject"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Fork"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Form">
		<rdfs:comment xml:lang="en">A shape for a whole track from classical music: its sections, the order they come in, and the plan of arrange mutations that changes them pass after pass. Each is a template built from public-domain themes (docs/forms).</rdfs:comment>
		<rdfs:label xml:lang="en">form</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#FormantVoice">
		<rdfs:comment xml:lang="en">A synthesised voice built from formants, the resonances that make vowels. It can sing a vocal line with no recorded voice involved.</rdfs:comment>
		<rdfs:label xml:lang="en">formant voice</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#FormantVoice"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Freeze">
		<rdfs:comment xml:lang="en">A granular effect that holds one moment of a deck&apos;s sound and stretches it into a sustained texture.</rdfs:comment>
		<rdfs:label xml:lang="en">freeze</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#AudioEffect"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Freeze"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Genre">
		<rdfs:comment xml:lang="en">A style the sequencer can generate a whole track in. Each carries the defaults that make it recognisable: tempo, scale, drum rhythms, groove, feel.</rdfs:comment>
		<rdfs:label xml:lang="en">Genre</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Genre"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#GenreFamily">
		<rdfs:comment xml:lang="en">A group of genres that share song structures and section energy: edm, song, jazz, chill.</rdfs:comment>
		<rdfs:label xml:lang="en">Genre family</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#GenreFamily"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#GrammarProduction">
		<rdfs:comment xml:lang="en">One production of BeatScript&apos;s grammar (grammar.ebnf, ISO 14977 EBNF; beatscript.app/docs/language). Its ns:ebnf is the right-hand side as written.</rdfs:comment>
		<rdfs:label xml:lang="en">grammar production</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#LanguageTerm"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Groove">
		<rdfs:comment xml:lang="en">How the bass line locks to the drums.</rdfs:comment>
		<rdfs:label xml:lang="en">Groove</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Groove"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#GroupTerm">
		<rdfs:comment xml:lang="en">Several terms squeezed into the time of one step.</rdfs:comment>
		<rdfs:label xml:lang="en">group</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#PatternTerm"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#GroupTerm"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#HistoryBuffer">
		<rdfs:comment xml:lang="en">A rolling memory of the last seconds a deck played. Capture-to-loop cuts a loop out of it after the fact.</rdfs:comment>
		<rdfs:label xml:lang="en">history buffer</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#HistoryBuffer"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#HitTerm">
		<rdfs:comment xml:lang="en">A step that sounds.</rdfs:comment>
		<rdfs:label xml:lang="en">hit</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#PatternTerm"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#HitTerm"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ImportLine">
		<rdfs:comment xml:lang="en">Brings in another program by CID. Pinning by content identifier means the imported text can never change under the importer.</rdfs:comment>
		<rdfs:label xml:lang="en">import line</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#ProgramLine"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ImportLine"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/open-net-cospan"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#InsertEffect">
		<rdfs:comment xml:lang="en">An effect placed in a deck&apos;s signal path, so all of the deck&apos;s sound passes through it.</rdfs:comment>
		<rdfs:label xml:lang="en">insert effect</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#AudioEffect"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#InsertEffect"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Instrument">
		<rdfs:comment xml:lang="en">A named sound the synth engine can play.</rdfs:comment>
		<rdfs:label xml:lang="en">Instrument</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Instrument"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#InstrumentRole">
		<rdfs:comment xml:lang="en">The job a track does in the mix: kick, snare, hihat, clap, bass, melody, harmony, arp.</rdfs:comment>
		<rdfs:label xml:lang="en">Instrument role</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#InstrumentRole"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#KeyDetection">
		<rdfs:comment xml:lang="en">Finds the musical key of audio and reports it as a Camelot code, which says which keys mix well together.</rdfs:comment>
		<rdfs:label xml:lang="en">key detection</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#Analysis"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#KeyDetection"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Keyword">
		<rdfs:comment xml:lang="en">A terminal of BeatScript&apos;s grammar: a word or a symbol written as it is.</rdfs:comment>
		<rdfs:label xml:lang="en">keyword</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#LanguageTerm"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#LanguageTerm">
		<rdfs:comment xml:lang="en">A piece of the BeatScript language as its grammar states it: a production, a keyword or a token class.</rdfs:comment>
		<rdfs:label xml:lang="en">BeatScript language term</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#LanguageVersion">
		<rdfs:comment xml:lang="en">One version of a language: the version line that says a text is in it, how its programs are canonicalized and what their CIDs are the CIDs of. A later version is prov:wasRevisionOf the one before it, and a program written in the earlier one keeps its meaning and its CID.</rdfs:comment>
		<rdfs:label xml:lang="en">language version</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#ProgrammingLanguage"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#LetLine">
		<rdfs:comment xml:lang="en">Binds a name to a value or pattern for use further down the program.</rdfs:comment>
		<rdfs:label xml:lang="en">let line</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#ProgramLine"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#LetLine"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#License">
		<rdfs:comment xml:lang="en">The terms a track is shared under.</rdfs:comment>
		<rdfs:label xml:lang="en">licence</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#License"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Loop">
		<rdfs:comment xml:lang="en">A short stretch of music that repeats cleanly.</rdfs:comment>
		<rdfs:label xml:lang="en">loop</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Loop"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#LoopSet">
		<rdfs:comment xml:lang="en">A collection of loops, either curated by hand or generated from a seed.</rdfs:comment>
		<rdfs:label xml:lang="en">loop set</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#LoopSet"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#MacroDefinition">
		<rdfs:comment xml:lang="en">A parameterised macro. It is total: a macro cannot call itself, directly or through others, so expansion always ends. Repetition is written repeat N.</rdfs:comment>
		<rdfs:label xml:lang="en">def (macro definition)</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#ProgramLine"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#MacroDefinition"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/open-net-cospan"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Mashup">
		<rdfs:comment xml:lang="en">Stems of different tracks played together, matched in key and tempo.</rdfs:comment>
		<rdfs:label xml:lang="en">mashup</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Mashup"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#McpServer">
		<rdfs:comment xml:lang="en">A Model Context Protocol server: tools an AI assistant such as Claude can call to use a product.</rdfs:comment>
		<rdfs:label xml:lang="en">MCP server</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#Product"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#McpTool">
		<rdfs:comment xml:lang="en">One tool of an MCP server: its name, description and input schema, as the server&apos;s tools/list gives them.</rdfs:comment>
		<rdfs:label xml:lang="en">MCP tool</rdfs:label>
		<owl:disjointWith rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<owl:disjointWith rdf:resource="https://beatscript.app/ontology/ns#Product"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#MelodyRing">
		<rdfs:comment xml:lang="en">The same ring, with a note binding on every non-rest step: a melody, bass line or arpeggio written out as a cycle.</rdfs:comment>
		<rdfs:label xml:lang="en">Melody ring</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#EngineNet"/>
		<skos:closeMatch rdf:resource="https://ontology.pflow.xyz/ns#PetriNet"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#MelodyRing"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#MeterFamily">
		<rdfs:comment xml:lang="en">A kind of line, by how its stresses fall: the closed set a phrasebook entry is filed under.</rdfs:comment>
		<rdfs:label xml:lang="en">meter family</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#MusicConcept">
		<rdfs:comment xml:lang="en">Root of everything this ontology describes about music.</rdfs:comment>
		<rdfs:label xml:lang="en">Music concept</rdfs:label>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#MusicConcept"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#MutationOperator">
		<rdfs:comment xml:lang="en">An operator of an arrange mutation: it changes a let pattern from one point of the arrangement (~) or for one section (@).</rdfs:comment>
		<rdfs:label xml:lang="en">arrange mutation operator</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#PatternTransform"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#NetCID">
		<rdfs:comment xml:lang="en">The content identifier of the Petri net one deck runs, in pflow&apos;s canonical net form. Two decks with equal nets have equal NetCIDs whatever program produced them.</rdfs:comment>
		<rdfs:label xml:lang="en">net CID</rdfs:label>
		<rdfs:seeAlso rdf:resource="https://ontology.pflow.xyz/ns#modelCID"/>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#ContentId"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#NetCID"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#NotesSegment">
		<rdfs:comment xml:lang="en">Free text riding on a share link outside the seal. Editing it does not change the program&apos;s CID.</rdfs:comment>
		<rdfs:label xml:lang="en">notes segment</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#NotesSegment"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Palette">
		<rdfs:comment xml:lang="en">A named set of sounds a program can choose as a whole.</rdfs:comment>
		<rdfs:label xml:lang="en">palette</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#PartLine">
		<rdfs:comment xml:lang="en">A line that names a part (drums, bass, lead) and gives it a pattern of terms to play.</rdfs:comment>
		<rdfs:label xml:lang="en">part line</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#ProgramLine"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#PartLine"/>
		<ns:categoricalReading rdf:resource="https://beatscript.app/ontology/concept/monoidal-product"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#PatternGenerator">
		<rdfs:comment xml:lang="en">A call that makes a pattern from its arguments, such as e(5,8), markov(0.6), chord(am) or choose.</rdfs:comment>
		<rdfs:label xml:lang="en">pattern generator</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#PatternTerm"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#PatternModifier">
		<rdfs:comment xml:lang="en">A mark written after a term or part that changes how it plays: repeat, chance, accent, slide, cycle length.</rdfs:comment>
		<rdfs:label xml:lang="en">pattern modifier</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#PatternTerm"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#PatternTerm">
		<rdfs:comment xml:lang="en">One element of a part&apos;s pattern.</rdfs:comment>
		<rdfs:label xml:lang="en">pattern term</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#PatternTerm"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#PatternTransform">
		<rdfs:comment xml:lang="en">A function from patterns to patterns, such as transpose or reverse. Transforms compose and have an identity, so they form a monoid.</rdfs:comment>
		<rdfs:label xml:lang="en">pattern transform</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#PatternTransform"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#PerformMove">
		<rdfs:comment xml:lang="en">A gesture the app carries out for the DJ: a timed change to one or both decks.</rdfs:comment>
		<rdfs:label xml:lang="en">perform move</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#PerformMove"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#PhraseTemplate">
		<rdfs:comment xml:lang="en">A template that compiles a phrase to a whole track: arrange from template(NAME, PHRASE). The phrase is the vocal line (its syllables the line&apos;s length, its stress the accents and the beats, its meter the subdivision); the arrangement is the template&apos;s own.</rdfs:comment>
		<rdfs:label xml:lang="en">phrase template</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Phrasebook">
		<rdfs:comment xml:lang="en">A curated set of phrases a program sings by id: sing @id on melody. The public-domain one is lines of verse, scripture, speech and work song first published before 1929, as a CC0 file with one CID.</rdfs:comment>
		<rdfs:label xml:lang="en">phrasebook</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#PhrasebookEntry">
		<rdfs:comment xml:lang="en">One line of a phrasebook: its words, the lyric BeatScript sings them as, where and when it was first published, and its meter as a step pattern.</rdfs:comment>
		<rdfs:label xml:lang="en">phrasebook entry</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Product">
		<rdfs:comment xml:lang="en">Something shipped under a name: a website, a language, an app or an MCP server.</rdfs:comment>
		<rdfs:label xml:lang="en">product</rdfs:label>
		<owl:disjointWith rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ProductFamily">
		<rdfs:comment xml:lang="en">One name shared by several products that are used together.</rdfs:comment>
		<rdfs:label xml:lang="en">product family</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#Product"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Program">
		<rdfs:comment xml:lang="en">A piece written in BeatScript: lines of text that compile to the Petri nets of a DJ deck. Identified by the CID of its canonical text, so a BeatScript 1 program and its upgrade to BeatScript 2, which play the same, are two programs: the upgrade is prov:wasRevisionOf the original, and each has its own ns:programCid and ns:inLanguageVersion.</rdfs:comment>
		<rdfs:label xml:lang="en">BeatScript program</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<skos:closeMatch rdf:resource="https://ontology.pflow.xyz/ns#PetriNet"/>
		<skos:hiddenLabel xml:lang="en">btw program</skos:hiddenLabel>
		<skos:historyNote xml:lang="en">Before language version 2 (2026-11-22) the language was called btw, and a program was a btw program.</skos:historyNote>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Program"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ProgramCID">
		<rdfs:comment xml:lang="en">The content identifier of a program&apos;s canonical text.</rdfs:comment>
		<rdfs:label xml:lang="en">program CID</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#ContentId"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ProgramCID"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ProgramLine">
		<rdfs:comment xml:lang="en">One line of a BeatScript program. The kind of line says what it declares.</rdfs:comment>
		<rdfs:label xml:lang="en">program line</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ProgramLine"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ProgrammingLanguage">
		<rdfs:comment xml:lang="en">A text language whose documents are programs a product runs. Its versions (ns:LanguageVersion) are in the generated vocabulary, from the code that reads them.</rdfs:comment>
		<rdfs:label xml:lang="en">programming language</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#Product"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Queue">
		<rdfs:comment xml:lang="en">The segments waiting to play next on a deck.</rdfs:comment>
		<rdfs:label xml:lang="en">queue</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Queue"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#RestTerm">
		<rdfs:comment xml:lang="en">A step that is silent.</rdfs:comment>
		<rdfs:label xml:lang="en">rest</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#PatternTerm"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#RestTerm"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#RhythmRing">
		<rdfs:comment xml:lang="en">N places in a cycle, one token circulating, one transition per step; transitions at pulse positions carry a note binding, the rest are silent. Realises a Euclidean rhythm.</rdfs:comment>
		<rdfs:comment xml:lang="en">Realised as a cycle of places and transitions with one token; the cycle makes it a state machine in pflow&apos;s terms.</rdfs:comment>
		<rdfs:label xml:lang="en">Rhythm ring</rdfs:label>
		<rdfs:seeAlso rdf:resource="https://ontology.pflow.xyz/ns#PetriNet"/>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#EngineNet"/>
		<skos:closeMatch rdf:resource="https://ontology.pflow.xyz/ns#PetriNet"/>
		<skos:scopeNote xml:lang="en">A rhythm ring is a state machine in pflow&apos;s sense: every transition has one input place and one output place, and the net holds exactly one token.</skos:scopeNote>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#RhythmRing"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Scale">
		<rdfs:comment xml:lang="en">A set of pitch-class offsets in semitones from a root.</rdfs:comment>
		<rdfs:label xml:lang="en">Scale</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Scale"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#SectionBlock">
		<rdfs:comment xml:lang="en">A named group of lines that plays as one section of the piece. Unrelated to ns:SongSection, which is a genre-level template slot; a section block is whatever the author wrote.</rdfs:comment>
		<rdfs:label xml:lang="en">section block</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#ProgramLine"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#SectionBlock"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#SectionProfile">
		<rdfs:comment xml:lang="en">What a section means in one family: which roles play and how much energy it carries.</rdfs:comment>
		<rdfs:label xml:lang="en">Section profile</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#SectionProfile"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#SectionSlot">
		<rdfs:comment xml:lang="en">One numbered place in a song structure, filled by a section.</rdfs:comment>
		<rdfs:label xml:lang="en">Section slot</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#SectionSlot"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Segment">
		<rdfs:comment xml:lang="en">One stretch of a set list: a track or loop and how long it plays.</rdfs:comment>
		<rdfs:label xml:lang="en">segment</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Segment"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#SetList">
		<rdfs:comment xml:lang="en">A plan for a DJ set: an ordered list of segments.</rdfs:comment>
		<rdfs:label xml:lang="en">set list</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#SetList"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#SetRecording">
		<rdfs:comment xml:lang="en">A recording of a performed set, identified by a CID over its tracklist.</rdfs:comment>
		<rdfs:label xml:lang="en">set recording</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#SetRecording"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ShareLink">
		<rdfs:comment xml:lang="en">A URL that carries a whole track in itself: the program&apos;s CID and its deflated canonical text sit in the fragment, so opening the link needs no server lookup and the text can be checked against the CID. May include an author signature, and an unsealed notes segment that is not covered by the seal.</rdfs:comment>
		<rdfs:label xml:lang="en">share link</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#ShareLink"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#SongSection">
		<rdfs:comment xml:lang="en">A named stretch of a song: intro, verse, drop and so on.</rdfs:comment>
		<rdfs:label xml:lang="en">Song section</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#SongSection"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#SongStructure">
		<rdfs:comment xml:lang="en">An ordered template of sections for one genre family and length class.</rdfs:comment>
		<rdfs:label xml:lang="en">Song structure</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#SongStructure"/>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Stem">
		<rdfs:comment xml:lang="en">One separated part of a mix.</rdfs:comment>
		<rdfs:label xml:lang="en">stem</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Stem"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#StemSeparation">
		<rdfs:comment xml:lang="en">Splits a mix into stems (drums, bass, vocals, other) with a port of the Demucs model.</rdfs:comment>
		<rdfs:label xml:lang="en">stem separation</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#Analysis"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#StemSeparation"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Technique">
		<rdfs:comment xml:lang="en">A way of writing music that a person or an agent can follow, taught by one document and used through the language&apos;s own words.</rdfs:comment>
		<rdfs:label xml:lang="en">composition technique</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ThemeEntry">
		<rdfs:comment xml:lang="en">One theme of a theme library: its bars in a stated key, its role, meter, source work, composer and year, and the themes it pairs with.</rdfs:comment>
		<rdfs:label xml:lang="en">theme</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ThemeLibrary">
		<rdfs:comment xml:lang="en">A curated set of melodies, basses and figures written as BeatScript bars to borrow. The public-domain one is music composed and first published before 1929, written from the melody itself, as a CC0 file with one CID: the melodic twin of the phrasebook.</rdfs:comment>
		<rdfs:label xml:lang="en">theme library</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ThemeMode">
		<rdfs:comment xml:lang="en">Whether a theme is in a major key, a minor key, or neither (a pedal or an ostinato).</rdfs:comment>
		<rdfs:label xml:lang="en">theme mode</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#ThemeRole">
		<rdfs:comment xml:lang="en">The part a theme is written for: melody, bass, harmony or arp.</rdfs:comment>
		<rdfs:label xml:lang="en">theme role</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#TimingWord">
		<rdfs:comment xml:lang="en">A phrase that says when a change happens: at a bar, on the next phrase, every N bars, for N bars, or as a ramp.</rdfs:comment>
		<rdfs:label xml:lang="en">timing word</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#TimingWord"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#TokenClass">
		<rdfs:comment xml:lang="en">A kind of token the lexer recognises, such as NAME, INT or NOTE: named in the grammar, defined by the lexer.</rdfs:comment>
		<rdfs:label xml:lang="en">token class</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#LanguageTerm"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#TrackObject">
		<rdfs:comment xml:lang="en">A published track: a program plus the rights and provenance that go with it.</rdfs:comment>
		<rdfs:label xml:lang="en">track object</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#TrackObject"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Visibility">
		<rdfs:comment xml:lang="en">Whether a track is listed for anyone or only for those with its link.</rdfs:comment>
		<rdfs:label xml:lang="en">visibility</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Visibility"/>
		<ns:status>in-development</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#VocalLine">
		<rdfs:comment xml:lang="en">Typed lyrics turned into phonemes and notes for a formant voice to sing. The phoneme path uses CC0 data only.</rdfs:comment>
		<rdfs:label xml:lang="en">vocal line</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#VocalLine"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#Vocoder">
		<rdfs:comment xml:lang="en">An effect that imposes the spectral shape of one signal (the modulator, usually a voice) onto another (the carrier, usually a synth or a deck).</rdfs:comment>
		<rdfs:label xml:lang="en">vocoder</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#AudioEffect"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#Vocoder"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#VocoderInput">
		<rdfs:comment xml:lang="en">A signal fed into a vocoder, as modulator or as carrier.</rdfs:comment>
		<rdfs:label xml:lang="en">vocoder input</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#VocoderInput"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#VocoderInstance">
		<rdfs:comment xml:lang="en">One running copy of a vocoder, with its own modulator, carrier and settings.</rdfs:comment>
		<rdfs:label xml:lang="en">vocoder instance</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#DjConcept"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#VocoderInstance"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:Class rdf:about="https://beatscript.app/ontology/ns#VoiceFamily">
		<rdfs:comment xml:lang="en">A family word: an inst= name that contains it plays the family&apos;s generic voice.</rdfs:comment>
		<rdfs:label xml:lang="en">voice family</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://beatscript.app/ontology/ns#MusicConcept"/>
		<ns:status>stable</ns:status>
	</owl:Class>
	<owl:ObjectProperty rdf:about="https://beatscript.app/ontology/ns#acceptsVerb">
		<rdfs:label xml:lang="en">accepts verb</rdfs:label>
		<owl:inverseOf rdf:resource="https://beatscript.app/ontology/ns#actsOn"/>
		<ns:status>stable</ns:status>
	</owl:ObjectProperty>
	<owl:ObjectProperty rdf:about="https://beatscript.app/ontology/ns#activeRole">
		<rdfs:domain rdf:resource="https://beatscript.app/ontology/ns#SectionProfile"/>
		<rdfs:label xml:lang="en">active role</rdfs:label>
		<rdfs:range rdf:resource="https://beatscript.app/ontology/ns#InstrumentRole"/>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/ns#activeRole"/>
