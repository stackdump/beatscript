	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/pattern-endofunctor">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#CategoricalConcept"/>
		<skos:definition xml:lang="en">Pattern as a functor from notes to notes: a function on single notes lifts to a function on patterns of them, and lifting respects composition and identity.</skos:definition>
		<skos:prefLabel xml:lang="en">Pattern endofunctor</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/pattern-endofunctor"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/phrasebook-family-anapestic">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#MeterFamily"/>
		<skos:definition xml:lang="en">Two unstressed syllables then a stressed one, so it rolls in threes: Byron&apos;s Sennacherib and Lear&apos;s nonsense.</skos:definition>
		<skos:prefLabel xml:lang="en">anapestic</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:suitsGenre rdf:resource="https://beatscript.app/ontology/genre/dnb"/>
		<ns:suitsGenre rdf:resource="https://beatscript.app/ontology/genre/garage"/>
		<ns:suitsGroove>wants a triplet feel: drum and bass, breakbeat</ns:suitsGroove>
		<ns:writtenAs>anapestic</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/phrasebook-family-call-and-response">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#MeterFamily"/>
		<skos:definition xml:lang="en">A work song: the leader sings a line and the crew answers; the stresses are the heaves, the pulls on the rope.</skos:definition>
		<skos:prefLabel xml:lang="en">call and response</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:suitsGroove>call and response: the leader&apos;s syllables, then the crew&apos;s</ns:suitsGroove>
		<ns:writtenAs>call-and-response</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/phrasebook-family-common-meter">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#MeterFamily"/>
		<skos:definition xml:lang="en">The hymn and ballad stanza: a line of four beats, then a line of three (eight syllables, then six).</skos:definition>
		<skos:prefLabel xml:lang="en">common meter</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:suitsGroove>its 8-6-8-6 fills a 16-bar section, a line to a four-bar phrase</ns:suitsGroove>
		<ns:writtenAs>common-meter</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/phrasebook-family-dactylic">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#MeterFamily"/>
		<skos:definition xml:lang="en">A stressed syllable then two unstressed ones, also in threes: the long line of Evangeline.</skos:definition>
		<skos:prefLabel xml:lang="en">dactylic</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:suitsGenre rdf:resource="https://beatscript.app/ontology/genre/dnb"/>
		<ns:suitsGenre rdf:resource="https://beatscript.app/ontology/genre/garage"/>
		<ns:suitsGroove>wants a triplet feel: drum and bass, breakbeat</ns:suitsGroove>
		<ns:writtenAs>dactylic</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/phrasebook-family-iambic">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#MeterFamily"/>
		<skos:definition xml:lang="en">Lines of ten syllables (eleven with a feminine ending) in pairs, unstressed then stressed: the beat of blank verse and the sonnet.</skos:definition>
		<skos:prefLabel xml:lang="en">iambic pentameter</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:suitsGenre rdf:resource="https://beatscript.app/ontology/genre/house"/>
		<ns:suitsGroove>lilts on the offbeat: house</ns:suitsGroove>
		<ns:writtenAs>iambic</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/phrasebook-family-nursery">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#MeterFamily"/>
		<skos:definition xml:lang="en">Two or three strong beats a line with any number of weak syllables between: a rhyme said aloud.</skos:definition>
		<skos:prefLabel xml:lang="en">nursery rhyme</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:suitsGenre rdf:resource="https://beatscript.app/ontology/genre/garage"/>
		<ns:suitsGenre rdf:resource="https://beatscript.app/ontology/genre/lofi"/>
		<ns:suitsGroove>a clapping or lullaby dimeter: a triplet shuffle, or sparse</ns:suitsGroove>
		<ns:writtenAs>nursery</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/phrasebook-family-oratory">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#MeterFamily"/>
		<skos:definition xml:lang="en">Speech: no fixed foot, the stresses of the sentence, built in threes and answering clauses.</skos:definition>
		<skos:prefLabel xml:lang="en">oratory</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:suitsGenre rdf:resource="https://beatscript.app/ontology/genre/ambient"/>
		<ns:suitsGroove>speech as rhythm: a sparse spot section, not a groove</ns:suitsGroove>
		<ns:writtenAs>oratory</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/phrasebook-family-parallelism">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#MeterFamily"/>
		<skos:definition xml:lang="en">The verse of the King James Bible: two halves that answer each other (day and night, speech and knowledge), with no fixed foot.</skos:definition>
		<skos:prefLabel xml:lang="en">parallelism</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:suitsGroove>repeat plus variation: the second half answers the first</ns:suitsGroove>
		<ns:writtenAs>parallelism</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/phrasebook-family-sprung">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#MeterFamily"/>
		<skos:definition xml:lang="en">Gerard Manley Hopkins&apos;s rhythm: count the stresses, not the syllables; a stress stands alone or takes up to three slack syllables.</skos:definition>
		<skos:prefLabel xml:lang="en">sprung rhythm</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:suitsGroove>counts stresses, not syllables: one stress to a beat, over any groove</ns:suitsGroove>
		<ns:writtenAs>sprung</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/phrasebook-family-trochaic">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#MeterFamily"/>
		<skos:definition xml:lang="en">A stressed syllable then an unstressed one, four to a line, the last often cut short: Blake&apos;s Tyger and Hiawatha.</skos:definition>
		<skos:prefLabel xml:lang="en">trochaic</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:suitsGenre rdf:resource="https://beatscript.app/ontology/genre/edm"/>
		<ns:suitsGenre rdf:resource="https://beatscript.app/ontology/genre/techno"/>
		<ns:suitsGenre rdf:resource="https://beatscript.app/ontology/genre/trance"/>
		<ns:suitsGroove>chants on the kick: techno, EDM, four on the floor</ns:suitsGroove>
		<ns:writtenAs>trochaic</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/phrasebook-feel-straight">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Feel"/>
		<skos:definition xml:lang="en">A straight feel: the syllables sit on the sixteenth grid.</skos:definition>
		<skos:prefLabel xml:lang="en">straight</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>straight</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/phrasebook-feel-triplet">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Feel"/>
		<skos:definition xml:lang="en">A triplet feel: the syllables go in groups of three.</skos:definition>
		<skos:prefLabel xml:lang="en">triplet</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>triplet</ns:writtenAs>
	</skos:Concept>
	<rdf:Description rdf:about="https://beatscript.app/ontology/concept/phrasebook-public-domain">
		<dct:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Phrasebook"/>
		<skos:definition xml:lang="en">Lines of verse, scripture, speech and work song first published before 1929, each with its source, its meter as a step pattern and the lyric BeatScript sings it as. A CC0 file, every text in the public domain, addressed by the CID of its text (beatscript.app/phrasebook).</skos:definition>
		<skos:prefLabel xml:lang="en">public-domain phrasebook</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>phrasebook-pd</ns:writtenAs>
	</rdf:Description>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/product-beatscript-language">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#ProgrammingLanguage"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/ontology/ns#Program"/>
		<skos:altLabel xml:lang="en">BeatScript</skos:altLabel>
		<skos:definition xml:lang="en">The language of BeatScript: whole tracks written as text, one line per deck, compiled to the Petri nets a deck runs. Small, total and deterministic: the same canonical text always has the same CID. Its documents are programs, written as .beatscript files.</skos:definition>
		<skos:hiddenLabel xml:lang="en">btw</skos:hiddenLabel>
		<skos:historyNote xml:lang="en">Called btw, its files .btw, before language version 2 (BeatScript 2, 2026-11-22). A btw program is a BeatScript 1 program: it is still read, and keeps its meaning and its CID.</skos:historyNote>
		<skos:prefLabel xml:lang="en">BeatScript language</skos:prefLabel>
		<ns:currentVersion rdf:resource="https://beatscript.app/ontology/concept/beatscript-2"/>
		<ns:fileExtension>.beatscript</ns:fileExtension>
		<ns:inProductFamily rdf:resource="https://beatscript.app/ontology/concept/product-beatscript"/>
		<ns:legacyFileExtension>.btw</ns:legacyFileExtension>
		<ns:legacyMediaType>text/btw</ns:legacyMediaType>
		<ns:legacyMediaType>text/x-beatscript</ns:legacyMediaType>
		<ns:mediaType>text/beatscript</ns:mediaType>
		<ns:status>stable</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/product-beatscript-mcp">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#McpServer"/>
		<skos:definition xml:lang="en">Tools that let an AI assistant such as Claude use BeatScript: check, format and render programs, and play them on a paired phone.</skos:definition>
		<skos:prefLabel xml:lang="en">BeatScript MCP server</skos:prefLabel>
		<ns:homepage rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://beatscript.app/mcp</ns:homepage>
		<ns:inProductFamily rdf:resource="https://beatscript.app/ontology/concept/product-beatscript"/>
		<ns:status>stable</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#McpServer"/>
		<skos:definition xml:lang="en">Read-only access to the BeatScript ontology (https://beatscript.app/ontology/ns#), derived from the bitwrap ontology 0.2.0: genres, scales, grooves, song sections, instruments, Euclidean rhythms, Markov melody, the Petri-net engine concepts, and the BeatScript language&apos;s own terms (grammar productions, keywords, voices, kits, control nouns and verbs, MCP tools). Queries run over the materialized graph and are capped at 1000 rows and 5 seconds.</skos:definition>
		<skos:prefLabel xml:lang="en">BeatScript ontology MCP server</skos:prefLabel>
		<ns:homepage rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://beatscript.app/ontology/</ns:homepage>
		<ns:inProductFamily rdf:resource="https://beatscript.app/ontology/concept/product-beatscript"/>
		<ns:status>stable</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/product-beatscript">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#ProductFamily"/>
		<skos:definition xml:lang="en">The name shared by a music language, the Android app that plays it, the website beatscript.app and its MCP servers. Write or generate a program, send it to the phone, hear it.</skos:definition>
		<skos:prefLabel xml:lang="en">BeatScript</skos:prefLabel>
		<ns:homepage rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://beatscript.app</ns:homepage>
		<ns:status>stable</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/ring-marking">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:closeMatch rdf:resource="https://ontology.pflow.xyz/ns#Marking"/>
		<skos:definition xml:lang="en">Where the token sits in each ring right now: the whole state of the sequencer. A track&apos;s marking resets to its initial marking at the loop point.</skos:definition>
		<skos:prefLabel xml:lang="en">ring marking</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/ring-marking"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/rotation">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:definition xml:lang="en">Shifting a rhythm&apos;s pulses by a number of steps without changing their spacing.</skos:definition>
		<skos:prefLabel xml:lang="en">rotation</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/rotation"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/sequential-composition">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#CategoricalConcept"/>
		<skos:definition xml:lang="en">Arrangement: one section followed by the next, the output marking of the first being the input of the second. Associative.</skos:definition>
		<skos:prefLabel xml:lang="en">sequential composition</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/sequential-composition"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/silence-unit">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#CategoricalConcept"/>
		<skos:definition xml:lang="en">The part that plays nothing. Stacking it with any part gives that same part back.</skos:definition>
		<skos:prefLabel xml:lang="en">silence (monoidal unit)</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/silence-unit"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/song-structure-net">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:closeMatch rdf:resource="https://beatscript.app/ontology/ns#ControlNet"/>
		<skos:definition xml:lang="en">A linear control net whose transitions mute and unmute tracks and activate slots at section boundaries, so the order of sections is the order of transitions firing.</skos:definition>
		<skos:prefLabel xml:lang="en">song structure net</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/song-structure-net"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/step-arc">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:closeMatch rdf:resource="https://ontology.pflow.xyz/ns#Arc"/>
		<skos:definition xml:lang="en">An arc from a place to its transition, or from a transition to the next place; together they close the ring.</skos:definition>
		<skos:prefLabel xml:lang="en">step arc</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/step-arc"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/step-place">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:closeMatch rdf:resource="https://ontology.pflow.xyz/ns#Place"/>
		<skos:definition xml:lang="en">One of the N places in a rhythm or melody ring. Each place is one step of the pattern.</skos:definition>
		<skos:prefLabel xml:lang="en">step place</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/step-place"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/syncopation">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:definition xml:lang="en">Accents placed off the strong beats.</skos:definition>
		<skos:prefLabel xml:lang="en">syncopation</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/syncopation"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/technique-found-phrases">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#Technique"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/docs/found-phrases"/>
		<skos:definition xml:lang="en">Borrowing found material for its shape, not its meaning: a public-domain line is chosen for its meter (trochees chant on the kick, iambs lilt on the offbeat, anapests and dactyls want a triplet feel, shanties call and respond, psalm parallelism repeats with variation), its stresses are written to land where the meter says, the vocal is kept low (about A3 to F4) and cycled between a buried section and a spotlit one, crossed onto the drum rhythms with xfer, and its pronunciation fixed with phoneme escapes. The lineage of sampling, cut-ups and readymades, borrowing structure rather than recordings, from sources clean by construction.</skos:definition>
		<skos:prefLabel xml:lang="en">found phrases</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:usesPhrasebook rdf:resource="https://beatscript.app/ontology/concept/phrasebook-public-domain"/>
		<ns:writtenAs>found-phrases</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/template-canon">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PhraseTemplate"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/ontology/concept/grammar-template"/>
		<skos:definition xml:lang="en">The phrase template canon: a canon at 90 in D: Pachelbel&apos;s violin line chased by copies of itself, a bar and a beat behind, over his ground; the phrase sung over them. Written arrange from template(canon, @mgm_pease_porridge_hot).</skos:definition>
		<skos:prefLabel xml:lang="en">canon</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>canon</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/template-cross">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PhraseTemplate"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/ontology/concept/grammar-template"/>
		<skos:definition xml:lang="en">The phrase template cross: a cross at 120 in D: two sources (two seeds, in any genres: `a=gen@1 dubstep seed=54876, b=gen@1 house seed=7`) take turns and overlap, and morph toward each other and back in cycles; the phrase sung over the crossing. Written arrange from template(cross, @psalm42_deep_calleth).</skos:definition>
		<skos:prefLabel xml:lang="en">cross</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>cross</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/template-deep-house">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PhraseTemplate"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/ontology/concept/grammar-template"/>
		<skos:definition xml:lang="en">The phrase template deep-house: deep house at 122: a night/spot cycle, the voice buried then spotlit, crossed onto the shaker; the phrase is the vocal line. Written arrange from template(deep-house, @tempest_such_stuff).</skos:definition>
		<skos:prefLabel xml:lang="en">deep-house</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>deep-house</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/template-fugue">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PhraseTemplate"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/ontology/concept/grammar-template"/>
		<skos:definition xml:lang="en">The phrase template fugue: a fugue at 104 in B minor: Grieg&apos;s Mountain King as the subject, answered a fifth up and re-entering transposed while Bach&apos;s Badinerie morphs toward it; the phrase sung over the subject. Written arrange from template(fugue, @tyger_burning_bright).</skos:definition>
		<skos:prefLabel xml:lang="en">fugue</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>fugue</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/template-passacaglia">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PhraseTemplate"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/ontology/concept/grammar-template"/>
		<skos:definition xml:lang="en">The phrase template passacaglia: a passacaglia at 100 in G minor: a ground that never changes (Holst&apos;s five-beat ostinato) under cumulative variations; the phrase sung over the ground. Written arrange from template(passacaglia, @eccl3_season).</skos:definition>
		<skos:prefLabel xml:lang="en">passacaglia</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>passacaglia</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/template-quodlibet">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PhraseTemplate"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/ontology/concept/grammar-template"/>
		<skos:definition xml:lang="en">The phrase template quodlibet: a quodlibet at 96 in D: public-domain themes take turns by section and cross-morph toward each other and away in cycles; the phrase sung over the ground. Written arrange from template(quodlibet, @psalm42_deep_calleth).</skos:definition>
		<skos:prefLabel xml:lang="en">quodlibet</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>quodlibet</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/template-rondo">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PhraseTemplate"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/ontology/concept/grammar-template"/>
		<skos:definition xml:lang="en">The phrase template rondo: a rondo at 116 in C: Joplin&apos;s Entertainer as the refrain, returning mutated between episodes (Bach&apos;s Prelude in C, the phrase sung). Written arrange from template(rondo, @shanty_drunken_sailor).</skos:definition>
		<skos:prefLabel xml:lang="en">rondo</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>rondo</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/template-theme-and-variations">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#PhraseTemplate"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/ontology/concept/grammar-template"/>
		<skos:definition xml:lang="en">The phrase template theme-and-variations: a theme and variations at 84 in D-flat: Dvorak&apos;s New World Largo, a different transform in each section and no cross-morphs; the phrase sung in one. Written arrange from template(theme-and-variations, @dickinson_chariot_death).</skos:definition>
		<skos:prefLabel xml:lang="en">theme-and-variations</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>theme-and-variations</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/tension-curve">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:definition xml:lang="en">A rise and release of intensity across a section or song.</skos:definition>
		<skos:prefLabel xml:lang="en">tension curve</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/tension-curve"/>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/theme-mode-major">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#ThemeMode"/>
		<skos:definition xml:lang="en">A theme in a major key.</skos:definition>
		<skos:prefLabel xml:lang="en">major</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>major</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/theme-mode-minor">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#ThemeMode"/>
		<skos:definition xml:lang="en">A theme in a minor key.</skos:definition>
		<skos:prefLabel xml:lang="en">minor</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>minor</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/theme-mode-modal">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#ThemeMode"/>
		<skos:definition xml:lang="en">A theme neither: a pedal or an ostinato on one note.</skos:definition>
		<skos:prefLabel xml:lang="en">modal</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>modal</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/theme-role-arp">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#ThemeRole"/>
		<skos:definition xml:lang="en">A theme written for the arp part: a chord broken into a figure: the harmony as a moving line.</skos:definition>
		<skos:prefLabel xml:lang="en">arp</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>arp</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/theme-role-bass">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#ThemeRole"/>
		<skos:definition xml:lang="en">A theme written for the bass part: a bass line, a ground or an ostinato: the line under the others.</skos:definition>
		<skos:prefLabel xml:lang="en">bass</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>bass</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/theme-role-harmony">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#ThemeRole"/>
		<skos:definition xml:lang="en">A theme written for the harmony part: chords, or an interval held: what the other lines are heard against.</skos:definition>
		<skos:prefLabel xml:lang="en">harmony</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>harmony</ns:writtenAs>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/theme-role-melody">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#ThemeRole"/>
		<skos:definition xml:lang="en">A theme written for the melody part: a tune: the line a person hums.</skos:definition>
		<skos:prefLabel xml:lang="en">melody</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>melody</ns:writtenAs>
	</skos:Concept>
	<rdf:Description rdf:about="https://beatscript.app/ontology/concept/themes-public-domain">
		<dct:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0/"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#ThemeLibrary"/>
		<rdfs:seeAlso rdf:resource="https://beatscript.app/themes"/>
		<skos:definition xml:lang="en">Melodies, basses and figures composed and first published before 1929, each written from the melody itself as BeatScript bars in a stated key, with its role, meter, source work, composer, year and pairings. A CC0 file, addressed by the CID of its text (beatscript.app/themes): the melodic twin of the phrasebook.</skos:definition>
		<skos:prefLabel xml:lang="en">public-domain theme library</skos:prefLabel>
		<ns:status>stable</ns:status>
		<ns:writtenAs>themes-pd</ns:writtenAs>
	</rdf:Description>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/timing-at-bar">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#TimingWord"/>
		<skos:definition xml:lang="en">The change happens at a numbered bar.</skos:definition>
		<skos:prefLabel xml:lang="en">at bar</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/timing-at-bar"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/timing-every-n-bars">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#TimingWord"/>
		<skos:definition xml:lang="en">The change repeats at a fixed bar interval.</skos:definition>
		<skos:prefLabel xml:lang="en">every N bars</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/timing-every-n-bars"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/timing-for-n-bars">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#TimingWord"/>
		<skos:definition xml:lang="en">The change holds for N bars and then reverts.</skos:definition>
		<skos:prefLabel xml:lang="en">for N bars</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/timing-for-n-bars"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/timing-on-next-phrase">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#TimingWord"/>
		<skos:definition xml:lang="en">The change waits for the next phrase boundary, so it lands on the beat the listener expects.</skos:definition>
		<skos:prefLabel xml:lang="en">on next phrase</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/timing-on-next-phrase"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/timing-ramp">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#TimingWord"/>
		<skos:definition xml:lang="en">The change moves gradually from one value to another over a span of bars instead of jumping.</skos:definition>
		<skos:prefLabel xml:lang="en">ramp</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/timing-ramp"/>
		<ns:status>in-development</ns:status>
	</skos:Concept>
