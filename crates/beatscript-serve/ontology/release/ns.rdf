	<skos:Concept rdf:about="https://beatscript.app/ontology/concept/ghost-note">
		<rdf:type rdf:resource="https://beatscript.app/ontology/ns#EngineConcept"/>
		<skos:definition xml:lang="en">A very quiet drum hit between the main ones, felt more than heard.</skos:definition>
		<skos:prefLabel xml:lang="en">ghost note</skos:prefLabel>
		<prov:wasDerivedFrom rdf:resource="https://ontology.bitwrap.io/concept/ghost-note"/>
