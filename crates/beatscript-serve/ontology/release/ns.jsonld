g production of BeatScript's grammar (a role of the form and what fills it: ground=gen@1 dubstep seed=54876 part=bass; one part of a seed role: a.bass=[d2 ~ a1 ~]; a form's number: delay=6 interval=-12)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"binding"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"NAME [ \".\" role ] \"=\" ( source | [ \"-\" ] INT )"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Phrase templates"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-dot"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-equals"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-minus"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-role"},{"@id":"https://beatscript.app/ontology/concept/grammar-source"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-int"},{"@id":"https://beatscript.app/ontology/concept/token-name"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"binding"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-block-end","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The block_end production of BeatScript's grammar (default end; loop N: 1 to 256 passes, then a coda)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"block_end"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"end\" | \"loop\" | \"loop\" INT [ \"then\" { NAME } \"end\" ]"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Arrange mutations"}],"https://b