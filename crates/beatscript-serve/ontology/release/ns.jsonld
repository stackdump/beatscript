script.app/ontology/ns#writtenAs":[{"@value":"launch"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-ldeck","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The ldeck production of BeatScript's grammar."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"ldeck"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"A\" | \"B\" | \"master\""}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Assertions"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-a"},{"@id":"https://beatscript.app/ontology/concept/keyword-b"},{"@id":"https://beatscript.app/ontology/concept/keyword-master"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"ldeck"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-let","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The let production of BeatScript's grammar (one token is a value; more tokens are a pattern)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"let"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"let\" NAME \"=\" ( sexpr | arith | ref | TOKEN { TOKEN } )"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Structure: lets, defs, sections, the arrangement"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-let"},{"@id":"https://beatscript.app