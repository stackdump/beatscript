lue":"do wheel"}]},{"@id":"https://beatscript.app/ontology/concept/noun-windows","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#ControlNoun"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The control noun windows: do windows <verb>."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"windows"}],"https://beatscript.app/ontology/ns#acceptsVerb":[{"@id":"https://beatscript.app/ontology/concept/verb-close"},{"@id":"https://beatscript.app/ontology/concept/verb-closeall"},{"@id":"https://beatscript.app/ontology/concept/verb-follow"},{"@id":"https://beatscript.app/ontology/concept/verb-fullscreen"},{"@id":"https://beatscript.app/ontology/concept/verb-list"},{"@id":"https://beatscript.app/ontology/concept/verb-open"},{"@id":"https://beatscript.app/ontology/concept/verb-toggle"}],"https://beatscript.app/ontology/ns#controlParameter":[{"@value":"on"},{"@value":"window"}],"https://beatscript.app/ontology/ns#defaultVerb":[{"@id":"https://beatscript.app/ontology/concept/verb-list"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"do windows"}]},{"@id":"https://beatscript.app/ontology/concept/open-net-cospan","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#CategoricalConcept"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://ontology.pflow.xyz/ns#hasPort"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A net with named ports at its boundary, as a cospan of sets of places. Imports and macro definitions are read this way: they are glued to the rest of a program by identifying ports."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"open net (cospan)"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/open-net-cospan"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/palette-acoustic","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The acoustic palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"acoustic"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"acoustic"}]},{"@id":"https://beatscript.app/ontology/concept/palette-ambient","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The ambient palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"ambient"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"ambient"}]},{"@id":"https://beatscript.app/ontology/concept/palette-chiptune","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The chiptune palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"chiptune"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"chiptune"}]},{"@id":"https://beatscript.app/ontology/concept/palette-club","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The club palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"club"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"club"}]},{"@id":"https://beatscript.app/ontology/concept/palette-jazz","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The jazz palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"jazz"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"jazz"}]},{"@id":"https://beatscript.app/ontology/concept/palette-lofi","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lofi palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"lofi"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"lofi"}]},{"@id":"https://beatscript.app/ontology/concept/palette-minecraft","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The minecraft palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"minecraft"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"minecraft"}]},{"@id":"https://beatscript.app/ontology/concept/palette-orchestral","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The orchestral palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"orchestral"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"orchestral"}]},{"@id":"https://beatscript.app/ontology/concept/palette-retro","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The retro palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"retro"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"retro"}]},{"@id":"https://beatscript.app/ontology/concept/palette-studio","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The studio palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"studio"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"studio"}]},{"@id":"https://beatscript.app/ontology/concept/palette-synth","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The synth palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"synth"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"synth"}]},{"@id":"https://beatscript.app/ontology/concept/palette-synthwave","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The synthwave palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"synthwave"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"synthwave"}]},{"@id":"https://beatscript.app/ontology/concept/palette-toybox","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The toybox palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"toybox"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"toybox"}]},{"@id":"https://beatscript.app/ontology/concept/palette-world","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Palette"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The world palette."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"world"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"world"}]},{"@id":"https://beatscript.app/ontology/concept/pattern-endofunctor","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#CategoricalConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Pattern as a functor from notes to notes: a function on single notes lifts to a function on patterns of them, and lifting respects composition and identity."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"Pattern endofunctor"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/pattern-endofunctor"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/phrasebook-family-anapestic","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MeterFamily"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Two unstressed syllables then a stressed one, so it rolls in threes: Byron's Sennacherib and Lear's nonsense."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"anapestic"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#suitsGenre":[{"@id":"https://beatscript.app/ontology/genre/dnb"},{"@id":"https://beatscript.app/ontology/genre/garage"}],"https://beatscript.app/ontology/ns#suitsGroove":[{"@value":"wants a triplet feel: drum and bass, breakbeat"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"anapestic"}]},{"@id":"https://beatscript.app/ontology/concept/phrasebook-family-call-and-response","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MeterFamily"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A work song: the leader sings a line and the crew answers; the stresses are the heaves, the pulls on the rope."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"call and response"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#suitsGroove":[{"@value":"call and response: the leader's syllables, then the crew's"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"call-and-response"}]},{"@id":"https://beatscript.app/ontology/concept/phrasebook-family-common-meter","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MeterFamily"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The hymn and ballad stanza: a line of four beats, then a line of three (eight syllables, then six)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"common meter"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#suitsGroove":[{"@value":"its 8-6-8-6 fills a 16-bar section, a line to a four-bar phrase"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"common-meter"}]},{"@id":"https://beatscript.app/ontology/concept/phrasebook-family-dactylic","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MeterFamily"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A stressed syllable then two unstressed ones, also in threes: the long line of Evangeline."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"dactylic"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#suitsGenre":[{"@id":"https://beatscript.app/ontology/genre/dnb"},{"@id":"https://beatscript.app/ontology/genre/garage"}],"https://beatscript.app/ontology/ns#suitsGroove":[{"@value":"wants a triplet feel: drum and bass, breakbeat"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"dactylic"}]},{"@id":"https://beatscript.app/ontology/concept/phrasebook-family-iambic","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MeterFamily"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Lines of ten syllables (eleven with a feminine ending) in pairs, unstressed then stressed: the beat of blank verse and the sonnet."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"iambic pentameter"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#suitsGenre":[{"@id":"https://beatscript.app/ontology/genre/house"}],"https://beatscript.app/ontology/ns#suitsGroove":[{"@value":"lilts on the offbeat: house"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"iambic"}]},{"@id":"https://beatscript.app/ontology/concept/phrasebook-family-nursery","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MeterFamily"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Two or three strong beats a line with any number of weak syllables between: a rhyme said aloud."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"nursery rhyme"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#suitsGenre":[{"@id":"https://beatscript.app/ontology/genre/garage"},{"@id":"https://beatscript.app/ontology/genre/lofi"}],"https://beatscript.app/ontology/ns#suitsGroove":[{"@value":"a clapping or lullaby dimeter: a triplet shuffle, or sparse"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"nursery"}]},{"@id":"https://beatscript.app/ontology/concept/phrasebook-family-oratory","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MeterFamily"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Speech: no fixed foot, the stresses of the sentence, built in threes and answering clauses."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"oratory"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#suitsGenre":[{"@id":"https://beatscript.app/ontology/genre/ambient"}],"https://beatscript.app/ontology/ns#suitsGroove":[{"@value":"speech as rhythm: a sparse spot section, not a groove"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"oratory"}]},{"@id":"https://beatscript.app/ontology/concept/phrasebook-family-parallelism","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MeterFamily"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The verse of the King James Bible: two halves that answer each other (day and night, speech and knowledge), with no fixed foot."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"parallelism"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#suitsGroove":[{"@value":"repeat plus variation: the second half answers the first"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"parallelism"}]},{"@id":"https://beatscript.app/ontology/concept/phrasebook-family-sprung","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MeterFamily"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Gerard Manley Hopkins's rhythm: count the stresses, not the syllables; a stress stands alone or takes up to three slack syllables."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"sprung rhythm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#suitsGroove":[{"@value":"counts stresses, not syllables: one stress to a beat, over any groove"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"sprung"}]},{"@id":"https://beatscript.app/ontology/concept/phrasebook-family-trochaic","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MeterFamily"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A stressed syllable then an unstressed one, four to a line, the last often cut short: Blake's Tyger and Hiawatha."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"trochaic"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#suitsGenre":[{"@id":"https://beatscript.app/ontology/genre/edm"},{"@id":"https://beatscript.app/ontology/genre/techno"},{"@id":"https://beatscript.app/ontology/genre/trance"}],"https://beatscript.app/ontology/ns#suitsGroove":[{"@value":"chants on the kick: techno, EDM, four on the floor"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"trochaic"}]},{"@id":"https://beatscript.app/ontology/concept/phrasebook-feel-straight","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Feel"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A straight feel: the syllables sit on the sixteenth grid."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"straight"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"straight"}]},{"@id":"https://beatscript.app/ontology/concept/phrasebook-feel-triplet","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Feel"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A triplet feel: the syllables go in groups of three."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"triplet"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"triplet"}]},{"@id":"https://beatscript.app/ontology/concept/phrasebook-public-domain","http://purl.org/dc/terms/license":[{"@id":"https://creativecommons.org/publicdomain/zero/1.0/"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Phrasebook"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Lines of verse, scripture, speech and work song first published before 1929, each with its source, its meter as a step pattern and the lyric BeatScript sings it as. A CC0 file, every text in the public domain, addressed by the CID of its text (beatscript.app/phrasebook)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"public-domain phrasebook"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"phrasebook-pd"}]},{"@id":"https://beatscript.app/ontology/concept/product-beatscript-language","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#ProgrammingLanguage"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/ns#Program"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@language":"en","@value":"BeatScript"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The language of BeatScript: whole tracks written as text, one line per deck, compiled to the Petri nets a deck runs. Small, total and deterministic: the same canonical text always has the same CID. Its documents are programs, written as .beatscript files."}],"http://www.w3.org/2004/02/skos/core#hiddenLabel":[{"@language":"en","@value":"btw"}],"http://www.w3.org/2004/02/skos/core#historyNote":[{"@language":"en","@value":"Called btw, its files .btw, before language version 2 (BeatScript 2, 2026-11-22). A btw program is a BeatScript 1 program: it is still read, and keeps its meaning and its CID."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"BeatScript language"}],"https://beatscript.app/ontology/ns#currentVersion":[{"@id":"https://beatscript.app/ontology/concept/beatscript-2"}],"https://beatscript.app/ontology/ns#fileExtension":[{"@value":".beatscript"}],"https://beatscript.app/ontology/ns#inProductFamily":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript"}],"https://beatscript.app/ontology/ns#legacyFileExtension":[{"@value":".btw"}],"https://beatscript.app/ontology/ns#legacyMediaType":[{"@value":"text/btw"},{"@value":"text/x-beatscript"}],"https://beatscript.app/ontology/ns#mediaType":[{"@value":"text/beatscript"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#McpServer"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Tools that let an AI assistant such as Claude use BeatScript: check, format and render programs, and play them on a paired phone."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"BeatScript MCP server"}],"https://beatscript.app/ontology/ns#homepage":[{"@type":"http://www.w3.org/2001/XMLSchema#anyURI","@value":"https://beatscript.app/mcp"}],"https://beatscript.app/ontology/ns#inProductFamily":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#McpServer"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Read-only access to the BeatScript ontology (https://beatscript.app/ontology/ns#), derived from the bitwrap ontology 0.2.0: genres, scales, grooves, song sections, instruments, Euclidean rhythms, Markov melody, the Petri-net engine concepts, and the BeatScript language's own terms (grammar productions, keywords, voices, kits, control nouns and verbs, MCP tools). Queries run over the materialized graph and are capped at 1000 rows and 5 seconds."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"BeatScript ontology MCP server"}],"https://beatscript.app/ontology/ns#homepage":[{"@type":"http://www.w3.org/2001/XMLSchema#anyURI","@value":"https://beatscript.app/ontology/"}],"https://beatscript.app/ontology/ns#inProductFamily":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/product-beatscript","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#ProductFamily"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The name shared by a music language, the Android app that plays it, the website beatscript.app and its MCP servers. Write or generate a program, send it to the phone, hear it."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"BeatScript"}],"https://beatscript.app/ontology/ns#homepage":[{"@type":"http://www.w3.org/2001/XMLSchema#anyURI","@value":"https://beatscript.app"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/ring-marking","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"https://ontology.pflow.xyz/ns#Marking"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Where the token sits in each ring right now: the whole state of the sequencer. A track's marking resets to its initial marking at the loop point."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"ring marking"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/ring-marking"}]},{"@id":"https://beatscript.app/ontology/concept/rotation","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Shifting a rhythm's pulses by a number of steps without changing their spacing."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"rotation"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/rotation"}]},{"@id":"https://beatscript.app/ontology/concept/sequential-composition","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#CategoricalConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Arrangement: one section followed by the next, the output marking of the first being the input of the second. Associative."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"sequential composition"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/sequential-composition"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/silence-unit","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#CategoricalConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The part that plays nothing. Stacking it with any part gives that same part back."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"silence (monoidal unit)"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/silence-unit"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/song-structure-net","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"https://beatscript.app/ontology/ns#ControlNet"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A linear control net whose transitions mute and unmute tracks and activate slots at section boundaries, so the order of sections is the order of transitions firing."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"song structure net"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/song-structure-net"}]},{"@id":"https://beatscript.app/ontology/concept/step-arc","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"https://ontology.pflow.xyz/ns#Arc"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"An arc from a place to its transition, or from a transition to the next place; together they close the ring."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"step arc"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/step-arc"}]},{"@id":"https://beatscript.app/ontology/concept/step-place","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"https://ontology.pflow.xyz/ns#Place"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"One of the N places in a rhythm or melody ring. Each place is one step of the pattern."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"step place"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/step-place"}]},{"@id":"https://beatscript.app/ontology/concept/syncopation","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Accents placed off the strong beats."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"syncopation"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/syncopation"}]},{"@id":"https://beatscript.app/ontology/concept/technique-found-phrases","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Technique"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/docs/found-phrases"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Borrowing found material for its shape, not its meaning: a public-domain line is chosen for its meter (trochees chant on the kick, iambs lilt on the offbeat, anapests and dactyls want a triplet feel, shanties call and respond, psalm parallelism repeats with variation), its stresses are written to land where the meter says, the vocal is kept low (about A3 to F4) and cycled between a buried section and a spotlit one, crossed onto the drum rhythms with xfer, and its pronunciation fixed with phoneme escapes. The lineage of sampling, cut-ups and readymades, borrowing structure rather than recordings, from sources clean by construction."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"found phrases"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesPhrasebook":[{"@id":"https://beatscript.app/ontology/concept/phrasebook-public-domain"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"found-phrases"}]},{"@id":"https://beatscript.app/ontology/concept/template-canon","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PhraseTemplate"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/concept/grammar-template"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The phrase template canon: a canon at 90 in D: Pachelbel's violin line chased by copies of itself, a bar and a beat behind, over his ground; the phrase sung over them. Written arrange from template(canon, @mgm_pease_porridge_hot)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"canon"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"canon"}]},{"@id":"https://beatscript.app/ontology/concept/template-cross","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PhraseTemplate"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/concept/grammar-template"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The phrase template cross: a cross at 120 in D: two sources (two seeds, in any genres: `a=gen@1 dubstep seed=54876, b=gen@1 house seed=7`) take turns and overlap, and morph toward each other and back in cycles; the phrase sung over the crossing. Written arrange from template(cross, @psalm42_deep_calleth)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"cross"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"cross"}]},{"@id":"https://beatscript.app/ontology/concept/template-deep-house","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PhraseTemplate"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/concept/grammar-template"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The phrase template deep-house: deep house at 122: a night/spot cycle, the voice buried then spotlit, crossed onto the shaker; the phrase is the vocal line. Written arrange from template(deep-house, @tempest_such_stuff)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"deep-house"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"deep-house"}]},{"@id":"https://beatscript.app/ontology/concept/template-fugue","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PhraseTemplate"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/concept/grammar-template"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The phrase template fugue: a fugue at 104 in B minor: Grieg's Mountain King as the subject, answered a fifth up and re-entering transposed while Bach's Badinerie morphs toward it; the phrase sung over the subject. Written arrange from template(fugue, @tyger_burning_bright)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"fugue"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"fugue"}]},{"@id":"https://beatscript.app/ontology/concept/template-passacaglia","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PhraseTemplate"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/concept/grammar-template"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The phrase template passacaglia: a passacaglia at 100 in G minor: a ground that never changes (Holst's five-beat ostinato) under cumulative variations; the phrase sung over the ground. Written arrange from template(passacaglia, @eccl3_season)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"passacaglia"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"passacaglia"}]},{"@id":"https://beatscript.app/ontology/concept/template-quodlibet","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PhraseTemplate"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/concept/grammar-template"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The phrase template quodlibet: a quodlibet at 96 in D: public-domain themes take turns by section and cross-morph toward each other and away in cycles; the phrase sung over the ground. Written arrange from template(quodlibet, @psalm42_deep_calleth)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"quodlibet"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"quodlibet"}]},{"@id":"https://beatscript.app/ontology/concept/template-rondo","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PhraseTemplate"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/concept/grammar-template"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The phrase template rondo: a rondo at 116 in C: Joplin's Entertainer as the refrain, returning mutated between episodes (Bach's Prelude in C, the phrase sung). Written arrange from template(rondo, @shanty_drunken_sailor)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"rondo"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"rondo"}]},{"@id":"https://beatscript.app/ontology/concept/template-theme-and-variations","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PhraseTemplate"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/concept/grammar-template"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The phrase template theme-and-variations: a theme and variations at 84 in D-flat: Dvorak's New World Largo, a different transform in each section and no cross-morphs; the phrase sung in one. Written arrange from template(theme-and-variations, @dickinson_chariot_death)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"theme-and-variations"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"theme-and-variations"}]},{"@id":"https://beatscript.app/ontology/concept/tension-curve","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A rise and release of intensity across a section or song."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"tension curve"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/tension-curve"}]},{"@id":"https://beatscript.app/ontology/concept/theme-mode-major","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#ThemeMode"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A theme in a major key."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"major"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"major"}]},{"@id":"https://beatscript.app/ontology/concept/theme-mode-minor","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#ThemeMode"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A theme in a minor key."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"minor"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"minor"}]},{"@id":"https://beatscript.app/ontology/concept/theme-mode-modal","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#ThemeMode"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A theme neither: a pedal or an ostinato on one note."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"modal"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"modal"}]},{"@id":"https://beatscript.app/ontology/concept/theme-role-arp","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#ThemeRole"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A theme written for the arp part: a chord broken into a figure: the harmony as a moving line."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"arp"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"arp"}]},{"@id":"https://beatscript.app/ontology/concept/theme-role-bass","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#ThemeRole"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A theme written for the bass part: a bass line, a ground or an ostinato: the line under the others."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"bass"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"bass"}]},{"@id":"https://beatscript.app/ontology/concept/theme-role-harmony","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#ThemeRole"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A theme written for the harmony part: chords, or an interval held: what the other lines are heard against."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"harmony"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"harmony"}]},{"@id":"https://beatscript.app/ontology/concept/theme-role-melody","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#ThemeRole"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A theme written for the melody part: a tune: the line a person hums."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"melody"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"melody"}]},{"@id":"https://beatscript.app/ontology/concept/themes-public-domain","http://purl.org/dc/terms/license":[{"@id":"https://creativecommons.org/publicdomain/zero/1.0/"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#ThemeLibrary"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/themes"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Melodies, basses and figures composed and first published before 1929, each written from the melody itself as BeatScript bars in a stated key, with its role, meter, source work, composer, year and pairings. A CC0 file, addressed by the CID of its text (beatscript.app/themes): the melodic twin of the phrasebook."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"public-domain theme library"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"themes-pd"}]},{"@id":"https://beatscript.app/ontology/concept/timing-at-bar","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TimingWord"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The change happens at a numbered bar."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"at bar"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/timing-at-bar"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/timing-every-n-bars","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TimingWord"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The change repeats at a fixed bar interval."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"every N bars"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/timing-every-n-bars"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/timing-for-n-bars","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TimingWord"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The change holds for N bars and then reverts."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"for N bars"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/timing-for-n-bars"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/timing-on-next-phrase","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TimingWord"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The change waits for the next phrase boundary, so it lands on the beat the listener expects."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"on next phrase"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/timing-on-next-phrase"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/timing-ramp","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TimingWord"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The change moves gradually from one value to another over a span of bars instead of jumping."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"ramp"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/timing-ramp"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/token-chord","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's CHORD token, used in: arg."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"CHORD"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"CHORD"}]},{"@id":"https://beatscript.app/ontology/concept/token-cid","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's CID token, used in: stored, track."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"CID"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"CID"}]},{"@id":"https://beatscript.app/ontology/concept/token-decimal","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's DECIMAL token, used in: TIME, clock, db, time."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"DECIMAL"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"DECIMAL"}]},{"@id":"https://beatscript.app/ontology/concept/token-gen","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's GEN token, used in: gen."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"GEN"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"GEN"}]},{"@id":"https://beatscript.app/ontology/concept/token-genre","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's GENRE token, used in: use_source."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"GENRE"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"GENRE"}]},{"@id":"https://beatscript.app/ontology/concept/token-ghost","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's GHOST token, used in: mark."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"GHOST"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"GHOST"}]},{"@id":"https://beatscript.app/ontology/concept/token-glob","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's GLOB token, used in: mut_target."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"GLOB"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"GLOB"}]},{"@id":"https://beatscript.app/ontology/concept/token-int","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's INT token, used in: SPEC, arg, arr_end, assert, atom, binding, block_end, bound, choose, dleaf, dterm, end, engine, evolve, gen, input, launch, mutation, op, part, repeat, rule, section, seed, set_mix, shape, sing, step, term, until_when."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"INT"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"INT"}]},{"@id":"https://beatscript.app/ontology/concept/token-key","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's KEY token, used in: arg, assert, gen_param, setting, sing."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"KEY"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"KEY"}]},{"@id":"https://beatscript.app/ontology/concept/token-macro","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's MACRO token, used in: engine."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"MACRO"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"MACRO"}]},{"@id":"https://beatscript.app/ontology/concept/token-name","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's NAME token, used in: SPEC, arg, arr_end, arrange, arrange_block, assert, atom, binding, block_end, call, def, do, end, engine, form, gen, gen_param, import, invoke, launch, let, mut_op, mut_target, sample, section, seed, set_play, sexpr, sing, source, start, station_line, stored, switch, template, track, until_when, use, use_source, when, wire."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"NAME"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"NAME"}]},{"@id":"https://beatscript.app/ontology/concept/token-newline","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's NEWLINE token, used in: arr_gap, body_line, def_line, evolve, line, mix, set, station."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"NEWLINE"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"NEWLINE"}]},{"@id":"https://beatscript.app/ontology/concept/token-note","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's NOTE token, used in: atom."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"NOTE"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"NOTE"}]},{"@id":"https://beatscript.app/ontology/concept/token-number","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's NUMBER token, used in: cprimary, gen_param, lfactor, lfo, mut_op, op, primary, prob, set_mix, weight."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"NUMBER"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"NUMBER"}]},{"@id":"https://beatscript.app/ontology/concept/token-param","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's PARAM token, used in: arg, atom, cprimary, deck, primary, pvalue."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"PARAM"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"PARAM"}]},{"@id":"https://beatscript.app/ontology/concept/token-phones","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's PHONES token, used in: escape."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"PHONES"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"PHONES"}]},{"@id":"https://beatscript.app/ontology/concept/token-phrase","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's PHRASE token, used in: sing, template, use_source."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"PHRASE"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"PHRASE"}]},{"@id":"https://beatscript.app/ontology/concept/token-pitch","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's PITCH token, used in: input."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"PITCH"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"PITCH"}]},{"@id":"https://beatscript.app/ontology/concept/token-ratchet","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's RATCHET token, used in: mark."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"RATCHET"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"RATCHET"}]},{"@id":"https://beatscript.app/ontology/concept/token-roman","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's ROMAN token, used in: arg, atom."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"ROMAN"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"ROMAN"}]},{"@id":"https://beatscript.app/ontology/concept/token-sdeg","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's SDEG token, used in: dleaf."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"SDEG"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"SDEG"}]},{"@id":"https://beatscript.app/ontology/concept/token-seed","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's SEED token, used in: seed."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"SEED"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"SEED"}]},{"@id":"https://beatscript.app/ontology/concept/token-space","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's SPACE token, used in: lyric_text."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"SPACE"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"SPACE"}]},{"@id":"https://beatscript.app/ontology/concept/token-string","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's STRING token, used in: do, doval, import, lyric, sample, set_play, template."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"STRING"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"STRING"}]},{"@id":"https://beatscript.app/ontology/concept/token-sugar","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's SUGAR token, used in: do."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"SUGAR"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"SUGAR"}]},{"@id":"https://beatscript.app/ontology/concept/token-text","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's TEXT token, used in: lyric_text."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"TEXT"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"TEXT"}]},{"@id":"https://beatscript.app/ontology/concept/token-token","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's TOKEN token, used in: let, tokens."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"TOKEN"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"TOKEN"}]},{"@id":"https://beatscript.app/ontology/concept/token-unit","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's UNIT token, used in: TIME."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"UNIT"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"UNIT"}]},{"@id":"https://beatscript.app/ontology/concept/token-word","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#TokenClass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lexer's WORD token, used in: arg, coperand, do, doval, engine, operand, pvalue."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"WORD"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"WORD"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-artifact","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"One BeatScript program as a self-contained HTML page, for the person to hear and share: publish the returned html as a page (an Artifact) exactly as it is, without rewriting it, and do not hand-roll a player instead. The page embeds the program's text and its CID, starts sound only when the person presses Play, shows the CID and the program's rights (licence, credits, forked from), and links back to the program on https://beatscript.app: https://beatscript.app/p/<CID> when the site has it stored, else the self-sealing share link (the program is in the link), never a /p/<CID> that would not answer. Nothing is fetched from https://beatscript.app. With store true a signed-in caller stores a text first, publicly and under its `#! license:` (default CC0-1.0, a Creative Commons licence only), as share does, so the page gets the /p/<CID> link and inline audio. Two ways to sound, chosen by audio: \"inline\" (the default for a stored program that renders) carries the site's Ogg Opus render of the program in the page as a data: URI in a plain <audio controls>, so the page loads nothing at all (no script, no engine); it is the offline render (notes and sounds, not control lines), at most 6 MB as base64, and a longer render, a text that is not stored, or a render that does not finish falls back to engine with audio_note saying why. \"engine\" (the default for a text) plays it live with the <beatscript-track> player (@stackdump/beatscript-player@0.3.0, the same engine as the editor, loaded from cdn.jsdelivr.net at that exact version with a Subresource Integrity hash for every module it loads); the host must allow scripts from cdn.jsdelivr.net and WebAssembly ('wasm-unsafe-eval'), as a claude.ai Artifact does. Ogg Opus does not play in older Safari; there is no AAC render. Give exactly one of text (the program; it must pass check; not stored unless store), cid (a program stored here or an example's CID: the page carries the stored rights) or example (a name from list_examples). title names the page (default the program's `#! name:`, else its stored name). Answers two text blocks: the first a JSON summary {title, cid, canonical_bytes, stored, rights, link, short_url, audio, player, render, audio_note, store_hint, html_bytes, publish}, the second the page (a whole HTML document). A program that uses samples or loops, or says `use restricted`, has nothing to play in a page and is refused. No sign-in, and it stores nothing, unless store; billed as a check (a render not cached yet is limited as render's are, a store as share's). Text at most 16384 bytes."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"artifact"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"audio\":{\"description\":\"inline (the site's Opus render in the page, nothing loaded; default for a stored program) or engine (the live player from jsDelivr; default for a text).\",\"enum\":[\"inline\",\"engine\"],\"type\":\"string\"},\"cid\":{\"description\":\"CID of a program stored here, or of an example: the page carries the rights it was stored with.\",\"maxLength\":100,\"pattern\":\"^z[1-9A-HJ-NP-Za-km-z]{20,100}$\",\"type\":\"string\"},\"example\":{\"description\":\"Name of an example, from list_examples.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$\",\"type\":\"string\"},\"store\":{\"description\":\"With text: store it on the site first (public, its `#! license:` or CC0-1.0; needs a signed-in caller), as share does, so the page links /p/<CID> and can carry the render inline (default false: the page links the self-sealing link instead).\",\"type\":\"boolean\"},\"text\":{\"description\":\"The program text. It must pass check.\",\"maxLength\":16384,\"type\":\"string\"},\"title\":{\"description\":\"The page's title and the name to publish it under (default the program's `#! name:`, else its stored name, else \\\"BeatScript\\\").\",\"maxLength\":80,\"type\":\"string\"}},\"required\":[],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"artifact"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"audio"},{"@value":"cid"},{"@value":"example"},{"@value":"store"},{"@value":"text"},{"@value":"title"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"A program as a page to publish"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-check","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Check a BeatScript program without playing it: parse, type-check and compile the text. ALWAYS call check before eval, share or render, and fix every error at its line:col before trying again: a program with an error is refused whole. Warnings do not block. A `control:` line is the control deck (docs/BEATSCRIPT.md \"The control deck\"): engine calls only (move, swap pairs, load pair, queue, crossfader, a timed tempo, duck, mix, do), beside deck A:, deck B: and master:, sequenced by sections like a deck; it checks and plays as the same line with no head. An `arrange { }` switches it pass by pass with a line of its own: `~ control off` (a section's control-deck lines do not fire from here on), `~ control on`, `@ control off` (the next section only), `~ control freeze off` (the lines of one call), `~3 control off` (every 3rd pass); plays[].control_off in the answer's arrange names the calls each play holds back.\n\nAnswers {ok, errors, warnings, diagnostics[{severity, line, col, end_col, message, expected, found, help, render}], cid, canonical, version, renamed_cid, expanded_cid, tempo, key, sections, song_bars, seconds, evolve, uses_assets, restricted, docs}, and refs and resolution for a program with references, and arrange {passes, unbounded, plays[{section, name, pass, coda, start_bar, bars, reads, control_off}], patterns, fires} for an `arrange { }` with mutations. docs is the text's doc comments, [{kind, name, doc}]: the `#` lines directly above a section, let, def or arrange (a comment, so the CID does not change); sections[].doc is a section's, when it has one. line and col are 1-based; help says what would fix it (\"did you mean ...\"); render is the same error in caret form. ok:false is an answer, not a tool error. cid and canonical are of the canonical text (comments and spacing do not change the CID). version is the language version: 2 for a text whose header has `#! beatscript 2` (write that), 1 for a text with `#! btw 1` or no version line (BeatScript 1, the old spelling, which checks as before and keeps its old CID); renamed_cid is the CID of the same program in the other version (fmt upgrades a BeatScript 1 text to it). A station program (radio: a `station { }` block, see the station tool) checks the tracks of its first pass of forms and its first segue, and the answer gains station {text, cid, genre, generator, seed, step, forms, tempo, key, length, start_cid, version, tracks, segue}.\n\nWith same_as (another program's CID or text) the answer gains same_as {same, text_same, basis, why, diffs[{section, deck, start_bar, a_cid, b_cid}], only_in_a, only_in_b, renamed, song, diff}: whether the two are the same song by their compiled nets and song-level settings, not their text. When they are not, diff says what changed in music: diff.summary is one line per change (\"tempo 124 -> 126\", \"moved outro: bar 13 -> bar 5\", \"drop2 bass = drop bass transposed +1\", \"drop bass: 1 note changed (1:7 c3 -> d3)\"), with song, arrangement (inserted, removed, moved, repeated, renamed, changed) and parts (a transform: transpose, octave, rotate, reverse, thin, fill, fast, slow; else the notes added, removed or changed at bar:step) as JSON. Use it to prove a refactor changed nothing, or to find what an edit did.\n\nThis is the loop for writing a program (there is no compose tool): read https://beatscript.app/docs/cheatsheet.md and one or two list_examples programs, call instruments, write the program (its first line `#! beatscript 2`), call check and fix every line:col error until ok, then eval / load to play it and share to store it. Voices come from the instruments tool: use only names from it. For a sung line, a public-domain phrasebook line (list_examples with phrasebook true) comes with its meter, stress and phoneme escapes, so that sing @id on melody checks with no unknown-word warning (https://beatscript.app/docs/found-phrases.md). A voice name with a leading digit (808-bass) cannot be written: inst=808-bass reads as 808 - bass and a quoted \"808-bass\" is refused, so pick a voice that starts with a letter (inst=sub-bass for a deep bass). Read-only, no sign-in. Limits: the text is at most 16384 bytes; about 60 calls a minute.\n\nReferences: a program can call the seeded generator (gen@2 techno seed=42 section=drop part=bass is the program generate prints, fitted to the program's key and tempo unless it says bpm= or key=) or borrow from seed(...), template(...) or a stored program by CID. Its cid is of the text as written (the recipe), and the answer says what the recipe makes: refs lists each reference of the program (a gen@N call, a seed(...), a template(...), a <cid>.section borrowed from a stored program): its kind, half (engine or structure), call, place (part, let, section or arrange), name, line and col, resolved (the CID it is pinned to), generator, fitted (what a gen call took from the program: key, bpm) and track; expanded_cid is the CID of the program with every reference written out as plain BeatScript: cid addresses the recipe, expanded_cid the result; the same recipe always gives the same expanded_cid, and a program with no references has expanded_cid equal to cid; resolution is the manifest: each reference once, with the CID it is pinned to and the generator and version that made it (seeded@2), and for a gen call the key and bpm it was generated in; a template's entry in resolution has parts: each role its reference binds, at any depth (a role of a form bound to a role is a part of that part), as {path, role, kind, call, cid, resolves, generator, parts}: path is where it stands (episodes/ground), kind what it was bound to (gen, stored, theme, notes or template), call the source as bound, cid the CID of what it is written out as (a program of its own: the key and tempo it plays in and the lines its binding wrote, every reference in them written out), resolves the CID its source is pinned to; the same recipe always gives the same parts and part CIDs. With expand true, each entry of refs also carries its expansion (the BeatScript it is written out as where it stands), and each part its text. A diagnostic of severity info at each gen call says the CID it resolved to and the key and tempo it was fitted to; the expand tool writes the whole program out. A `use SOURCE as NAME` line names a source on a line of its own (a stored program's <cid>.drop or <cid>.drop.bass, a gen call, a canned section template(passacaglia).ground, a form, theme ode_to_joy, phrase @tempest_such_stuff, genre@1 techno.drop; docs/BEATSCRIPT.md \"Name a source: `use`\"), and the name is then used as a section, a let or a phrase of the program's own (in a role, as its source): it is a reference of kind `use` in refs, a note at it says what the name is, and imports lists each `use SOURCE as NAME` line of the program: its name, what the name is (is: a section, a line, a source for a role or a phrase), from (the source, in canonical spelling), source (its kind: stored, gen, template, form, theme, phrase or genre), resolved (what it is pinned to: a CID, or the library's CID for a theme or a phrase), line and col, and what (a sentence).\n\nLexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules' pronunciation. Only the word, its phonemes and the program's CID are kept, never the text. The answer's lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"check"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"expand\":{\"description\":\"Also give each entry of refs its expansion: the BeatScript the reference is written out as where it stands, and each of a template's parts in resolution its text (default false).\",\"type\":\"boolean\"},\"genre\":{\"description\":\"Optional: a genre of the BeatScript ontology (techno, house, jazz, ... or its https://beatscript.app/ontology/genre/ IRI); else the program's own `#! genre:` line. The answer gains style {genre, label, warnings[{severity: \\\"style\\\", code, message, line?, col?}]}: advice from the genre's conventions in the ontology (a tempo outside its range, a kit or voice the genre and its family do not use, chords far from its progressions). Style warnings never make ok false.\",\"maxLength\":200,\"type\":\"string\"},\"same_as\":{\"description\":\"Optional: another program to compare with, as its CID (stored here, or an example's), a short https://beatscript.app/p/<CID> link, or its text. The answer gains same_as: whether the two are the same song by their compiled nets and song-level settings (tempo, key, swing, length, end, loop), not their text: a let/def/repeat refactor or a renamed section is the same song; a changed note is not, and diff says what changed in music (song settings, sections moved or inserted, a part transposed or rotated, notes at bar:step).\",\"maxLength\":16384,\"type\":\"string\"},\"text\":{\"description\":\"The program text (at most 16384 bytes). Comments and blank lines are fine.\",\"maxLength\":16384,\"type\":\"string\"}},\"required\":[\"text\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"text"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"check"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"expand"},{"@value":"genre"},{"@value":"same_as"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Check a BeatScript program"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-devices","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"List the phones paired with the token's account (djrust on Android scans the QR code that https://beatscript.app shows under Mobile; site/PAIRING.md): id, name, fingerprint (the code both ends showed at pairing), paired, connected (djrust has its stream open now), last_seen, and state (what it last reported: cid, playing, section, bar). Pairing is the grant: a phone paired by an account is driven over MCP with that account's token and no other.\n\nPass a phone's id as device to eval, load, get or stop to drive that phone alone (eval and load run the same checks as for a tab; a program with errors, samples or \"use restricted\" is not sent). Needs a bearer token. Read-only."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"devices"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{},\"required\":[],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"devices"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Your paired phones"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-embed","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A program (or a set, or a station) embedded anywhere, from one embed config (https://beatscript.app/embed-config.schema.json, the same config the <beatscript-track> player and the <beatscript-studio> editor read): give a target and a config, and get the snippet or page for it, whether the config works there, is degraded or is unsupported, and one-sentence notes on what the target cannot do and what it does instead. Use the snippet as it is. Targets: artifact, web, iframe, oembed, preview, markdown, jupyter, vscode, obsidian, audio, rss, android, json. kind is player, studio (the whole editor as an MCP server inside the page: check, fmt, expand, generate, highlight, share, open, instruments, cheatsheet run offline on the wasm engine), card or audio; source is text, cid, set or station; audio is live, render, inline or url; features and capabilities are lists. With target artifact the answer is two text blocks, a JSON summary and the page: publish the page as an HTML page (an Artifact) exactly as it is, and declare the summary's capabilities (sample, mcp with the Beatscript connector's share, render and queue, db and user, downloads, room) when you publish it. Kind player or audio on target artifact is the artifact tool's page: kind audio (or audio inline) carries the site's render of a stored program in the page (a render not cached yet is limited as render's are), kind player plays it with the pinned player; kind studio loads @stackdump/beatscript-studio from cdn.jsdelivr.net at an exact version with Subresource Integrity. markdown (a GitHub README) gets an SVG card (https://beatscript.app/card/<CID>.svg) and an audio link; iframe, oembed, preview, audio, rss and obsidian need a program the site stores (share it signed in, or render it); android is the self-sealing /p# link the app opens. Give the program as text, cid or example (or in the config's source). No sign-in, and it stores nothing unless store (artifact, player or audio only); billed as a check. Text at most 16384 bytes. See https://beatscript.app/docs/embed."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"embed"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"cid\":{\"description\":\"CID of a program stored here, or of an example.\",\"maxLength\":100,\"pattern\":\"^z[1-9A-HJ-NP-Za-km-z]{20,100}$\",\"type\":\"string\"},\"config\":{\"description\":\"The embed config (https://beatscript.app/embed-config.schema.json): kind, source, audio, features, capabilities, theme, compact, width, height, title, site, bridge, pin. Defaults by kind.\",\"type\":\"object\"},\"example\":{\"description\":\"Name of an example, from list_examples.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$\",\"type\":\"string\"},\"store\":{\"description\":\"Target artifact, kind player or audio: store the text first (signed in), as the artifact tool does.\",\"type\":\"boolean\"},\"target\":{\"description\":\"Where it goes. artifact (the default) gives a whole page.\",\"enum\":[\"artifact\",\"web\",\"iframe\",\"oembed\",\"preview\",\"markdown\",\"jupyter\",\"vscode\",\"obsidian\",\"audio\",\"rss\",\"android\",\"json\"],\"type\":\"string\"},\"text\":{\"description\":\"The program text, instead of the config's source. It must pass check.\",\"maxLength\":16384,\"type\":\"string\"},\"title\":{\"description\":\"The name to show and publish under (default the program's `#! name:`).\",\"maxLength\":80,\"type\":\"string\"}},\"required\":[],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"embed"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"cid"},{"@value":"config"},{"@value":"example"},{"@value":"store"},{"@value":"target"},{"@value":"text"},{"@value":"title"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"A program embedded anywhere"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-eval","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Send a program to a browser tab that has https://beatscript.app open, as if the user pressed Cmd+Enter in the editor: the text replaces the editor's and the change lands on the next bar, with no gap; play:true starts playback too. Needs a bearer token.\n\nA tab must be connected. It is the page's own connection, so ask the user to open https://beatscript.app in a browser (signed in as the same account as the token, and eval reaches every live tab of that account), or, for a tab that is not signed in, to press MCP in the page's top bar and give you the session id it shows, which you pass as session. With no tab connected the answer is a no_session error that says this.\n\nRun check first. eval checks too and refuses a program with errors (nothing is sent; the diagnostics come back), and one that uses samples or \"use restricted\" (the browser has no such files). The program is the user's to hear: do not eval over something they are playing without saying so. After eval call get to see what is playing, the section and bar, and any diagnostics the page itself reports. The text is formatted on the way in, as fmt does (header lines and comments kept), so the editor shows it tidy. Text is at most 16384 bytes.\n\nLexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules' pronunciation. Only the word, its phonemes and the program's CID are kept, never the text. The answer's lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"eval"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"device\":{\"description\":\"Id of one of your paired phones (djrust on Android), from the devices tool. Targets that phone alone; do not combine with session.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9_-]{6,64}$\",\"type\":\"string\"},\"play\":{\"description\":\"Start playing too (default false: load it and leave it stopped, or leave a playing tab as it is).\",\"type\":\"boolean\"},\"session\":{\"description\":\"Session id of one browser tab, from the MCP panel of the page. Leave out to use your own signed-in tabs (every live one for eval/load/stop, the latest for get).\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9_-]{6,64}$\",\"type\":\"string\"},\"text\":{\"description\":\"The program text. It must pass check.\",\"maxLength\":16384,\"type\":\"string\"}},\"required\":[\"text\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"text"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"eval"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"device"},{"@value":"play"},{"@value":"session"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Play a program in a browser tab"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-expand","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Write out every seed(...) and template(...) of a BeatScript program as the plain BeatScript it stands for, to start from a generated track and edit it. seed(genre, n[, structure]) is a track of the beats generator (genres: ambient blues bossa country dnb dubstep edm funk garage house jazz lofi metal reggae speedcore synthwave techno trance trap; structures: standard, loop, minimal, extended), and it is a value, never audio: `arrange from seed(techno, 42)` is the whole track, `section intro from seed(techno, 42)[1..8]` its first eight bars as a section, and `bass seed(techno, 42).bass[17..24]` (or `let riff = seed(techno, 42).bass[17..24]`) one part's bars as a pattern; seed@2(genre, n) is seeds v2, the same track with its genre's swing written (`arrange from seed@2(jazz, 7)` says swing 0.6; a bare seed(...) is seeds v1, written straight). template(name, phrase) compiles a phrase, a phrasebook id (@tempest_such_stuff) or any words in quotes, to a whole track, `arrange from template(deep-house, @tempest_such_stuff)` (templates: deep-house): the phrase is the vocal line, its syllables the line's length, its stress the accents and the beats, its meter the subdivision, and the arrangement is the template's own. A gen@N call (gen@2 techno seed=42 section=drop part=bass: the seeded generator, the program generate prints, pinned by its CID) is written out by where it stands: `arrange from gen@2 ...` as the whole program (under a `# from: gen@2 ... -> <cid>` line), a part line or `section X from gen@2 ... section=drop` as that section's parts, `let bed = gen@2 ... section=drop part=bass` as a let a bar (bed_1, bed_2, ..., bed = <bed_1 bed_2 ...>). check, eval and share take the references as they are and play the same music (the CID is of the short text); expand gives the long text, with a `# from seed(...)` or `# from template(...)` line over each place it wrote, to edit from there. Answers {ok, text, canonical, cid, from_cid, refs, resolution, diagnostics}: cid is the written-out program's, from_cid the one you gave; resolution is check's manifest (each reference once with its pin, and a template's nested parts, each with the CID of what it is written out as); with lineage true the text opens with `#! forked-from: <from_cid>`. With eject \"line:col\" it writes out only the reference there, in place, under its `# from: <call> -> <cid>` line (a comment: the ejected text has the CID of the same notes typed by hand), and answers {ok, text, cid, ejected: {call, kind, half, place, name, resolved, from}}. A `use SOURCE as NAME` line is written out as the definition its source makes (section NAME from ..., let NAME = ..., a theme's lets in the program's key), and a name in a role or a phrase's place as its source; the answer then also has imports, each name with its source. Read-only, no sign-in."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"expand"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"eject\":{\"description\":\"Optional: \\\"line:col\\\" (1-based) of one reference (a gen@N call, a seed(...), a <cid>.drop, a template(...)): eject it, writing just that one out in place under its `# from: <call> -> <cid>` line, the rest left as they are.\",\"maxLength\":16,\"pattern\":\"^[0-9]+:[0-9]+$\",\"type\":\"string\"},\"lineage\":{\"description\":\"Open the written-out text with `#! forked-from: <CID of the program as given>` (default false), so that once it is shared it says what it came from.\",\"type\":\"boolean\"},\"text\":{\"description\":\"The program text, with gen@N calls, seed(...) or template(...) references in it.\",\"maxLength\":16384,\"type\":\"string\"}},\"required\":[\"text\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"text"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"expand"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"eject"},{"@value":"lineage"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Write out a program's seeds and templates"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-fmt","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Format a BeatScript program as the editor's fmt button does, in BeatScript 2: one statement a line, one space between tokens, blocks indented two spaces, numbers, notes and chords spelled one way, and the version line `#! beatscript 2` first; the other `#!` header lines, the comments and the blank lines between blocks stay where they are. A BeatScript 1 text (`#! btw 1`, or no version line) is upgraded: the same program under a new CID, and from_cid is the CID of the text as given (the old CID keeps working). Answers text (the formatted program), canonical (the same with no comments and no header lines but the version line: the CID is of that), cid, version (2), from_cid (only when it upgraded) and comments. A BeatScript 2 text formats to its own CID, so use fmt to tidy a program, to upgrade one, or to compare two; eval, load, queue, share and push_private already format what they are given and never upgrade it. A program that does not parse answers the same diagnostics as check. Read-only, no sign-in."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"fmt"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"text\":{\"description\":\"The program text.\",\"maxLength\":16384,\"type\":\"string\"}},\"required\":[\"text\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"text"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"fmt"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Format a BeatScript program"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-generate","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Generate a whole BeatScript track from a seed, with no model and no sign-in: the beats generator picks the genre's rhythms (Euclidean), chord progression, instruments and song structure from the seed, and the result is printed as readable source (named lets, a def for the shared groove, sections, an arrange, filter ramps, the chords as Roman numerals and e()/arp()/markov()/every/rotate/degrade with their seeds written out, so one `key` line moves the whole song) for you to edit. Same genre, bpm, key, length and seed: the same text and CID, every time; the seed and generator are in the #! header so the track can be re-derived. The program passes check and is stored as public CC0 (source generate). Answers text, cid, name, seed, generator, url and render_url; play it with eval or load, or edit it and check again.\n\nThe answer also has gen, the call that is this program in BeatScript (gen@2 techno seed=42, with the bpm=, key= and length= you gave: `arrange from gen@2 techno seed=42` plays it), expanded_cid (the same as cid: a generated program has no references), and parts, so you can pick parts without reading the text: one entry a role, {role, section, sections, voice or kit, text, let, gen}, where gen is the call that is just that part (gen@2 techno seed=42 section=drop part=bass) and let is what `let drop_bass = <gen>` writes (a let a bar). Put a part's gen in a let or on a part line of your own program to layer it, mutate it in an arrange or cross it with another seed; there it is fitted to your program's key and tempo unless it says key= and bpm=, and check reports it in refs. With part (a role) the answer gains that part and its let alone; generator picks the version (1, 2 or 3, as gen@1, gen@2 and gen@3 name them; 3 writes BeatScript 2); seeds (a list, or {count, start}, at most 16) answers a compact summary a seed instead of one program.\n\nLexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules' pronunciation. Only the word, its phonemes and the program's CID are kept, never the text. The answer's lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"generate"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"bpm\":{\"description\":\"Tempo; default the genre's.\",\"maximum\":300,\"minimum\":40,\"type\":\"number\"},\"generator\":{\"description\":\"The version of the seeded generator, as gen@N names it in a program: 1 (seeded@1, frozen), 2 (seeded@2, the chords and arps as Roman numerals) or 3 (seeded@3: seeded@2's music written in BeatScript 2, `#! beatscript 2` first); default 3. A version always prints the same program for the same inputs.\",\"enum\":[1,2,3],\"type\":\"integer\"},\"genre\":{\"description\":\"The genre whose rhythms, chords, instruments and song structure it uses (default techno).\",\"enum\":[\"techno\",\"house\",\"jazz\",\"ambient\",\"dnb\",\"edm\",\"speedcore\",\"dubstep\",\"country\",\"blues\",\"synthwave\",\"trance\",\"lofi\",\"reggae\",\"funk\",\"bossa\",\"trap\",\"garage\",\"metal\",\"electro\",\"deephouse\",\"italo\",\"acid\"],\"type\":\"string\"},\"key\":{\"description\":\"Key: am, c, f#m, d:dorian ...; default the genre's.\",\"maxLength\":16,\"type\":\"string\"},\"length\":{\"description\":\"Song length (default standard).\",\"enum\":[\"short\",\"standard\",\"long\"],\"type\":\"string\"},\"part\":{\"description\":\"One part (a role): the answer gains part (that role's entry of parts) and let, the let its gen call writes (let drop_bass_1 = ... let drop_bass = <drop_bass_1 ...>), to paste into a program of your own.\",\"enum\":[\"kick\",\"snare\",\"hihat\",\"clap\",\"bass\",\"melody\",\"harmony\",\"arp\"],\"type\":\"string\"},\"section\":{\"description\":\"With part: the section the part is taken from (default the drop or chorus when it plays there, else the first section it plays in).\",\"maxLength\":32,\"type\":\"string\"},\"seed\":{\"description\":\"A number or a word (default 1). Same inputs, same program text and CID.\",\"type\":[\"string\",\"integer\"]},\"seeds\":{\"anyOf\":[{\"items\":{\"type\":[\"string\",\"integer\"]},\"maxItems\":16,\"minItems\":1,\"type\":\"array\"},{\"additionalProperties\":false,\"properties\":{\"count\":{\"maximum\":16,\"minimum\":1,\"type\":\"integer\"},\"start\":{\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"count\"],\"type\":\"object\"}],\"description\":\"Instead of seed: many seeds, as a list ([1, 2, \\\"sunrise\\\"]) or as {count, start} (count seeds from start, default 1), at most 16. The answer is programs, one compact summary a seed in order: seed, generator, cid, name, key, tempo, bars, gen, parts (role, section, sections, voice or kit, text, gen) and url and render_url; each program is stored as one generate stores it, and nothing else is. The same seeds give the same summaries.\"}},\"required\":[],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"generate"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"bpm"},{"@value":"generator"},{"@value":"genre"},{"@value":"key"},{"@value":"length"},{"@value":"part"},{"@value":"section"},{"@value":"seed"},{"@value":"seeds"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Generate a track from a seed (no model)"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-genre-template","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A starting BeatScript program for a genre, built from the BeatScript ontology's data for it (https://beatscript.app/ontology/, CC0, forked from the bitwrap ontology): its tempo, key (root and scale), swing, drum kit and Euclidean kick, snare and hihat rhythms, its bass, arp and melody voices, its first chord progression (the chords, bass, arp and melody are Roman numerals, so a `key` line moves them all), and its family's standard song structure, each section with the roles the family's section profile makes active and its usual length. Returns {text, cid, canonical, seconds, genre{genre, label, family, tempo, tempo_range, scale, kit, voices, progressions, sections}} (and phrase, warnings with a phrase). The text passes check (it is checked before it is returned) and carries a `#! genre:` line, so check reports its style against the genre. Edit it, check it, then play or share it. For vocals, pass phrase (a phrasebook id from list_examples with phrasebook true, or any words): it is sung on the melody part of each section that has one, and the answer gains phrase with its source, year, meter, stress, syllables and phoneme escapes and whether its meter fits the genre (https://beatscript.app/docs/found-phrases.md). For a classical form, pass form (quodlibet, passacaglia, canon, rondo, fugue or theme-and-variations): the program is that form's template at the genre's tempo, built from public-domain themes, with the phrase (or the form's own) sung in it, and the answer gains form (its sections, mutation plan, themes and reference track) and expanded (the program written out to edit). To borrow one theme instead, pass theme (an id from list_examples with themes true): its lets go in, moved to the genre's key, played by the part of its role. See https://beatscript.app/docs/forms.md. For a whole track made from a phrase, write `arrange from template(deep-house, \"your words\")` (see expand). The plain answer also has use: each section of the genre's frozen template as a line, use genre@1 techno.drop as drop, that borrows it by name into a program of your own. Read-only, no sign-in. The answer also has expanded_cid (the CID of the program written out: the same as cid for a program with no references) and, for a program with references (a form's template(...)), refs and resolution, as check gives them: with roles bound, the template's entry in resolution has parts, each role (at any depth: a form in a role has its own) with the CID of what it is written out as. A form takes its sources as roles (docs/beatscript/ext-roles.md): with form and roles, each role is bound to a source (a seed of the seeded generator, a public-domain theme, notes, a stored program's part or section, another form), and the forms include cross (a quodlibet of two sources, roles a and b): two seeds that lead in turn, overlap, and morph toward each other and back.\n\nLexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules' pronunciation. Only the word, its phonemes and the program's CID are kept, never the text. The answer's lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"genre_template"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"form\":{\"description\":\"Optional (docs/beatscript/forms.md): a classical form, one of quodlibet, passacaglia, canon, rondo, fugue, theme-and-variations, or cross (a quodlibet of two sources, roles a and b). The program is then that form's template at the genre's tempo, arrange from template(<form>, <phrase>), and the answer gains form (shape, mutation plan, themes, reference track, its roles with their parts, and its numbers) and expanded (the program written out as plain BeatScript). Not with theme.\",\"maxLength\":64,\"type\":\"string\"},\"genre\":{\"description\":\"A genre of the BeatScript ontology: its name (techno, house, jazz, dnb, ...), genre:<name>, or its https://beatscript.app/ontology/genre/ IRI.\",\"maxLength\":200,\"type\":\"string\"},\"phrase\":{\"description\":\"Optional, for vocals (found phrases, see docs/beatscript/found-phrases.md): a phrasebook id (tyger_burning_bright, from list_examples with phrasebook true) or any words. It is sung on the melody part of each section that has one, and the answer gains phrase: its source, year, meter, stress, syllables and phoneme escapes, and whether its meter fits the genre.\",\"maxLength\":400,\"type\":\"string\"},\"roles\":{\"additionalProperties\":{\"maxLength\":400,\"type\":\"string\"},\"description\":\"Optional, with form (docs/beatscript/ext-roles.md): the form's roles, each bound to a source, {\\\"ROLE\\\": \\\"SOURCE\\\"}: a seed of the seeded generator (gen@1 dubstep seed=54876, gen@2 techno seed=42 section=drop part=bass), a public-domain theme id (ode_to_joy), notes in brackets, a stored program's part or section by CID, a stored set by CID (its tracks in order) or one of its tracks (<cid>.track2), another form (template(passacaglia, ground=gen@1 dubstep seed=54876)) or one section of it (template(cross).both, template(cross).both.arp: where a line goes, the notes its part plays). cross takes a and b, and one part of either alone as a.bass, a.melody, a.harmony; quodlibet a, b, ground and third; passacaglia ground and upper; canon subject and ground, and the numbers delay (beats behind, {\\\"delay\\\": \\\"6\\\"}) and interval (semitones, {\\\"interval\\\": \\\"7\\\"}); rondo refrain and episodes; fugue subject and counter; theme-and-variations theme. A seed is fitted to the form's key and tempo and stays an engine call, pinned (see resolution).\",\"type\":\"object\"},\"theme\":{\"description\":\"Optional (docs/beatscript/forms.md): a theme of the public-domain theme library (ode_to_joy, pachelbel_ground, from list_examples with themes true). Its lets go into the program, moved to the genre's key, and the part of its role plays it in every section that has one; the answer gains theme. Not with form.\",\"maxLength\":64,\"type\":\"string\"}},\"required\":[\"genre\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"genre"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"genre_template"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"form"},{"@value":"phrase"},{"@value":"roles"},{"@value":"theme"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"A starting program for a genre"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-get","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"What a browser tab at https://beatscript.app is doing now, as the page last reported it: the program text and cid, playing (true/false), source (engine or stream), section (name), section_num of sections_total, bar, bars_in_section, phase (0-7, the light in the phrase), marks (what is firing: active lines, token flashes, ramps and timed lines, with line:col spans into the text), diagnostics (the page's own check of the text), ts, mixer (what the listener hears: crossfader, master, and per deck its level, mute, EQ kills, filter, insert filter and vocoder; null from a page or phone too old to report it) and warnings (a playing deck that cannot be heard, and why: \"deck B inaudible: the crossfader is all the way to A\"). Use it after eval or load to confirm the change landed, and to see the program a user is playing and editing.\n\nNeeds a bearer token: it reads the tabs of the token's account, by default the most recently seen one. A tab that is not signed in is read by its session id (the page's MCP panel shows it), with your token. Read-only. No tab connected: a no_session error that says how to connect one."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"get"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"device\":{\"description\":\"Id of one of your paired phones (djrust on Android), from the devices tool. Targets that phone alone; do not combine with session.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9_-]{6,64}$\",\"type\":\"string\"},\"session\":{\"description\":\"Session id of one browser tab, from the MCP panel of the page. Leave out to use your own signed-in tabs (every live one for eval/load/stop, the latest for get).\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9_-]{6,64}$\",\"type\":\"string\"}},\"required\":[],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"get"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"device"},{"@value":"session"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"What a browser tab is playing"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-instruments","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The sounds a program may name: voices (inst=NAME), families (a name that contains one plays that family's generic voice and check warns about it), drum kits (kit=NAME) and palettes. Use only names from this answer: an unknown inst= is a check error with the nearest names. acid (a saw) and acid-square are a 303-style voice made in the engine: an accent ! is louder and opens its filter further, accents in a row build, a slide ^ glides into the next note (60 ms, or glide=), decay= is its filter's decay. Read-only, no sign-in, cached for five minutes."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"instruments"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{},\"required\":[],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"instruments"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Voices, kits and palettes"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-lineage","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A stored program's family tree, from the rights each program keeps (forked_from): its ancestors (nearest first), its siblings (the parent's other forks) and every generation of its forks, each edge labelled with what changed in music from parent to fork (the same diff summary lines check's same_as gives: \"tempo 124 -> 126\", \"drop2 bass = drop bass transposed +1\"; sameSong true when the fork only rewrote the text). Returns the JSON-LD document https://beatscript.app/p/<CID>/tree.jsonld serves: program, forkCount, descendantCount, ancestors, siblings and forks as CIDs, programs (name, licence, tempo, key, credits, url, forkCount of each, and where public programs draw on it, referencedBy: how many call or borrow it, and vendoredFrom: how many vendored it, from the `# from:` lines their saves kept as meta.based_on), derivations (from, to, sameSong, change, and a compare URL, https://beatscript.app/p/<A>/compare/<B>). Only public programs appear: a private one is never listed, and a chain that passes through one stops there (ancestorsCut). A person can browse the same tree at https://beatscript.app/p/<CID>/tree."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"lineage"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"cid\":{\"description\":\"The program: its CID, or a short https://beatscript.app/p/<CID> link. It must be stored here (or be an example) and public.\",\"maxLength\":200,\"type\":\"string\"}},\"required\":[\"cid\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"cid"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"lineage"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"A program's family tree"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-list-examples","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The public example programs of https://beatscript.app, all CC0-1.0: name, title, description, cid, bpm, bars, license and the url of the raw .beatscript. Pass name to get that program's full text as well. Read two or three before writing a program of your own: after the cheat-sheet (https://beatscript.app/docs/cheatsheet.md) they are the best guide to the language, from a four-line beat (first-beat) to whole tracks with sections, defs, ramps and evolve. With phrasebook true (or a meter, or syllables) it also returns the public-domain phrasebook: lines first published before 1929, each with its text, source, year, meter, stress pattern, syllables and phoneme escapes, to sing by id (sing @tempest_such_stuff on melody); choose one for its meter, see https://beatscript.app/docs/found-phrases.md. With themes true (or a key, a role or a composer) it also returns the public-domain theme library: melodies, basses and figures composed and published before 1929, each as BeatScript bars in a stated key with the let lines and the part that play it, its work, composer, year and the themes it morphs well with; borrow one as found material or build a form from it, see https://beatscript.app/docs/forms.md. With imports true it also lists what a `use SOURCE as NAME` line can name: the kinds of source, each template's sections (use template(passacaglia).ground as ground) and each genre template's (use genre@1 techno.drop as drop), see https://beatscript.app/docs/BEATSCRIPT.md \"Name a source: `use`\". Read-only, no sign-in."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"list_examples"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"composer\":{\"description\":\"Only the themes by this composer (any part of the name: beethoven). Implies themes.\",\"maxLength\":64,\"type\":\"string\"},\"imports\":{\"description\":\"Also return what a `use SOURCE as NAME` line can name (default false): the kinds of source, each with how it is written and what the name is; the templates and their sections (canned sections: use template(passacaglia).ground as ground); the genre templates and their sections (use genre@1 techno.drop as drop); themes and phrasebook lines are listed by themes and phrasebook.\",\"type\":\"boolean\"},\"key\":{\"description\":\"Only the themes in this key, matched on its tonic: a key word (d, bm, db). Implies themes.\",\"maxLength\":16,\"type\":\"string\"},\"lexicon\":{\"description\":\"Also return the lexicon harvest (default false): the words the checking tools collected from programs' lyrics, ranked for the CC0 lexicon, at most 50: those with an annotated escape (word=/phonemes/) first, then by how many programs gave them. Each is {word, programs, conflict, in_lexicon, variants[{phones, source (annotated or rule), count, first, last, cids}]}; conflict: two annotated pronunciations disagree. Read-only.\",\"type\":\"boolean\"},\"meter\":{\"description\":\"Only the phrasebook lines of this meter: a family (iambic, trochaic, anapestic, dactylic, common-meter, sprung, nursery, parallelism, oratory, call-and-response) or a word of a meter's name (pentameter). Implies phrasebook.\",\"maxLength\":64,\"type\":\"string\"},\"name\":{\"description\":\"Optional: also return this example's full text.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$\",\"type\":\"string\"},\"phrasebook\":{\"description\":\"Also return the public-domain phrasebook: lines first published before 1929, each with its text, source, year, meter, stress pattern, syllables and phoneme escapes (default false).\",\"type\":\"boolean\"},\"role\":{\"description\":\"Only the themes of this role: melody, bass, harmony or arp. Implies themes.\",\"maxLength\":16,\"type\":\"string\"},\"syllables\":{\"description\":\"Only the phrasebook lines with this many syllables: a number (8) or a range (8-12). Implies phrasebook.\",\"maxLength\":16,\"type\":\"string\"},\"themes\":{\"description\":\"Also return the public-domain theme library: melodies, basses and figures composed and published before 1929, each as BeatScript bars in a stated key (let-ready), with its role, meter, work, composer, year and pairings (default false).\",\"type\":\"boolean\"}},\"required\":[],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"list_examples"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"composer"},{"@value":"imports"},{"@value":"key"},{"@value":"lexicon"},{"@value":"meter"},{"@value":"name"},{"@value":"phrasebook"},{"@value":"role"},{"@value":"syllables"},{"@value":"themes"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"The example programs"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-listen","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Listen to a BeatScript program without audio: it is rendered offline through the same engine as render, and you get a small JSON summary to check your work by ear, as numbers. Per deck and per part (a role of a deck's line: drums, bass, ...): RMS and peak in dBFS and loudness in LUFS. `silent` lists every deck or part that has notes in the window but is not heard (under -60 LUFS), with `reason` when the mixer explains it (master_zero, mute, level_0, crossfader, filter_closed, eq_killed; voice_missing when the mixer lets a part through and its voice made nothing; no_sound otherwise) and `why` in words. `detected` gives the tempo and key heard against the declared ones (bpm_match same|half|double|two_thirds|three_halves|differs; key_match same|relative|differs|unsure|undeclared). `sections` gives each section's loudness (and `control_off` on a section an `arrange { }` switch such as `~ control off` plays with lines of its control deck held back: the calls that do not fire there), `bar_lufs` a loudness per bar, and master.clipped_samples counts samples over full scale. `warnings` is the short list to act on. A part that came from a reference (a gen@2 call, a seed(...), a template, a stored program's section) says so in `from` {call, kind, resolved, place, generator, sections} (`also_from` when several made it; a `use` line's also has its `name`); a gen call fitted to the program's key or tempo says so in `notes`, in check's words; and the answer gains `expanded_cid` and `resolution`, as check's (and `imports`, the names its `use` lines give). Give exactly one of text, cid, example; optionally `section` (listen to that section only) and `bars` (at most this many bars of the window). Nothing is stored and no sign-in is needed. At most 30 new listens an hour per caller; the same program, section and bars again is answered from the cache. Programs are at most 16384 bytes; the render covers at most 96 bars from the start. Like render, the offline engine plays the notes, the mixer and insert moves it has ops for and the `macro` lines (the DJ macro catalogue: see the macros tool); `notes` names the control lines it leaves out. A program with a macro line gains `macros`: each call in the window, `at_bar` (the bar the engine starts it on, as the time words count), and `played`, with `refused` (the engine's reason, also a warning) when it was not.\n\nLexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules' pronunciation. Only the word, its phonemes and the program's CID are kept, never the text. The answer's lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"listen"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"bars\":{\"description\":\"At most this many bars of the window, from its start.\",\"maximum\":96,\"minimum\":1,\"type\":\"integer\"},\"cid\":{\"description\":\"CID of a stored program or an example.\",\"maxLength\":100,\"pattern\":\"^z[1-9A-HJ-NP-Za-km-z]{20,100}$\",\"type\":\"string\"},\"example\":{\"description\":\"Name of an example, from list_examples.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$\",\"type\":\"string\"},\"section\":{\"description\":\"Listen to this section only (its name in the program).\",\"maxLength\":64,\"type\":\"string\"},\"text\":{\"description\":\"The program text. It must pass check. Not stored.\",\"maxLength\":16384,\"type\":\"string\"}},\"required\":[],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"listen"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"bars"},{"@value":"cid"},{"@value":"example"},{"@value":"section"},{"@value":"text"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Listen to a program (a summary, no audio)"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-load","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Put a stored or example program into a browser tab (the same tabs and rules as eval: a tab open at https://beatscript.app, signed in as the token's account, or its session id from the page's MCP panel). Give exactly one of: cid (a program the site stored, or an example's CID; render and a signed-in share store theirs), example (a name from list_examples), url (a share link https://beatscript.app/#CID.packed or a /c/ link; one made on an older host opens too; the link is verified, and one whose CID is not its text's is refused with cid_mismatch). play:true starts it. The program is formatted on the way in, as eval's text is. Needs a bearer token. Call get afterwards to see what is playing.\n\nLexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules' pronunciation. Only the word, its phonemes and the program's CID are kept, never the text. The answer's lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"load"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"cid\":{\"description\":\"CID of a program the site has stored (render and a signed-in share store theirs) or of an example.\",\"maxLength\":100,\"pattern\":\"^z[1-9A-HJ-NP-Za-km-z]{20,100}$\",\"type\":\"string\"},\"device\":{\"description\":\"Id of one of your paired phones (djrust on Android), from the devices tool. Targets that phone alone; do not combine with session.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9_-]{6,64}$\",\"type\":\"string\"},\"example\":{\"description\":\"Name of an example, from list_examples.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$\",\"type\":\"string\"},\"play\":{\"description\":\"Start playing too (default false: load it and leave it stopped, or leave a playing tab as it is).\",\"type\":\"boolean\"},\"session\":{\"description\":\"Session id of one browser tab, from the MCP panel of the page. Leave out to use your own signed-in tabs (every live one for eval/load/stop, the latest for get).\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9_-]{6,64}$\",\"type\":\"string\"},\"url\":{\"description\":\"A share link: https://beatscript.app/#<CID>.<packed>, a /c/ link, or a short /p/<CID> link (one made on an older host opens too) (the program must be stored here).\",\"maxLength\":32768,\"type\":\"string\"}},\"required\":[],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"load"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"cid"},{"@value":"device"},{"@value":"example"},{"@value":"play"},{"@value":"session"},{"@value":"url"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Load a stored program into a browser tab"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-macros","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The DJ macro catalogue a program's `macro` line names (docs/beatscript/ext-control.md): `macro riser on A over 8 bars` (or on the control deck, `control: macro cathedral on B over 2 bars`) fires one entry on the deck's bar line, the same thing the desktop's Effects window and the booth fire. Returns the macro@1 table, or version's: for each entry its id, label, category, family (trick, net, master, aux), transition (a one-shot), length (bars: runs `over N bars`, 1 to 64; sweep: the riser rises over them; held: held that long, then let go; own: takes no `over`), default_bars (when the line says no `over`) and needs_net (works a net deck's parts). A bare `macro` is macro@1 for good and its table never changes; a later catalogue is macro@2. listen and render play a macro line; a browser tab does not (not played here). Read-only, no sign-in."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"macros"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"version\":{\"description\":\"Optional: which table, macro@N (default 1: what a bare `macro` is).\",\"minimum\":1,\"type\":\"integer\"}},\"required\":[],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"macros"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"version"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"The DJ macro catalogue a macro line names"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-open","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Decode a BeatScript share link and return its canonical text, its text (the program formatted, with the `#!` header lines and comments the link carried: what to edit), its CID and whether the CID verifies against the text. Takes either form: a self-sealing link (https://beatscript.app/#<CID>.<packed>, a /c/<CID>.<packed> link, a bare #fragment or <CID>.<packed>) or a CID-only link (https://beatscript.app/p/<CID>, /c/<CID>, #<CID>, or a bare CID; the same forms on an older host open too), which is resolved from the programs the site has stored (shared signed in, or rendered) and the examples, and answers its rights in meta. Either way the text is recompiled and its CID recomputed: a program whose CID is not its text's is refused with cid_mismatch, and an unknown CID answers not_found. Do not trust or play a refused text. Comments and header lines carried in a link are not covered by the CID (a beats link's notes are unverified). Read-only, no sign-in."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"open"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"url\":{\"description\":\"A share link (self-sealing #<CID>.<packed>, or a short <site>/p/<CID> or /c/<CID> link), a #fragment, <CID>.<packed>, or a bare CID.\",\"maxLength\":32768,\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"url"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"open"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Open a share link"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-push-private","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Send a private program to one of your paired phones, end-to-end encrypted, and never stored. Use it for what https://beatscript.app does not keep: covers, programs with local samples (`sample ... from`), `use restricted`, anything not under a Creative Commons licence. The program is sealed for the phone's own key (X25519 from its pairing key, ChaCha20-Poly1305) and handed to the phone's live connection in memory: it is not written to disk, a database or a log (only its size and the device id are logged), no CID is registered, and if the phone is not connected nothing is sent and nothing is kept (push again when it is). The phone opens it, checks it and plays it itself; samples resolve against files in the phone's own sample library, and any that are missing are reported back in get's diagnostics, never fetched. Give device and exactly one of text (sealed here, so the text is in this server's memory for this call, where it is formatted first, as eval's is) or sealed (an envelope you sealed yourself for the phone's seal_key from devices: then this server only ever sees ciphertext). Needs a bearer token; only your own paired phones."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"push_private"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"device\":{\"description\":\"Id of one of your paired phones, from the devices tool.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9_-]{6,64}$\",\"type\":\"string\"},\"load\":{\"description\":\"Load it on the phone and leave it stopped unless play (default false: play it as eval does).\",\"type\":\"boolean\"},\"play\":{\"description\":\"Start playing too (default false: load it and leave it stopped, or leave a playing tab as it is).\",\"type\":\"boolean\"},\"sealed\":{\"description\":\"An envelope you sealed for the phone's seal_key (beatscript-seal v1). Give text or sealed.\",\"maxLength\":65536,\"type\":\"string\"},\"text\":{\"description\":\"The program text, sealed here for the phone. Give text or sealed.\",\"maxLength\":16384,\"type\":\"string\"}},\"required\":[\"device\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"device"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"push_private"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"load"},{"@value":"play"},{"@value":"sealed"},{"@value":"text"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Send a private program to your phone"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-queue","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"An \"up next\" queue on one browser tab at https://beatscript.app (the same tabs and rules as load: session, or device, else your most recently seen signed-in tab). When the playing program ends the page plays the next item, on the bar line where it can; a looping program (one that never ends) plays for the item's bars or minutes, else one full pass of its arrangement, and then advances. Needs a bearer token.\n\naction is one of: list (the queue, now_playing, position, paused_reason, listener), add (items: up to 20 per call, 50 in the queue), remove (item: an item id from list, or a CID), move (item and to: reorder; to is the index in up_next, 0 plays next), clear, skip (play the next item now, or with item that item). The radio page (https://beatscript.app/radio) shows its queue as a playlist with each row's render status, and the person there can add, remove, reorder and play rows too.\n\nItems must already be programs: {cid} of a stored program (render and a signed-in share store theirs) or an example's CID, {example} by name from list_examples, or {url} a share link (verified exactly as load verifies it; a CID-only link must name a stored program). Optional per item: bars (1-1024) or minutes (0.1-120) to play, title. THE QUEUE NEVER COMPOSES OR CALLS A MODEL, and there is no way to make it: to queue new music, write the programs yourself (check them), store each with render or share, then add the CIDs.\n\nThe queue advances only while a listener is plausibly present, as the page reports it: it pauses at the next track boundary when the tab's audio is suspended, when the tab has been hidden with no key, pointer, touch or media key for 30 minutes, or after 8 tracks in a row without any interaction; the page then shows \"Still listening? Press play to continue\". Only a person on the page lifts a pause: skip is refused while paused (paused_reason says why), and load still plays one program as it always has but does not resume the queue. Writes are limited to about 30 a minute. The queue lives with the tab's session and is gone when the tab is.\n\nLexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules' pronunciation. Only the word, its phonemes and the program's CID are kept, never the text. The answer's lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"queue"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"action\":{\"description\":\"list, add, remove, move, clear or skip.\",\"enum\":[\"list\",\"add\",\"remove\",\"move\",\"clear\",\"skip\"],\"type\":\"string\"},\"device\":{\"description\":\"Id of one of your paired phones (djrust on Android), from the devices tool. Targets that phone alone; do not combine with session.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9_-]{6,64}$\",\"type\":\"string\"},\"item\":{\"description\":\"remove, move and skip: an item id from list (q1, q2, ...) or a CID (the first queued item with it). skip with an item plays that item now; without one, the next.\",\"maxLength\":100,\"type\":\"string\"},\"items\":{\"description\":\"add: the programs to append, each an object with exactly one of cid, example, url, and optionally bars, minutes, title.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"bars\":{\"description\":\"Play this many bars, then advance (else until the program ends; a loop: one arrangement pass).\",\"maximum\":1024,\"minimum\":1,\"type\":\"integer\"},\"cid\":{\"description\":\"CID of a stored program or an example.\",\"maxLength\":100,\"pattern\":\"^z[1-9A-HJ-NP-Za-km-z]{20,100}$\",\"type\":\"string\"},\"example\":{\"description\":\"Name of an example, from list_examples.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$\",\"type\":\"string\"},\"minutes\":{\"description\":\"Play this long, then advance at the next bar line. Not with bars.\",\"maximum\":120,\"minimum\":0.1,\"type\":\"number\"},\"title\":{\"description\":\"What the page shows for it (else the program's name).\",\"maxLength\":80,\"type\":\"string\"},\"url\":{\"description\":\"A share link, verified as load verifies it.\",\"maxLength\":32768,\"type\":\"string\"}},\"type\":\"object\"},\"maxItems\":20,\"type\":\"array\"},\"session\":{\"description\":\"Session id of one browser tab, from the MCP panel of the page. Leave out to use your own signed-in tabs (every live one for eval/load/stop, the latest for get).\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9_-]{6,64}$\",\"type\":\"string\"},\"to\":{\"description\":\"move: the index in up_next the item goes to (0 plays next; past the end is last).\",\"maximum\":1023,\"minimum\":0,\"type\":\"integer\"}},\"required\":[\"action\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"action"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"queue"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"device"},{"@value":"item"},{"@value":"items"},{"@value":"session"},{"@value":"to"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Up next: queue programs on a browser tab"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-record","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Set up a demo recording of a program: the page in record mode (full screen code, the firing markers and follow-scroll on) and the steps that turn it into a video. Give exactly one of text, cid or example (as render does: a text or example is checked and stored publicly as CC0-1.0, nothing private). Answers {cid, seconds, record_url, record_url_manual_clock, audio_url, recipe}. record_url opens the page in record mode and plays it for a person to screen-record; record_url_manual_clock opens it on a fake clock that a script steps frame by frame (window.__btw.setTime(seconds); window.__btw.frame()), which is how site/tools/record-demo.mjs in the repo makes a perfectly synced, stutter-free MP4 (H.264, AAC, 1920x1080) plus a silent hero loop (MP4 and WebM) and a poster PNG, taking the audio from audio_url (the offline render of the same program). This tool does not capture video itself: it needs a browser and ffmpeg on your side. The audio is the offline render: notes and sounds, not control lines (filters, reverb). Call check first. Rendering limits apply (about 30 programs an hour per client). No sign-in needed."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"record"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"cid\":{\"description\":\"CID of a program already stored (for instance the cid render or a signed-in share returned).\",\"maxLength\":100,\"pattern\":\"^z[1-9A-HJ-NP-Za-km-z]{20,100}$\",\"type\":\"string\"},\"example\":{\"description\":\"Name of an example, from list_examples.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$\",\"type\":\"string\"},\"text\":{\"description\":\"The program text. It must pass check; it is stored publicly (CC0-1.0).\",\"maxLength\":16384,\"type\":\"string\"}},\"required\":[],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"record"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"cid"},{"@value":"example"},{"@value":"text"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Set up a demo recording"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-render","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Make a program streamable as audio. Give exactly one of text (the program), cid (a program already stored, e.g. what an earlier render or a signed-in share returned) or example (a name from list_examples). A text or example is checked, then stored publicly under its CID as CC0-1.0 if it is not stored yet (never submit anything private; programs that use samples or \"use restricted\" are refused). Answers {cid, stream_url, status_url, seconds, format}: open stream_url to listen (it streams the offline render as it renders; the first sound comes within about a second, so a client can play it at once), download the same URL for a file, and read status_url to see how far a render is. format is opus (Ogg Opus, small) or wav (16-bit stereo, plays chunk by chunk in a web page); default opus. To take the program to a DAW: format midi (a Standard MIDI File: a track per part, drums on channel 10 with General MIDI notes, the tempo map, key and section markers) or stems (a zip of a 32-bit float WAV per part and per deck that add up to the master, plus the master, the .mid and manifest.json with the CID, tempo, key and the stored license and credits; stems-opus: the same with Ogg Opus stems); a stems URL answers 202 while it is being made, ask again until it is the zip.\n\nCall check first. The offline render plays the notes and sounds, not control lines (filters, reverb, do ... lines), so it can sound plainer than the browser; a program with no end (no sections or end line) is cut at the server's bar limit (256 bars). Rendering is limited per address per hour and to a few at once: on busy or rate_limited wait retry_after seconds. No sign-in needed; about 30 programs an hour per client.\n\nLexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules' pronunciation. Only the word, its phonemes and the program's CID are kept, never the text. The answer's lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"render"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"cid\":{\"description\":\"CID of a program already stored (for instance the cid render or a signed-in share returned).\",\"maxLength\":100,\"pattern\":\"^z[1-9A-HJ-NP-Za-km-z]{20,100}$\",\"type\":\"string\"},\"example\":{\"description\":\"Name of an example, from list_examples.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$\",\"type\":\"string\"},\"format\":{\"default\":\"opus\",\"description\":\"opus (Ogg Opus, smaller, for download or <audio>) or wav (16-bit stereo, plays chunk by chunk in a web page) to listen; for a DAW: midi (a Standard MIDI File of the notes, a track per part), stems (a zip: a 32-bit float WAV per part and per deck that add up to the master, the master, the .mid and manifest.json with the CID, tempo, key, license and credits) or stems-opus (the same zip with Ogg Opus stems).\",\"enum\":[\"opus\",\"wav\",\"midi\",\"stems\",\"stems-opus\"],\"type\":\"string\"},\"text\":{\"description\":\"The program text. It must pass check; it is stored publicly (CC0-1.0).\",\"maxLength\":16384,\"type\":\"string\"}},\"required\":[],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"render"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"cid"},{"@value":"example"},{"@value":"format"},{"@value":"text"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Render a program to streaming audio"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-share","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Make the share links of a program. Always the self-sealing link: https://beatscript.app/#<CID>.<base64url(deflate(formatted text))>; the program travels inside the link with its `#!` header lines and comments, and whoever opens it gets exactly that program, verified against the CID (the canonical text's: the headers and comments are not covered by it), and can play and fork it. Also social_url (https://beatscript.app/c/<CID>.<packed>, the form to post where a link preview is wanted: it carries a card image). Called signed in (a bearer token), it also stores the program on the site (public, with its rights: license, forked_from, credits, name; the first share's rights stay) and returns the CID-only forms: short_url (https://beatscript.app/p/<CID>) and short_social_url (https://beatscript.app/c/<CID>), plus fetch_url, a public GET that returns the canonical text and rights for a phone or an app. A program with references (a template(...), a gen@N call, a seed(...), a borrowed <cid>.section) has expanded_cid, the CID of the same track with every reference written out as plain BeatScript; a signed-in share stores that expansion beside it, as a program of its own that plays the same (or finds it already stored: first write wins, so it keeps the rights its first sharer gave), and returns expanded_url (https://beatscript.app/p/<expanded_cid>) and expansion_license. An expansion that would copy another's program under other rights (only CC0 programs, or the sharer's own under the same licence, are copied), or is over the size limit, is not stored, and expansion_note says why. Opening a short link fetches the text, recompiles it, recomputes the CID and refuses a mismatch. A short link to a BeatScript 1 program (https://beatscript.app/p/<old CID>) redirects to its BeatScript 2 upgrade (the CID check's renamed_cid gives, the program fmt writes) once the site stores it; the old CID's text stays at fetch_url. Anonymous calls get the self-sealing links and short_url null. The program must pass check and must not use samples or \"use restricted\" (a private program is never shared or stored); programs shared here are CC0 unless license says otherwise. The text is formatted on the way in, its version kept (the stored program is its canonical text, whose CID the header lines and comments do not change, and the link carries the formatted text; a `#! name:` line names the stored program). Its `# from: <call> -> <cid>` lines (what an eject wrote out: comments, so not in the CID) are kept with it as meta.based_on [\"<call> -> <cid>\"]: its linked data lists each in isBasedOn as vendored, and lineage counts it (vendoredFrom); open with the CID answers them in meta. Links over about 2000 characters (chars says) may be cut by some apps; short links are not. A stored program also embeds in other sites: embed_url (https://beatscript.app/embed/<CID>) is a player any page may frame, https://beatscript.app/embed.js gives <beatscript-player cid=\"<CID>\">, and https://beatscript.app/oembed?url=<a /p/ or /c/ link> answers oEmbed; see https://beatscript.app/docs/embed. Who authored a program and what rights it has, in plain language: https://beatscript.app/authorship.\n\nLexicon harvest, a side effect with no flag: when the program checks and may be kept (no samples or loops, no `use restricted`, public visibility; push_private records nothing), the (word, phonemes) pairs of its lyrics are recorded to grow the CC0 lexicon: each annotated escape word=/phonemes/ (jingle=/j ii ng g uh l/ sings the escape and keeps the word) and each word no lexicon knows, with the rules' pronunciation. Only the word, its phonemes and the program's CID are kept, never the text. The answer's lexicon is {harvested, new}: the pairs taken from this program, and how many no program had given before. When check says a word is not in the lexicon and it sounds wrong, write it as word=/phonemes/."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"share"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"credits\":{\"description\":\"Who is credited, one short line each. Stored with the rights.\",\"items\":{\"maxLength\":80,\"type\":\"string\"},\"maxItems\":8,\"type\":\"array\"},\"forked_from\":{\"description\":\"CID of the program this one was forked from. Stored with the rights.\",\"maxLength\":100,\"pattern\":\"^z[1-9A-HJ-NP-Za-km-z]{20,100}$\",\"type\":\"string\"},\"license\":{\"description\":\"Rights kept with the stored program: a Creative Commons SPDX id (default CC0-1.0; CC-BY-4.0, CC-BY-SA-4.0 and the like). The site stores no other licence: keep such a program local, or send it to your phone with push_private.\",\"maxLength\":40,\"type\":\"string\"},\"name\":{\"description\":\"A name for the program (else its `#! name:` line).\",\"maxLength\":80,\"type\":\"string\"},\"text\":{\"description\":\"The program text. It must pass check.\",\"maxLength\":16384,\"type\":\"string\"}},\"required\":[\"text\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"text"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"share"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"credits"},{"@value":"forked_from"},{"@value":"license"},{"@value":"name"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Make share links"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-station","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Radio: a station is a BeatScript program that names a run of tracks with no end, and this tool answers what is at a position of one. Stations are endless and deterministic: position N of a station is always the same track (the same text, so the same CID), worked out from the station's text alone, with no clock and no store; nothing is stored here. A station program holds its `tempo`, its `key` and one block:\n\ntempo 128\nkey am\nstation {\n  from gen@2 techno seed=42\n  next seed=~\n  forms seeded passacaglia rondo fugue\n}\n\nfrom is the first track's call of the seeded generator (gen@V GENRE seed=N, optionally length=short|standard|long; the station's tempo and key are its own lines, never the call's bpm= or key=). next is the walk from one track's seed to the next: seed=+N counts on (each track's seed is the one before's plus N), seed=~ draws each seed from the CID of the track before (worked out step by step, so a position past the walk's cap is refused; a seed=+N station has a track at any position); default seed=+1. forms is the forms rotation within the genre: track N plays forms[N mod R] of the R forms (seeded, the generator's own arrangement, or passacaglia, canon, rondo, fugue, theme-and-variations, cross), each form's first role bound to the chapter's theme seed (the first track of each pass of the rotation, so it recurs) and its second role to track N's own seed; default forms seeded. The segue from track N to N+1 is the cross form of their two seeds: a program of its own, with its own CID.\n\nAnswers {ok, version, station {text, cid, genre, generator, seed, step, forms, tempo, key, length, start_cid}, n, tracks[{n, seed, theme, form, phrase, text, cid, parent, station, check}], segues[{from, to, form, phrase, text, cid, check}], neighbours, retuned, locks, diagnostics}; ok:false with error and diagnostics is an answer, not a tool error. Each track's text is a program to check, listen to, eval, render or share; its parent is track N-1's CID. A listener does not steer a station: they turn its knobs (genre, seed, step, forms, tempo, key, length), and turning one moves them to a neighbouring station that already exists. retune sets knobs before anything else, each to a value or to \"+1\" / \"-1\" for one notch (seed by 1, tempo by 2, key a fifth round the circle in its own mode, step between +1 and ~, forms rotated by one, length one step; a genre only by name), and retune keeps N: the answer is track N of the retuned station. locks are knobs held fixed: retuning a locked knob is refused, and neighbours (true) lists the stations one notch away along each unlocked knob, each with its text, its CID and its track at n. check (true) checks each track and segue: {ok, expanded_cid, bars, seconds, errors}; each program checked counts as one call of the checker. check of a station program answers station too. Read-only, no sign-in. Stations, the walk and the knobs: https://beatscript.app/docs/radio.md."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"station"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"check\":{\"description\":\"Check each track and segue: {ok, expanded_cid, bars, seconds, errors} (default false). Each program checked counts as one call of the checker.\",\"type\":\"boolean\"},\"count\":{\"description\":\"How many tracks from n (default 1, at most 16; with check, at most 4).\",\"maximum\":16,\"minimum\":1,\"type\":\"integer\"},\"locks\":{\"description\":\"Knobs held fixed: retuning one is refused, and neighbours never turns one.\",\"items\":{\"enum\":[\"genre\",\"seed\",\"step\",\"forms\",\"tempo\",\"key\",\"length\"],\"type\":\"string\"},\"maxItems\":7,\"type\":\"array\"},\"n\":{\"description\":\"The position: the station's track n (default 0). Track n of a station is always the same track.\",\"minimum\":0,\"type\":\"integer\"},\"neighbours\":{\"description\":\"Also the neighbouring stations, one notch away along each unlocked knob, each with its text, its CID and its track at n (default false).\",\"type\":\"boolean\"},\"retune\":{\"additionalProperties\":false,\"description\":\"Knobs to set before anything else, each to a value or to \\\"+1\\\" / \\\"-1\\\" for one notch: {\\\"tempo\\\": \\\"+1\\\"}, {\\\"seed\\\": 7, \\\"forms\\\": \\\"seeded cross\\\"}. The position n is kept: the answer is track n of the retuned station.\",\"properties\":{\"forms\":{\"description\":\"The forms in turn (\\\"seeded passacaglia\\\" or a list), or a notch: rotated by one.\",\"items\":{\"type\":\"string\"},\"type\":[\"string\",\"array\"]},\"genre\":{\"description\":\"A genre of the seeded generator, by name (a genre has no notch).\",\"type\":\"string\"},\"key\":{\"description\":\"A key (am, c, f#m ...), or a notch: a fifth round the circle in its own mode.\",\"type\":\"string\"},\"length\":{\"description\":\"short, standard or long, or a notch.\",\"type\":\"string\"},\"seed\":{\"description\":\"The first track's seed: a whole number or a word, or \\\"+1\\\" / \\\"-1\\\".\",\"type\":[\"string\",\"integer\"]},\"step\":{\"description\":\"The walk: \\\"+1\\\", \\\"+2\\\" ... or \\\"~\\\"; a notch turns between +1 and ~.\",\"type\":\"string\"},\"tempo\":{\"description\":\"40 to 300, or a notch of 2.\",\"type\":[\"string\",\"number\"]}},\"type\":\"object\"},\"segue\":{\"description\":\"Also the segue after each track, track n into n+1: the cross form of their two seeds, with its own CID (default true).\",\"type\":\"boolean\"},\"station\":{\"description\":\"The station program: its tempo and key lines and its station { from, next, forms } block (at most 16384 bytes).\",\"maxLength\":16384,\"type\":\"string\"}},\"required\":[\"station\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"station"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"station"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"check"},{"@value":"count"},{"@value":"locks"},{"@value":"n"},{"@value":"neighbours"},{"@value":"retune"},{"@value":"segue"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"A radio station: the track at a position"}]},{"@id":"https://beatscript.app/ontology/concept/tool-beatscript-stop","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Stop what a browser tab at https://beatscript.app is playing: the program ends and whatever its lines held (a filter, a mute) is put back. Reaches every live tab of the token's account, or one tab by session (the id the page's MCP panel shows). Needs a bearer token. No tab connected: a no_session error that says how to connect one."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"stop"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"additionalProperties\":false,\"properties\":{\"device\":{\"description\":\"Id of one of your paired phones (djrust on Android), from the devices tool. Targets that phone alone; do not combine with session.\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9_-]{6,64}$\",\"type\":\"string\"},\"session\":{\"description\":\"Session id of one browser tab, from the MCP panel of the page. Leave out to use your own signed-in tabs (every live one for eval/load/stop, the latest for get).\",\"maxLength\":64,\"pattern\":\"^[A-Za-z0-9_-]{6,64}$\",\"type\":\"string\"}},\"required\":[],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"stop"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"device"},{"@value":"session"}],"https://beatscript.app/ontology/ns#toolTitle":[{"@language":"en","@value":"Stop a browser tab"}]},{"@id":"https://beatscript.app/ontology/concept/tool-ontology-describe-term","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Everything the ontology states about one class, property, genre, scale, groove, section, instrument or concept, as N-Triples (the materialized graph). Give a short name such as Genre, bpm, genre:techno or section:drop, or a full IRI in the ontology's namespaces. format \"json\" returns a compact view instead: label, types, definition (its own, else the glossary concept it closeMatches, else its rdfs:comment), direct superclasses and subclasses as asserted, close matches and sources."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"describe_term"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"properties\":{\"format\":{\"description\":\"triples (default, N-Triples) or json (compact term view)\",\"enum\":[\"triples\",\"json\"],\"type\":\"string\"},\"term\":{\"description\":\"name or IRI\",\"type\":\"string\"}},\"required\":[\"term\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"term"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"describe_term"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"format"}]},{"@id":"https://beatscript.app/ontology/concept/tool-ontology-get-genre","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"One genre in full: tempo, scale, kick/snare/hihat Euclidean rhythms (pulses, steps, rotation, MIDI note), swing, humanize, densities, instrument per channel, chord progressions, song-structure sections, and links to Wikidata and to pflow ontology terms. Give a slug such as techno or jazz."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"get_genre"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"properties\":{\"genre\":{\"description\":\"genre slug, e.g. techno\",\"type\":\"string\"}},\"required\":[\"genre\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"genre"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"get_genre"}]},{"@id":"https://beatscript.app/ontology/concept/tool-ontology-get-release","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Version, pack digest and file hashes of the release being served, and what its certificate covers."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"get_release"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"properties\":{},\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"get_release"}]},{"@id":"https://beatscript.app/ontology/concept/tool-ontology-list-classes","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"All classes in the ontology namespace with their direct superclasses, as asserted: a superclass another listed one already implies is left out, so LiveNet lists DeadlockFreeNet, not PetriNet too. For the inferred closure, query rdfs:subClassOf with sparql_query."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"list_classes"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"properties\":{},\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"list_classes"}]},{"@id":"https://beatscript.app/ontology/concept/tool-ontology-list-genres","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Every genre the engine knows, with its tempo, scale, family and groove. Filter by family (edm, song, jazz, chill) or by a BPM range."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"list_genres"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"properties\":{\"family\":{\"description\":\"edm, song, jazz or chill; omit for all\",\"type\":\"string\"},\"max_bpm\":{\"type\":\"integer\"},\"min_bpm\":{\"type\":\"integer\"}},\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"list_genres"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"family"},{"@value":"max_bpm"},{"@value":"min_bpm"}]},{"@id":"https://beatscript.app/ontology/concept/tool-ontology-search-terms","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Find terms whose label, other label (an alternative or a former name, such as btw for BeatScript) or definition contains the text (case-insensitive). A class with no definition of its own gets the one of the glossary concept it closeMatches, or its rdfs:comment."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"search_terms"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"properties\":{\"limit\":{\"description\":\"max results, default 25, at most 200\",\"type\":\"integer\"},\"text\":{\"description\":\"text to look for\",\"type\":\"string\"}},\"required\":[\"text\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"text"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"search_terms"}],"https://beatscript.app/ontology/ns#toolParameter":[{"@value":"limit"}]},{"@id":"https://beatscript.app/ontology/concept/tool-ontology-sparql-query","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#McpTool"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Run a read-only SPARQL query (SELECT, ASK, CONSTRUCT or DESCRIBE) over the BeatScript ontology. Rows are capped and queries time out. Results can contain blank nodes (OWL class expressions); add FILTER(isIRI(?x)) to skip them."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"sparql_query"}],"https://beatscript.app/ontology/ns#inputSchema":[{"@value":"{\"properties\":{\"query\":{\"description\":\"SPARQL query text\",\"type\":\"string\"}},\"required\":[\"query\"],\"type\":\"object\"}"}],"https://beatscript.app/ontology/ns#needsToken":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#providedBy":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp"}],"https://beatscript.app/ontology/ns#readOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#requiredParameter":[{"@value":"query"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#toolName":[{"@value":"sparql_query"}]},{"@id":"https://beatscript.app/ontology/concept/transform-degrade","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternTransform"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Drop some hits at random, thinning the pattern."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"degrade"}],"http://www.w3.org/2004/02/skos/core#relatedMatch":[{"@id":"https://beatscript.app/ontology/concept/density"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/transform-degrade"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/endomorphism-monoid"}],"https://beatscript.app/ontology/ns#liftedThrough":[{"@id":"https://beatscript.app/ontology/concept/pattern-endofunctor"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"degrade"}]},{"@id":"https://beatscript.app/ontology/concept/transform-every","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternTransform"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The pattern call every: takes a pattern and gives another."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"every"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"every"}]},{"@id":"https://beatscript.app/ontology/concept/transform-fast","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternTransform"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Squeeze the pattern so each step lasts less time."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"fast"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/transform-fast"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/endomorphism-monoid"}],"https://beatscript.app/ontology/ns#liftedThrough":[{"@id":"https://beatscript.app/ontology/concept/pattern-endofunctor"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"fast"}]},{"@id":"https://beatscript.app/ontology/concept/transform-humanize","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternTransform"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/ns#humanize"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Add small random wobble to timing and loudness."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"humanize"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/transform-humanize"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/endomorphism-monoid"}],"https://beatscript.app/ontology/ns#liftedThrough":[{"@id":"https://beatscript.app/ontology/concept/pattern-endofunctor"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"humanize"}]},{"@id":"https://beatscript.app/ontology/concept/transform-maybe","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternTransform"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The pattern call maybe: takes a pattern and gives another."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"maybe"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"maybe"}]},{"@id":"https://beatscript.app/ontology/concept/transform-octave","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternTransform"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Move every note up or down whole octaves: a transpose by a multiple of twelve."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"octave"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/transform-octave"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/endomorphism-monoid"}],"https://beatscript.app/ontology/ns#liftedThrough":[{"@id":"https://beatscript.app/ontology/concept/pattern-endofunctor"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"octave"}]},{"@id":"https://beatscript.app/ontology/concept/transform-rests","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternTransform"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The pattern call rests: takes a pattern and gives another."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"rests"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"rests"}]},{"@id":"https://beatscript.app/ontology/concept/transform-reverse","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternTransform"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Play the pattern backwards. Doing it twice is the identity."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"reverse"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/transform-reverse"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/endomorphism-monoid"}],"https://beatscript.app/ontology/ns#liftedThrough":[{"@id":"https://beatscript.app/ontology/concept/pattern-endofunctor"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"reverse"}]},{"@id":"https://beatscript.app/ontology/concept/transform-rotate","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternTransform"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Shift the pattern in time by a number of steps, wrapping around."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"rotate"}],"http://www.w3.org/2004/02/skos/core#relatedMatch":[{"@id":"https://beatscript.app/ontology/concept/rotation"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/transform-rotate"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/endomorphism-monoid"}],"https://beatscript.app/ontology/ns#liftedThrough":[{"@id":"https://beatscript.app/ontology/concept/pattern-endofunctor"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"rotate"}]},{"@id":"https://beatscript.app/ontology/concept/transform-slow","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternTransform"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Stretch the pattern so each step lasts longer."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"slow"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/transform-slow"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/endomorphism-monoid"}],"https://beatscript.app/ontology/ns#liftedThrough":[{"@id":"https://beatscript.app/ontology/concept/pattern-endofunctor"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"slow"}]},{"@id":"https://beatscript.app/ontology/concept/transform-transpose","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternTransform"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Shift every note by a fixed number of semitones."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"transpose"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/transform-transpose"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/endomorphism-monoid"}],"https://beatscript.app/ontology/ns#liftedThrough":[{"@id":"https://beatscript.app/ontology/concept/pattern-endofunctor"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"transpose"}]},{"@id":"https://beatscript.app/ontology/concept/verb-activity","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beats