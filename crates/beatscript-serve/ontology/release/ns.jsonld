01/rdf-schema#label":[{"@language":"en","@value":"harmonic minor"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Natural minor with a raised seventh degree."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/scale/harmonic-minor"}],"https://beatscript.app/ontology/ns#intervals":[{"@value":"0 2 3 5 7 8 11"}],"https://beatscript.app/ontology/ns#noteCount":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"7"}]},{"@id":"https://beatscript.app/ontology/scale/major","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Scale"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"major"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The seven-note major scale: whole, whole, half, whole, whole, whole, half."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/scale/major"}],"https://beatscript.app/ontology/ns#intervals":[{"@value":"0 2 4 5 7 9 11"}],"https://beatscript.app/ontology/ns#noteCount":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"7"}]},{"@id":"https://beatscript.app/ontology/scale/minor-pentatonic","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Scale"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"minor pentatonic"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The five-note minor pentatonic scale."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/scale/minor-pentatonic"}],"https://beatscript.app/ontology/ns#intervals":[{"@value":"0 3 5 7 10"}],"https://beatscript.app/ontology/ns#noteCount":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"5"}]},{"@id":"https://beatscript.app/ontology/scale/minor","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Scale"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"minor"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The natural minor scale, the sixth mode of the major scale."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/scale/minor"}],"https://beatscript.app/ontology/ns#intervals":[{"@value":"0 2 3 5 7 8 10"}],"https://beatscript.app/ontology/ns#noteCount":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"7"}]},{"@id":"https://beatscript.app/ontology/scale/mixolydian","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Scale"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"mixolydian"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Major with a lowered seventh: the fifth mode of the major scale."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/scale/mixolydian"}],"https://beatscript.app/ontology/ns#intervals":[{"@value":"0 2 4 5 7 9 10"}],"https://beatscript.app/ontology/ns#noteCount":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"7"}]},{"@id":"https://beatscript.app/ontology/scale/pentatonic","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Scale"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"pentatonic"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The five-note major pentatonic scale: the major scale without its fourth and seventh."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/scale/pentatonic"}],"https://beatscript.app/ontology/ns#intervals":[{"@value":"0 2 4 7 9"}],"https://beatscript.app/ontology/ns#noteCount":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"5"}]},{"@id":"https://beatscript.app/ontology/scale/phrygian","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Scale"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"phrygian"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Minor with a lowered second degree: the third mode of the major scale. Dark and tense."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/scale/phrygian"}],"https://beatscript.app/ontology/ns#intervals":[{"@value":"0 1 3 5 7 8 10"}],"https://beatscript.app/ontology/ns#noteCount":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"7"}]},{"@id":"https://beatscript.app/ontology/section/breakdown","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#SongSection"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"breakdown"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A stripped-back section where the drums drop out and a melody carries."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/section/breakdown"}],"https://beatscript.app/ontology/ns#bars":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"8"}]},{"@id":"https://beatscript.app/ontology/section/bridge","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#SongSection"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"bridge"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A contrasting section away from the verse and chorus."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/section/bridge"}],"https://beatscript.app/ontology/ns#bars":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"8"}]},{"@id":"https://beatscript.app/ontology/section/buildup","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#SongSection"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"buildup"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Rising tension before a drop: snare and hi-hat density climb."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/section/buildup"}],"https://beatscript.app/ontology/ns#bars":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"8"}]},{"@id":"https://beatscript.app/ontology/section/chorus","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#SongSection"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"chorus"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The high-energy, full-arrangement section a song returns to."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/section/chorus"}],"https://beatscript.app/ontology/ns#bars":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"16"}]},{"@id":"https://beatscript.app/ontology/section/drop","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#SongSection"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"drop"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The peak of an electronic track after a buildup: full arrangement at highest energy."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/section/drop"}],"https://beatscript.app/ontology/ns#bars":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"16"}]},{"@id":"https://beatscript.app/ontology/section/intro","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#SongSection"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"intro"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The opening: few parts playing, building attention."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/section/intro"}],"https://beatscript.app/ontology/ns#bars":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"8"}]},{"@id":"https://beatscript.app/ontology/section/outro","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#SongSection"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"outro"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The closing section: parts fall away."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/section/outro"}],"https://beatscript.app/ontology/ns#bars":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"8"}]},{"@id":"https://beatscript.app/ontology/section/pre-chorus","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#SongSection"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"pre-chorus"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A short lift into the chorus."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/section/pre-chorus"}],"https://beatscript.app/ontology/ns#bars":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"8"}]},{"@id":"https://beatscript.app/ontology/section/solo","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#SongSection"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"solo"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A section featuring one melodic voice over the rhythm section."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/section/solo"}],"https://beatscript.app/ontology/ns#bars":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"16"}]},{"@id":"http