org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#stepsPerChord"}]},{"@id":"https://beatscript.app/ontology/ns#stressPattern","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The meter as a BeatScript step pattern, one step a syllable: x stressed, ~ not (~ x is an iamb)."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#PhrasebookEntry"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"stress pattern"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#sugarWord","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A word a program may write without do to reach this noun: vocoder on is do vocoder on."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#ControlNoun"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"sugar word"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#suitsGenre","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A genre whose groove a line of this meter family sits on."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#MeterFamily"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"suits genre"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"https://beatscript.app/ontology/ns#Genre"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#suitsGroove","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The groove a line of this meter family sits on, in a sentence: a trochee chants on the kick, an iamb lilts on the offbeat, an anapest wants a triplet feel."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#MeterFamily"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"suits groove"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#sungBy","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#VocalLine"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"sung by"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"https://beatscript.app/ontology/ns#FormantVoice"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#sungBy"}]},{"@id":"https://beatscript.app/ontology/ns#swing","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"How far off-beats are pushed late, 0 (straight) to about 60 (heavy)."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#Genre"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@langu