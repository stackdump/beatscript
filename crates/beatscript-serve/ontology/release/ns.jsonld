 sung: jingle=/j ii ng g uh l/)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"lyric_text"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"{ TEXT | \"/\" SPACE | escape } [ \"/\" { TEXT } ]"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Mix moves and sung lyrics"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-slash"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-escape"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-space"},{"@id":"https://beatscript.app/ontology/concept/token-text"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"lyric_text"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-lyric","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The lyric production of BeatScript's grammar (its text is lyric_text; docs/beatscript/phonemes.md)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"lyric"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"STRING"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Mix moves and sung lyrics"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-string"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"lyric"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-mark","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https:/