/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arr_gap production of BeatScript's grammar (a mutation runs to the end of its line)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"arr_gap"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"NEWLINE | \",\" | mutation NEWLINE"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Arrange mutations"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-comma"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-mutation"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-newline"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"arr_gap"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-arrange-block","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange_block production of BeatScript's grammar (at least one section; see \"Arrange mutations\"; a named arrangement with mutations)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"arrange_block"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"arrange\" \"{\" { arr_gap } NAME { arr_gap | NAME } \"}\" [ block_end ] | \"arrange\" NAME \":\" \"{\" { arr_gap } NAME { arr_gap | NAME } \"}\" [ arr_end ]"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Arrange mutations"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/c