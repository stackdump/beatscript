cript.app/ontology/concept/grammar-sexpr"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-name"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"sexpr"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-shape","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The shape production of BeatScript's grammar."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"shape"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"linear\" | \"exp\" | \"log\" | \"s-curve\" | \"step\" INT"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Shapes and lfo"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-exp"},{"@id":"https://beatscript.app/ontology/concept/keyword-linear"},{"@id":"https://beatscript.app/ontology/concept/keyword-log"},{"@id":"https://beatscript.app/ontology/concept/keyword-s-curve"},{"@id":"https://beatscript.app/ontology/concept/keyword-step"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-int"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"shape"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-sing","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The sing production of BeatScript's grammar (a tonal role; PHRASE: a phrasebook id, @hands_up; NAME: a phrase a `use phrase` line named)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@l