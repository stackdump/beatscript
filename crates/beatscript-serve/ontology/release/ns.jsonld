d by"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#maxBpm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"},{"@id":"http://www.w3.org/2002/07/owl#FunctionalProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The fastest tempo, in beats per minute, the genre is usually played at. A convention, not a rule."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#Genre"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"fastest usual tempo"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#maxBpm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#mediaType","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The media (MIME) type a program text in the language is served and accepted as."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#ProgrammingLanguage"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"media type"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#melodyDensity","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Share of melody steps that sound rather than rest, 0 to 1."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#Genre"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"melody density"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#melodyDensity"}]},{"@id":"https://beatscript.app/ontology/ns#melodyDuration","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Note length in milliseconds."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#Genre"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"melody note length"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#melodyDuration"}]},{"@id":"https://beatscript.app/ontology/ns#melodyInstrument","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"MIDI channel 4."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"melody instrument"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"https://beatscript.app/ontology/ns#usesInstrument"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#melodyInstrument"}]},{"@id":"https://beatscript.app/ontology/ns#meter","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The meter as a person names it: iambic pentameter, common meter."}],"http://www.w3.org/2000/01/rdf-sch