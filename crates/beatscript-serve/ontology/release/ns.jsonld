ment, when the instrument's own name is not one."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#Instrument"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"BeatScript voice"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#beatscriptVoice"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#bpm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"},{"@id":"http://www.w3.org/2002/07/owl#FunctionalProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Beats per minute the generator starts at. Not a rule of the genre."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#Genre"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"default tempo"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#bpm"}]},{"@id":"https://beatscript.app/ontology/ns#callResponse","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#Genre"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"call and response"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#callResponse"}]},{"@id":"https://beatscript.app/ontology/ns#callSyllables","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}],"http://ww