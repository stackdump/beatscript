.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The doval production of BeatScript's grammar."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"doval"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"arith [ \"->\" arith ] | WORD | STRING | \"[\" [ doval { \",\" doval } ] \"]\" | lfo"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Control: what the mix does"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-arrow"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-close-bracket"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-comma"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-open-bracket"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-arith"},{"@id":"https://beatscript.app/ontology/concept/grammar-doval"},{"@id":"https://beatscript.app/ontology/concept/grammar-lfo"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-string"},{"@id":"https://beatscript.app/ontology/concept/token-word"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"doval"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-dseq","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The dseq production of BeatScript's grammar."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"dseq"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"dterm { dterm }"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Degrees, Roman numerals, chance"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-dterm"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"dseq"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-dstack","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The dstack production of BeatScript's grammar."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"dstack"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"dseq { \",\" dseq }"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Degrees, Roman numerals, chance"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-comma"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-dseq"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"dstack"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-dterm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The dterm production of BeatScript's grammar."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"dterm"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"dleaf [ mark ] [ \"*\" INT ] | \"~\" | \"x\" | \"[\" dstack \"]\" | \"<\" dseq \">\" | \"(\" ( dterm | arith ) \")\""}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Degrees, Roman numerals, chance"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-close-bracket"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-close-paren"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-gt"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-lt"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-open-bracket"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-open-paren"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-star"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-tilde"},{"@id":"https://beatscript.app/ontology/concept/keyword-x"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-arith"},{"@id":"https://beatscript.app/ontology/concept/grammar-dleaf"},{"@id":"https://beatscript.app/ontology/concept/grammar-dseq"},{"@id":"https://beatscript.app/ontology/concept/grammar-dstack"},{"@id":"https://beatscript.app/ontology/concept/grammar-dterm"},{"@id":"https://beatscript.app/ontology/concept/grammar-mark"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-int"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"dterm"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-duck","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The duck production of BeatScript's grammar."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"duck"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"duck\" deck \"under\" deck \".\" role db { \"attack=\" time | \"release=\" time }"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Mix moves and sung lyrics"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-attack-param"},{"@id":"https://beatscript.app/ontology/concept/keyword-duck"},{"@id":"https://beatscript.app/ontology/concept/keyword-release-param"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-dot"},{"@id":"https://beatscript.app/ontology/concept/keyword-under"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-db"},{"@id":"https://beatscript.app/ontology/concept/grammar-deck"},{"@id":"https://beatscript.app/ontology/concept/grammar-role"},{"@id":"https://beatscript.app/ontology/concept/grammar-time"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"duck"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-dur","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The dur production of BeatScript's grammar (4 bars 1/2 bar 2 beats)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"dur"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"arith ( \"bar\" | \"bars\" | \"beat\" | \"beats\" )"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Lines: when, where, what"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-bar"},{"@id":"https://beatscript.app/ontology/concept/keyword-bars"},{"@id":"https://beatscript.app/ontology/concept/keyword-beat"},{"@id":"https://beatscript.app/ontology/concept/keyword-beats"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-arith"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"dur"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-emit","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The emit production of BeatScript's grammar (a line of a def body: what an out port carries)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"emit"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"emit\" [ type | \"out\" ] tokens"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Typed ports"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-emit"},{"@id":"https://beatscript.app/ontology/concept/keyword-out"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-tokens"},{"@id":"https://beatscript.app/ontology/concept/grammar-type"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"emit"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-end","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The end production of BeatScript's grammar (a song ends after its last section by default)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"end"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"end\" [ \"at\" \"bar\" INT | \"after\" NAME ]"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Structure: lets, defs, sections, the arrangement"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-after"},{"@id":"https://beatscript.app/ontology/concept/keyword-at"},{"@id":"https://beatscript.app/ontology/concept/keyword-bar"},{"@id":"https://beatscript.app/ontology/concept/keyword-end"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-int"},{"@id":"https://beatscript.app/ontology/concept/token-name"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"end"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-engine","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The engine production of BeatScript's grammar (no target, or control:; at bar 16: tempo 128 -> 140 over 4 bars; the booth's: the desktop app plays these; macro riser on A over 8 bars: the DJ macro catalogue, by id; MACRO is macro or macro@1)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"engine"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"crossfader\" change | \"tempo\" tempo | \"swap\" \"pairs\" [ \"with\" MOVE ] | \"move\" MOVE \"on\" deck [ span ] | \"load\" \"pair\" SPEC [ \"group\" INT ] | \"queue\" ( \"play\" | \"pause\" | \"stop\" | \"next\" | \"loop\" | \"jump\" INT | \"add\" WORD ) | MACRO NAME ( \"on\" deck [ span ] | span \"on\" deck )"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Control: what the mix does"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-add"},{"@id":"https://beatscript.app/ontology/concept/keyword-crossfader"},{"@id":"https://beatscript.app/ontology/concept/keyword-group"},{"@id":"https://beatscript.app/ontology/concept/keyword-jump"},{"@id":"https://beatscript.app/ontology/concept/keyword-load"},{"@id":"https://beatscript.app/ontology/concept/keyword-loop"},{"@id":"https://beatscript.app/ontology/concept/keyword-move"},{"@id":"https://beatscript.app/ontology/concept/keyword-next"},{"@id":"https://beatscript.app/ontology/concept/keyword-on"},{"@id":"https://beatscript.app/ontology/concept/keyword-pair"},{"@id":"https://beatscript.app/ontology/concept/keyword-pairs"},{"@id":"https://beatscript.app/ontology/concept/keyword-pause"},{"@id":"https://beatscript.app/ontology/concept/keyword-play"},{"@id":"https://beatscript.app/ontology/concept/keyword-queue"},{"@id":"https://beatscript.app/ontology/concept/keyword-stop"},{"@id":"https://beatscript.app/ontology/concept/keyword-swap"},{"@id":"https://beatscript.app/ontology/concept/keyword-tempo"},{"@id":"https://beatscript.app/ontology/concept/keyword-with"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-change"},{"@id":"https://beatscript.app/ontology/concept/grammar-deck"},{"@id":"https://beatscript.app/ontology/concept/grammar-lexical-move"},{"@id":"https://beatscript.app/ontology/concept/grammar-lexical-spec"},{"@id":"https://beatscript.app/ontology/concept/grammar-span"},{"@id":"https://beatscript.app/ontology/concept/grammar-tempo"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-int"},{"@id":"https://beatscript.app/ontology/concept/token-macro"},{"@id":"https://beatscript.app/ontology/concept/token-name"},{"@id":"https://beatscript.app/ontology/concept/token-word"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"engine"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-escape","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The escape production of BeatScript's grammar (PHONES (beatscript-v1): aa ae uh aw eh er ii ee uu oo ay ie oy ow oh p b t d k g f v s z sh zh th dh h m n ng l r w y ch j, \"_\" a rest, \"-\" cuts a word, \":\" holds a vowel one more note, \"!\" accents it)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"escape"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"/\" PHONES \"/\""}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Mix moves and sung lyrics"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-slash"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-phones"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"escape"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-evolve","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The evolve production of BeatScript's grammar (a rule a line; the bound last)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"evolve"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"evolve\" \"every\" INT \"bars\" \"{\" { NEWLINE } { rule NEWLINE { NEWLINE } } [ bound NEWLINE { NEWLINE } ] \"}\""}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Evolving"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-bars"},{"@id":"https://beatscript.app/ontology/concept/keyword-every"},{"@id":"https://beatscript.app/ontology/concept/keyword-evolve"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-close-brace"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-open-brace"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-bound"},{"@id":"https://beatscript.app/ontology/concept/grammar-rule"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-int"},{"@id":"https://beatscript.app/ontology/concept/token-newline"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"evolve"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-expr","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The expr production of BeatScript's grammar (a guard: kept when it is true)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"expr"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"or"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Arithmetic and guards"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-or"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"expr"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-form","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The form production of BeatScript's grammar (a form inside another takes no phrase: forms nest 3 deep; .both is one of its sections, .both.arp that section's part)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"form"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"template\" \"(\" NAME { \",\" binding } \")\" [ \".\" NAME [ \".\" role ] ]"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Phrase templates"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-close-paren"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-comma"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-dot"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-open-paren"},{"@id":"https://beatscript.app/ontology/concept/keyword-template"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-binding"},{"@id":"https://beatscript.app/ontology/concept/grammar-role"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-name"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"form"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-gen-param","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The gen_param production of BeatScript's grammar."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"gen_param"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"bpm\" \"=\" NUMBER | \"key\" \"=\" KEY | \"length\" \"=\" ( \"short\" | \"standard\" | \"long\" ) | \"section\" \"=\" NAME | \"part\" \"=\" role"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Start from a seed"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-bpm"},{"@id":"https://beatscript.app/ontology/concept/keyword-key"},{"@id":"https://beatscript.app/ontology/concept/keyword-length"},{"@id":"https://beatscript.app/ontology/concept/keyword-long"},{"@id":"https://beatscript.app/ontology/concept/keyword-part"},{"@id":"https://beatscript.app/ontology/concept/keyword-section"},{"@id":"https://beatscript.app/ontology/concept/keyword-short"},{"@id":"https://beatscript.app/ontology/concept/keyword-standard"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-equals"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-role"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-key"},{"@id":"https://beatscript.app/ontology/concept/token-name"},{"@id":"https://beatscript.app/ontology/concept/token-number"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"gen_param"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-gen","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The gen production of BeatScript's grammar (gen@2 techno seed=42 section=drop part=bass: the seeded generator, called; GEN is gen@2 or a bare gen)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"gen"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"GEN NAME \"seed\" \"=\" ( INT | NAME ) { gen_param }"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Start from a seed"}],"https://beatscript.app/ontology/ns#hostOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-seed"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-equals"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-gen-param"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-gen"},{"@id":"https://beatscript.app/ontology/concept/token-int"},{"@id":"https://beatscript.app/ontology/concept/token-name"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"gen"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-guard","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The guard production of BeatScript's grammar (kept where it holds)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"guard"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"when\" expr"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Lines: when, where, what"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-when"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-expr"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"guard"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-headed","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The headed production of BeatScript's grammar (a deck's parts: no time word before them; the control deck; a def's call, a duck and a mix name their decks themselves)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"headed"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"deck\" deck \":\" parts [ guard ] | [ timing \":\" ] [ target \":\" ] control [ cguard ] | [ timing \":\" ] \"control\" \":\" ( engine | do | duck | mix ) [ cguard ] | [ timing \":\" ] ( invoke | duck | mix ) [ cguard ]"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Lines: when, where, what"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-control"},{"@id":"https://beatscript.app/ontology/concept/keyword-deck"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-colon"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-cguard"},{"@id":"https://beatscript.app/ontology/concept/grammar-control"},{"@id":"https://beatscript.app/ontology/concept/grammar-deck"},{"@id":"https://beatscript.app/ontology/concept/grammar-do"},{"@id":"https://beatscript.app/ontology/concept/grammar-duck"},{"@id":"https://beatscript.app/ontology/concept/grammar-engine"},{"@id":"https://beatscript.app/ontology/concept/grammar-guard"},{"@id":"https://beatscript.app/ontology/concept/grammar-invoke"},{"@id":"https://beatscript.app/ontology/concept/grammar-mix"},{"@id":"https://beatscript.app/ontology/concept/grammar-parts"},{"@id":"https://beatscript.app/ontology/concept/grammar-target"},{"@id":"https://beatscript.app/ontology/concept/grammar-timing"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"headed"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-import","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The import production of BeatScript's grammar (a snippet's name in quotes, or its CID)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"import"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"import\" ( NAME | STRING )"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Radio: stations"}],"https://beatscript.app/ontology/ns#hostOnly":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-import"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-name"},{"@id":"https://beatscript.app/ontology/concept/token-string"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"import"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-input","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The input production of BeatScript's grammar (performed: only in a control value or guard; PITCH: a note with its octave, c4)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"input"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"knob\" \"(\" INT \")\" | \"pad\" \"(\" INT \")\" | \"fader\" \"(\" deck \")\" | \"held\" \"(\" \"key\" \")\" | \"held\" \"(\" PITCH \")\""}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Arithmetic and guards"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-fader"},{"@id":"https://beatscript.app/ontology/concept/keyword-held"},{"@id":"https://beatscript.app/ontology/concept/keyword-key"},{"@id":"https://beatscript.app/ontology/concept/keyword-knob"},{"@id":"https://beatscript.app/ontology/concept/keyword-pad"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-close-paren"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-open-paren"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-deck"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-int"},{"@id":"https://beatscript.app/ontology/concept/token-pitch"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"input"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-invoke","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The invoke production of BeatScript's grammar (a def's call)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"invoke"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"NAME \"(\" [ tokens { \",\" tokens } ] \")\""}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Structure: lets, defs, sections, the arrangement"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-close-paren"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-comma"},{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-open-paren"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-tokens"}],"https://beatscript.app/ontology/ns#usesToken":[{