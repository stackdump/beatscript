:[{"@language":"en","@value":"The parts production of BeatScript's grammar (only after \"deck X:\" and with no time word)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"parts"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"pitem { \"|\" pitem }"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Parts"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-bar"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-pitem"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"parts"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-pattern","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The pattern production of BeatScript's grammar."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"pattern"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"term { term }"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Mini-notation: the rhythm of a part"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-term"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"pattern"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-pexpr","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The pexpr production of BeatScript's gra