\" ] cprimary"}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Arithmetic and guards"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-minus"}],"https://beatscript.app/ontology/ns#usesProduction":[{"@id":"https://beatscript.app/ontology/concept/grammar-cprimary"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"cunary"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-db","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The db production of BeatScript's grammar (glued: 6db)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"db"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"DECIMAL \"db\""}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Mix moves and sung lyrics"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-db"}],"https://beatscript.app/ontology/ns#usesToken":[{"@id":"https://beatscript.app/ontology/concept/token-decimal"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"db"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-deck","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The deck production of BeatScript's grammar (PARAM: in a def body, filled in when it is called)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"deck"}],"https://beatscr