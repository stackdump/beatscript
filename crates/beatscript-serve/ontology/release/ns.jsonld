[{"@id":"https://beatscript.app/ontology/concept/beatscript-1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#LanguageVersion"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@language":"en","@value":"btw"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"BeatScript 1: a text is in it when its header block has the version line #! btw 1, or no version line at all. Its canonical text has no #! line, and its program CID is the CID of the document {\"format\":1,\"text\":\"<canonical text>\",\"type\":\"djrust.live\"}."}],"http://www.w3.org/2004/02/skos/core#historyNote":[{"@language":"en","@value":"The name of the language before language version 2 was btw: BeatScript 1 is the language as it was written then. Every BeatScript 1 program, link and CID keeps its meaning; fmt upgrades a program to BeatScript 2, which plays the same under a new CID."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"BeatScript 1"}],"https://beatscript.app/ontology/ns#programCidFormat":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"1"}],"https://beatscript.app/ontology/ns#programCidType":[{"@value":"djrust.live"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#versionLine":[{"@value":"#! btw 1"}],"https://beatscript.app/ontology/ns#versionOf":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-language"}]},{"@id":"https://beatscript.app/ontology/concept/beatscript-2","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#LanguageVersion"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"BeatScript 2: a text is in it when its header block has the version line #! beatscript 2. Its canonical text begins with #! beatscript 2, and its program CID is the CID of the document {\"format\":2,\"text\":\"<canonical text>\",\"type\":\"beatscript\"}. The current version: what fmt upgrades a program to and what the generators write."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"BeatScript 2"}],"http://www.w3.org/ns/prov#wasRevisionOf":[{"@id":"https://beatscript.app/ontology/concept/beatscript-1"}],"https://beatscript.app/ontology/ns#programCidFormat":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"2"}],"https://beatscript.app/ontology/ns#programCidType":[{"@value":"beatscript"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#versionLine":[{"@value":"#! beatscript 2"}],"https://beatscript.app/ontology/ns#versionOf":[{"@id":"https://beatscript.app/ontology/concept/product-beatscript-language"}]},{"@id":"https://beatscript.app/ontology/concept/bjorklund","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://en.wikipedia.org/wiki/Euclidean_rhythm"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The procedure that spreads K pulses over N steps as evenly as possible. Applied repeatedly, it merges the longer groups with the leftover shorter ones until at most one leftover remains."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"Bjorklund algorithm"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/bjorklund"}]},{"@id":"https://beatscript.app/ontology/concept/call-and-response","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A phrase answered by another phrase."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"call and response"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/call-and-response"}]},{"@id":"https://beatscript.app/ontology/concept/camelot-wheel","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A way of naming the twenty-four keys as numbers 1 to 12 with a letter, A for minor and B for major. Keys one step apart on the wheel, or at the same number with the other letter, mix harmonically."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"Camelot wheel"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/camelot-wheel"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/chord-tone","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A scale degree that belongs to the chord sounding now. Strong-beat melody notes are pulled to the nearest one."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"chord tone"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/chord-tone"}]},{"@id":"https://beatscript.app/ontology/concept/circulating-token","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"https://ontology.pflow.xyz/ns#Token"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The single token that moves around a ring, one step per tick. Its position is the playhead."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"circulating token"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/circulating-token"}]},{"@id":"https://beatscript.app/ontology/concept/density","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The share of steps that sound rather than rest."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"density"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/density"}]},{"@id":"https://beatscript.app/ontology/concept/empty-section-identity","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#CategoricalConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The section with no lines. Arranging it before or after any section leaves that section unchanged."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"empty section (identity)"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/empty-section-identity"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/ending-end","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Ending"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The program stops when its last section finishes."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"end"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/ending-end"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/ending-loop","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Ending"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The program returns to its first section when its last finishes, and the net's marking resets to its initial marking."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"loop"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/ending-loop"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/endomorphism-monoid","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#CategoricalConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The pattern transforms, each taking a pattern to a pattern, closed under doing one after another, with doing nothing as the identity."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"endomorphism monoid"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/endomorphism-monoid"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/euclidean-rhythm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"https://beatscript.app/ontology/ns#EuclideanRhythm"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A rhythm made by the Bjorklund algorithm. Many traditional patterns around the world are Euclidean rhythms. In the engine it becomes a rhythm ring with a note binding on each pulse step."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"Euclidean rhythm"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/euclidean-rhythm"}]},{"@id":"https://beatscript.app/ontology/concept/evolve-invert","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EvolveOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The evolve operator invert: applied to a part once a generation."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"invert"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"invert"}]},{"@id":"https://beatscript.app/ontology/concept/evolve-octave","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EvolveOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The evolve operator octave: applied to a part once a generation."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"octave"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"octave"}]},{"@id":"https://beatscript.app/ontology/concept/evolve-reverse","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EvolveOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The evolve operator reverse: applied to a part once a generation."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"reverse"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"reverse"}]},{"@id":"https://beatscript.app/ontology/concept/evolve-rotate","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EvolveOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The evolve operator rotate: applied to a part once a generation."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"rotate"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"rotate"}]},{"@id":"https://beatscript.app/ontology/concept/evolve-thin","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EvolveOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The evolve operator thin: applied to a part once a generation."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"thin"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"thin"}]},{"@id":"https://beatscript.app/ontology/concept/evolve-transpose","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EvolveOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The evolve operator transpose: applied to a part once a generation."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"transpose"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"transpose"}]},{"@id":"https://beatscript.app/ontology/concept/fmt","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The formatter: rewrites a BeatScript program into its canonical form without changing what it plays. The fmt a person or an agent asks for also upgrades a BeatScript 1 program to BeatScript 2, a new CID for the same music; the formatting a program gets on its way in (eval, load, share, queue, push) keeps its version, so its CID never moves."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"fmt"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/fmt"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/normal-form"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/form-canon","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Form"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/docs/forms#canon"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The canon, a form from classical music: lead chase round sung round sung: one voice, then two, then three. The theme chases its own delayed and rotated copies; they are made of its bars, so `~ theme_* rot 2` and `rev` move the leader and its followers together."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"canon"}],"https://beatscript.app/ontology/ns#formShape":[{"@language":"en","@value":"lead chase round sung round sung: one voice, then two, then three"}],"https://beatscript.app/ontology/ns#formTemplate":[{"@id":"https://beatscript.app/ontology/concept/template-canon"}],"https://beatscript.app/ontology/ns#mutationPlan":[{"@language":"en","@value":"the theme chases its own delayed and rotated copies; they are made of its bars, so `~ theme_* rot 2` and `rev` move the leader and its followers together"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesMutation":[{"@id":"https://beatscript.app/ontology/concept/mutation-op-accent"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-decay"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-grow"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-rev"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-rot"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-xfer"}],"https://beatscript.app/ontology/ns#usesTechnique":[{"@id":"https://beatscript.app/ontology/concept/technique-found-phrases"}],"https://beatscript.app/ontology/ns#usesTheme":[{"@value":"pachelbel_ground"},{"@value":"pachelbel_violin"}],"https://beatscript.app/ontology/ns#usesThemeLibrary":[{"@id":"https://beatscript.app/ontology/concept/themes-public-domain"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"canon"}]},{"@id":"https://beatscript.app/ontology/concept/form-cross","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Form"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/docs/forms#cross"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The cross, a form from classical music: a_leads b_leads both both sung a_leads b_leads sung: one source leads, then the other, then both at once. A quodlibet of two: `~ a_melody_* morph b_melody_1 p` paired with `~ b_bass_* morph a_bass_1 p`, an `@ ... xfer` one-shot in the overlap, then the pull turned round (`~ b_melody_* morph a_melody_1 p`, `~ a_bass_* morph b_bass_1 p`); `~` persists and compounds pass on pass (loop 3)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"cross"}],"https://beatscript.app/ontology/ns#formShape":[{"@language":"en","@value":"a_leads b_leads both both sung a_leads b_leads sung: one source leads, then the other, then both at once"}],"https://beatscript.app/ontology/ns#formTemplate":[{"@id":"https://beatscript.app/ontology/concept/template-cross"}],"https://beatscript.app/ontology/ns#mutationPlan":[{"@language":"en","@value":"a quodlibet of two: `~ a_melody_* morph b_melody_1 p` paired with `~ b_bass_* morph a_bass_1 p`, an `@ ... xfer` one-shot in the overlap, then the pull turned round (`~ b_melody_* morph a_melody_1 p`, `~ a_bass_* morph b_bass_1 p`); `~` persists and compounds pass on pass (loop 3)"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesMutation":[{"@id":"https://beatscript.app/ontology/concept/mutation-op-decay"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-grow"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-morph"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-xfer"}],"https://beatscript.app/ontology/ns#usesTechnique":[{"@id":"https://beatscript.app/ontology/concept/technique-found-phrases"}],"https://beatscript.app/ontology/ns#usesTheme":[{"@value":"badinerie"},{"@value":"ode_to_joy"},{"@value":"pachelbel_ground"}],"https://beatscript.app/ontology/ns#usesThemeLibrary":[{"@id":"https://beatscript.app/ontology/concept/themes-public-domain"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"cross"}]},{"@id":"https://beatscript.app/ontology/concept/form-fugue","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Form"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/docs/forms#fugue"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The fugue, a form from classical music: subject answer counter sung answer counter sung: the voices enter one by one. The subject re-enters transposed (`~ subject_* down 2`, later `~ up 2`) while the countersubject morphs toward it (`~ counter_* morph subject_1 p`)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"fugue"}],"https://beatscript.app/ontology/ns#formShape":[{"@language":"en","@value":"subject answer counter sung answer counter sung: the voices enter one by one"}],"https://beatscript.app/ontology/ns#formTemplate":[{"@id":"https://beatscript.app/ontology/concept/template-fugue"}],"https://beatscript.app/ontology/ns#mutationPlan":[{"@language":"en","@value":"the subject re-enters transposed (`~ subject_* down 2`, later `~ up 2`) while the countersubject morphs toward it (`~ counter_* morph subject_1 p`)"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesMutation":[{"@id":"https://beatscript.app/ontology/concept/mutation-op-decay"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-down"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-grow"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-morph"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-up"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-xfer"}],"https://beatscript.app/ontology/ns#usesTechnique":[{"@id":"https://beatscript.app/ontology/concept/technique-found-phrases"}],"https://beatscript.app/ontology/ns#usesTheme":[{"@value":"badinerie"},{"@value":"mountain_king"}],"https://beatscript.app/ontology/ns#usesThemeLibrary":[{"@id":"https://beatscript.app/ontology/concept/themes-public-domain"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"fugue"}]},{"@id":"https://beatscript.app/ontology/concept/form-passacaglia","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Form"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/docs/forms#passacaglia"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The passacaglia, a form from classical music: ground variation sung variation sung variation sung: the ground under every section. Cumulative variations above the ground, each `~` added on top of the last: `rot 2 | accent`, `thin`, `rev | drift`, `grow`, `up 1`, `down 1`, `decay`; the ground is never mutated."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"passacaglia"}],"https://beatscript.app/ontology/ns#formShape":[{"@language":"en","@value":"ground variation sung variation sung variation sung: the ground under every section"}],"https://beatscript.app/ontology/ns#formTemplate":[{"@id":"https://beatscript.app/ontology/concept/template-passacaglia"}],"https://beatscript.app/ontology/ns#mutationPlan":[{"@language":"en","@value":"cumulative variations above the ground, each `~` added on top of the last: `rot 2 | accent`, `thin`, `rev | drift`, `grow`, `up 1`, `down 1`, `decay`; the ground is never mutated"}],"https://beatscript.app/ontology/ns#referenceProgram":[{"@value":"z4EBG9j3xZiLH5Sa8EnFW5sg2WuSPRuMbBaTr3JHeQjfWWE7Ug9"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesMutation":[{"@id":"https://beatscript.app/ontology/concept/mutation-op-accent"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-decay"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-down"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-drift"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-grow"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-rev"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-rot"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-thin"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-up"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-xfer"}],"https://beatscript.app/ontology/ns#usesTechnique":[{"@id":"https://beatscript.app/ontology/concept/technique-found-phrases"}],"https://beatscript.app/ontology/ns#usesTheme":[{"@value":"mars_ostinato"}],"https://beatscript.app/ontology/ns#usesThemeLibrary":[{"@id":"https://beatscript.app/ontology/concept/themes-public-domain"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"passacaglia"}]},{"@id":"https://beatscript.app/ontology/concept/form-quodlibet","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Form"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/docs/forms#quodlibet"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The quodlibet, a form from classical music: canon ode fate voices canon voices: one theme leads each section, the others under it. `~ a_* morph b_1 p` paired later with `~ b_* morph a_1 p`, the pair pulled away by a morph toward a third line, `@` one-shot borrowings; `~` persists and compounds pass on pass (loop 3)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"quodlibet"}],"https://beatscript.app/ontology/ns#formShape":[{"@language":"en","@value":"canon ode fate voices canon voices: one theme leads each section, the others under it"}],"https://beatscript.app/ontology/ns#formTemplate":[{"@id":"https://beatscript.app/ontology/concept/template-quodlibet"}],"https://beatscript.app/ontology/ns#mutationPlan":[{"@language":"en","@value":"`~ a_* morph b_1 p` paired later with `~ b_* morph a_1 p`, the pair pulled away by a morph toward a third line, `@` one-shot borrowings; `~` persists and compounds pass on pass (loop 3)"}],"https://beatscript.app/ontology/ns#referenceProgram":[{"@value":"z4EBG9j86dPTC9HH6EjtBJFAWZsJLiPum4np9zoJQC9PzWm9SoC"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesMutation":[{"@id":"https://beatscript.app/ontology/concept/mutation-op-decay"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-grow"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-morph"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-xfer"}],"https://beatscript.app/ontology/ns#usesTechnique":[{"@id":"https://beatscript.app/ontology/concept/technique-found-phrases"}],"https://beatscript.app/ontology/ns#usesTheme":[{"@value":"beethoven_fate"},{"@value":"ode_to_joy"},{"@value":"pachelbel_ground"},{"@value":"pachelbel_violin"}],"https://beatscript.app/ontology/ns#usesThemeLibrary":[{"@id":"https://beatscript.app/ontology/concept/themes-public-domain"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"quodlibet"}]},{"@id":"https://beatscript.app/ontology/concept/form-rondo","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Form"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/docs/forms#rondo"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The rondo, a form from classical music: refrain episode refrain sung refrain episode refrain sung refrain: A B A C A B A C A. The refrain mutated on each return: `~ rot 2 | accent`, `@ mirror | vel 2` for one return, `~ up 1` then `~ down 1`; the episode morphs toward the refrain."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"rondo"}],"https://beatscript.app/ontology/ns#formShape":[{"@language":"en","@value":"refrain episode refrain sung refrain episode refrain sung refrain: A B A C A B A C A"}],"https://beatscript.app/ontology/ns#formTemplate":[{"@id":"https://beatscript.app/ontology/concept/template-rondo"}],"https://beatscript.app/ontology/ns#mutationPlan":[{"@language":"en","@value":"the refrain mutated on each return: `~ rot 2 | accent`, `@ mirror | vel 2` for one return, `~ up 1` then `~ down 1`; the episode morphs toward the refrain"}],"https://beatscript.app/ontology/ns#referenceProgram":[{"@value":"z4EBG9izzm3asNWWapjXtPFSZoPzgyj4cKjPELrw4jvrhdjPxrW"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesMutation":[{"@id":"https://beatscript.app/ontology/concept/mutation-op-accent"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-down"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-mirror"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-morph"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-rot"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-up"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-vel"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-xfer"}],"https://beatscript.app/ontology/ns#usesTechnique":[{"@id":"https://beatscript.app/ontology/concept/technique-found-phrases"}],"https://beatscript.app/ontology/ns#usesTheme":[{"@value":"bach_prelude_c"},{"@value":"the_entertainer"}],"https://beatscript.app/ontology/ns#usesThemeLibrary":[{"@id":"https://beatscript.app/ontology/concept/themes-public-domain"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"rondo"}]},{"@id":"https://beatscript.app/ontology/concept/form-theme-and-variations","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Form"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/docs/forms#theme-and-variations"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The theme and variations, a form from classical music: theme variation variation variation sung variation theme. One source, a different transform for each section as a one-shot `@` (`rev`, `invert`, `stutter 2`, `oct -1`, `half | accent`), so the theme comes back unchanged; no cross-morphs."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"theme and variations"}],"https://beatscript.app/ontology/ns#formShape":[{"@language":"en","@value":"theme variation variation variation sung variation theme"}],"https://beatscript.app/ontology/ns#formTemplate":[{"@id":"https://beatscript.app/ontology/concept/template-theme-and-variations"}],"https://beatscript.app/ontology/ns#mutationPlan":[{"@language":"en","@value":"one source, a different transform for each section as a one-shot `@` (`rev`, `invert`, `stutter 2`, `oct -1`, `half | accent`), so the theme comes back unchanged; no cross-morphs"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesMutation":[{"@id":"https://beatscript.app/ontology/concept/mutation-op-accent"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-grow"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-half"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-invert"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-oct"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-rev"},{"@id":"https://beatscript.app/ontology/concept/mutation-op-stutter"}],"https://beatscript.app/ontology/ns#usesTechnique":[{"@id":"https://beatscript.app/ontology/concept/technique-found-phrases"}],"https://beatscript.app/ontology/ns#usesTheme":[{"@value":"new_world_largo"}],"https://beatscript.app/ontology/ns#usesThemeLibrary":[{"@id":"https://beatscript.app/ontology/concept/themes-public-domain"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"theme-and-variations"}]},{"@id":"https://beatscript.app/ontology/concept/free-smc","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#CategoricalConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The category whose objects are multisets of places and whose morphisms are generated by the net's transitions. A deck's net is read as this category: what the deck can do is exactly what the category's morphisms can do."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"free symmetric monoidal category on a net"}],"http://www.w3.org/2004/02/skos/core#relatedMatch":[{"@id":"https://beatscript.app/ontology/concept/note-transition"},{"@id":"https://beatscript.app/ontology/concept/step-place"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/free-smc"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/generator-arp","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternGenerator"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/ns#ArpTerm"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The pattern generator arp: a call that makes a pattern from its arguments."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"arp"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"arp"}]},{"@id":"https://beatscript.app/ontology/concept/generator-choose","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternGenerator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The pattern generator choose: a call that makes a pattern from its arguments."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"choose"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"choose"}]},{"@id":"https://beatscript.app/ontology/concept/generator-chord","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternGenerator"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/ns#ChordTerm"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The pattern generator chord: a call that makes a pattern from its arguments."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"chord"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"chord"}]},{"@id":"https://beatscript.app/ontology/concept/generator-deg","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternGenerator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The pattern generator deg: a call that makes a pattern from its arguments."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"deg"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"deg"}]},{"@id":"https://beatscript.app/ontology/concept/generator-e","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternGenerator"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/ns#EuclidTerm"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The pattern generator e: a call that makes a pattern from its arguments."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"e"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"e"}]},{"@id":"https://beatscript.app/ontology/concept/generator-euclid","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternGenerator"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/ns#EuclidTerm"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The pattern generator euclid: a call that makes a pattern from its arguments."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"euclid"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"euclid"}]},{"@id":"https://beatscript.app/ontology/concept/generator-markov","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternGenerator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The pattern generator markov: a call that makes a pattern from its arguments."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"markov"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"markov"}]},{"@id":"https://beatscript.app/ontology/concept/ghost-note","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A very quiet drum hit between the main ones, felt more than heard."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"ghost note"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/ghost-note"}]},{"@id":"https://beatscript.app/ontology/concept/grammar-action","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The action production of BeatScript's grammar (hertz: 20 .. 20k; 0 .. 1: how much; deck X: / master: level; deck X:)."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"action"}],"https://beatscript.app/ontology/ns#ebnf":[{"@value":"\"filter\" ( \"lp\" | \"hp\" ) change | \"filter\" ( \"off\" | \"open\" ) | ( \"delay\" | \"reverb\" | \"crush\" | \"drive\" | \"resonance\" ) change | ( \"level\" | \"low\" | \"mid\" | \"high\" ) change | \"load\" SPEC | \"play\" | \"stop\" | \"sync\" | \"mute\" | \"unmute\""}],"https://beatscript.app/ontology/ns#grammarSection":[{"@language":"en","@value":"Control: what the mix does"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#usesKeyword":[{"@id":"https://beatscript.app/ontology/concept/keyword-crush"},{"@id":"https://beatscript.app/ontology/concept/keyword-delay"},{"@id":"https://beatscript.app/ontology/concept/keyword-drive"},{"@id":"https://beatscript.app/ontology/concept/keyword-filter"},{"@id":"https://beatscript.app/ontology/concept/keyword-high"},{"@id":"https://beatscript.app/ontology/concept/keyword-hp"},{"@id":"https://beatscript.app/ontology/concept/keyword-level"},{"@id":"https://beatscript.app/ontology/concept/keyword-load"},{"@id":"https://beatscript.app/ontology/concept/keyword-low"},{"@id":"https://beatscript.app/ontology/concept/keyword-lp"},{"@id":"https://beatscript.app/ontology/concept/keyword-mid"},{"@id":"https://beatscript.app/ontology/concept/keyword-mute"},{"@id":"https://beatscript.app/ontology/concept/keyword-off"},{"@id":"https://beatscript.app/ontology/concept/keyword-open"},{"@id":"https://beatscript.app/ontology/concept/keyword-play"},{"@