gy/variant/trap-hihat-c"},{"@id":"https://beatscript.app/ontology/variant/trap-kick-b"},{"@id":"https://beatscript.app/ontology/variant/trap-kick-c"},{"@id":"https://beatscript.app/ontology/variant/trap-snare-b"},{"@id":"https://beatscript.app/ontology/variant/trap-snare-c"}],"https://beatscript.app/ontology/ns#hasProgression":[{"@id":"https://beatscript.app/ontology/progression/trap-1"},{"@id":"https://beatscript.app/ontology/progression/trap-2"}],"https://beatscript.app/ontology/ns#hihatRhythm":[{"@id":"https://beatscript.app/ontology/rhythm/trap-hihat"}],"https://beatscript.app/ontology/ns#humanize":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"8"}],"https://beatscript.app/ontology/ns#inFamily":[{"@id":"https://beatscript.app/ontology/family/edm"}],"https://beatscript.app/ontology/ns#kickRhythm":[{"@id":"https://beatscript.app/ontology/rhythm/trap-kick"}],"https://beatscript.app/ontology/ns#maxBpm":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"170"}],"https://beatscript.app/ontology/ns#melodyDensity":[{"@type":"http://www.w3.org/2001/XMLSchema#decimal","@value":"0.35"}],"https://beatscript.app/ontology/ns#melodyDuration":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"120"}],"https://beatscript.app/ontology/ns#minBpm":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"130"}],"https://beatscript.app/ontology/ns#rootNote":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"38"}],"https://beatscript.app/ontology/ns#snareRhythm":[{"@id":"https://beatscript.app/ontology/rhythm/trap-snare"}],"https://beatscript.app/ontology/ns#swing":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"10"}],"https://beatscript.app/ontology/ns#syncopation":[{"@type":"http://www.w3.org/2001/XMLSchema#decimal","@value":"0.3"}],"https://beatscript.app/ontology/ns#tensionCurve":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#typicalArp":[{"@id":"https://beatscript.app/ontology/instrument/pluck"}],"https://beatscript.app/ontology/ns#typicalBass":[{"@id":"https://beatscript.app/ontology/instrument/sub-bass"}],"https://beatscript.app/ontology/ns#typicalKit":[{"@id":"https://beatscript.app/ontology/instrument/drums-808"}],"https://beatscript.app/ontology/ns#typicalMelody":[{"@id":"https://beatscript.app/ontology/instrument/fm-bell"}]},{"@id":"https://beatscript.app/ontology/groove/bossa","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Groove"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"bossa"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A syncopated ostinato alternating the root and the low fifth, the bossa nova bass figure."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/groove/bossa"}]},{"@id":"https://beatscript.app/ontology/groove/breakbeat","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Groove"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"breakbeat"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The bass plays about three eighths of the steps, evenly spread and randomly rotated, independent of the kick."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/groove/breakbeat"}]},{"@id":"https://beatscript.app/ontology/groove/four-on-floor","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Groove"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"four on floor"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The bass plays exactly where the kick plays."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/groove/four-on-floor"}]},{"@id":"https://beatscript.app/ontology/groove/offbeat","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Groove"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"offbeat"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The bass plays one step before each kick, in the gap the kick leaves."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/groove/offbeat"}]},{"@id":"https://beatscript.app/ontology/groove/sidechained","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Groove"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"sidechained"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The bass plays wherever the kick does not, so the two never sound together."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/groove/sidechained"}]},{"@id":"https://beatscript.app/ontology/groove/syncopated-pocket","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Groove"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"syncopated pocket"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The bass follows the kick and adds two off-beat hits, on steps 6 and 14 of a sixteen-step bar (3 and 7 of eight)."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/groove/syncopated-pocket"}]},{"@id":"https://beatscript.app/ontology/groove/walking","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Groove"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"walking"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A steady quarter-note bass line that walks through the chord tones, independent of the kick."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/groove/walking"}]},{"@id":"https://beatscript.app/ontology/instrument/808-bass","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#BeatScriptVoice"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The BeatScript voice 808-bass, written inst=808-bass."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"808-bass"}],"https://beatscript.app/ontology/ns#inVoiceFamily":[{"@id":"https://beatscript.app/ontology/concept/voice-family-808"},{"@id":"https://beatscript.app/ontology/concept/voice-family-bass"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"inst=808-bass"}]},{"@id":"https://beatscript.app/ontology/instrument/acid-square","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#BeatScriptVoice"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The BeatScript voice acid-square, written inst=acid-square."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"acid-square"}],"https://beatscript.app/ontology/ns#inVoiceFamily":[{"@id":"https://beatscript.app/ontology/concept/voice-family-acid"},{"@id":"https://beatscript.app/ontology/concept/voice-family-square"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"inst=acid-square"}]},{"@id":"https://beatscript.app/ontology/instrument/acid","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#BeatScriptVoice"},{"@id":"https://beatscript.app/ontology/ns#Instrument"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"acid"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A resonant filtered sawtooth bass of the acid-house kind."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"http