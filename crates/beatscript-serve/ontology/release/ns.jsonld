@value":"tri"}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"tri"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/keyword-under","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The keyword under of BeatScript, written in: duck."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"under"}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"under"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/keyword-unmute","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The keyword unmute of BeatScript, written in: action."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"unmute"}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"unmute"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/keyword-until","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The keyword until of BeatScript, written in: set_next, set_play."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"until"}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"until"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/keyword-use","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The keyword use of BeatScript, written in: use."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"use"}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"use"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/keyword-vel","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The keyword vel of BeatScript, written in: pname."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"vel"}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"vel"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/keyword-vocoder-handoff","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The keyword vocoder_handoff of BeatScript, written in: MOVE."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"vocoder_handoff"}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"vocoder_handoff"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/keyword-voice-lead","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The keyword voice-lead of BeatScript, written in: param."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"voice-lead"}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"voice-lead"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/keyword-voice-param","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The keyword voice= of BeatScript, written in: sing."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"voice="}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"voice="}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/keyword-weights","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The keyword weights of BeatScript, written in: choose."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"weights"}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"weights"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/keyword-when","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The keyword when of BeatScript, written in: bound, cguard, guard, rule."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"when"}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"when"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/keyword-wire","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The keyword wire of BeatScript, written in: wire."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"wire"}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"wire"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/keyword-with","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The keyword with of BeatScript, written in: engine, set_mix."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"with"}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"with"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/keyword-x","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#Keyword"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The keyword x of BeatScript, written in: atom, dterm."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"x"}],"https://beatscript.app/ontology/ns#keywordText":[{"@value":"x"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/license-all-rights-reserved","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#License"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"No licence is granted beyond what the law allows by default."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"all rights reserved"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/license-all-rights-reserved"}],"https://beatscript.app/ontology/ns#isDefaultLicense":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/license-cc-by-4-0","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#License"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"https://creativecommons.org/licenses/by/4.0/"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Creative Commons Attribution 4.0: anyone may reuse the track if they credit the author."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"CC-BY-4.0"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/license-cc-by-4-0"}],"https://beatscript.app/ontology/ns#isDefaultLicense":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"false"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/license-cc0-1-0","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#License"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"https://creativecommons.org/publicdomain/zero/1.0/"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Creative Commons Zero 1.0: the author dedicates the track to the public domain. The default for a new track."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"CC0-1.0"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/license-cc0-1-0"}],"https://beatscript.app/ontology/ns#isDefaultLicense":[{"@type":"http://www.w3.org/2001/XMLSchema#boolean","@value":"true"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/markov-melody","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A melody made by a chain in which the next scale degree depends on the current one and the position in the bar: strong beats land on the nearest chord tone, weak beats move by step or repeat. A density setting then turns the weakest-beat notes into rests, never the first step."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"Markov melody"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/markov-melody"}]},{"@id":"https://beatscript.app/ontology/concept/modifier-accent","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternModifier"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A term written c2! is accented: played louder than its neighbours."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"accent (!)"}],"https://beatscript.app/ontology/ns#markedBy":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-bang"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"!"}]},{"@id":"https://beatscript.app/ontology/concept/modifier-chance","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternModifier"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A term written x?p plays with probability p (0 to 1, or a percent), drawn from the program's seed so the same program always plays the same."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"chance (?p)"}],"https://beatscript.app/ontology/ns#markedBy":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-question"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"?"}]},{"@id":"https://beatscript.app/ontology/concept/modifier-cycle","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternModifier"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A part written hihat/12 has a cycle of n sixteenths instead of 16, so it drifts against the bar."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"cycle length (/n)"}],"https://beatscript.app/ontology/ns#markedBy":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-slash"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"/"}]},{"@id":"https://beatscript.app/ontology/concept/modifier-repeat","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternModifier"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A term written x*n plays n times in the time of one slot: hihat x*4 is four hits in one step."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"repeat (*n)"}],"https://beatscript.app/ontology/ns#markedBy":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-star"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"*"}]},{"@id":"https://beatscript.app/ontology/concept/modifier-slide","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PatternModifier"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A term written e2^ slides into the next note instead of re-attacking, as on an acid bass line."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"slide (^)"}],"https://beatscript.app/ontology/ns#markedBy":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-caret"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"^"}]},{"@id":"https://beatscript.app/ontology/concept/monoidal-product","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#CategoricalConcept"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Stacking parts side by side: two parts played together make one part whose net is the disjoint union of the two. Written with the tensor sign. Associative and symmetric: the order parts are listed in does not change what plays."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"monoidal product"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/monoidal-product"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/concept/move-bass-swap","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PerformMove"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Cut the outgoing deck's low end and bring in the incoming deck's, so two basslines never sound together."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"bass swap"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/move-bass-swap"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/move-echo-out","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PerformMove"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Feed the outgoing deck into a delay and cut the dry signal, leaving the echoes to trail away."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"echo out"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/move-echo-out"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/move-filter-exit","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PerformMove"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Close a filter on the outgoing deck until it fades out of the mix."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"filter exit"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/move-filter-exit"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/move-loop-roll","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PerformMove"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Repeat ever shorter slices of the playing audio to build tension."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"loop roll"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/move-loop-roll"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/move-phrase-sync","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PerformMove"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Line the incoming deck up so its phrase starts on the outgoing deck's phrase boundary."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"phrase sync"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/move-phrase-sync"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/move-vocoder-handoff","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#PerformMove"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"Pass the carrier role of a vocoder from one deck to the other so a voice carries across the change."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"vocoder handoff"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/concept/move-vocoder-handoff"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-every-nth-pass","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#LanguageTerm"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"An arrange mutation written ~N target op (or @N target op) fires only on every Nth pass of its arrange block, on passes N, 2N, 3N and so on counted from 1; with no count it fires on every pass."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"mutation count (~N, @N)"}],"https://beatscript.app/ontology/ns#markedBy":[{"@id":"https://beatscript.app/ontology/concept/token-int"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"~N"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-from-here","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#LanguageTerm"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"An arrange mutation written ~target op applies from that point of the arrangement to its end."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"mutation from here on (~)"}],"https://beatscript.app/ontology/ns#markedBy":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-tilde"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"~"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-next-section","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#LanguageTerm"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"An arrange mutation written @target op applies to the next section only."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"mutation for one section (@)"}],"https://beatscript.app/ontology/ns#markedBy":[{"@id":"https://beatscript.app/ontology/concept/keyword-symbol-at"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"@"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-accent","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator accent."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"accent"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"accent"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-decay","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator decay."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"decay"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"decay"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-double","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator double."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"double"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"double"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-down","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator down."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"down"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"down"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-drift","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator drift."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"drift"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"drift"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-euclid","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator euclid."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"euclid"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"euclid"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-fill","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator fill."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"fill"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"fill"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-grow","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator grow."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"grow"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"grow"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-half","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator half."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"half"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"half"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-invert","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator invert."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"invert"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"invert"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-jux","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator jux."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"jux"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"jux"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-mask","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator mask."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"mask"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"mask"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-mirror","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator mirror."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"mirror"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"mirror"}]},{"@id":"https://beatscript.app/ontology/concept/mutation-op-morph","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"},{"@id":"https://beatscript.app/ontology/ns#MutationOperator"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The arrange mutation operator morph."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"morph"}],"https://beatscript.