r-ooh","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#BeatScriptVoice"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The BeatScript voice voice-choir-ooh, written inst=voice-choir-ooh."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"voice-choir-ooh"}],"https://beatscript.app/ontology/ns#inVoiceFamily":[{"@id":"https://beatscript.app/ontology/concept/voice-family-choir"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"inst=voice-choir-ooh"}]},{"@id":"https://beatscript.app/ontology/instrument/voice-robot-choir","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#BeatScriptVoice"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The BeatScript voice voice-robot-choir, written inst=voice-robot-choir."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"voice-robot-choir"}],"https://beatscript.app/ontology/ns#inVoiceFamily":[{"@id":"https://beatscript.app/ontology/concept/voice-family-choir"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"inst=voice-robot-choir"}]},{"@id":"https://beatscript.app/ontology/instrument/voice-robot","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#BeatScriptVoice"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The BeatScript voice voice-robot, written inst=voice-robot."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"voice-robot"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"inst=voice-robot"}]},{"@id":"https://beatscript.app/ontology/instrument/voice-soprano","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#BeatScriptVoice"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The BeatScript voice voice-soprano, written inst=voice-soprano."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"voice-soprano"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"inst=voice-soprano"}]},{"@id":"https://beatscript.app/ontology/instrument/voice-talkbox","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#BeatScriptVoice"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The BeatScript voice voice-talkbox, written inst=voice-talkbox."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"voice-talkbox"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"inst=voice-talkbox"}]},{"@id":"https://beatscript.app/ontology/instrument/warm-pad","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#BeatScriptVoice"},{"@id":"https://beatscript.app/ontology/ns#Instrument"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"warm-pad"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A slow, soft sustained pad."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/instrument/warm-pad"}],"https://beatscript.app/ontology/ns#inVoiceFamily":[{"@id":"https://beatscript.app/ontology/concept/voice-family-pad"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"inst=warm-pad"}]},{"@id":"https://beatscript.app/ontology/instrument/wobble-bass","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#Instrument"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"wobble-bass"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"A bass whose filter is modulated at a steady rate, giving the dubstep wobble."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/instrument/wobble-bass"}]},{"@id":"https://beatscript.app/ontology/instrument/wobble-lead","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://beatscript.app/ontology/ns#BeatScriptVoice"}],"http://www.w3.org/2004/02/skos/core#definition":[{"@language":"en","@value":"The BeatScript voice wobble-lead, written inst=wobble-lead."}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@language":"en","@value":"wobble-lead"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}],"https://beatscript.app/ontology/ns#writtenAs":[{"@value":"inst=wobble-lead"}]},{"@id":"https://beatscript.app/ontology/ns#ABPair","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Two complementary loops: the call and the answer, in the same key and at the same tempo, so either can follow the other."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"A/B pair"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/concept/call-and-response"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ABPair"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#AlternationTerm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Terms taken in turn, one per pass through the pattern."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"alternation"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#PatternTerm"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#AlternationTerm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#Analysis","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A step that reads audio and reports facts about it: beats, key, stems."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"audio analysis"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Analysis"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#ArpTerm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A chord's notes played one after another across the step."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"arp term"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#PatternTerm"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ArpTerm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#ArrangeLine","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Orders section blocks in time. Read categorically, it is sequential composition."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"arrange line"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#ProgramLine"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ArrangeLine"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/sequential-composition"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#AudioEffect","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Something that changes a deck's sound as it plays."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"audio effect"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#AudioEffect"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#AuthorSignature","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A signature by the author over the program's CID, proving who sealed the link."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"author signature"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://ontology.pflow.xyz/ns#signature"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#AuthorSignature"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#Batch","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Several control commands sent as one, applied together."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"batch"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Batch"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#BeatGrid","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The positions of beats and downbeats in an audio file, found by a neural network (Beat This!)."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"beat grid"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#Analysis"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#BeatGrid"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#BeatScriptVoice","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A voice a BeatScript part may name with inst=NAME: what /api/instruments lists."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"BeatScript voice"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#Instrument"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#CanonicalForm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The normal form of a BeatScript program: whitespace, numbers, note spelling and comments are normalised, so two spellings of one program have one canonical text and therefore one CID. A BeatScript 2 canonical text begins with its version line, #! beatscript 2; a BeatScript 1 canonical text has no #! line, so the first line alone tells the version."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"canonical form"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#CanonicalForm"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/normal-form"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#CategoricalConcept","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A notion from category theory used to read how decks, parts and sections compose."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"categorical concept"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#CategoricalConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#ChordProgression","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A cycle of chords named by the scale degree of their root."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Chord progression"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ChordProgression"}]},{"@id":"https://beatscript.app/ontology/ns#ChordTerm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Several notes sounded together on one step."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"chord term"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#PatternTerm"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ChordTerm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#ContentId","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A name derived from the bytes it names (a CID): the same content always has the same identifier."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"content identifier"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://ontology.pflow.xyz/ns#modelCID"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/2004/02/skos/core#scopeNote":[{"@language":"en","@value":"pflow's modelCID is the content identifier of a net model; ProgramCID and NetCID are the same kind of name for a BeatScript program and for the net a deck runs."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ContentId"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#ControlLanguage","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The app's text command language: every control is a noun (what) and a verb (do what). One verb, describe, tells a user what a noun can do."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"control language"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ControlLanguage"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#ControlLine","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A line that sets something about the deck rather than playing notes: tempo, key, a level."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"control line"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#ProgramLine"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ControlLine"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#ControlNet","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A linear net that fires mute and unmute actions at section boundaries, which is how a song structure plays out."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Control net"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://ontology.pflow.xyz/ns#PetriNet"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#EngineNet"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"https://ontology.pflow.xyz/ns#PetriNet"}],"http://www.w3.org/2004/02/skos/core#scopeNote":[{"@language":"en","@value":"A control net is a linear workflow: its transitions fire once, in order."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ControlNet"}]},{"@id":"https://beatscript.app/ontology/ns#ControlNoun","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The thing a control command acts on: a deck, a fader, an effect."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"control noun"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ControlNoun"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#ControlVerb","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"What a control command does to its noun."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"control verb"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ControlVerb"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#Credit","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"An acknowledgement of someone whose work a track uses, such as a sample or a forked program's author."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"credit"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Credit"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#Deck","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One playback channel of the DJ app. Each deck runs a Petri net compiled from a program."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"deck"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Deck"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/free-smc"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#DjConcept","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Root of the things a DJ app has: collections of loops, set planning, performance moves, effects, analysis and the control language."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"DJ concept"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#DjConcept"}]},{"@id":"https://beatscript.app/ontology/ns#DoLine","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Runs one verb of the control language, so a program can reach any control the app has without a dedicated syntax for it."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"do line"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#ProgramLine"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#DoLine"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#DrumKit","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A set of drum sounds a part may name with kit=NAME."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"drum kit"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#Instrument"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#DrumVariant","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A named alteration (B, C) of a genre's base drum rhythm: add pulses, scale them, rotate."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Drum variant"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#DrumVariant"}]},{"@id":"https://beatscript.app/ontology/ns#Ending","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"What happens when a program's last section finishes: it ends, or it loops back to the start."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"ending"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Ending"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#EngineConcept","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A concept from the generator or sequencer that is not itself a genre property: the Bjorklund algorithm, Markov melody, swing and so on."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Engine concept"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#EngineConcept"}]},{"@id":"https://beatscript.app/ontology/ns#EngineNet","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A Petri net the sequencer executes to make sound."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Engine net"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"https://ontology.pflow.xyz/ns#PetriNet"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#EngineNet"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/free-smc"}]},{"@id":"https://beatscript.app/ontology/ns#EuclidTerm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"K hits spread evenly over N steps, as a Euclidean rhythm."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"euclid term"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://beatscript.app/ontology/ns#EuclideanRhythm"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#PatternTerm"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#EuclidTerm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#EuclideanRhythm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"K pulses spread as evenly as possible over N steps, then rotated."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Euclidean rhythm"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#EuclideanRhythm"}]},{"@id":"https://beatscript.app/ontology/ns#EvolveOperator","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"An operation an evolve block applies to a part every N bars, generation after generation."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"evolve operator"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#PatternTransform"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#Feel","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"How a line's syllables sit on the grid: on the sixteenths, or in groups of three."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"feel"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#Fork","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A track made by changing another track. It names what it was forked from, and so its credits and licence trace back."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"fork"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#TrackObject"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Fork"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#Form","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A shape for a whole track from classical music: its sections, the order they come in, and the plan of arrange mutations that changes them pass after pass. Each is a template built from public-domain themes (docs/forms)."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"form"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#FormantVoice","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A synthesised voice built from formants, the resonances that make vowels. It can sing a vocal line with no recorded voice involved."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"formant voice"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#FormantVoice"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#Freeze","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A granular effect that holds one moment of a deck's sound and stretches it into a sustained texture."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"freeze"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#AudioEffect"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Freeze"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#Genre","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A style the sequencer can generate a whole track in. Each carries the defaults that make it recognisable: tempo, scale, drum rhythms, groove, feel."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Genre"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Genre"}]},{"@id":"https://beatscript.app/ontology/ns#GenreFamily","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A group of genres that share song structures and section energy: edm, song, jazz, chill."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Genre family"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#GenreFamily"}]},{"@id":"https://beatscript.app/ontology/ns#GrammarProduction","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One production of BeatScript's grammar (grammar.ebnf, ISO 14977 EBNF; beatscript.app/docs/language). Its ns:ebnf is the right-hand side as written."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"grammar production"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#LanguageTerm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#Groove","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"How the bass line locks to the drums."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Groove"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Groove"}]},{"@id":"https://beatscript.app/ontology/ns#GroupTerm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Several terms squeezed into the time of one step."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"group"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#PatternTerm"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#GroupTerm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#HistoryBuffer","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A rolling memory of the last seconds a deck played. Capture-to-loop cuts a loop out of it after the fact."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"history buffer"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#HistoryBuffer"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#HitTerm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A step that sounds."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"hit"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#PatternTerm"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#HitTerm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#ImportLine","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Brings in another program by CID. Pinning by content identifier means the imported text can never change under the importer."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"import line"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#ProgramLine"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ImportLine"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/open-net-cospan"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#InsertEffect","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"An effect placed in a deck's signal path, so all of the deck's sound passes through it."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"insert effect"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#AudioEffect"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#InsertEffect"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#Instrument","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A named sound the synth engine can play."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Instrument"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Instrument"}]},{"@id":"https://beatscript.app/ontology/ns#InstrumentRole","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The job a track does in the mix: kick, snare, hihat, clap, bass, melody, harmony, arp."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Instrument role"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#InstrumentRole"}]},{"@id":"https://beatscript.app/ontology/ns#KeyDetection","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Finds the musical key of audio and reports it as a Camelot code, which says which keys mix well together."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"key detection"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#Analysis"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#KeyDetection"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#Keyword","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A terminal of BeatScript's grammar: a word or a symbol written as it is."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"keyword"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#LanguageTerm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#LanguageTerm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A piece of the BeatScript language as its grammar states it: a production, a keyword or a token class."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"BeatScript language term"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#LanguageVersion","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One version of a language: the version line that says a text is in it, how its programs are canonicalized and what their CIDs are the CIDs of. A later version is prov:wasRevisionOf the one before it, and a program written in the earlier one keeps its meaning and its CID."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"language version"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#ProgrammingLanguage"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#LetLine","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Binds a name to a value or pattern for use further down the program."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"let line"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#ProgramLine"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#LetLine"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#License","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The terms a track is shared under."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"licence"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#License"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#Loop","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A short stretch of music that repeats cleanly."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"loop"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Loop"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#LoopSet","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A collection of loops, either curated by hand or generated from a seed."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"loop set"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#LoopSet"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#MacroDefinition","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A parameterised macro. It is total: a macro cannot call itself, directly or through others, so expansion always ends. Repetition is written repeat N."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"def (macro definition)"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#ProgramLine"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#MacroDefinition"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/open-net-cospan"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#Mashup","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Stems of different tracks played together, matched in key and tempo."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"mashup"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Mashup"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#McpServer","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A Model Context Protocol server: tools an AI assistant such as Claude can call to use a product."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"MCP server"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#Product"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#McpTool","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One tool of an MCP server: its name, description and input schema, as the server's tools/list gives them."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"MCP tool"}],"http://www.w3.org/2002/07/owl#disjointWith":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"},{"@id":"https://beatscript.app/ontology/ns#Product"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#MelodyRing","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The same ring, with a note binding on every non-rest step: a melody, bass line or arpeggio written out as a cycle."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Melody ring"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#EngineNet"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"https://ontology.pflow.xyz/ns#PetriNet"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#MelodyRing"}]},{"@id":"https://beatscript.app/ontology/ns#MeterFamily","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A kind of line, by how its stresses fall: the closed set a phrasebook entry is filed under."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"meter family"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#MusicConcept","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Root of everything this ontology describes about music."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Music concept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#MusicConcept"}]},{"@id":"https://beatscript.app/ontology/ns#MutationOperator","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"An operator of an arrange mutation: it changes a let pattern from one point of the arrangement (~) or for one section (@)."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"arrange mutation operator"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#PatternTransform"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#NetCID","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The content identifier of the Petri net one deck runs, in pflow's canonical net form. Two decks with equal nets have equal NetCIDs whatever program produced them."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"net CID"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://ontology.pflow.xyz/ns#modelCID"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#ContentId"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#NetCID"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#NotesSegment","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Free text riding on a share link outside the seal. Editing it does not change the program's CID."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"notes segment"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#NotesSegment"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#Palette","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A named set of sounds a program can choose as a whole."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"palette"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#PartLine","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A line that names a part (drums, bass, lead) and gives it a pattern of terms to play."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"part line"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#ProgramLine"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#PartLine"}],"https://beatscript.app/ontology/ns#categoricalReading":[{"@id":"https://beatscript.app/ontology/concept/monoidal-product"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#PatternGenerator","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A call that makes a pattern from its arguments, such as e(5,8), markov(0.6), chord(am) or choose."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"pattern generator"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#PatternTerm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#PatternModifier","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A mark written after a term or part that changes how it plays: repeat, chance, accent, slide, cycle length."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"pattern modifier"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#PatternTerm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#PatternTerm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One element of a part's pattern."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"pattern term"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#PatternTerm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#PatternTransform","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A function from patterns to patterns, such as transpose or reverse. Transforms compose and have an identity, so they form a monoid."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"pattern transform"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#EngineConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#PatternTransform"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#PerformMove","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A gesture the app carries out for the DJ: a timed change to one or both decks."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"perform move"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#PerformMove"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#PhraseTemplate","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A template that compiles a phrase to a whole track: arrange from template(NAME, PHRASE). The phrase is the vocal line (its syllables the line's length, its stress the accents and the beats, its meter the subdivision); the arrangement is the template's own."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"phrase template"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#Phrasebook","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A curated set of phrases a program sings by id: sing @id on melody. The public-domain one is lines of verse, scripture, speech and work song first published before 1929, as a CC0 file with one CID."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"phrasebook"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#PhrasebookEntry","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One line of a phrasebook: its words, the lyric BeatScript sings them as, where and when it was first published, and its meter as a step pattern."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"phrasebook entry"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#Product","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Something shipped under a name: a website, a language, an app or an MCP server."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"product"}],"http://www.w3.org/2002/07/owl#disjointWith":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#ProductFamily","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One name shared by several products that are used together."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"product family"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#Product"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#Program","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A piece written in BeatScript: lines of text that compile to the Petri nets of a DJ deck. Identified by the CID of its canonical text, so a BeatScript 1 program and its upgrade to BeatScript 2, which play the same, are two programs: the upgrade is prov:wasRevisionOf the original, and each has its own ns:programCid and ns:inLanguageVersion."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"BeatScript program"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"https://ontology.pflow.xyz/ns#PetriNet"}],"http://www.w3.org/2004/02/skos/core#hiddenLabel":[{"@language":"en","@value":"btw program"}],"http://www.w3.org/2004/02/skos/core#historyNote":[{"@language":"en","@value":"Before language version 2 (2026-11-22) the language was called btw, and a program was a btw program."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Program"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#ProgramCID","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The content identifier of a program's canonical text."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"program CID"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#ContentId"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ProgramCID"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#ProgramLine","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One line of a BeatScript program. The kind of line says what it declares."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"program line"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ProgramLine"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#ProgrammingLanguage","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A text language whose documents are programs a product runs. Its versions (ns:LanguageVersion) are in the generated vocabulary, from the code that reads them."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"programming language"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#Product"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#Queue","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The segments waiting to play next on a deck."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"queue"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Queue"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#RestTerm","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A step that is silent."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"rest"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#PatternTerm"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#RestTerm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#RhythmRing","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"N places in a cycle, one token circulating, one transition per step; transitions at pulse positions carry a note binding, the rest are silent. Realises a Euclidean rhythm."},{"@language":"en","@value":"Realised as a cycle of places and transitions with one token; the cycle makes it a state machine in pflow's terms."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Rhythm ring"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://ontology.pflow.xyz/ns#PetriNet"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#EngineNet"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"https://ontology.pflow.xyz/ns#PetriNet"}],"http://www.w3.org/2004/02/skos/core#scopeNote":[{"@language":"en","@value":"A rhythm ring is a state machine in pflow's sense: every transition has one input place and one output place, and the net holds exactly one token."}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#RhythmRing"}]},{"@id":"https://beatscript.app/ontology/ns#Scale","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A set of pitch-class offsets in semitones from a root."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Scale"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Scale"}]},{"@id":"https://beatscript.app/ontology/ns#SectionBlock","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A named group of lines that plays as one section of the piece. Unrelated to ns:SongSection, which is a genre-level template slot; a section block is whatever the author wrote."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"section block"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#ProgramLine"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#SectionBlock"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#SectionProfile","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"What a section means in one family: which roles play and how much energy it carries."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Section profile"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#SectionProfile"}]},{"@id":"https://beatscript.app/ontology/ns#SectionSlot","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One numbered place in a song structure, filled by a section."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Section slot"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#SectionSlot"}]},{"@id":"https://beatscript.app/ontology/ns#Segment","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One stretch of a set list: a track or loop and how long it plays."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"segment"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Segment"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#SetList","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A plan for a DJ set: an ordered list of segments."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"set list"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#SetList"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#SetRecording","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A recording of a performed set, identified by a CID over its tracklist."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"set recording"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#SetRecording"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#ShareLink","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A URL that carries a whole track in itself: the program's CID and its deflated canonical text sit in the fragment, so opening the link needs no server lookup and the text can be checked against the CID. May include an author signature, and an unsealed notes segment that is not covered by the seal."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"share link"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#ShareLink"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#SongSection","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A named stretch of a song: intro, verse, drop and so on."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Song section"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#SongSection"}]},{"@id":"https://beatscript.app/ontology/ns#SongStructure","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"An ordered template of sections for one genre family and length class."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Song structure"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#SongStructure"}]},{"@id":"https://beatscript.app/ontology/ns#Stem","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One separated part of a mix."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"stem"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Stem"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#StemSeparation","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Splits a mix into stems (drums, bass, vocals, other) with a port of the Demucs model."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"stem separation"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#Analysis"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#StemSeparation"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#Technique","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A way of writing music that a person or an agent can follow, taught by one document and used through the language's own words."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"composition technique"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#ThemeEntry","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One theme of a theme library: its bars in a stated key, its role, meter, source work, composer and year, and the themes it pairs with."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"theme"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#ThemeLibrary","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A curated set of melodies, basses and figures written as BeatScript bars to borrow. The public-domain one is music composed and first published before 1929, written from the melody itself, as a CC0 file with one CID: the melodic twin of the phrasebook."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"theme library"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#ThemeMode","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Whether a theme is in a major key, a minor key, or neither (a pedal or an ostinato)."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"theme mode"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#ThemeRole","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The part a theme is written for: melody, bass, harmony or arp."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"theme role"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#TimingWord","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A phrase that says when a change happens: at a bar, on the next phrase, every N bars, for N bars, or as a ramp."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"timing word"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#TimingWord"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#TokenClass","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A kind of token the lexer recognises, such as NAME, INT or NOTE: named in the grammar, defined by the lexer."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"token class"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#LanguageTerm"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#TrackObject","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A published track: a program plus the rights and provenance that go with it."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"track object"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#TrackObject"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#Visibility","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Whether a track is listed for anyone or only for those with its link."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"visibility"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Visibility"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#VocalLine","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Typed lyrics turned into phonemes and notes for a formant voice to sing. The phoneme path uses CC0 data only."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"vocal line"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#VocalLine"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#Vocoder","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"An effect that imposes the spectral shape of one signal (the modulator, usually a voice) onto another (the carrier, usually a synth or a deck)."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"vocoder"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#AudioEffect"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#Vocoder"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#VocoderInput","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A signal fed into a vocoder, as modulator or as carrier."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"vocoder input"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#VocoderInput"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#VocoderInstance","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One running copy of a vocoder, with its own modulator, carrier and settings."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"vocoder instance"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#DjConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#VocoderInstance"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#VoiceFamily","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A family word: an inst= name that contains it plays the family's generic voice."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"voice family"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#acceptsVerb","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"accepts verb"}],"http://www.w3.org/2002/07/owl#inverseOf":[{"@id":"https://beatscript.app/ontology/ns#actsOn"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#activeRole","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#SectionProfile"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"active role"}],"http://