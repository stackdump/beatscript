0/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#canonicalText"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#capturesLoop","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#HistoryBuffer"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"captures loop"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"https://beatscript.app/ontology/ns#Loop"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#capturesLoop"}]},{"@id":"https://beatscript.app/ontology/ns#categoricalReading","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The notion from category theory that this construct is an instance of."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#MusicConcept"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"categorical reading"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"https://beatscript.app/ontology/ns#CategoricalConcept"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#categoricalReading"}],"https://beatscript.app/ontology/ns#status":[{"@value":"in-development"}]},{"@id":"https://beatscript.app/ontology/ns#chordCount","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#ChordProgression"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"chord count"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#chordCount"}]},{"@id":"https://beatscript.app/ontology/ns#collectionKind","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"\"curated\" (picked by hand) or \"seeded\" (generated from a seed)."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#LoopSet"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"collection kind"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://ontology.bitwrap.io/ns#collectionKind"}]},{"@id":"https://beatscript.app/ontology/ns#controlParameter","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#ControlNoun"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"control parameter"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"https://beatscript.app/ontology/ns#status":[{"@value":"stable"}]},{"@id":"https://beatscript.app/ontology/ns#currentVersion","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#FunctionalProperty"},{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The version new text is written in: what fmt upgrades a program to and what the generators write."}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://beatscript.app/ontology/ns#ProgrammingLanguage"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"e