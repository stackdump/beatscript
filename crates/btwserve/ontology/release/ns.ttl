	ns:writtenAs "type" .
<https://beatscript.app/ontology/concept/grammar-unary> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The unary production of BeatScript's grammar."@en ;
	skos:prefLabel "unary"@en ;
	ns:ebnf "[ \"-\" ] primary" ;
	ns:grammarSection "Arithmetic and guards"@en ;
	ns:status "stable" ;
