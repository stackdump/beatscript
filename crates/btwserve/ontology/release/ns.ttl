	ns:usesToken <https://beatscript.app/ontology/concept/token-decimal> ;
	ns:writtenAs "time" .
<https://beatscript.app/ontology/concept/grammar-timing> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The timing production of BeatScript's grammar."@en ;
	skos:prefLabel "timing"@en ;
