	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-port> ;
	ns:usesToken <https://beatscript.app/ontology/concept/token-name> ;
	ns:writtenAs "wire" .
<https://beatscript.app/ontology/concept/insert-crush> a skos:Concept , ns:InsertEffect ;
	skos:definition "Lowers the bit depth and sample rate for a gritty, digital sound."@en ;
