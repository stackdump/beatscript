<https://beatscript.app/ontology/concept/grammar-part> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The part production of BeatScript's grammar (hihat/12 x x ~ x : a cycle of 12 sixteenths; bass seed(techno, 42)[17..24]: a generated part's bars; bass <cid>.drop: a stored program's)."@en ;
	skos:prefLabel "part"@en ;
