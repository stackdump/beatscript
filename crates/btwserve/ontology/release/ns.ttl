ns:usesProduction a owl:ObjectProperty ;
	rdfs:domain ns:GrammarProduction ;
	rdfs:label "uses production"@en ;
	rdfs:range ns:GrammarProduction ;
	ns:status "stable" .
ns:usesStem a owl:ObjectProperty ;
	rdfs:domain ns:Mashup ;
	rdfs:label "uses stem"@en ;
	rdfs:range ns:Stem ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#usesStem> .
ns:usesTechnique a owl:ObjectProperty ;
	rdfs:comment "A composition technique the form is written with (found phrases: the vocal line)."@en ;
	rdfs:domain ns:Form ;
	rdfs:label "uses technique"@en ;
	rdfs:range ns:Technique ;
	ns:status "stable" .
ns:usesTerm a owl:ObjectProperty ;
