<https://beatscript.app/ontology/concept/pattern-endofunctor> a skos:Concept , ns:CategoricalConcept ;
	skos:definition "Pattern as a functor from notes to notes: a function on single notes lifts to a function on patterns of them, and lifting respects composition and identity."@en ;
	skos:prefLabel "Pattern endofunctor"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/pattern-endofunctor> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/phrasebook-family-anapestic> a skos:Concept , ns:MeterFamily ;
	skos:definition "Two unstressed syllables then a stressed one, so it rolls in threes: Byron's Sennacherib and Lear's nonsense."@en ;
	skos:prefLabel "anapestic"@en ;
	ns:status "stable" ;
	ns:suitsGenre <https://beatscript.app/ontology/genre/dnb> , <https://beatscript.app/ontology/genre/garage> ;
	ns:suitsGroove "wants a triplet feel: drum and bass, breakbeat" ;
	ns:writtenAs "anapestic" .
<https://beatscript.app/ontology/concept/phrasebook-family-call-and-response> a skos:Concept , ns:MeterFamily ;
	skos:definition "A work song: the leader sings a line and the crew answers; the stresses are the heaves, the pulls on the rope."@en ;
	skos:prefLabel "call and response"@en ;
	ns:status "stable" ;
	ns:suitsGroove "call and response: the leader's syllables, then the crew's" ;
	ns:writtenAs "call-and-response" .
<https://beatscript.app/ontology/concept/phrasebook-family-common-meter> a skos:Concept , ns:MeterFamily ;
	skos:definition "The hymn and ballad stanza: a line of four beats, then a line of three (eight syllables, then six)."@en ;
	skos:prefLabel "common meter"@en ;
	ns:status "stable" ;
	ns:suitsGroove "its 8-6-8-6 fills a 16-bar section, a line to a four-bar phrase" ;
	ns:writtenAs "common-meter" .
<https://beatscript.app/ontology/concept/phrasebook-family-dactylic> a skos:Concept , ns:MeterFamily ;
	skos:definition "A stressed syllable then two unstressed ones, also in threes: the long line of Evangeline."@en ;
	skos:prefLabel "dactylic"@en ;
	ns:status "stable" ;
	ns:suitsGenre <https://beatscript.app/ontology/genre/dnb> , <https://beatscript.app/ontology/genre/garage> ;
	ns:suitsGroove "wants a triplet feel: drum and bass, breakbeat" ;
	ns:writtenAs "dactylic" .
<https://beatscript.app/ontology/concept/phrasebook-family-iambic> a skos:Concept , ns:MeterFamily ;
	skos:definition "Lines of ten syllables (eleven with a feminine ending) in pairs, unstressed then stressed: the beat of blank verse and the sonnet."@en ;
	skos:prefLabel "iambic pentameter"@en ;
	ns:status "stable" ;
	ns:suitsGenre <https://beatscript.app/ontology/genre/house> ;
	ns:suitsGroove "lilts on the offbeat: house" ;
	ns:writtenAs "iambic" .
<https://beatscript.app/ontology/concept/phrasebook-family-nursery> a skos:Concept , ns:MeterFamily ;
	skos:definition "Two or three strong beats a line with any number of weak syllables between: a rhyme said aloud."@en ;
	skos:prefLabel "nursery rhyme"@en ;
	ns:status "stable" ;
	ns:suitsGenre <https://beatscript.app/ontology/genre/garage> , <https://beatscript.app/ontology/genre/lofi> ;
	ns:suitsGroove "a clapping or lullaby dimeter: a triplet shuffle, or sparse" ;
	ns:writtenAs "nursery" .
<https://beatscript.app/ontology/concept/phrasebook-family-oratory> a skos:Concept , ns:MeterFamily ;
	skos:definition "Speech: no fixed foot, the stresses of the sentence, built in threes and answering clauses."@en ;
	skos:prefLabel "oratory"@en ;
	ns:status "stable" ;
	ns:suitsGenre <https://beatscript.app/ontology/genre/ambient> ;
	ns:suitsGroove "speech as rhythm: a sparse spot section, not a groove" ;
	ns:writtenAs "oratory" .
<https://beatscript.app/ontology/concept/phrasebook-family-parallelism> a skos:Concept , ns:MeterFamily ;
	skos:definition "The verse of the King James Bible: two halves that answer each other (day and night, speech and knowledge), with no fixed foot."@en ;
	skos:prefLabel "parallelism"@en ;
	ns:status "stable" ;
	ns:suitsGroove "repeat plus variation: the second half answers the first" ;
	ns:writtenAs "parallelism" .
<https://beatscript.app/ontology/concept/phrasebook-family-sprung> a skos:Concept , ns:MeterFamily ;
	skos:definition "Gerard Manley Hopkins's rhythm: count the stresses, not the syllables; a stress stands alone or takes up to three slack syllables."@en ;
	skos:prefLabel "sprung rhythm"@en ;
	ns:status "stable" ;
	ns:suitsGroove "counts stresses, not syllables: one stress to a beat, over any groove" ;
	ns:writtenAs "sprung" .
<https://beatscript.app/ontology/concept/phrasebook-family-trochaic> a skos:Concept , ns:MeterFamily ;
	skos:definition "A stressed syllable then an unstressed one, four to a line, the last often cut short: Blake's Tyger and Hiawatha."@en ;
	skos:prefLabel "trochaic"@en ;
	ns:status "stable" ;
	ns:suitsGenre <https://beatscript.app/ontology/genre/edm> , <https://beatscript.app/ontology/genre/techno> , <https://beatscript.app/ontology/genre/trance> ;
	ns:suitsGroove "chants on the kick: techno, EDM, four on the floor" ;
	ns:writtenAs "trochaic" .
<https://beatscript.app/ontology/concept/phrasebook-feel-straight> a skos:Concept , ns:Feel ;
	skos:definition "A straight feel: the syllables sit on the sixteenth grid."@en ;
	skos:prefLabel "straight"@en ;
	ns:status "stable" ;
	ns:writtenAs "straight" .
<https://beatscript.app/ontology/concept/phrasebook-feel-triplet> a skos:Concept , ns:Feel ;
	skos:definition "A triplet feel: the syllables go in groups of three."@en ;
	skos:prefLabel "triplet"@en ;
	ns:status "stable" ;
	ns:writtenAs "triplet" .
<https://beatscript.app/ontology/concept/phrasebook-public-domain> dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
	a skos:Concept , ns:Phrasebook ;
	skos:definition "Lines of verse, scripture, speech and work song first published before 1929, each with its source, its meter as a step pattern and the lyric BeatScript sings it as. A CC0 file, every text in the public domain, addressed by the CID of its text (beatscript.app/phrasebook)."@en ;
	skos:prefLabel "public-domain phrasebook"@en ;
	ns:status "stable" ;
	ns:writtenAs "phrasebook-pd" .
<https://beatscript.app/ontology/concept/product-beatscript-mcp> a skos:Concept , ns:McpServer ;
	skos:definition "Tools that let an AI assistant such as Claude use BeatScript: check, format and render programs, and play them on a paired phone."@en ;
	skos:prefLabel "BeatScript MCP server"@en ;
	ns:homepage "https://beatscript.app/mcp"^^xsd:anyURI ;
	ns:inProductFamily <https://beatscript.app/ontology/concept/product-beatscript> ;
	ns:status "stable" .
<https://beatscript.app/ontology/concept/product-beatscript-ontology-mcp> a skos:Concept , ns:McpServer ;
	skos:definition "Read-only access to the BeatScript ontology (https://beatscript.app/ontology/ns#), derived from the bitwrap ontology 0.2.0: genres, scales, grooves, song sections, instruments, Euclidean rhythms, Markov melody, the Petri-net engine concepts, and the BeatScript language's own terms (grammar productions, keywords, voices, kits, control nouns and verbs, MCP tools). Queries run over the materialized graph and are capped at 1000 rows and 5 seconds."@en ;
	skos:prefLabel "BeatScript ontology MCP server"@en ;
	ns:homepage "https://beatscript.app/ontology/"^^xsd:anyURI ;
	ns:inProductFamily <https://beatscript.app/ontology/concept/product-beatscript> ;
	ns:status "stable" .
<https://beatscript.app/ontology/concept/product-beatscript> a skos:Concept , ns:ProductFamily ;
	skos:definition "The name shared by a music language, the Android app that plays it, the website beatscript.app and its MCP servers. Write or generate a program, send it to the phone, hear it."@en ;
	skos:prefLabel "BeatScript"@en ;
	ns:homepage "https://beatscript.app"^^xsd:anyURI ;
	ns:status "stable" .
<https://beatscript.app/ontology/concept/ring-marking> a skos:Concept , ns:EngineConcept ;
	skos:closeMatch pflow:Marking ;
	skos:definition "Where the token sits in each ring right now: the whole state of the sequencer. A track's marking resets to its initial marking at the loop point."@en ;
	skos:prefLabel "ring marking"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/ring-marking> .
<https://beatscript.app/ontology/concept/rotation> a skos:Concept , ns:EngineConcept ;
	skos:definition "Shifting a rhythm's pulses by a number of steps without changing their spacing."@en ;
	skos:prefLabel "rotation"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/rotation> .
<https://beatscript.app/ontology/concept/sequential-composition> a skos:Concept , ns:CategoricalConcept ;
	skos:definition "Arrangement: one section followed by the next, the output marking of the first being the input of the second. Associative."@en ;
	skos:prefLabel "sequential composition"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/sequential-composition> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/silence-unit> a skos:Concept , ns:CategoricalConcept ;
	skos:definition "The part that plays nothing. Stacking it with any part gives that same part back."@en ;
	skos:prefLabel "silence (monoidal unit)"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/silence-unit> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/song-structure-net> a skos:Concept , ns:EngineConcept ;
	skos:closeMatch ns:ControlNet ;
	skos:definition "A linear control net whose transitions mute and unmute tracks and activate slots at section boundaries, so the order of sections is the order of transitions firing."@en ;
	skos:prefLabel "song structure net"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/song-structure-net> .
<https://beatscript.app/ontology/concept/step-arc> a skos:Concept , ns:EngineConcept ;
	skos:closeMatch pflow:Arc ;
	skos:definition "An arc from a place to its transition, or from a transition to the next place; together they close the ring."@en ;
	skos:prefLabel "step arc"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/step-arc> .
<https://beatscript.app/ontology/concept/step-place> a skos:Concept , ns:EngineConcept ;
	skos:closeMatch pflow:Place ;
	skos:definition "One of the N places in a rhythm or melody ring. Each place is one step of the pattern."@en ;
	skos:prefLabel "step place"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/step-place> .
<https://beatscript.app/ontology/concept/syncopation> a skos:Concept , ns:EngineConcept ;
	skos:definition "Accents placed off the strong beats."@en ;
	skos:prefLabel "syncopation"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/syncopation> .
<https://beatscript.app/ontology/concept/technique-found-phrases> a skos:Concept , ns:Technique ;
	rdfs:seeAlso <https://beatscript.app/docs/found-phrases> ;
	skos:definition "Borrowing found material for its shape, not its meaning: a public-domain line is chosen for its meter (trochees chant on the kick, iambs lilt on the offbeat, anapests and dactyls want a triplet feel, shanties call and respond, psalm parallelism repeats with variation), its stresses are written to land where the meter says, the vocal is kept low (about A3 to F4) and cycled between a buried section and a spotlit one, crossed onto the drum rhythms with xfer, and its pronunciation fixed with phoneme escapes. The lineage of sampling, cut-ups and readymades, borrowing structure rather than recordings, from sources clean by construction."@en ;
	skos:prefLabel "found phrases"@en ;
	ns:status "stable" ;
	ns:usesPhrasebook <https://beatscript.app/ontology/concept/phrasebook-public-domain> ;
	ns:writtenAs "found-phrases" .
<https://beatscript.app/ontology/concept/template-canon> a skos:Concept , ns:PhraseTemplate ;
	rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> ;
	skos:definition "The phrase template canon: a canon at 90 in D: Pachelbel's violin line chased by copies of itself, a bar and a beat behind, over his ground; the phrase sung over them. Written arrange from template(canon, @mgm_pease_porridge_hot)."@en ;
	skos:prefLabel "canon"@en ;
	ns:status "stable" ;
	ns:writtenAs "canon" .
<https://beatscript.app/ontology/concept/template-cross> a skos:Concept , ns:PhraseTemplate ;
	rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> ;
	skos:definition "The phrase template cross: a cross at 120 in D: two sources (two seeds, in any genres: `a=gen@1 dubstep seed=54876, b=gen@1 house seed=7`) take turns and overlap, and morph toward each other and back in cycles; the phrase sung over the crossing. Written arrange from template(cross, @psalm42_deep_calleth)."@en ;
	skos:prefLabel "cross"@en ;
	ns:status "stable" ;
	ns:writtenAs "cross" .
<https://beatscript.app/ontology/concept/template-deep-house> a skos:Concept , ns:PhraseTemplate ;
	rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> ;
	skos:definition "The phrase template deep-house: deep house at 122: a night/spot cycle, the voice buried then spotlit, crossed onto the shaker; the phrase is the vocal line. Written arrange from template(deep-house, @tempest_such_stuff)."@en ;
	skos:prefLabel "deep-house"@en ;
	ns:status "stable" ;
	ns:writtenAs "deep-house" .
<https://beatscript.app/ontology/concept/template-fugue> a skos:Concept , ns:PhraseTemplate ;
	rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> ;
	skos:definition "The phrase template fugue: a fugue at 104 in B minor: Grieg's Mountain King as the subject, answered a fifth up and re-entering transposed while Bach's Badinerie morphs toward it; the phrase sung over the subject. Written arrange from template(fugue, @tyger_burning_bright)."@en ;
	skos:prefLabel "fugue"@en ;
	ns:status "stable" ;
	ns:writtenAs "fugue" .
<https://beatscript.app/ontology/concept/template-passacaglia> a skos:Concept , ns:PhraseTemplate ;
	rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> ;
	skos:definition "The phrase template passacaglia: a passacaglia at 100 in G minor: a ground that never changes (Holst's five-beat ostinato) under cumulative variations; the phrase sung over the ground. Written arrange from template(passacaglia, @eccl3_season)."@en ;
	skos:prefLabel "passacaglia"@en ;
	ns:status "stable" ;
	ns:writtenAs "passacaglia" .
<https://beatscript.app/ontology/concept/template-quodlibet> a skos:Concept , ns:PhraseTemplate ;
	rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> ;
	skos:definition "The phrase template quodlibet: a quodlibet at 96 in D: public-domain themes take turns by section and cross-morph toward each other and away in cycles; the phrase sung over the ground. Written arrange from template(quodlibet, @psalm42_deep_calleth)."@en ;
	skos:prefLabel "quodlibet"@en ;
	ns:status "stable" ;
	ns:writtenAs "quodlibet" .
<https://beatscript.app/ontology/concept/template-rondo> a skos:Concept , ns:PhraseTemplate ;
	rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> ;
	skos:definition "The phrase template rondo: a rondo at 116 in C: Joplin's Entertainer as the refrain, returning mutated between episodes (Bach's Prelude in C, the phrase sung). Written arrange from template(rondo, @shanty_drunken_sailor)."@en ;
	skos:prefLabel "rondo"@en ;
	ns:status "stable" ;
	ns:writtenAs "rondo" .
<https://beatscript.app/ontology/concept/template-theme-and-variations> a skos:Concept , ns:PhraseTemplate ;
	rdfs:seeAlso <https://beatscript.app/ontology/concept/grammar-template> ;
	skos:definition "The phrase template theme-and-variations: a theme and variations at 84 in D-flat: Dvorak's New World Largo, a different transform in each section and no cross-morphs; the phrase sung in one. Written arrange from template(theme-and-variations, @dickinson_chariot_death)."@en ;
	skos:prefLabel "theme-and-variations"@en ;
	ns:status "stable" ;
	ns:writtenAs "theme-and-variations" .
<https://beatscript.app/ontology/concept/tension-curve> a skos:Concept , ns:EngineConcept ;
	skos:definition "A rise and release of intensity across a section or song."@en ;
	skos:prefLabel "tension curve"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/tension-curve> .
<https://beatscript.app/ontology/concept/theme-mode-major> a skos:Concept , ns:ThemeMode ;
	skos:definition "A theme in a major key."@en ;
	skos:prefLabel "major"@en ;
	ns:status "stable" ;
	ns:writtenAs "major" .
<https://beatscript.app/ontology/concept/theme-mode-minor> a skos:Concept , ns:ThemeMode ;
	skos:definition "A theme in a minor key."@en ;
	skos:prefLabel "minor"@en ;
	ns:status "stable" ;
	ns:writtenAs "minor" .
<https://beatscript.app/ontology/concept/theme-mode-modal> a skos:Concept , ns:ThemeMode ;
	skos:definition "A theme neither: a pedal or an ostinato on one note."@en ;
	skos:prefLabel "modal"@en ;
	ns:status "stable" ;
	ns:writtenAs "modal" .
<https://beatscript.app/ontology/concept/theme-role-arp> a skos:Concept , ns:ThemeRole ;
	skos:definition "A theme written for the arp part: a chord broken into a figure: the harmony as a moving line."@en ;
	skos:prefLabel "arp"@en ;
	ns:status "stable" ;
	ns:writtenAs "arp" .
<https://beatscript.app/ontology/concept/theme-role-bass> a skos:Concept , ns:ThemeRole ;
	skos:definition "A theme written for the bass part: a bass line, a ground or an ostinato: the line under the others."@en ;
	skos:prefLabel "bass"@en ;
	ns:status "stable" ;
	ns:writtenAs "bass" .
<https://beatscript.app/ontology/concept/theme-role-harmony> a skos:Concept , ns:ThemeRole ;
	skos:definition "A theme written for the harmony part: chords, or an interval held: what the other lines are heard against."@en ;
	skos:prefLabel "harmony"@en ;
	ns:status "stable" ;
	ns:writtenAs "harmony" .
<https://beatscript.app/ontology/concept/theme-role-melody> a skos:Concept , ns:ThemeRole ;
	skos:definition "A theme written for the melody part: a tune: the line a person hums."@en ;
	skos:prefLabel "melody"@en ;
	ns:status "stable" ;
	ns:writtenAs "melody" .
<https://beatscript.app/ontology/concept/themes-public-domain> dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
	a skos:Concept , ns:ThemeLibrary ;
	rdfs:seeAlso <https://beatscript.app/themes> ;
	skos:definition "Melodies, basses and figures composed and first published before 1929, each written from the melody itself as BeatScript bars in a stated key, with its role, meter, source work, composer, year and pairings. A CC0 file, addressed by the CID of its text (beatscript.app/themes): the melodic twin of the phrasebook."@en ;
	skos:prefLabel "public-domain theme library"@en ;
	ns:status "stable" ;
	ns:writtenAs "themes-pd" .
<https://beatscript.app/ontology/concept/timing-at-bar> a skos:Concept , ns:TimingWord ;
	skos:definition "The change happens at a numbered bar."@en ;
	skos:prefLabel "at bar"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/timing-at-bar> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/timing-every-n-bars> a skos:Concept , ns:TimingWord ;
	skos:definition "The change repeats at a fixed bar interval."@en ;
	skos:prefLabel "every N bars"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/timing-every-n-bars> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/timing-for-n-bars> a skos:Concept , ns:TimingWord ;
	skos:definition "The change holds for N bars and then reverts."@en ;
	skos:prefLabel "for N bars"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/timing-for-n-bars> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/timing-on-next-phrase> a skos:Concept , ns:TimingWord ;
	skos:definition "The change waits for the next phrase boundary, so it lands on the beat the listener expects."@en ;
	skos:prefLabel "on next phrase"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/timing-on-next-phrase> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/timing-ramp> a skos:Concept , ns:TimingWord ;
	skos:definition "The change moves gradually from one value to another over a span of bars instead of jumping."@en ;
	skos:prefLabel "ramp"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/timing-ramp> ;
	ns:status "in-development" .
