	skos:definition "A hand-clap sound doubling the snare."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/role/clap> .
<https://beatscript.app/ontology/role/harmony> a ns:InstrumentRole ;
	rdfs:label "harmony"@en ;
	skos:definition "Chordal accompaniment: pads, keys or stabs."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/role/harmony> .
<https://beatscript.app/ontology/role/hihat> a ns:InstrumentRole ;
	rdfs:label "hihat"@en ;
	skos:definition "The hi-hat: keeps the subdivision."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/role/hihat> .
<https://beatscript.app/ontology/role/kick> a ns:InstrumentRole ;
	rdfs:label "kick"@en ;
	skos:definition "The bass drum: marks the pulse."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/role/kick> .
<https://beatscript.app/ontology/role/melody> a ns:InstrumentRole ;
	rdfs:label "melody"@en ;
	skos:definition "The lead line."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/role/melody> .
<https://beatscript.app/ontology/role/snare> a ns:InstrumentRole ;
	rdfs:label "snare"@en ;
	skos:definition "The snare drum: marks the backbeat."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/role/snare> .
<https://beatscript.app/ontology/scale/blues> a ns:Scale ;
	rdfs:label "blues"@en ;
	skos:definition "The minor pentatonic scale plus the flattened fifth, the blue note."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/scale/blues> ;
	ns:intervals "0 3 5 6 7 10" ;
	ns:noteCount 6 .
<https://beatscript.app/ontology/scale/dorian> a ns:Scale ;
	rdfs:label "dorian"@en ;
	skos:definition "Minor with a raised sixth degree: the second mode of the major scale."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/scale/dorian> ;
	ns:intervals "0 2 3 5 7 9 10" ;
	ns:noteCount 7 .
<https://beatscript.app/ontology/scale/harmonic-minor> a ns:Scale ;
	rdfs:label "harmonic minor"@en ;
	skos:definition "Natural minor with a raised seventh degree."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/scale/harmonic-minor> ;
	ns:intervals "0 2 3 5 7 8 11" ;
	ns:noteCount 7 .
<https://beatscript.app/ontology/scale/major> a ns:Scale ;
	rdfs:label "major"@en ;
	skos:definition "The seven-note major scale: whole, whole, half, whole, whole, whole, half."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/scale/major> ;
	ns:intervals "0 2 4 5 7 9 11" ;
	ns:noteCount 7 .
<https://beatscript.app/ontology/scale/minor-pentatonic> a ns:Scale ;
	rdfs:label "minor pentatonic"@en ;
	skos:definition "The five-note minor pentatonic scale."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/scale/minor-pentatonic> ;
	ns:intervals "0 3 5 7 10" ;
	ns:noteCount 5 .
<https://beatscript.app/ontology/scale/minor> a ns:Scale ;
	rdfs:label "minor"@en ;
	skos:definition "The natural minor scale, the sixth mode of the major scale."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/scale/minor> ;
	ns:intervals "0 2 3 5 7 8 10" ;
	ns:noteCount 7 .
<https://beatscript.app/ontology/scale/mixolydian> a ns:Scale ;
	rdfs:label "mixolydian"@en ;
	skos:definition "Major with a lowered seventh: the fifth mode of the major scale."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/scale/mixolydian> ;
	ns:intervals "0 2 4 5 7 9 10" ;
	ns:noteCount 7 .
<https://beatscript.app/ontology/scale/pentatonic> a ns:Scale ;
	rdfs:label "pentatonic"@en ;
	skos:definition "The five-note major pentatonic scale: the major scale without its fourth and seventh."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/scale/pentatonic> ;
	ns:intervals "0 2 4 7 9" ;
	ns:noteCount 5 .
<https://beatscript.app/ontology/scale/phrygian> a ns:Scale ;
	rdfs:label "phrygian"@en ;
	skos:definition "Minor with a lowered second degree: the third mode of the major scale. Dark and tense."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/scale/phrygian> ;
	ns:intervals "0 1 3 5 7 8 10" ;
	ns:noteCount 7 .
<https://beatscript.app/ontology/section/breakdown> a ns:SongSection ;
	rdfs:label "breakdown"@en ;
	skos:definition "A stripped-back section where the drums drop out and a melody carries."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/section/breakdown> .
<https://beatscript.app/ontology/section/bridge> a ns:SongSection ;
	rdfs:label "bridge"@en ;
	skos:definition "A contrasting section away from the verse and chorus."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/section/bridge> .
<https://beatscript.app/ontology/section/buildup> a ns:SongSection ;
	rdfs:label "buildup"@en ;
	skos:definition "Rising tension before a drop: snare and hi-hat density climb."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/section/buildup> .
<https://beatscript.app/ontology/section/chorus> a ns:SongSection ;
	rdfs:label "chorus"@en ;
	skos:definition "The high-energy, full-arrangement section a song returns to."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/section/chorus> .
<https://beatscript.app/ontology/section/drop> a ns:SongSection ;
	rdfs:label "drop"@en ;
	skos:definition "The peak of an electronic track after a buildup: full arrangement at highest energy."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/section/drop> .
<https://beatscript.app/ontology/section/intro> a ns:SongSection ;
	rdfs:label "intro"@en ;
	skos:definition "The opening: few parts playing, building attention."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/section/intro> .
<https://beatscript.app/ontology/section/outro> a ns:SongSection ;
	rdfs:label "outro"@en ;
	skos:definition "The closing section: parts fall away."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/section/outro> .
<https://beatscript.app/ontology/section/pre-chorus> a ns:SongSection ;
	rdfs:label "pre-chorus"@en ;
	skos:definition "A short lift into the chorus."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/section/pre-chorus> .
<https://beatscript.app/ontology/section/solo> a ns:SongSection ;
	rdfs:label "solo"@en ;
	skos:definition "A section featuring one melodic voice over the rhythm section."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/section/solo> .
<https://beatscript.app/ontology/section/verse> a ns:SongSection ;
	rdfs:label "verse"@en ;
	skos:definition "A main body section carrying the groove with moderate energy."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/section/verse> .
