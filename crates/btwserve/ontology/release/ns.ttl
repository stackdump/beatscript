	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#usesInstrument> .
ns:usesKeyword a owl:ObjectProperty ;
	rdfs:domain ns:GrammarProduction ;
	rdfs:label "uses keyword"@en ;
	rdfs:range ns:Keyword ;
