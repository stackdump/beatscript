	ns:writtenAs "tokens" .
<https://beatscript.app/ontology/concept/grammar-type> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The type production of BeatScript's grammar."@en ;
	skos:prefLabel "type"@en ;
	ns:ebnf "\"chords\" | \"key\" | \"bass\" | \"melody\" | \"drums\" | \"rhythm\" | \"bars\" | \"tempo\" | \"pattern\"" ;
	ns:grammarSection "Typed ports"@en ;
	ns:status "stable" ;
