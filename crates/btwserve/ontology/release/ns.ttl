ns:templateKind a owl:DatatypeProperty ;
	rdfs:comment "minimal, standard, extended, ab, drop, build or jam."@en ;
	rdfs:domain ns:SongStructure ;
	rdfs:label "template kind"@en ;
	rdfs:range xsd:string ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#templateKind> .
ns:tempoBpm a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:comment "Beats per minute the program sets. Distinct from ns:bpm, which is a genre's default."@en ;
	rdfs:domain ns:Program ;
	rdfs:label "program tempo"@en ;
	rdfs:range xsd:integer ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#tempoBpm> ;
	ns:status "in-development" .
ns:tensionCurve a owl:DatatypeProperty ;
	rdfs:domain ns:Genre ;
	rdfs:label "tension curve"@en ;
	rdfs:range xsd:boolean ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#tensionCurve> .
ns:themeMode a owl:ObjectProperty ;
	rdfs:domain ns:ThemeEntry ;
	rdfs:label "theme mode"@en ;
	rdfs:range ns:ThemeMode ;
	ns:status "stable" .
ns:themeRole a owl:ObjectProperty ;
