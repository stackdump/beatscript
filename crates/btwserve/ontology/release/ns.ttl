	rdfs:domain ns:Form ;
	rdfs:label "uses mutation"@en ;
	rdfs:range ns:MutationOperator ;
	ns:status "stable" .
ns:usesPhrasebook a owl:ObjectProperty ;
	rdfs:comment "The phrasebook a technique takes its found material from."@en ;
