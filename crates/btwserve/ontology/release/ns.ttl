	ns:usesToken <https://beatscript.app/ontology/concept/token-int> , <https://beatscript.app/ontology/concept/token-word> ;
	ns:writtenAs "engine" .
<https://beatscript.app/ontology/concept/grammar-escape> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The escape production of BeatScript's grammar (PHONES (beatscript-v1): aa ae uh aw eh er ii ee uu oo ay ie oy ow oh p b t d k g f v s z sh zh th dh h m n ng l r w y ch j, \"_\" a rest, \"-\" cuts a word, \":\" holds a vowel one more note, \"!\" accents it)."@en ;
