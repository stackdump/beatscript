<https://beatscript.app/ontology/concept/grammar-until-when> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The until_when production of BeatScript's grammar (a time, a bar of the track, a section's start or end)."@en ;
	skos:prefLabel "until_when"@en ;
