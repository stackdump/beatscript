@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ns: <https://beatscript.app/ontology/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pflow: <https://ontology.pflow.xyz/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
<https://beatscript.app/ontology/concept/bjorklund> a skos:Concept , ns:EngineConcept ;
	rdfs:seeAlso <https://en.wikipedia.org/wiki/Euclidean_rhythm> ;
	skos:definition "The procedure that spreads K pulses over N steps as evenly as possible. Applied repeatedly, it merges the longer groups with the leftover shorter ones until at most one leftover remains."@en ;
	skos:prefLabel "Bjorklund algorithm"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/bjorklund> .
<https://beatscript.app/ontology/concept/call-and-response> a skos:Concept , ns:EngineConcept ;
	skos:definition "A phrase answered by another phrase."@en ;
	skos:prefLabel "call and response"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/call-and-response> .
<https://beatscript.app/ontology/concept/camelot-wheel> a skos:Concept , ns:EngineConcept ;
	skos:definition "A way of naming the twenty-four keys as numbers 1 to 12 with a letter, A for minor and B for major. Keys one step apart on the wheel, or at the same number with the other letter, mix harmonically."@en ;
	skos:prefLabel "Camelot wheel"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/camelot-wheel> ;
	ns:status "stable" .
<https://beatscript.app/ontology/concept/chord-tone> a skos:Concept , ns:EngineConcept ;
	skos:definition "A scale degree that belongs to the chord sounding now. Strong-beat melody notes are pulled to the nearest one."@en ;
	skos:prefLabel "chord tone"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/chord-tone> .
<https://beatscript.app/ontology/concept/circulating-token> a skos:Concept , ns:EngineConcept ;
	skos:closeMatch pflow:Token ;
	skos:definition "The single token that moves around a ring, one step per tick. Its position is the playhead."@en ;
	skos:prefLabel "circulating token"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/circulating-token> .
<https://beatscript.app/ontology/concept/density> a skos:Concept , ns:EngineConcept ;
	skos:definition "The share of steps that sound rather than rest."@en ;
	skos:prefLabel "density"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/density> .
<https://beatscript.app/ontology/concept/empty-section-identity> a skos:Concept , ns:CategoricalConcept ;
	skos:definition "The section with no lines. Arranging it before or after any section leaves that section unchanged."@en ;
	skos:prefLabel "empty section (identity)"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/empty-section-identity> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/ending-end> a skos:Concept , ns:Ending ;
	skos:definition "The program stops when its last section finishes."@en ;
	skos:prefLabel "end"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/ending-end> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/ending-loop> a skos:Concept , ns:Ending ;
	skos:definition "The program returns to its first section when its last finishes, and the net's marking resets to its initial marking."@en ;
	skos:prefLabel "loop"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/ending-loop> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/endomorphism-monoid> a skos:Concept , ns:CategoricalConcept ;
	skos:definition "The pattern transforms, each taking a pattern to a pattern, closed under doing one after another, with doing nothing as the identity."@en ;
	skos:prefLabel "endomorphism monoid"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/endomorphism-monoid> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/euclidean-rhythm> a skos:Concept , ns:EngineConcept ;
	skos:closeMatch ns:EuclideanRhythm ;
	skos:definition "A rhythm made by the Bjorklund algorithm. Many traditional patterns around the world are Euclidean rhythms. In the engine it becomes a rhythm ring with a note binding on each pulse step."@en ;
	skos:prefLabel "Euclidean rhythm"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/euclidean-rhythm> .
<https://beatscript.app/ontology/concept/evolve-invert> a skos:Concept , ns:EvolveOperator ;
	skos:definition "The evolve operator invert: applied to a part once a generation."@en ;
	skos:prefLabel "invert"@en ;
	ns:status "stable" ;
	ns:writtenAs "invert" .
<https://beatscript.app/ontology/concept/evolve-octave> a skos:Concept , ns:EvolveOperator ;
	skos:definition "The evolve operator octave: applied to a part once a generation."@en ;
	skos:prefLabel "octave"@en ;
	ns:status "stable" ;
	ns:writtenAs "octave" .
<https://beatscript.app/ontology/concept/evolve-reverse> a skos:Concept , ns:EvolveOperator ;
	skos:definition "The evolve operator reverse: applied to a part once a generation."@en ;
	skos:prefLabel "reverse"@en ;
	ns:status "stable" ;
	ns:writtenAs "reverse" .
<https://beatscript.app/ontology/concept/evolve-rotate> a skos:Concept , ns:EvolveOperator ;
	skos:definition "The evolve operator rotate: applied to a part once a generation."@en ;
	skos:prefLabel "rotate"@en ;
	ns:status "stable" ;
	ns:writtenAs "rotate" .
<https://beatscript.app/ontology/concept/evolve-thin> a skos:Concept , ns:EvolveOperator ;
	skos:definition "The evolve operator thin: applied to a part once a generation."@en ;
	skos:prefLabel "thin"@en ;
	ns:status "stable" ;
	ns:writtenAs "thin" .
<https://beatscript.app/ontology/concept/evolve-transpose> a skos:Concept , ns:EvolveOperator ;
	skos:definition "The evolve operator transpose: applied to a part once a generation."@en ;
	skos:prefLabel "transpose"@en ;
	ns:status "stable" ;
	ns:writtenAs "transpose" .
<https://beatscript.app/ontology/concept/fmt> a skos:Concept , ns:EngineConcept ;
	skos:definition "The formatter: rewrites a btw program into its canonical form without changing what it plays."@en ;
	skos:prefLabel "fmt"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/fmt> ;
	ns:categoricalReading <https://beatscript.app/ontology/concept/normal-form> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/form-canon> a skos:Concept , ns:Form ;
	rdfs:seeAlso <https://beatscript.app/docs/forms#canon> ;
	skos:definition "The canon, a form from classical music: lead chase round sung round sung: one voice, then two, then three. The theme chases its own delayed and rotated copies; they are made of its bars, so `~ theme_* rot 2` and `rev` move the leader and its followers together."@en ;
	skos:prefLabel "canon"@en ;
	ns:formShape "lead chase round sung round sung: one voice, then two, then three"@en ;
	ns:formTemplate <https://beatscript.app/ontology/concept/template-canon> ;
	ns:mutationPlan "the theme chases its own delayed and rotated copies; they are made of its bars, so `~ theme_* rot 2` and `rev` move the leader and its followers together"@en ;
	ns:status "stable" ;
	ns:usesMutation <https://beatscript.app/ontology/concept/mutation-op-accent> , <https://beatscript.app/ontology/concept/mutation-op-decay> , <https://beatscript.app/ontology/concept/mutation-op-grow> , <https://beatscript.app/ontology/concept/mutation-op-rev> , <https://beatscript.app/ontology/concept/mutation-op-rot> , <https://beatscript.app/ontology/concept/mutation-op-xfer> ;
	ns:usesTechnique <https://beatscript.app/ontology/concept/technique-found-phrases> ;
	ns:usesTheme "pachelbel_ground" , "pachelbel_violin" ;
	ns:usesThemeLibrary <https://beatscript.app/ontology/concept/themes-public-domain> ;
	ns:writtenAs "canon" .
<https://beatscript.app/ontology/concept/form-cross> a skos:Concept , ns:Form ;
	rdfs:seeAlso <https://beatscript.app/docs/forms#cross> ;
	skos:definition "The cross, a form from classical music: a_leads b_leads both both sung a_leads b_leads sung: one source leads, then the other, then both at once. A quodlibet of two: `~ a_melody_* morph b_melody_1 p` paired with `~ b_bass_* morph a_bass_1 p`, an `@ ... xfer` one-shot in the overlap, then the pull turned round (`~ b_melody_* morph a_melody_1 p`, `~ a_bass_* morph b_bass_1 p`); `~` persists and compounds pass on pass (loop 3)."@en ;
	skos:prefLabel "cross"@en ;
	ns:formShape "a_leads b_leads both both sung a_leads b_leads sung: one source leads, then the other, then both at once"@en ;
	ns:formTemplate <https://beatscript.app/ontology/concept/template-cross> ;
	ns:mutationPlan "a quodlibet of two: `~ a_melody_* morph b_melody_1 p` paired with `~ b_bass_* morph a_bass_1 p`, an `@ ... xfer` one-shot in the overlap, then the pull turned round (`~ b_melody_* morph a_melody_1 p`, `~ a_bass_* morph b_bass_1 p`); `~` persists and compounds pass on pass (loop 3)"@en ;
	ns:status "stable" ;
	ns:usesMutation <https://beatscript.app/ontology/concept/mutation-op-decay> , <https://beatscript.app/ontology/concept/mutation-op-grow> , <https://beatscript.app/ontology/concept/mutation-op-morph> , <https://beatscript.app/ontology/concept/mutation-op-xfer> ;
	ns:usesTechnique <https://beatscript.app/ontology/concept/technique-found-phrases> ;
	ns:usesTheme "badinerie" , "ode_to_joy" , "pachelbel_ground" ;
	ns:usesThemeLibrary <https://beatscript.app/ontology/concept/themes-public-domain> ;
	ns:writtenAs "cross" .
<https://beatscript.app/ontology/concept/form-fugue> a skos:Concept , ns:Form ;
	rdfs:seeAlso <https://beatscript.app/docs/forms#fugue> ;
	skos:definition "The fugue, a form from classical music: subject answer counter sung answer counter sung: the voices enter one by one. The subject re-enters transposed (`~ subject_* down 2`, later `~ up 2`) while the countersubject morphs toward it (`~ counter_* morph subject_1 p`)."@en ;
	skos:prefLabel "fugue"@en ;
	ns:formShape "subject answer counter sung answer counter sung: the voices enter one by one"@en ;
	ns:formTemplate <https://beatscript.app/ontology/concept/template-fugue> ;
	ns:mutationPlan "the subject re-enters transposed (`~ subject_* down 2`, later `~ up 2`) while the countersubject morphs toward it (`~ counter_* morph subject_1 p`)"@en ;
	ns:status "stable" ;
	ns:usesMutation <https://beatscript.app/ontology/concept/mutation-op-decay> , <https://beatscript.app/ontology/concept/mutation-op-down> , <https://beatscript.app/ontology/concept/mutation-op-grow> , <https://beatscript.app/ontology/concept/mutation-op-morph> , <https://beatscript.app/ontology/concept/mutation-op-up> , <https://beatscript.app/ontology/concept/mutation-op-xfer> ;
	ns:usesTechnique <https://beatscript.app/ontology/concept/technique-found-phrases> ;
	ns:usesTheme "badinerie" , "mountain_king" ;
	ns:usesThemeLibrary <https://beatscript.app/ontology/concept/themes-public-domain> ;
	ns:writtenAs "fugue" .
<https://beatscript.app/ontology/concept/form-passacaglia> a skos:Concept , ns:Form ;
	rdfs:seeAlso <https://beatscript.app/docs/forms#passacaglia> ;
	skos:definition "The passacaglia, a form from classical music: ground variation sung variation sung variation sung: the ground under every section. Cumulative variations above the ground, each `~` added on top of the last: `rot 2 | accent`, `thin`, `rev | drift`, `grow`, `up 1`, `down 1`, `decay`; the ground is never mutated."@en ;
	skos:prefLabel "passacaglia"@en ;
	ns:formShape "ground variation sung variation sung variation sung: the ground under every section"@en ;
	ns:formTemplate <https://beatscript.app/ontology/concept/template-passacaglia> ;
	ns:mutationPlan "cumulative variations above the ground, each `~` added on top of the last: `rot 2 | accent`, `thin`, `rev | drift`, `grow`, `up 1`, `down 1`, `decay`; the ground is never mutated"@en ;
	ns:referenceProgram "z4EBG9j7BJKjYPfs6QQBQCdjieviWbSwbJqEPm9idg79wTYNLW1" ;
	ns:status "stable" ;
	ns:usesMutation <https://beatscript.app/ontology/concept/mutation-op-accent> , <https://beatscript.app/ontology/concept/mutation-op-decay> , <https://beatscript.app/ontology/concept/mutation-op-down> , <https://beatscript.app/ontology/concept/mutation-op-drift> , <https://beatscript.app/ontology/concept/mutation-op-grow> , <https://beatscript.app/ontology/concept/mutation-op-rev> , <https://beatscript.app/ontology/concept/mutation-op-rot> , <https://beatscript.app/ontology/concept/mutation-op-thin> , <https://beatscript.app/ontology/concept/mutation-op-up> , <https://beatscript.app/ontology/concept/mutation-op-xfer> ;
	ns:usesTechnique <https://beatscript.app/ontology/concept/technique-found-phrases> ;
	ns:usesTheme "mars_ostinato" ;
	ns:usesThemeLibrary <https://beatscript.app/ontology/concept/themes-public-domain> ;
	ns:writtenAs "passacaglia" .
<https://beatscript.app/ontology/concept/form-quodlibet> a skos:Concept , ns:Form ;
	rdfs:seeAlso <https://beatscript.app/docs/forms#quodlibet> ;
	skos:definition "The quodlibet, a form from classical music: canon ode fate voices canon voices: one theme leads each section, the others under it. `~ a_* morph b_1 p` paired later with `~ b_* morph a_1 p`, the pair pulled away by a morph toward a third line, `@` one-shot borrowings; `~` persists and compounds pass on pass (loop 3)."@en ;
	skos:prefLabel "quodlibet"@en ;
	ns:formShape "canon ode fate voices canon voices: one theme leads each section, the others under it"@en ;
	ns:formTemplate <https://beatscript.app/ontology/concept/template-quodlibet> ;
	ns:mutationPlan "`~ a_* morph b_1 p` paired later with `~ b_* morph a_1 p`, the pair pulled away by a morph toward a third line, `@` one-shot borrowings; `~` persists and compounds pass on pass (loop 3)"@en ;
	ns:referenceProgram "z4EBG9j9Z3mPn1vKYrEVc93WXEjYyL7bCGdBM7jX4h8ZWMEuYZx" ;
	ns:status "stable" ;
	ns:usesMutation <https://beatscript.app/ontology/concept/mutation-op-decay> , <https://beatscript.app/ontology/concept/mutation-op-grow> , <https://beatscript.app/ontology/concept/mutation-op-morph> , <https://beatscript.app/ontology/concept/mutation-op-xfer> ;
	ns:usesTechnique <https://beatscript.app/ontology/concept/technique-found-phrases> ;
	ns:usesTheme "beethoven_fate" , "ode_to_joy" , "pachelbel_ground" , "pachelbel_violin" ;
	ns:usesThemeLibrary <https://beatscript.app/ontology/concept/themes-public-domain> ;
	ns:writtenAs "quodlibet" .
<https://beatscript.app/ontology/concept/form-rondo> a skos:Concept , ns:Form ;
	rdfs:seeAlso <https://beatscript.app/docs/forms#rondo> ;
	skos:definition "The rondo, a form from classical music: refrain episode refrain sung refrain episode refrain sung refrain: A B A C A B A C A. The refrain mutated on each return: `~ rot 2 | accent`, `@ mirror | vel 2` for one return, `~ up 1` then `~ down 1`; the episode morphs toward the refrain."@en ;
	skos:prefLabel "rondo"@en ;
	ns:formShape "refrain episode refrain sung refrain episode refrain sung refrain: A B A C A B A C A"@en ;
	ns:formTemplate <https://beatscript.app/ontology/concept/template-rondo> ;
	ns:mutationPlan "the refrain mutated on each return: `~ rot 2 | accent`, `@ mirror | vel 2` for one return, `~ up 1` then `~ down 1`; the episode morphs toward the refrain"@en ;
	ns:referenceProgram "z4EBG9izUsbisU2JZtPHUo4hcQpYd8FLyZXLqKUmbtftjj3Lirw" ;
	ns:status "stable" ;
	ns:usesMutation <https://beatscript.app/ontology/concept/mutation-op-accent> , <https://beatscript.app/ontology/concept/mutation-op-down> , <https://beatscript.app/ontology/concept/mutation-op-mirror> , <https://beatscript.app/ontology/concept/mutation-op-morph> , <https://beatscript.app/ontology/concept/mutation-op-rot> , <https://beatscript.app/ontology/concept/mutation-op-up> , <https://beatscript.app/ontology/concept/mutation-op-vel> , <https://beatscript.app/ontology/concept/mutation-op-xfer> ;
	ns:usesTechnique <https://beatscript.app/ontology/concept/technique-found-phrases> ;
	ns:usesTheme "bach_prelude_c" , "the_entertainer" ;
	ns:usesThemeLibrary <https://beatscript.app/ontology/concept/themes-public-domain> ;
	ns:writtenAs "rondo" .
<https://beatscript.app/ontology/concept/form-theme-and-variations> a skos:Concept , ns:Form ;
	rdfs:seeAlso <https://beatscript.app/docs/forms#theme-and-variations> ;
	skos:definition "The theme and variations, a form from classical music: theme variation variation variation sung variation theme. One source, a different transform for each section as a one-shot `@` (`rev`, `invert`, `stutter 2`, `oct -1`, `half | accent`), so the theme comes back unchanged; no cross-morphs."@en ;
	skos:prefLabel "theme and variations"@en ;
	ns:formShape "theme variation variation variation sung variation theme"@en ;
	ns:formTemplate <https://beatscript.app/ontology/concept/template-theme-and-variations> ;
	ns:mutationPlan "one source, a different transform for each section as a one-shot `@` (`rev`, `invert`, `stutter 2`, `oct -1`, `half | accent`), so the theme comes back unchanged; no cross-morphs"@en ;
	ns:status "stable" ;
	ns:usesMutation <https://beatscript.app/ontology/concept/mutation-op-accent> , <https://beatscript.app/ontology/concept/mutation-op-grow> , <https://beatscript.app/ontology/concept/mutation-op-half> , <https://beatscript.app/ontology/concept/mutation-op-invert> , <https://beatscript.app/ontology/concept/mutation-op-oct> , <https://beatscript.app/ontology/concept/mutation-op-rev> , <https://beatscript.app/ontology/concept/mutation-op-stutter> ;
	ns:usesTechnique <https://beatscript.app/ontology/concept/technique-found-phrases> ;
	ns:usesTheme "new_world_largo" ;
	ns:usesThemeLibrary <https://beatscript.app/ontology/concept/themes-public-domain> ;
	ns:writtenAs "theme-and-variations" .
<https://beatscript.app/ontology/concept/free-smc> a skos:Concept , ns:CategoricalConcept ;
	skos:definition "The category whose objects are multisets of places and whose morphisms are generated by the net's transitions. A deck's net is read as this category: what the deck can do is exactly what the category's morphisms can do."@en ;
	skos:prefLabel "free symmetric monoidal category on a net"@en ;
	skos:relatedMatch <https://beatscript.app/ontology/concept/note-transition> , <https://beatscript.app/ontology/concept/step-place> ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/free-smc> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/generator-arp> a skos:Concept , ns:PatternGenerator ;
	rdfs:seeAlso ns:ArpTerm ;
	skos:definition "The pattern generator arp: a call that makes a pattern from its arguments."@en ;
	skos:prefLabel "arp"@en ;
	ns:status "stable" ;
	ns:writtenAs "arp" .
<https://beatscript.app/ontology/concept/generator-choose> a skos:Concept , ns:PatternGenerator ;
	skos:definition "The pattern generator choose: a call that makes a pattern from its arguments."@en ;
	skos:prefLabel "choose"@en ;
	ns:status "stable" ;
	ns:writtenAs "choose" .
<https://beatscript.app/ontology/concept/generator-chord> a skos:Concept , ns:PatternGenerator ;
	rdfs:seeAlso ns:ChordTerm ;
	skos:definition "The pattern generator chord: a call that makes a pattern from its arguments."@en ;
	skos:prefLabel "chord"@en ;
	ns:status "stable" ;
	ns:writtenAs "chord" .
<https://beatscript.app/ontology/concept/generator-deg> a skos:Concept , ns:PatternGenerator ;
	skos:definition "The pattern generator deg: a call that makes a pattern from its arguments."@en ;
	skos:prefLabel "deg"@en ;
	ns:status "stable" ;
	ns:writtenAs "deg" .
<https://beatscript.app/ontology/concept/generator-e> a skos:Concept , ns:PatternGenerator ;
	rdfs:seeAlso ns:EuclidTerm ;
	skos:definition "The pattern generator e: a call that makes a pattern from its arguments."@en ;
	skos:prefLabel "e"@en ;
	ns:status "stable" ;
	ns:writtenAs "e" .
<https://beatscript.app/ontology/concept/generator-euclid> a skos:Concept , ns:PatternGenerator ;
	rdfs:seeAlso ns:EuclidTerm ;
	skos:definition "The pattern generator euclid: a call that makes a pattern from its arguments."@en ;
	skos:prefLabel "euclid"@en ;
	ns:status "stable" ;
	ns:writtenAs "euclid" .
<https://beatscript.app/ontology/concept/generator-markov> a skos:Concept , ns:PatternGenerator ;
	skos:definition "The pattern generator markov: a call that makes a pattern from its arguments."@en ;
	skos:prefLabel "markov"@en ;
	ns:status "stable" ;
	ns:writtenAs "markov" .
<https://beatscript.app/ontology/concept/ghost-note> a skos:Concept , ns:EngineConcept ;
	skos:definition "A very quiet drum hit between the main ones, felt more than heard."@en ;
	skos:prefLabel "ghost note"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/ghost-note> .
<https://beatscript.app/ontology/concept/grammar-action> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The action production of BeatScript's grammar (hertz: 20 .. 20k; 0 .. 1: how much; deck X: / master: level; deck X:)."@en ;
	skos:prefLabel "action"@en ;
	ns:ebnf "\"filter\" ( \"lp\" | \"hp\" ) change | \"filter\" ( \"off\" | \"open\" ) | ( \"delay\" | \"reverb\" | \"crush\" | \"drive\" | \"resonance\" ) change | ( \"level\" | \"low\" | \"mid\" | \"high\" ) change | \"load\" SPEC | \"play\" | \"stop\" | \"sync\" | \"mute\" | \"unmute\"" ;
	ns:grammarSection "Control: what the mix does"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-crush> , <https://beatscript.app/ontology/concept/keyword-delay> , <https://beatscript.app/ontology/concept/keyword-drive> , <https://beatscript.app/ontology/concept/keyword-filter> , <https://beatscript.app/ontology/concept/keyword-high> , <https://beatscript.app/ontology/concept/keyword-hp> , <https://beatscript.app/ontology/concept/keyword-level> , <https://beatscript.app/ontology/concept/keyword-load> , <https://beatscript.app/ontology/concept/keyword-low> , <https://beatscript.app/ontology/concept/keyword-lp> , <https://beatscript.app/ontology/concept/keyword-mid> , <https://beatscript.app/ontology/concept/keyword-mute> , <https://beatscript.app/ontology/concept/keyword-off> , <https://beatscript.app/ontology/concept/keyword-open> , <https://beatscript.app/ontology/concept/keyword-play> , <https://beatscript.app/ontology/concept/keyword-resonance> , <https://beatscript.app/ontology/concept/keyword-reverb> , <https://beatscript.app/ontology/concept/keyword-stop> , <https://beatscript.app/ontology/concept/keyword-sync> , <https://beatscript.app/ontology/concept/keyword-unmute> ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-change> , <https://beatscript.app/ontology/concept/grammar-lexical-spec> ;
	ns:writtenAs "action" .
<https://beatscript.app/ontology/concept/grammar-and> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The and production of BeatScript's grammar."@en ;
	skos:prefLabel "and"@en ;
	ns:ebnf "not { \"and\" not }" ;
	ns:grammarSection "Arithmetic and guards"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-and> ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-not> ;
	ns:writtenAs "and" .
<https://beatscript.app/ontology/concept/grammar-arg> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The arg production of BeatScript's grammar."@en ;
	skos:prefLabel "arg"@en ;
