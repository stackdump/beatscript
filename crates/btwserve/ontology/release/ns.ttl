<https://beatscript.app/ontology/concept/grammar-when> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The when production of BeatScript's grammar (every 16 bars every 2 beats every 4 bars from 8; every 8 bars: a phrase; once, on that place of the program; once, where that section ends; once, that long ahead of that section)."@en ;
	skos:prefLabel "when"@en ;
	ns:ebnf "\"every\" dur [ \"from\" ( arith | pos ) ] | \"on\" \"phrase\" | \"on\" \"next\" \"bar\" | \"on\" \"next\" \"phrase\" [ \"8\" | \"16\" | \"32\" ] | \"at\" pos | \"after\" NAME | \"before\" NAME dur" ;
	ns:grammarSection "Lines: when, where, what"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-16> , <https://beatscript.app/ontology/concept/keyword-32> , <https://beatscript.app/ontology/concept/keyword-8> , <https://beatscript.app/ontology/concept/keyword-after> , <https://beatscript.app/ontology/concept/keyword-at> , <https://beatscript.app/ontology/concept/keyword-bar> , <https://beatscript.app/ontology/concept/keyword-before> , <https://beatscript.app/ontology/concept/keyword-every> , <https://beatscript.app/ontology/concept/keyword-from> , <https://beatscript.app/ontology/concept/keyword-next> , <https://beatscript.app/ontology/concept/keyword-on> , <https://beatscript.app/ontology/concept/keyword-phrase> ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-arith> , <https://beatscript.app/ontology/concept/grammar-dur> , <https://beatscript.app/ontology/concept/grammar-pos> ;
	ns:usesToken <https://beatscript.app/ontology/concept/token-name> ;
	ns:writtenAs "when" .
<https://beatscript.app/ontology/concept/grammar-wire> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The wire production of BeatScript's grammar (at the top: wire changes.out -> walker.chords)."@en ;
	skos:prefLabel "wire"@en ;
	ns:ebnf "\"wire\" NAME \".\" port \"->\" NAME \".\" port" ;
	ns:grammarSection "Typed ports"@en ;
