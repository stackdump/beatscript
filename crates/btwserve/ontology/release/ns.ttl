<https://beatscript.app/ontology/concept/token-name> a skos:Concept , ns:TokenClass ;
	skos:definition "The lexer's NAME token, used in: SPEC, arg, arr_end, arrange, arrange_block, assert, atom, binding, block_end, call, def, do, end, form, gen, gen_param, import, invoke, launch, let, mut_op, mut_target, sample, section, seed, set_play, sexpr, sing, source, start, stored, template, until_when, when, wire."@en ;
