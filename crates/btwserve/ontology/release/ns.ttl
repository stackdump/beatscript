<https://beatscript.app/ontology/instrument/voice-robot-choir> a ns:BeatScriptVoice ;
	skos:definition "The BeatScript voice voice-robot-choir, written inst=voice-robot-choir."@en ;
	skos:prefLabel "voice-robot-choir"@en ;
	ns:inVoiceFamily <https://beatscript.app/ontology/concept/voice-family-choir> ;
	ns:status "stable" ;
	ns:writtenAs "inst=voice-robot-choir" .
<https://beatscript.app/ontology/instrument/voice-robot> a ns:BeatScriptVoice ;
	skos:definition "The BeatScript voice voice-robot, written inst=voice-robot."@en ;
	skos:prefLabel "voice-robot"@en ;
	ns:status "stable" ;
	ns:writtenAs "inst=voice-robot" .
<https://beatscript.app/ontology/instrument/voice-soprano> a ns:BeatScriptVoice ;
	skos:definition "The BeatScript voice voice-soprano, written inst=voice-soprano."@en ;
	skos:prefLabel "voice-soprano"@en ;
	ns:status "stable" ;
	ns:writtenAs "inst=voice-soprano" .
<https://beatscript.app/ontology/instrument/voice-talkbox> a ns:BeatScriptVoice ;
	skos:definition "The BeatScript voice voice-talkbox, written inst=voice-talkbox."@en ;
	skos:prefLabel "voice-talkbox"@en ;
	ns:status "stable" ;
	ns:writtenAs "inst=voice-talkbox" .
<https://beatscript.app/ontology/instrument/warm-pad> a ns:BeatScriptVoice , ns:Instrument ;
	rdfs:label "warm-pad"@en ;
	skos:definition "A slow, soft sustained pad."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/instrument/warm-pad> ;
	ns:inVoiceFamily <https://beatscript.app/ontology/concept/voice-family-pad> ;
	ns:status "stable" ;
	ns:writtenAs "inst=warm-pad" .
<https://beatscript.app/ontology/instrument/wobble-bass> a ns:Instrument ;
	rdfs:label "wobble-bass"@en ;
	skos:definition "A bass whose filter is modulated at a steady rate, giving the dubstep wobble."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/instrument/wobble-bass> .
<https://beatscript.app/ontology/instrument/wobble-lead> a ns:BeatScriptVoice ;
	skos:definition "The BeatScript voice wobble-lead, written inst=wobble-lead."@en ;
	skos:prefLabel "wobble-lead"@en ;
	ns:status "stable" ;
	ns:writtenAs "inst=wobble-lead" .
ns:ABPair a owl:Class ;
	rdfs:comment "Two complementary loops: the call and the answer, in the same key and at the same tempo, so either can follow the other."@en ;
	rdfs:label "A/B pair"@en ;
	rdfs:seeAlso <https://beatscript.app/ontology/concept/call-and-response> ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ABPair> ;
	ns:status "stable" .
ns:AlternationTerm a owl:Class ;
	rdfs:comment "Terms taken in turn, one per pass through the pattern."@en ;
	rdfs:label "alternation"@en ;
	rdfs:subClassOf ns:PatternTerm ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#AlternationTerm> ;
	ns:status "in-development" .
ns:Analysis a owl:Class ;
	rdfs:comment "A step that reads audio and reports facts about it: beats, key, stems."@en ;
	rdfs:label "audio analysis"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Analysis> ;
	ns:status "stable" .
ns:ArpTerm a owl:Class ;
	rdfs:comment "A chord's notes played one after another across the step."@en ;
	rdfs:label "arp term"@en ;
	rdfs:subClassOf ns:PatternTerm ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ArpTerm> ;
	ns:status "in-development" .
ns:ArrangeLine a owl:Class ;
	rdfs:comment "Orders section blocks in time. Read categorically, it is sequential composition."@en ;
	rdfs:label "arrange line"@en ;
	rdfs:subClassOf ns:ProgramLine ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ArrangeLine> ;
	ns:categoricalReading <https://beatscript.app/ontology/concept/sequential-composition> ;
	ns:status "in-development" .
ns:AudioEffect a owl:Class ;
	rdfs:comment "Something that changes a deck's sound as it plays."@en ;
	rdfs:label "audio effect"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#AudioEffect> ;
	ns:status "stable" .
ns:AuthorSignature a owl:Class ;
	rdfs:comment "A signature by the author over the program's CID, proving who sealed the link."@en ;
	rdfs:label "author signature"@en ;
	rdfs:seeAlso pflow:signature ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#AuthorSignature> ;
	ns:status "in-development" .
ns:Batch a owl:Class ;
	rdfs:comment "Several control commands sent as one, applied together."@en ;
	rdfs:label "batch"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Batch> ;
	ns:status "stable" .
ns:BeatGrid a owl:Class ;
	rdfs:comment "The positions of beats and downbeats in an audio file, found by a neural network (Beat This!)."@en ;
	rdfs:label "beat grid"@en ;
	rdfs:subClassOf ns:Analysis ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#BeatGrid> ;
	ns:status "stable" .
ns:BeatScriptVoice a owl:Class ;
	rdfs:comment "A voice a BeatScript part may name with inst=NAME: what /api/instruments lists."@en ;
	rdfs:label "BeatScript voice"@en ;
	rdfs:subClassOf ns:Instrument ;
	ns:status "stable" .
ns:CanonicalForm a owl:Class ;
	rdfs:comment "The normal form of a btw program: whitespace, numbers, note spelling and comments are normalised, so two spellings of one program have one canonical text and therefore one CID."@en ;
	rdfs:label "canonical form"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#CanonicalForm> ;
	ns:categoricalReading <https://beatscript.app/ontology/concept/normal-form> ;
	ns:status "in-development" .
ns:CategoricalConcept a owl:Class ;
	rdfs:comment "A notion from category theory used to read how decks, parts and sections compose."@en ;
	rdfs:label "categorical concept"@en ;
	rdfs:subClassOf ns:EngineConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#CategoricalConcept> ;
	ns:status "in-development" .
ns:ChordProgression a owl:Class ;
	rdfs:comment "A cycle of chords named by the scale degree of their root."@en ;
	rdfs:label "Chord progression"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ChordProgression> .
ns:ChordTerm a owl:Class ;
	rdfs:comment "Several notes sounded together on one step."@en ;
	rdfs:label "chord term"@en ;
	rdfs:subClassOf ns:PatternTerm ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ChordTerm> ;
	ns:status "in-development" .
ns:ContentId a owl:Class ;
	rdfs:comment "A name derived from the bytes it names (a CID): the same content always has the same identifier."@en ;
	rdfs:label "content identifier"@en ;
	rdfs:seeAlso pflow:modelCID ;
	rdfs:subClassOf ns:MusicConcept ;
	skos:scopeNote "pflow's modelCID is the content identifier of a net model; ProgramCID and NetCID are the same kind of name for a btw program and for the net a deck runs."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ContentId> ;
	ns:status "stable" .
ns:ControlLanguage a owl:Class ;
	rdfs:comment "The app's text command language: every control is a noun (what) and a verb (do what). One verb, describe, tells a user what a noun can do."@en ;
	rdfs:label "control language"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ControlLanguage> ;
	ns:status "stable" .
ns:ControlLine a owl:Class ;
	rdfs:comment "A line that sets something about the deck rather than playing notes: tempo, key, a level."@en ;
	rdfs:label "control line"@en ;
	rdfs:subClassOf ns:ProgramLine ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ControlLine> ;
	ns:status "in-development" .
ns:ControlNet a owl:Class ;
	rdfs:comment "A linear net that fires mute and unmute actions at section boundaries, which is how a song structure plays out."@en ;
	rdfs:label "Control net"@en ;
	rdfs:seeAlso pflow:PetriNet ;
	rdfs:subClassOf ns:EngineNet ;
	skos:closeMatch pflow:PetriNet ;
	skos:scopeNote "A control net is a linear workflow: its transitions fire once, in order."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ControlNet> .
ns:ControlNoun a owl:Class ;
	rdfs:comment "The thing a control command acts on: a deck, a fader, an effect."@en ;
	rdfs:label "control noun"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ControlNoun> ;
	ns:status "stable" .
ns:ControlVerb a owl:Class ;
	rdfs:comment "What a control command does to its noun."@en ;
	rdfs:label "control verb"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ControlVerb> ;
	ns:status "stable" .
ns:Credit a owl:Class ;
	rdfs:comment "An acknowledgement of someone whose work a track uses, such as a sample or a forked program's author."@en ;
	rdfs:label "credit"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Credit> ;
	ns:status "in-development" .
ns:Deck a owl:Class ;
	rdfs:comment "One playback channel of the DJ app. Each deck runs a Petri net compiled from a program."@en ;
	rdfs:label "deck"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Deck> ;
	ns:categoricalReading <https://beatscript.app/ontology/concept/free-smc> ;
	ns:status "stable" .
ns:DjConcept a owl:Class ;
	rdfs:comment "Root of the things a DJ app has: collections of loops, set planning, performance moves, effects, analysis and the control language."@en ;
	rdfs:label "DJ concept"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#DjConcept> .
ns:DoLine a owl:Class ;
	rdfs:comment "Runs one verb of the control language, so a program can reach any control the app has without a dedicated syntax for it."@en ;
	rdfs:label "do line"@en ;
	rdfs:subClassOf ns:ProgramLine ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#DoLine> ;
	ns:status "in-development" .
ns:DrumKit a owl:Class ;
	rdfs:comment "A set of drum sounds a part may name with kit=NAME."@en ;
	rdfs:label "drum kit"@en ;
	rdfs:subClassOf ns:Instrument ;
	ns:status "stable" .
ns:DrumVariant a owl:Class ;
	rdfs:comment "A named alteration (B, C) of a genre's base drum rhythm: add pulses, scale them, rotate."@en ;
	rdfs:label "Drum variant"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#DrumVariant> .
ns:Ending a owl:Class ;
	rdfs:comment "What happens when a program's last section finishes: it ends, or it loops back to the start."@en ;
	rdfs:label "ending"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Ending> ;
	ns:status "in-development" .
ns:EngineConcept a owl:Class ;
	rdfs:comment "A concept from the generator or sequencer that is not itself a genre property: the Bjorklund algorithm, Markov melody, swing and so on."@en ;
	rdfs:label "Engine concept"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#EngineConcept> .
ns:EngineNet a owl:Class ;
	rdfs:comment "A Petri net the sequencer executes to make sound."@en ;
	rdfs:label "Engine net"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	skos:closeMatch pflow:PetriNet ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#EngineNet> ;
	ns:categoricalReading <https://beatscript.app/ontology/concept/free-smc> .
ns:EuclidTerm a owl:Class ;
	rdfs:comment "K hits spread evenly over N steps, as a Euclidean rhythm."@en ;
	rdfs:label "euclid term"@en ;
	rdfs:seeAlso ns:EuclideanRhythm ;
	rdfs:subClassOf ns:PatternTerm ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#EuclidTerm> ;
	ns:status "in-development" .
ns:EuclideanRhythm a owl:Class ;
	rdfs:comment "K pulses spread as evenly as possible over N steps, then rotated."@en ;
	rdfs:label "Euclidean rhythm"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#EuclideanRhythm> .
ns:EvolveOperator a owl:Class ;
	rdfs:comment "An operation an evolve block applies to a part every N bars, generation after generation."@en ;
	rdfs:label "evolve operator"@en ;
	rdfs:subClassOf ns:PatternTransform ;
	ns:status "stable" .
ns:Feel a owl:Class ;
	rdfs:comment "How a line's syllables sit on the grid: on the sixteenths, or in groups of three."@en ;
	rdfs:label "feel"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:Fork a owl:Class ;
	rdfs:comment "A track made by changing another track. It names what it was forked from, and so its credits and licence trace back."@en ;
	rdfs:label "fork"@en ;
	rdfs:subClassOf ns:TrackObject ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Fork> ;
	ns:status "in-development" .
ns:Form a owl:Class ;
	rdfs:comment "A shape for a whole track from classical music: its sections, the order they come in, and the plan of arrange mutations that changes them pass after pass. Each is a template built from public-domain themes (docs/forms)."@en ;
	rdfs:label "form"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:FormantVoice a owl:Class ;
	rdfs:comment "A synthesised voice built from formants, the resonances that make vowels. It can sing a vocal line with no recorded voice involved."@en ;
	rdfs:label "formant voice"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#FormantVoice> ;
	ns:status "stable" .
ns:Freeze a owl:Class ;
	rdfs:comment "A granular effect that holds one moment of a deck's sound and stretches it into a sustained texture."@en ;
	rdfs:label "freeze"@en ;
	rdfs:subClassOf ns:AudioEffect ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Freeze> ;
	ns:status "stable" .
ns:Genre a owl:Class ;
	rdfs:comment "A style the sequencer can generate a whole track in. Each carries the defaults that make it recognisable: tempo, scale, drum rhythms, groove, feel."@en ;
	rdfs:label "Genre"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Genre> .
ns:GenreFamily a owl:Class ;
	rdfs:comment "A group of genres that share song structures and section energy: edm, song, jazz, chill."@en ;
	rdfs:label "Genre family"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#GenreFamily> .
ns:GrammarProduction a owl:Class ;
	rdfs:comment "One production of BeatScript's grammar (grammar.ebnf, ISO 14977 EBNF; beatscript.app/docs/language). Its ns:ebnf is the right-hand side as written."@en ;
	rdfs:label "grammar production"@en ;
	rdfs:subClassOf ns:LanguageTerm ;
	ns:status "stable" .
ns:Groove a owl:Class ;
	rdfs:comment "How the bass line locks to the drums."@en ;
	rdfs:label "Groove"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Groove> .
ns:GroupTerm a owl:Class ;
	rdfs:comment "Several terms squeezed into the time of one step."@en ;
	rdfs:label "group"@en ;
	rdfs:subClassOf ns:PatternTerm ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#GroupTerm> ;
	ns:status "in-development" .
ns:HistoryBuffer a owl:Class ;
	rdfs:comment "A rolling memory of the last seconds a deck played. Capture-to-loop cuts a loop out of it after the fact."@en ;
	rdfs:label "history buffer"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#HistoryBuffer> ;
	ns:status "stable" .
ns:HitTerm a owl:Class ;
	rdfs:comment "A step that sounds."@en ;
	rdfs:label "hit"@en ;
	rdfs:subClassOf ns:PatternTerm ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#HitTerm> ;
	ns:status "in-development" .
ns:ImportLine a owl:Class ;
	rdfs:comment "Brings in another program by CID. Pinning by content identifier means the imported text can never change under the importer."@en ;
	rdfs:label "import line"@en ;
	rdfs:subClassOf ns:ProgramLine ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ImportLine> ;
	ns:categoricalReading <https://beatscript.app/ontology/concept/open-net-cospan> ;
	ns:status "in-development" .
ns:InsertEffect a owl:Class ;
	rdfs:comment "An effect placed in a deck's signal path, so all of the deck's sound passes through it."@en ;
	rdfs:label "insert effect"@en ;
	rdfs:subClassOf ns:AudioEffect ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#InsertEffect> ;
	ns:status "stable" .
ns:Instrument a owl:Class ;
	rdfs:comment "A named sound the synth engine can play."@en ;
	rdfs:label "Instrument"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Instrument> .
ns:InstrumentRole a owl:Class ;
	rdfs:comment "The job a track does in the mix: kick, snare, hihat, clap, bass, melody, harmony, arp."@en ;
	rdfs:label "Instrument role"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#InstrumentRole> .
ns:KeyDetection a owl:Class ;
	rdfs:comment "Finds the musical key of audio and reports it as a Camelot code, which says which keys mix well together."@en ;
	rdfs:label "key detection"@en ;
	rdfs:subClassOf ns:Analysis ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#KeyDetection> ;
	ns:status "stable" .
ns:Keyword a owl:Class ;
	rdfs:comment "A terminal of BeatScript's grammar: a word or a symbol written as it is."@en ;
	rdfs:label "keyword"@en ;
	rdfs:subClassOf ns:LanguageTerm ;
	ns:status "stable" .
ns:LanguageTerm a owl:Class ;
	rdfs:comment "A piece of the BeatScript language as its grammar states it: a production, a keyword or a token class."@en ;
	rdfs:label "BeatScript language term"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:LetLine a owl:Class ;
	rdfs:comment "Binds a name to a value or pattern for use further down the program."@en ;
	rdfs:label "let line"@en ;
	rdfs:subClassOf ns:ProgramLine ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#LetLine> ;
	ns:status "in-development" .
ns:License a owl:Class ;
	rdfs:comment "The terms a track is shared under."@en ;
	rdfs:label "licence"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#License> ;
	ns:status "in-development" .
ns:Loop a owl:Class ;
	rdfs:comment "A short stretch of music that repeats cleanly."@en ;
	rdfs:label "loop"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Loop> ;
	ns:status "stable" .
ns:LoopSet a owl:Class ;
	rdfs:comment "A collection of loops, either curated by hand or generated from a seed."@en ;
	rdfs:label "loop set"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#LoopSet> ;
	ns:status "stable" .
ns:MacroDefinition a owl:Class ;
	rdfs:comment "A parameterised macro. It is total: a macro cannot call itself, directly or through others, so expansion always ends. Repetition is written repeat N."@en ;
	rdfs:label "def (macro definition)"@en ;
	rdfs:subClassOf ns:ProgramLine ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#MacroDefinition> ;
	ns:categoricalReading <https://beatscript.app/ontology/concept/open-net-cospan> ;
	ns:status "in-development" .
ns:Mashup a owl:Class ;
	rdfs:comment "Stems of different tracks played together, matched in key and tempo."@en ;
	rdfs:label "mashup"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Mashup> ;
	ns:status "stable" .
ns:McpServer a owl:Class ;
	rdfs:comment "A Model Context Protocol server: tools an AI assistant such as Claude can call to use a product."@en ;
	rdfs:label "MCP server"@en ;
	rdfs:subClassOf ns:Product ;
	ns:status "stable" .
ns:McpTool a owl:Class ;
	rdfs:comment "One tool of an MCP server: its name, description and input schema, as the server's tools/list gives them."@en ;
	rdfs:label "MCP tool"@en ;
	owl:disjointWith ns:MusicConcept , ns:Product ;
	ns:status "stable" .
ns:MelodyRing a owl:Class ;
	rdfs:comment "The same ring, with a note binding on every non-rest step: a melody, bass line or arpeggio written out as a cycle."@en ;
	rdfs:label "Melody ring"@en ;
	rdfs:subClassOf ns:EngineNet ;
	skos:closeMatch pflow:PetriNet ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#MelodyRing> .
ns:MeterFamily a owl:Class ;
	rdfs:comment "A kind of line, by how its stresses fall: the closed set a phrasebook entry is filed under."@en ;
	rdfs:label "meter family"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:MusicConcept a owl:Class ;
	rdfs:comment "Root of everything this ontology describes about music."@en ;
	rdfs:label "Music concept"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#MusicConcept> .
ns:MutationOperator a owl:Class ;
	rdfs:comment "An operator of an arrange mutation: it changes a let pattern from one point of the arrangement (~) or for one section (@)."@en ;
	rdfs:label "arrange mutation operator"@en ;
	rdfs:subClassOf ns:PatternTransform ;
	ns:status "stable" .
ns:NetCID a owl:Class ;
	rdfs:comment "The content identifier of the Petri net one deck runs, in pflow's canonical net form. Two decks with equal nets have equal NetCIDs whatever program produced them."@en ;
	rdfs:label "net CID"@en ;
	rdfs:seeAlso pflow:modelCID ;
	rdfs:subClassOf ns:ContentId ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#NetCID> ;
	ns:status "in-development" .
ns:NotesSegment a owl:Class ;
	rdfs:comment "Free text riding on a share link outside the seal. Editing it does not change the program's CID."@en ;
	rdfs:label "notes segment"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#NotesSegment> ;
	ns:status "in-development" .
ns:Palette a owl:Class ;
	rdfs:comment "A named set of sounds a program can choose as a whole."@en ;
	rdfs:label "palette"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:PartLine a owl:Class ;
	rdfs:comment "A line that names a part (drums, bass, lead) and gives it a pattern of terms to play."@en ;
	rdfs:label "part line"@en ;
	rdfs:subClassOf ns:ProgramLine ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#PartLine> ;
	ns:categoricalReading <https://beatscript.app/ontology/concept/monoidal-product> ;
	ns:status "in-development" .
ns:PatternGenerator a owl:Class ;
	rdfs:comment "A call that makes a pattern from its arguments, such as e(5,8), markov(0.6), chord(am) or choose."@en ;
	rdfs:label "pattern generator"@en ;
	rdfs:subClassOf ns:PatternTerm ;
	ns:status "stable" .
ns:PatternModifier a owl:Class ;
	rdfs:comment "A mark written after a term or part that changes how it plays: repeat, chance, accent, slide, cycle length."@en ;
	rdfs:label "pattern modifier"@en ;
	rdfs:subClassOf ns:PatternTerm ;
	ns:status "stable" .
ns:PatternTerm a owl:Class ;
	rdfs:comment "One element of a part's pattern."@en ;
	rdfs:label "pattern term"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#PatternTerm> ;
	ns:status "in-development" .
ns:PatternTransform a owl:Class ;
	rdfs:comment "A function from patterns to patterns, such as transpose or reverse. Transforms compose and have an identity, so they form a monoid."@en ;
	rdfs:label "pattern transform"@en ;
	rdfs:subClassOf ns:EngineConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#PatternTransform> ;
	ns:status "in-development" .
ns:PerformMove a owl:Class ;
	rdfs:comment "A gesture the app carries out for the DJ: a timed change to one or both decks."@en ;
	rdfs:label "perform move"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#PerformMove> ;
	ns:status "stable" .
ns:PhraseTemplate a owl:Class ;
	rdfs:comment "A template that compiles a phrase to a whole track: arrange from template(NAME, PHRASE). The phrase is the vocal line (its syllables the line's length, its stress the accents and the beats, its meter the subdivision); the arrangement is the template's own."@en ;
	rdfs:label "phrase template"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:Phrasebook a owl:Class ;
	rdfs:comment "A curated set of phrases a program sings by id: sing @id on melody. The public-domain one is lines of verse, scripture, speech and work song first published before 1929, as a CC0 file with one CID."@en ;
	rdfs:label "phrasebook"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:PhrasebookEntry a owl:Class ;
	rdfs:comment "One line of a phrasebook: its words, the lyric BeatScript sings them as, where and when it was first published, and its meter as a step pattern."@en ;
	rdfs:label "phrasebook entry"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:Product a owl:Class ;
	rdfs:comment "Something shipped under a name: a website, a language, an app or an MCP server."@en ;
	rdfs:label "product"@en ;
	owl:disjointWith ns:MusicConcept ;
	ns:status "stable" .
ns:ProductFamily a owl:Class ;
	rdfs:comment "One name shared by several products that are used together."@en ;
	rdfs:label "product family"@en ;
	rdfs:subClassOf ns:Product ;
	ns:status "stable" .
ns:Program a owl:Class ;
	rdfs:comment "A piece written in btw, the bitwrap language: lines of text that compile to the Petri nets of a DJ deck. Identified by the CID of its canonical text."@en ;
	rdfs:label "btw program"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	skos:closeMatch pflow:PetriNet ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Program> ;
	ns:status "in-development" .
ns:ProgramCID a owl:Class ;
	rdfs:comment "The content identifier of a program's canonical text."@en ;
	rdfs:label "program CID"@en ;
	rdfs:subClassOf ns:ContentId ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ProgramCID> ;
	ns:status "in-development" .
ns:ProgramLine a owl:Class ;
	rdfs:comment "One line of a btw program. The kind of line says what it declares."@en ;
	rdfs:label "program line"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ProgramLine> ;
	ns:status "in-development" .
ns:Queue a owl:Class ;
	rdfs:comment "The segments waiting to play next on a deck."@en ;
	rdfs:label "queue"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Queue> ;
	ns:status "stable" .
ns:RestTerm a owl:Class ;
	rdfs:comment "A step that is silent."@en ;
	rdfs:label "rest"@en ;
	rdfs:subClassOf ns:PatternTerm ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#RestTerm> ;
	ns:status "in-development" .
ns:RhythmRing a owl:Class ;
	rdfs:comment "N places in a cycle, one token circulating, one transition per step; transitions at pulse positions carry a note binding, the rest are silent. Realises a Euclidean rhythm."@en , "Realised as a cycle of places and transitions with one token; the cycle makes it a state machine in pflow's terms."@en ;
	rdfs:label "Rhythm ring"@en ;
	rdfs:seeAlso pflow:PetriNet ;
	rdfs:subClassOf ns:EngineNet ;
	skos:closeMatch pflow:PetriNet ;
	skos:scopeNote "A rhythm ring is a state machine in pflow's sense: every transition has one input place and one output place, and the net holds exactly one token."@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#RhythmRing> .
ns:Scale a owl:Class ;
	rdfs:comment "A set of pitch-class offsets in semitones from a root."@en ;
	rdfs:label "Scale"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Scale> .
ns:SectionBlock a owl:Class ;
	rdfs:comment "A named group of lines that plays as one section of the piece. Unrelated to ns:SongSection, which is a genre-level template slot; a section block is whatever the author wrote."@en ;
	rdfs:label "section block"@en ;
	rdfs:subClassOf ns:ProgramLine ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#SectionBlock> ;
	ns:status "in-development" .
ns:SectionProfile a owl:Class ;
	rdfs:comment "What a section means in one family: which roles play and how much energy it carries."@en ;
	rdfs:label "Section profile"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#SectionProfile> .
ns:SectionSlot a owl:Class ;
	rdfs:comment "One numbered place in a song structure, filled by a section."@en ;
	rdfs:label "Section slot"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#SectionSlot> .
ns:Segment a owl:Class ;
	rdfs:comment "One stretch of a set list: a track or loop and how long it plays."@en ;
	rdfs:label "segment"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Segment> ;
	ns:status "stable" .
ns:SetList a owl:Class ;
	rdfs:comment "A plan for a DJ set: an ordered list of segments."@en ;
	rdfs:label "set list"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#SetList> ;
	ns:status "stable" .
ns:SetRecording a owl:Class ;
	rdfs:comment "A recording of a performed set, identified by a CID over its tracklist."@en ;
	rdfs:label "set recording"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#SetRecording> ;
	ns:status "stable" .
ns:ShareLink a owl:Class ;
	rdfs:comment "A URL that carries a whole track in itself: the program's CID and its deflated canonical text sit in the fragment, so opening the link needs no server lookup and the text can be checked against the CID. May include an author signature, and an unsealed notes segment that is not covered by the seal."@en ;
	rdfs:label "share link"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ShareLink> ;
	ns:status "in-development" .
ns:SongSection a owl:Class ;
	rdfs:comment "A named stretch of a song: intro, verse, drop and so on."@en ;
	rdfs:label "Song section"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#SongSection> .
ns:SongStructure a owl:Class ;
	rdfs:comment "An ordered template of sections for one genre family and length class."@en ;
	rdfs:label "Song structure"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#SongStructure> .
ns:Stem a owl:Class ;
	rdfs:comment "One separated part of a mix."@en ;
	rdfs:label "stem"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Stem> ;
	ns:status "in-development" .
ns:StemSeparation a owl:Class ;
	rdfs:comment "Splits a mix into stems (drums, bass, vocals, other) with a port of the Demucs model."@en ;
	rdfs:label "stem separation"@en ;
	rdfs:subClassOf ns:Analysis ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#StemSeparation> ;
	ns:status "in-development" .
ns:Technique a owl:Class ;
	rdfs:comment "A way of writing music that a person or an agent can follow, taught by one document and used through the language's own words."@en ;
	rdfs:label "composition technique"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:ThemeEntry a owl:Class ;
	rdfs:comment "One theme of a theme library: its bars in a stated key, its role, meter, source work, composer and year, and the themes it pairs with."@en ;
	rdfs:label "theme"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:ThemeLibrary a owl:Class ;
	rdfs:comment "A curated set of melodies, basses and figures written as BeatScript bars to borrow. The public-domain one is music composed and first published before 1929, written from the melody itself, as a CC0 file with one CID: the melodic twin of the phrasebook."@en ;
	rdfs:label "theme library"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:ThemeMode a owl:Class ;
	rdfs:comment "Whether a theme is in a major key, a minor key, or neither (a pedal or an ostinato)."@en ;
	rdfs:label "theme mode"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:ThemeRole a owl:Class ;
	rdfs:comment "The part a theme is written for: melody, bass, harmony or arp."@en ;
	rdfs:label "theme role"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:TimingWord a owl:Class ;
	rdfs:comment "A phrase that says when a change happens: at a bar, on the next phrase, every N bars, for N bars, or as a ramp."@en ;
	rdfs:label "timing word"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#TimingWord> ;
	ns:status "in-development" .
ns:TokenClass a owl:Class ;
	rdfs:comment "A kind of token the lexer recognises, such as NAME, INT or NOTE: named in the grammar, defined by the lexer."@en ;
	rdfs:label "token class"@en ;
	rdfs:subClassOf ns:LanguageTerm ;
	ns:status "stable" .
ns:TrackObject a owl:Class ;
	rdfs:comment "A published track: a program plus the rights and provenance that go with it."@en ;
	rdfs:label "track object"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#TrackObject> ;
	ns:status "in-development" .
ns:Visibility a owl:Class ;
	rdfs:comment "Whether a track is listed for anyone or only for those with its link."@en ;
	rdfs:label "visibility"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Visibility> ;
	ns:status "in-development" .
ns:VocalLine a owl:Class ;
	rdfs:comment "Typed lyrics turned into phonemes and notes for a formant voice to sing. The phoneme path uses CC0 data only."@en ;
	rdfs:label "vocal line"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#VocalLine> ;
	ns:status "stable" .
ns:Vocoder a owl:Class ;
	rdfs:comment "An effect that imposes the spectral shape of one signal (the modulator, usually a voice) onto another (the carrier, usually a synth or a deck)."@en ;
	rdfs:label "vocoder"@en ;
	rdfs:subClassOf ns:AudioEffect ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#Vocoder> ;
	ns:status "stable" .
ns:VocoderInput a owl:Class ;
	rdfs:comment "A signal fed into a vocoder, as modulator or as carrier."@en ;
	rdfs:label "vocoder input"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#VocoderInput> ;
	ns:status "stable" .
ns:VocoderInstance a owl:Class ;
	rdfs:comment "One running copy of a vocoder, with its own modulator, carrier and settings."@en ;
	rdfs:label "vocoder instance"@en ;
	rdfs:subClassOf ns:DjConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#VocoderInstance> ;
	ns:status "stable" .
ns:VoiceFamily a owl:Class ;
	rdfs:comment "A family word: an inst= name that contains it plays the family's generic voice."@en ;
	rdfs:label "voice family"@en ;
	rdfs:subClassOf ns:MusicConcept ;
	ns:status "stable" .
ns:acceptsVerb a owl:ObjectProperty ;
	rdfs:label "accepts verb"@en ;
	owl:inverseOf ns:actsOn ;
	ns:status "stable" .
ns:activeRole a owl:ObjectProperty ;
	rdfs:domain ns:SectionProfile ;
	rdfs:label "active role"@en ;
	rdfs:range ns:InstrumentRole ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#activeRole> .
ns:actsOn a owl:ObjectProperty ;
	rdfs:domain ns:ControlVerb ;
	rdfs:label "acts on"@en ;
	rdfs:range ns:ControlNoun ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#actsOn> .
ns:arpInstrument a owl:ObjectProperty ;
	rdfs:comment "MIDI channel 5."@en ;
	rdfs:label "arp instrument"@en ;
	rdfs:subPropertyOf ns:usesInstrument ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#arpInstrument> .
ns:author a owl:DatatypeProperty ;
	rdfs:domain ns:TrackObject ;
	rdfs:label "author"@en ;
	rdfs:range xsd:string ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#author> ;
	ns:status "in-development" .
ns:barPattern a owl:DatatypeProperty ;
	rdfs:comment "One bar of the theme as a BeatScript pattern (the bars in order, as a list)."@en ;
	rdfs:domain ns:ThemeEntry ;
	rdfs:label "bar pattern"@en ;
	rdfs:range xsd:string ;
	ns:status "stable" .
ns:bassDensity a owl:DatatypeProperty ;
	rdfs:domain ns:Genre ;
	rdfs:label "bass density"@en ;
	rdfs:range xsd:decimal ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#bassDensity> .
ns:bassDuration a owl:DatatypeProperty ;
	rdfs:domain ns:Genre ;
	rdfs:label "bass note length"@en ;
	rdfs:range xsd:integer ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#bassDuration> .
ns:bassInstrument a owl:ObjectProperty ;
	rdfs:comment "MIDI channel 6."@en ;
	rdfs:label "bass instrument"@en ;
	rdfs:subPropertyOf ns:usesInstrument ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#bassInstrument> .
ns:batchesVerb a owl:ObjectProperty ;
	rdfs:domain ns:Batch ;
	rdfs:label "batches verb"@en ;
	rdfs:range ns:ControlVerb ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#batchesVerb> .
ns:bpm a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:comment "Beats per minute the generator starts at. Not a rule of the genre."@en ;
	rdfs:domain ns:Genre ;
	rdfs:label "default tempo"@en ;
	rdfs:range xsd:integer ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#bpm> .
ns:callResponse a owl:DatatypeProperty ;
	rdfs:domain ns:Genre ;
	rdfs:label "call and response"@en ;
	rdfs:range xsd:boolean ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#callResponse> .
ns:callSyllables a owl:DatatypeProperty ;
	rdfs:comment "For a work song, how many of the first syllables are the leader's call; the rest is the crew's answer."@en ;
	rdfs:domain ns:PhrasebookEntry ;
	rdfs:label "call syllables"@en ;
	rdfs:range xsd:integer ;
	ns:status "stable" .
ns:camelot a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:comment "The key on the Camelot wheel, such as 8A."@en ;
	rdfs:domain ns:Program ;
	rdfs:label "Camelot code"@en ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://beatscript.app/ontology/concept/camelot-wheel> ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#camelot> ;
	ns:status "in-development" .
ns:canonicalText a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:comment "The program in canonical form."@en ;
	rdfs:domain ns:Program ;
	rdfs:label "canonical text"@en ;
	rdfs:range xsd:string ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#canonicalText> ;
	ns:status "in-development" .
ns:capturesLoop a owl:ObjectProperty ;
	rdfs:domain ns:HistoryBuffer ;
	rdfs:label "captures loop"@en ;
	rdfs:range ns:Loop ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#capturesLoop> .
ns:categoricalReading a owl:ObjectProperty ;
	rdfs:comment "The notion from category theory that this construct is an instance of."@en ;
	rdfs:domain ns:MusicConcept ;
	rdfs:label "categorical reading"@en ;
	rdfs:range ns:CategoricalConcept ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#categoricalReading> ;
	ns:status "in-development" .
ns:chordCount a owl:DatatypeProperty ;
	rdfs:domain ns:ChordProgression ;
	rdfs:label "chord count"@en ;
	rdfs:range xsd:integer ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#chordCount> .
ns:collectionKind a owl:DatatypeProperty ;
	rdfs:comment "\"curated\" (picked by hand) or \"seeded\" (generated from a seed)."@en ;
	rdfs:domain ns:LoopSet ;
	rdfs:label "collection kind"@en ;
	rdfs:range xsd:string ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#collectionKind> .
ns:controlParameter a owl:DatatypeProperty ;
	rdfs:domain ns:ControlNoun ;
	rdfs:label "control parameter"@en ;
	rdfs:range xsd:string ;
	ns:status "stable" .
ns:cycleSteps a owl:DatatypeProperty ;
	rdfs:comment "The sixteenths one bar of the theme takes on the grid: 16, 12 for 3/4, 20 for 5/4."@en ;
	rdfs:domain ns:ThemeEntry ;
	rdfs:label "cycle steps"@en ;
	rdfs:range xsd:integer ;
	ns:status "stable" .
ns:defaultGroove a owl:FunctionalProperty , owl:ObjectProperty ;
	rdfs:domain ns:Genre ;
	rdfs:label "default groove"@en ;
	rdfs:range ns:Groove ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#defaultGroove> .
ns:defaultScale a owl:FunctionalProperty , owl:ObjectProperty ;
	rdfs:domain ns:Genre ;
	rdfs:label "default scale"@en ;
	rdfs:range ns:Scale ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#defaultScale> .
ns:defaultVerb a owl:FunctionalProperty , owl:ObjectProperty ;
	rdfs:domain ns:ControlNoun ;
	rdfs:label "default verb"@en ;
	rdfs:range ns:ControlVerb ;
	ns:status "stable" .
ns:degrees a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:comment "Scale degree of each chord's root, counted from 1, space separated."@en ;
	rdfs:domain ns:ChordProgression ;
	rdfs:label "degrees"@en ;
	rdfs:range xsd:string ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#degrees> .
ns:drumFills a owl:DatatypeProperty ;
	rdfs:domain ns:Genre ;
	rdfs:label "drum fills"@en ;
	rdfs:range xsd:boolean ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#drumFills> .
ns:drumKit a owl:ObjectProperty ;
	rdfs:comment "MIDI channel 10."@en ;
	rdfs:label "drum kit"@en ;
	rdfs:subPropertyOf ns:usesInstrument ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#drumKit> .
ns:drumRhythm a owl:ObjectProperty ;
	rdfs:domain ns:Genre ;
	rdfs:label "drum rhythm"@en ;
	rdfs:range ns:EuclideanRhythm ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#drumRhythm> .
ns:durationVariation a owl:DatatypeProperty ;
	rdfs:domain ns:Genre ;
	rdfs:label "duration variation"@en ;
	rdfs:range xsd:decimal ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#durationVariation> .
ns:ebnf a owl:DatatypeProperty ;
	rdfs:comment "The production's right-hand side in ISO 14977 EBNF, comments removed and whitespace collapsed."@en ;
	rdfs:domain ns:GrammarProduction ;
	rdfs:label "EBNF"@en ;
	rdfs:range xsd:string ;
	ns:status "stable" .
ns:edition a owl:DatatypeProperty ;
	rdfs:comment "The pre-1929 edition the text was read from."@en ;
	rdfs:domain ns:PhrasebookEntry ;
	rdfs:label "edition"@en ;
	rdfs:range xsd:string ;
	ns:status "stable" .
ns:energy a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:comment "Target loudness and intensity of the section, 0 to 1."@en ;
	rdfs:domain ns:SectionProfile ;
	rdfs:label "energy"@en ;
	rdfs:range xsd:decimal ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#energy> .
ns:feel a owl:ObjectProperty ;
	rdfs:domain ns:PhrasebookEntry ;
	rdfs:label "feel"@en ;
	rdfs:range ns:Feel ;
	ns:status "stable" .
ns:filterOpen a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:comment "How open the filter is in the section, 0 (closed) to 1 (open)."@en ;
	rdfs:domain ns:SectionProfile ;
	rdfs:label "filter openness"@en ;
	rdfs:range xsd:decimal ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#filterOpen> .
ns:firstPublished a owl:DatatypeProperty ;
	rdfs:comment "The year the work was first published (a work song: the year of the earliest collection this wording was read in)."@en ;
	rdfs:domain ns:PhrasebookEntry ;
	rdfs:label "first published"@en ;
	rdfs:range xsd:gYear ;
	ns:status "stable" .
ns:forFamily a owl:FunctionalProperty , owl:ObjectProperty ;
	rdfs:label "for family"@en ;
	rdfs:range ns:GenreFamily ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#forFamily> .
ns:forRole a owl:FunctionalProperty , owl:ObjectProperty ;
	rdfs:label "for role"@en ;
	rdfs:range ns:InstrumentRole ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#forRole> .
ns:forkedFrom a owl:FunctionalProperty , owl:ObjectProperty ;
	rdfs:domain ns:Fork ;
	rdfs:label "forked from"@en ;
	rdfs:range ns:TrackObject ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#forkedFrom> ;
	ns:status "in-development" .
ns:formShape a owl:DatatypeProperty ;
	rdfs:comment "The sections of the form and the order they come in."@en ;
	rdfs:domain ns:Form ;
	rdfs:label "form shape"@en ;
	rdfs:range xsd:string ;
	ns:status "stable" .
ns:formTemplate a owl:ObjectProperty ;
	rdfs:comment "The template that writes the form: arrange from template(<name>, <phrase>)."@en ;
	rdfs:domain ns:Form ;
	rdfs:label "form template"@en ;
	rdfs:range ns:PhraseTemplate ;
	ns:status "stable" .
ns:genreId a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:comment "The name the generator and its API use for this genre."@en ;
	rdfs:domain ns:Genre ;
	rdfs:label "genre id"@en ;
	rdfs:range xsd:string ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#genreId> .
ns:ghostNotes a owl:DatatypeProperty ;
	rdfs:domain ns:Genre ;
	rdfs:label "ghost notes"@en ;
	rdfs:range xsd:decimal ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/ns#ghostNotes> .
ns:grammarSection a owl:DatatypeProperty ;
	rdfs:domain ns:GrammarProduction ;
