<https://beatscript.app/ontology/concept/license-all-rights-reserved> a skos:Concept , ns:License ;
	skos:definition "No licence is granted beyond what the law allows by default."@en ;
	skos:prefLabel "all rights reserved"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/license-all-rights-reserved> ;
	ns:isDefaultLicense false ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/license-cc-by-4-0> a skos:Concept , ns:License ;
	skos:closeMatch <https://creativecommons.org/licenses/by/4.0/> ;
	skos:definition "Creative Commons Attribution 4.0: anyone may reuse the track if they credit the author."@en ;
	skos:prefLabel "CC-BY-4.0"@en ;
