<https://beatscript.app/ontology/concept/grammar-shape> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The shape production of BeatScript's grammar."@en ;
	skos:prefLabel "shape"@en ;
	ns:ebnf "\"linear\" | \"exp\" | \"log\" | \"s-curve\" | \"step\" INT" ;
	ns:grammarSection "Shapes and lfo"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-exp> , <https://beatscript.app/ontology/concept/keyword-linear> , <https://beatscript.app/ontology/concept/keyword-log> , <https://beatscript.app/ontology/concept/keyword-s-curve> , <https://beatscript.app/ontology/concept/keyword-step> ;
	ns:usesToken <https://beatscript.app/ontology/concept/token-int> ;
	ns:writtenAs "shape" .
<https://beatscript.app/ontology/concept/grammar-sing> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The sing production of BeatScript's grammar (a tonal role; PHRASE: a phrasebook id, @hands_up)."@en ;
	skos:prefLabel "sing"@en ;
	ns:ebnf "\"sing\" ( lyric | PHRASE ) \"on\" role { \"bars=\" INT | \"key=\" KEY | \"voice=\" NAME }" ;
	ns:grammarSection "Mix moves and sung lyrics"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-bars-param> , <https://beatscript.app/ontology/concept/keyword-key-param> , <https://beatscript.app/ontology/concept/keyword-on> , <https://beatscript.app/ontology/concept/keyword-sing> , <https://beatscript.app/ontology/concept/keyword-voice-param> ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-lyric> , <https://beatscript.app/ontology/concept/grammar-role> ;
	ns:usesToken <https://beatscript.app/ontology/concept/token-int> , <https://beatscript.app/ontology/concept/token-key> , <https://beatscript.app/ontology/concept/token-name> , <https://beatscript.app/ontology/concept/token-phrase> ;
	ns:writtenAs "sing" .
<https://beatscript.app/ontology/concept/grammar-source> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The source production of BeatScript's grammar (an engine call; a public-domain theme by id (ode_to_joy); notes; another template; a stored program's part or sections)."@en ;
	skos:prefLabel "source"@en ;
	ns:ebnf "gen | NAME | notes | form | stored" ;
	ns:grammarSection "Phrase templates"@en ;
	ns:status "stable" ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-form> , <https://beatscript.app/ontology/concept/grammar-gen> , <https://beatscript.app/ontology/concept/grammar-notes> , <https://beatscript.app/ontology/concept/grammar-stored> ;
	ns:usesToken <https://beatscript.app/ontology/concept/token-name> ;
	ns:writtenAs "source" .
<https://beatscript.app/ontology/concept/grammar-span> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The span production of BeatScript's grammar."@en ;
	skos:prefLabel "span"@en ;
	ns:ebnf "\"over\" dur" ;
	ns:grammarSection "Control: what the mix does"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-over> ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-dur> ;
	ns:writtenAs "span" .
<https://beatscript.app/ontology/concept/grammar-start> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The start production of BeatScript's grammar (the named arrangement that plays first; default the first written)."@en ;
	skos:prefLabel "start"@en ;
	ns:ebnf "\"start\" NAME" ;
	ns:grammarSection "Structure: lets, defs, sections, the arrangement"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-start> ;
	ns:usesToken <https://beatscript.app/ontology/concept/token-name> ;
	ns:writtenAs "start" .
<https://beatscript.app/ontology/concept/grammar-statement> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The statement production of BeatScript's grammar."@en ;
	skos:prefLabel "statement"@en ;
	ns:ebnf "setting | headed | let | def | repeat | section | arrange | arrange_block | start | launch | import | end | loop | evolve | wire | assert | sample | use | set" ;
	ns:grammarSection "Programs and lines"@en ;
	ns:status "stable" ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-arrange-block> , <https://beatscript.app/ontology/concept/grammar-arrange> , <https://beatscript.app/ontology/concept/grammar-assert> , <https://beatscript.app/ontology/concept/grammar-def> , <https://beatscript.app/ontology/concept/grammar-end> , <https://beatscript.app/ontology/concept/grammar-evolve> , <https://beatscript.app/ontology/concept/grammar-headed> , <https://beatscript.app/ontology/concept/grammar-import> , <https://beatscript.app/ontology/concept/grammar-launch> , <https://beatscript.app/ontology/concept/grammar-let> , <https://beatscript.app/ontology/concept/grammar-loop> , <https://beatscript.app/ontology/concept/grammar-repeat> , <https://beatscript.app/ontology/concept/grammar-sample> , <https://beatscript.app/ontology/concept/grammar-section> , <https://beatscript.app/ontology/concept/grammar-set> , <https://beatscript.app/ontology/concept/grammar-setting> , <https://beatscript.app/ontology/concept/grammar-start> , <https://beatscript.app/ontology/concept/grammar-use> , <https://beatscript.app/ontology/concept/grammar-wire> ;
	ns:writtenAs "statement" .
<https://beatscript.app/ontology/concept/grammar-stored> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The stored production of BeatScript's grammar (a saved program's section or part, by its CID: <cid>.drop <cid>.drop.bass; a bare <cid> is a program with no sections)."@en ;
	skos:prefLabel "stored"@en ;
	ns:ebnf "CID [ \".\" NAME ] [ \".\" role ]" ;
	ns:grammarSection "Start from a seed"@en ;
	ns:hostOnly true ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-symbol-dot> ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-role> ;
	ns:usesToken <https://beatscript.app/ontology/concept/token-cid> , <https://beatscript.app/ontology/concept/token-name> ;
	ns:writtenAs "stored" .
<https://beatscript.app/ontology/concept/grammar-structure> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The structure production of BeatScript's grammar (the generator's song structures; standard is the default)."@en ;
	skos:prefLabel "structure"@en ;
	ns:ebnf "\"standard\" | \"loop\" | \"minimal\" | \"extended\"" ;
	ns:grammarSection "Start from a seed"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-extended> , <https://beatscript.app/ontology/concept/keyword-loop> , <https://beatscript.app/ontology/concept/keyword-minimal> , <https://beatscript.app/ontology/concept/keyword-standard> ;
	ns:writtenAs "structure" .
<https://beatscript.app/ontology/concept/grammar-subject> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The subject production of BeatScript's grammar (sing: the vocal; a deck; A.snare; bass on both decks)."@en ;
	skos:prefLabel "subject"@en ;
	ns:ebnf "\"sing\" | ldeck | [ ldeck \".\" ] role" ;
	ns:grammarSection "Assertions"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-sing> , <https://beatscript.app/ontology/concept/keyword-symbol-dot> ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-ldeck> , <https://beatscript.app/ontology/concept/grammar-role> ;
	ns:writtenAs "subject" .
<https://beatscript.app/ontology/concept/grammar-sum> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The sum production of BeatScript's grammar."@en ;
	skos:prefLabel "sum"@en ;
	ns:ebnf "product { ( \"+\" | \"-\" ) product }" ;
	ns:grammarSection "Arithmetic and guards"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-symbol-minus> , <https://beatscript.app/ontology/concept/keyword-symbol-plus> ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-product> ;
	ns:writtenAs "sum" .
<https://beatscript.app/ontology/concept/grammar-target> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The target production of BeatScript's grammar."@en ;
	skos:prefLabel "target"@en ;
	ns:ebnf "\"deck\" deck | \"master\"" ;
	ns:grammarSection "Lines: when, where, what"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-deck> , <https://beatscript.app/ontology/concept/keyword-master> ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-deck> ;
	ns:writtenAs "target" .
<https://beatscript.app/ontology/concept/grammar-template> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The template production of BeatScript's grammar (a template's name and a phrase, a phrasebook id or words in quotes: the phrase is the vocal line of a track; then a form's roles)."@en ;
	skos:prefLabel "template"@en ;
	ns:ebnf "\"template\" \"(\" NAME \",\" ( PHRASE | STRING ) { \",\" binding } \")\"" ;
	ns:grammarSection "Phrase templates"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-symbol-close-paren> , <https://beatscript.app/ontology/concept/keyword-symbol-comma> , <https://beatscript.app/ontology/concept/keyword-symbol-open-paren> , <https://beatscript.app/ontology/concept/keyword-template> ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-binding> ;
	ns:usesToken <https://beatscript.app/ontology/concept/token-name> , <https://beatscript.app/ontology/concept/token-phrase> , <https://beatscript.app/ontology/concept/token-string> ;
	ns:writtenAs "template" .
<https://beatscript.app/ontology/concept/grammar-tempo> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The tempo production of BeatScript's grammar (tempo 126 tempo 100 -> 130 over 8 bars exp)."@en ;
	skos:prefLabel "tempo"@en ;
	ns:ebnf "arith [ \"->\" arith \"over\" dur [ shape ] ]" ;
	ns:grammarSection "Settings"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-over> , <https://beatscript.app/ontology/concept/keyword-symbol-arrow> ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-arith> , <https://beatscript.app/ontology/concept/grammar-dur> , <https://beatscript.app/ontology/concept/grammar-shape> ;
	ns:writtenAs "tempo" .
<https://beatscript.app/ontology/concept/grammar-term> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The term production of BeatScript's grammar (x*4 c2! e2^ x:3 x*8?0.7)."@en ;
	skos:prefLabel "term"@en ;
	ns:ebnf "atom [ mark ] [ \"*\" ( INT | \"(\" arith \")\" ) ] { \"?\" [ prob ] } [ \"~\" INT ]" ;
	ns:grammarSection "Mini-notation: the rhythm of a part"@en ;
	ns:status "stable" ;
	ns:usesKeyword <https://beatscript.app/ontology/concept/keyword-symbol-close-paren> , <https://beatscript.app/ontology/concept/keyword-symbol-open-paren> , <https://beatscript.app/ontology/concept/keyword-symbol-question> , <https://beatscript.app/ontology/concept/keyword-symbol-star> , <https://beatscript.app/ontology/concept/keyword-symbol-tilde> ;
	ns:usesProduction <https://beatscript.app/ontology/concept/grammar-arith> , <https://beatscript.app/ontology/concept/grammar-atom> , <https://beatscript.app/ontology/concept/grammar-mark> , <https://beatscript.app/ontology/concept/grammar-prob> ;
	ns:usesToken <https://beatscript.app/ontology/concept/token-int> ;
	ns:writtenAs "term" .
<https://beatscript.app/ontology/concept/grammar-time> a skos:Concept , ns:GrammarProduction ;
	skos:definition "The time production of BeatScript's grammar (glued: 5ms)."@en ;
	skos:prefLabel "time"@en ;
	ns:ebnf "DECIMAL ( \"ms\" | \"s\" )" ;
