<https://beatscript.app/ontology/concept/license-cc0-1-0> a skos:Concept , ns:License ;
	skos:closeMatch <https://creativecommons.org/publicdomain/zero/1.0/> ;
	skos:definition "Creative Commons Zero 1.0: the author dedicates the track to the public domain. The default for a new track."@en ;
	skos:prefLabel "CC0-1.0"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/license-cc0-1-0> ;
	ns:isDefaultLicense true ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/markov-melody> a skos:Concept , ns:EngineConcept ;
	skos:definition "A melody made by a chain in which the next scale degree depends on the current one and the position in the bar: strong beats land on the nearest chord tone, weak beats move by step or repeat. A density setting then turns the weakest-beat notes into rests, never the first step."@en ;
	skos:prefLabel "Markov melody"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/markov-melody> .
<https://beatscript.app/ontology/concept/modifier-accent> a skos:Concept , ns:PatternModifier ;
	skos:definition "A term written c2! is accented: played louder than its neighbours."@en ;
	skos:prefLabel "accent (!)"@en ;
	ns:markedBy <https://beatscript.app/ontology/concept/keyword-symbol-bang> ;
	ns:status "stable" ;
	ns:writtenAs "!" .
<https://beatscript.app/ontology/concept/modifier-chance> a skos:Concept , ns:PatternModifier ;
	skos:definition "A term written x?p plays with probability p (0 to 1, or a percent), drawn from the program's seed so the same program always plays the same."@en ;
	skos:prefLabel "chance (?p)"@en ;
	ns:markedBy <https://beatscript.app/ontology/concept/keyword-symbol-question> ;
	ns:status "stable" ;
	ns:writtenAs "?" .
<https://beatscript.app/ontology/concept/modifier-cycle> a skos:Concept , ns:PatternModifier ;
	skos:definition "A part written hihat/12 has a cycle of n sixteenths instead of 16, so it drifts against the bar."@en ;
	skos:prefLabel "cycle length (/n)"@en ;
	ns:markedBy <https://beatscript.app/ontology/concept/keyword-symbol-slash> ;
	ns:status "stable" ;
	ns:writtenAs "/" .
<https://beatscript.app/ontology/concept/modifier-repeat> a skos:Concept , ns:PatternModifier ;
	skos:definition "A term written x*n plays n times in the time of one slot: hihat x*4 is four hits in one step."@en ;
	skos:prefLabel "repeat (*n)"@en ;
	ns:markedBy <https://beatscript.app/ontology/concept/keyword-symbol-star> ;
	ns:status "stable" ;
	ns:writtenAs "*" .
<https://beatscript.app/ontology/concept/modifier-slide> a skos:Concept , ns:PatternModifier ;
	skos:definition "A term written e2^ slides into the next note instead of re-attacking, as on an acid bass line."@en ;
	skos:prefLabel "slide (^)"@en ;
	ns:markedBy <https://beatscript.app/ontology/concept/keyword-symbol-caret> ;
	ns:status "stable" ;
	ns:writtenAs "^" .
<https://beatscript.app/ontology/concept/monoidal-product> a skos:Concept , ns:CategoricalConcept ;
	skos:definition "Stacking parts side by side: two parts played together make one part whose net is the disjoint union of the two. Written with the tensor sign. Associative and symmetric: the order parts are listed in does not change what plays."@en ;
	skos:prefLabel "monoidal product"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/monoidal-product> ;
	ns:status "in-development" .
<https://beatscript.app/ontology/concept/move-bass-swap> a skos:Concept , ns:PerformMove ;
	skos:definition "Cut the outgoing deck's low end and bring in the incoming deck's, so two basslines never sound together."@en ;
	skos:prefLabel "bass swap"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/move-bass-swap> ;
	ns:status "stable" .
<https://beatscript.app/ontology/concept/move-echo-out> a skos:Concept , ns:PerformMove ;
	skos:definition "Feed the outgoing deck into a delay and cut the dry signal, leaving the echoes to trail away."@en ;
	skos:prefLabel "echo out"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/move-echo-out> ;
	ns:status "stable" .
<https://beatscript.app/ontology/concept/move-filter-exit> a skos:Concept , ns:PerformMove ;
	skos:definition "Close a filter on the outgoing deck until it fades out of the mix."@en ;
	skos:prefLabel "filter exit"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/move-filter-exit> ;
	ns:status "stable" .
<https://beatscript.app/ontology/concept/move-loop-roll> a skos:Concept , ns:PerformMove ;
	skos:definition "Repeat ever shorter slices of the playing audio to build tension."@en ;
	skos:prefLabel "loop roll"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/move-loop-roll> ;
	ns:status "stable" .
<https://beatscript.app/ontology/concept/move-phrase-sync> a skos:Concept , ns:PerformMove ;
	skos:definition "Line the incoming deck up so its phrase starts on the outgoing deck's phrase boundary."@en ;
	skos:prefLabel "phrase sync"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/move-phrase-sync> ;
	ns:status "stable" .
<https://beatscript.app/ontology/concept/move-vocoder-handoff> a skos:Concept , ns:PerformMove ;
	skos:definition "Pass the carrier role of a vocoder from one deck to the other so a voice carries across the change."@en ;
	skos:prefLabel "vocoder handoff"@en ;
	prov:wasDerivedFrom <https://ontology.bitwrap.io/concept/move-vocoder-handoff> ;
	ns:status "stable" .
<https://beatscript.app/ontology/concept/mutation-every-nth-pass> a skos:Concept , ns:LanguageTerm ;
	skos:definition "An arrange mutation written ~N target op (or @N target op) fires only on every Nth pass of its arrange block, on passes N, 2N, 3N and so on counted from 1; with no count it fires on every pass."@en ;
	skos:prefLabel "mutation count (~N, @N)"@en ;
	ns:markedBy <https://beatscript.app/ontology/concept/token-int> ;
	ns:status "stable" ;
	ns:writtenAs "~N" .
<https://beatscript.app/ontology/concept/mutation-from-here> a skos:Concept , ns:LanguageTerm ;
	skos:definition "An arrange mutation written ~target op applies from that point of the arrangement to its end."@en ;
	skos:prefLabel "mutation from here on (~)"@en ;
	ns:markedBy <https://beatscript.app/ontology/concept/keyword-symbol-tilde> ;
	ns:status "stable" ;
	ns:writtenAs "~" .
<https://beatscript.app/ontology/concept/mutation-next-section> a skos:Concept , ns:LanguageTerm ;
	skos:definition "An arrange mutation written @target op applies to the next section only."@en ;
	skos:prefLabel "mutation for one section (@)"@en ;
	ns:markedBy <https://beatscript.app/ontology/concept/keyword-symbol-at> ;
	ns:status "stable" ;
	ns:writtenAs "@" .
