#! name: Full fathom five
#! license: CC0-1.0
# full-fathom-five: the reference program of the PASSACAGLIA form (docs/beatscript/forms.md; `template(passacaglia, ...)` is its skeleton).
# CC0-1.0. It sings lines of Ariel's song from William Shakespeare, The Tempest, 1.2 (first printed in the First Folio, 1623, in
# the public domain; the words as in the Globe edition, 1864): "Full fathom five thy father lies" and "Those are pearls that
# were his eyes", respelt for the voice with phoneme escapes. Linked data: full-fathom-five.jsonld (isBasedOn The Tempest). A fixed ground (syn_bass, then syn_bass2) under
# cumulative variations above it: `~ syn_marimba rot 2 | accent`, `~ drm_shk thin`, `~ drm_* grow`, `rev | drift`, `~ syn_* up 1`
# then `down 1`, `decay`; the voice crossed onto the shaker and the hats with one-shot `@ vox xfer`.
# Known: `check` warns that `full` and `five` are not in the lexicon (sounded out by the rules as /f uh l/ and /f ie v/). The
# program is pinned as it is, warning included: an escape would change its code and so its CID.
# Hand-written 2026-11-22; the program below is its canonical text unchanged, CID
# z4EBG9j7BJKjYPfs6QQBQCdjieviWbSwbJqEPm9idg79wTYNLW1 (these comment lines are not part of it).
tempo 112
key g
swing 0.12
let kick4 = x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~ ~ ~
let drm_clap = ~ ~ ~ ~ x ~ ~ ~ ~ ~ ~ ~ x ~ ~ ~
let drm_hat = ~ ~ x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~
let drm_shk = x ~ x x x ~ x x x ~ x x x ~ x x
let chords = ~ ~ [g3, b3, d4] ~ ~ ~ [g3, b3, d4] ~ ~ ~ [e3, g3, b3] ~ ~ ~ [e3, g3, b3] ~
let chords2 = ~ ~ [c3, e3, g3] ~ ~ ~ [c3, e3, g3] ~ ~ ~ [d3, f#3, a3] ~ ~ ~ [d3, f#3, a3] ~
let syn_marimba = g4 ~ b4 d5 ~ b4 g4 ~ e4 ~ g4 b4 ~ g4 e4 ~
let syn_flute = d5 ~ ~ ~ b4 ~ ~ ~ g4 ~ a4 ~ b4 ~ ~ ~
let syn_bass = g1 ~ ~ g1 ~ ~ ~ ~ e1 ~ ~ e1 ~ ~ ~ ~
let syn_bass2 = c2 ~ ~ c2 ~ ~ ~ ~ d2 ~ ~ d2 ~ ~ ~ ~
let pads = [g3, b3, d4, f#4] ~ ~ ~ ~ ~ ~ ~ [c3, e3, g3, b3] ~ ~ ~ ~ ~ ~ ~
let vox = g3 ~ ~ b3 ~ d4 ~ ~ b3 ~ a3 ~ g3 ~ ~ ~
section shore 8 bars {
  deck A: kick kick4 kit=drums vel=90..105 | hihat drm_hat kit=drums vel=50..75 | snare drm_shk kit=drums-lofi vel=25..45
  deck B: bass syn_bass decay=220 inst=sub-bass | harmony chords inst=steel-drum vel=55..75 | arp syn_marimba inst=marimba vel=50..75
}
section fathom 8 bars {
  master: reverb 0.15
  deck A: kick kick4 kit=drums vel=90..105 | clap drm_clap kit=drums vel=70..90 | hihat drm_hat kit=drums vel=55..80 | snare drm_shk kit=drums-lofi vel=25..45
  deck B: bass syn_bass decay=220 inst=sub-bass | harmony chords inst=steel-drum vel=45..60 | melody vox
  deck B: sing "full /f ae dh uh m/ five /dh ie/ father /l ie z/" on melody
}
section coral 8 bars {
  master: reverb 0.15
  deck A: kick kick4 kit=drums vel=90..105 | clap drm_clap kit=drums vel=70..90 | hihat drm_hat kit=drums vel=55..80 | snare drm_shk kit=drums-lofi vel=25..45
  deck B: bass syn_bass2 decay=220 inst=sub-bass | harmony chords2 inst=steel-drum vel=55..75 | arp syn_marimba inst=marimba vel=45..70 | melody syn_flute inst=flute vel=60..85
}
section pearls 8 bars {
  master: reverb 0.1
  deck A: kick kick4 kit=drums vel=85..100 | hihat drm_hat kit=drums vel=35..55
  deck B: bass syn_bass2 decay=200 inst=sub-bass | harmony pads inst=warm-pad vel=35..48 | melody vox
  deck B: sing "those are /p er l z/ that were his eyes" on melody
}
section tide 4 bars {
  master: reverb 0.3
  master: filter lp 9000 -> 2500 over 4 bars
  deck B: harmony pads inst=warm-pad vel=45..60 | arp syn_marimba inst=kalimba vel=50..70
}
arrange {
  shore fathom
  ~ syn_marimba rot 2 | accent 0.25
  ~ drm_shk thin 0.15
  coral
  ~ syn_flute morph syn_marimba 0.3
  fathom pearls
  ~ drm_* grow
  tide
  ~ syn_marimba rev | drift 0.1
  @ vox xfer drm_shk
  fathom coral
  ~ syn_* up 1
  @ syn_flute mirror | vel 2
  coral
  ~ syn_* down 1
  @ vox xfer drm_hat
  pearls tide
  ~ drm_* decay
} loop
