# F10, composition made literal: stack(a, b) plays sections at once, then(a, b) one after the other,
# `arrange a b c` is then(a, b, c), `silence` is the unit of both, and a `let` names a composition.
# Original, CC0-1.0.
tempo 118
key am

section intro 4 bars {
  deck A: hihat x ~ x ~ vel=50..80
}

section groove 8 bars {
  deck A: kick x ~ x ~ | snare ~ x ~ x | hihat x*8 vel=60..90
}

section wash 8 bars {
  deck B: harmony <chord(am) chord(f) chord(c) chord(g)>
}

# four bars: stacked on an eight-bar section it stops where it ends (its decks stop), and played twice
# in a row (then) it fills the eight
section riff 4 bars {
  deck B: melody <a4 c5 e5 g5> | bass <a1 ~ c2 ~>
}

section coda 4 bars {
  deck A: kick x ~ ~ ~
  deck B: harmony chord(am)
}

# an alias: a name for two sections together
let verse = stack(groove, wash)

# intro, then the verse with the riff twice over it, then the coda; the order inside stack() does not matter
arrange intro stack(then(riff, riff), verse) coda
end after coda
