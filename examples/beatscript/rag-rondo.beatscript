#! beatscript 2
#! name: Rag Rondo
#! themes after Scott Joplin, The Entertainer (1902) and Maple Leaf Rag (1899), public domain
#! license: CC0-1.0
# rag-rondo: the reference program of the RONDO form (docs/beatscript/forms.md; `template(rondo, ...)` is its skeleton). CC0-1.0.
# Its themes are after Scott Joplin, The Entertainer (1902; syn_ent, syn_ent2: the first strain) and Maple Leaf Rag (1899;
# syn_maple: an approximation of its figure in C, not a transcription), both in the public domain. Linked data: rag-rondo.jsonld.
# Electro-swing at 122: the refrain `rag` returns mutated (`~ syn_ent rot 2 | accent`, `@ syn_ent xfer drm_hat`, `~ syn_ent
# mirror | vel 2`) between the contrasting strains `maple` and `trio`, with cross-morphs between the strains.
# Known (the program's own record): the master clips about 0.1 ms in the rag sections, and `up 1` / `down 1` flatten the
# Entertainer's d# passing tones to d (degrees of the key have no sharps).
# Hand-written 2026-11-22; the program below is its canonical text unchanged, CID
# z4EBG9izzm3asNWWapjXtPFSZoPzgyj4cKjPELrw4jvrhdjPxrW (these comment lines are not part of it).
tempo 122
key c
swing 0.18
let kick4 = x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~ ~ ~
let drm_snr = ~ ~ ~ ~ x ~ ~ ~ ~ ~ ~ ~ x ~ ~ ~
let drm_hat = ~ ~ x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x x
let drm_shk = x ~ x ~ x ~ x ~ x ~ x ~ x ~ x ~
let bassC = c2 ~ ~ ~ ~ ~ ~ ~ g1 ~ ~ ~ ~ ~ ~ ~
let bassF = f1 ~ ~ ~ ~ ~ ~ ~ c2 ~ ~ ~ ~ ~ ~ ~
let strideC = ~ ~ ~ ~ [e3, g3, c4] ~ ~ ~ ~ ~ ~ ~ [f3, g3, b3] ~ ~ ~
let strideF = ~ ~ ~ ~ [f3, a3, c4] ~ ~ ~ ~ ~ ~ ~ [e3, g3, c4] ~ ~ ~
let syn_ent = d4 d#4 e4 c5 ~ e4 c5 ~ e4 c5 ~ ~ ~ ~ ~ ~
let syn_ent2 = c5 d5 d#5 e5 c5 d5 e5 ~ b4 d5 ~ c5 ~ ~ ~ ~
let syn_maple = ~ g4 c5 e5 ~ g5 ~ e5 c5 ~ g4 ~ e5 ~ c5 ~
let syn_trio = c5 ~ a4 ~ f4 ~ a4 c5 ~ d5 c5 a4 ~ f4 ~ ~
let brass = ~ ~ ~ ~ [e4, g4, c5] ~ ~ [e4, g4, c5] ~ ~ ~ ~ ~ ~ ~ ~
section intro 4 bars {
  master: filter lp 2500 -> 12000 over 4 bars
  deck B: bass bassC decay=180 inst=bass vel=70..85 | harmony strideC inst=piano vel=50..65
}
section rag 8 bars {
  deck A: kick kick4 kit=drums vel=80..95 | clap drm_snr kit=drums vel=60..80 | hihat drm_hat kit=drums vel=40..65 | snare drm_shk kit=drums-lofi vel=20..35
  deck B: bass bassC decay=180 inst=bass vel=70..85 | harmony strideC inst=piano vel=50..65 | melody syn_ent inst=piano vel=55..75 | arp syn_ent2 inst=clavinet vel=40..60
}
section maple 8 bars {
  master: reverb 0.15
  deck A: kick kick4 kit=drums vel=85..100 | clap drm_snr kit=drums vel=60..80 | hihat drm_hat kit=drums vel=45..70
  deck B: bass bassC decay=180 inst=bass vel=70..85 | harmony brass inst=brass vel=50..70 | melody syn_maple inst=sax vel=65..85 | arp strideC inst=piano vel=45..60
}
section trio 8 bars {
  master: reverb 0.2
  deck A: kick kick4 kit=drums vel=80..95 | hihat drm_hat kit=drums vel=40..60 | snare drm_shk kit=drums-lofi vel=20..35
  deck B: bass bassF decay=200 inst=bass vel=70..85 | harmony strideF inst=electric-piano vel=50..65 | melody syn_trio inst=trumpet vel=60..80
}
section outro 4 bars {
  master: reverb 0.3
  master: filter lp 12000 -> 2000 over 4 bars
  deck B: bass bassC decay=180 inst=bass vel=70..85 | harmony strideC inst=piano vel=50..65 | melody syn_ent inst=music-box vel=55..75
}
arrange {
  intro rag
  ~ syn_ent2 morph syn_maple 0.25
  maple
  ~ syn_ent rot 2 | accent 0.3
  ~ drm_shk thin 0.2
  rag
  ~ syn_maple morph syn_ent 0.25
  trio
  ~ drm_* grow
  @ syn_ent xfer drm_hat
  rag
  ~ syn_trio morph syn_maple 0.3
  ~ syn_* up 1
  maple
  ~ syn_* down 1
  ~ syn_ent mirror | vel 2
  rag outro
  ~ drm_* decay
} loop
