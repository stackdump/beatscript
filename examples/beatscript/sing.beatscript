#! beatscript 2
# sing: typed lyrics sung on a part's own notes (CC0-1.0, an original line).
# `sing "words" on melody` gives each syllable one note of the melody, in order, timed to the melody (no rhythm of its own).
# The lyric wraps when it is shorter than the notes and stops when it is longer. A hyphen splits a word into syllables
# (lan-tern), `_` is a rest, `voice=` names a voice: a neural one (alto) that is not installed falls back to the
# formant voice, and `check` says so. The line is a control line: it fires where its section starts.
tempo 112
key am

deck A: kick x ~ x ~ | snare ~ x ~ x | hihat x*8 vel=60..90
deck B: bass a2 ~ e2 ~ | harmony chord(am) | melody <[a4 c5 e5 c5] [g4 b4 d5 b4]>

section verse 8 bars {
  # eight syllables on the melody's eight notes (it takes two bars to come round), sung over the whole section
  deck B: sing "lamps in the harbor, glowing slow" on melody voice=alto
}

section answer 4 bars {
  # a shorter lyric wraps over the two bars it is told to cover
  deck B: sing "hush _ lan-tern" on melody bars=2 voice=robot-choir
}

arrange verse answer
