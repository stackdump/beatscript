#! beatscript 2
# scale.beatscript: degrees, Roman numerals, a key per section and voice leading (F5). Original, CC0-1.0.
# The song is i VI III VII in A minor (Am F C G): chords that move as little as they can, the
# roots in the bass, a melody written as degrees of the key. The second section says `key cm`
# as its first line, and every degree and numeral above is read again in C minor.
tempo 96
key am

# deg( ) takes accidentals and octave marks: #7 is the 7th degree raised a semitone (the leading
# tone), 1' is the tonic an octave up and 1, an octave down
let tune = deg(1 3 5 ~ #7 1' 5 1,)

deck A: kick x ~ x ~ | hihat x*8 vel=60..90
deck B: harmony i VI III VII voice-lead | bass i VI III VII | melody tune

# an arp plays a numeral's chord one note at a time over its share of the bar: ii° is B D F,
# V7/7 is E7 with its seventh in the bass
section verse 8 bars {
  deck B: arp i ii° V7/7 i voice-lead
}

# bII is the chord on the lowered second degree (Db in C minor); V7 is G7
section lift 8 bars {
  key cm
  deck B: arp i bII V7 i
}

arrange verse lift verse
